	-- Rebind root butt welds to legs (R15: UpperLeg, R6: Leg). UV/skin stay under the root.
	-- Returns: reboundCount, hasLeft, hasRight
	function Function.ReparentButtsToLegs(Character, Data)
		if not Character then return 0, false, false end
		local morph = Character:FindFirstChild("Morph")
		if not morph then return 0, false, false end

		local leftLeg = Character:FindFirstChild("LeftUpperLeg")
			or Character:FindFirstChild("Left Leg")
		local rightLeg = Character:FindFirstChild("RightUpperLeg")
			or Character:FindFirstChild("Right Leg")
		if not leftLeg and not rightLeg then
			warn("[Morph] ButtsParentToLegs: no leg parts found")
			return 0, false, false
		end

		local function findWeld(part)
			local w = part:FindFirstChildOfClass("Motor6D") or part:FindFirstChildOfClass("Weld")
			if w then return w end
			w = part:FindFirstChild(part.Name .. " Weld") or part:FindFirstChild(part.Name .. "_Weld")
			if w and (w:IsA("Motor6D") or w:IsA("Weld")) then return w end
			for _, c in ipairs(part:GetChildren()) do
				if c:IsA("Motor6D") or c:IsA("Weld") then return c end
			end
			local par = part.Parent
			if par then
				for _, c in ipairs(par:GetChildren()) do
					if (c:IsA("Motor6D") or c:IsA("Weld")) and c.Part1 == part then
						return c
					end
				end
			end
			return nil
		end

		local function isButtRoot(part)
			local n = string.lower(part.Name)
			if n:find("uv") or n:find("skin") or n:find("texture") or n:find("pant") then
				return false
			end
			if not (n:find("butt") or n:find("ass")) then return false end
			local p = part.Parent
			if p and p:IsA("BasePart") then
				local pn = string.lower(p.Name)
				if pn:find("butt") or pn:find("ass") then return false end
			end
			return true
		end

		local function pickLeg(part, n)
			if n:find("left") and not n:find("right") then
				return leftLeg
			end
			if n:find("right") then
				return rightLeg
			end
			local root = Character:FindFirstChild("HumanoidRootPart")
				or Character:FindFirstChild("Torso")
				or Character:FindFirstChild("UpperTorso")
			if root then
				if part.Position.X >= root.Position.X then
					return rightLeg
				else
					return leftLeg
				end
			end
			return rightLeg
		end

		local rebound, gotLeft, gotRight = 0, false, false
		for _, d in ipairs(morph:GetDescendants()) do
			if not d:IsA("BasePart") then continue end
			if not isButtRoot(d) then continue end
			local n = string.lower(d.Name)
			local leg = pickLeg(d, n)
			if not leg then continue end

			local weld = findWeld(d)
			if not weld then continue end

			if weld.Part0 == leg then
				if leg == leftLeg then gotLeft = true end
				if leg == rightLeg then gotRight = true end
				continue
			end

			local worldCF = d.CFrame
			weld.Part0 = leg
			weld.Part1 = d
			local c1 = weld.C1
			if typeof(c1) ~= "CFrame" then c1 = CFrame.new() end
			weld.C0 = leg.CFrame:ToObjectSpace(worldCF) * c1

			local pd = PlayerData[Data]
			local physList = pd and pd.CurrentPartList and pd.CurrentPartList.BodyPartPhysics
			if physList and physList[d] then
				-- Keep spring Base on torso (leg motion as Base makes butts explode).
				-- Only refresh weld refs + rest pose after reparent.
				physList[d].Weld = weld
				physList[d].CF = weld.C0
				physList[d].CF1 = weld.C1
				local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
				if torso then
					physList[d].Base = torso
					physList[d].OriginCFrame = torso.CFrame
				end
				if physList[d].Spring then
					physList[d].Spring.Position = Vector3.zero
					physList[d].Spring.Velocity = Vector3.zero
				end
			end
			rebound += 1
			if leg == leftLeg then gotLeft = true end
			if leg == rightLeg then gotRight = true end
		end
		return rebound, gotLeft, gotRight
	end


	function Function.ApplyPhysicsToggle(Character, Data, kind, enabled)
		-- kind = "breast" | "butt" | "soft"
		local data = PlayerData[Data]
		if not data or not data.CurrentPartList then return end
		local phys = data.CurrentPartList.BodyPartPhysics
		if not phys then return end

		if not enabled then
			if kind == "breast" then
				Function.ClearClothWrap(Data)
			end
			-- Freeze + remove so a mode switch (e.g. asym) can re-register cleanly
			for part, prop in pairs(phys) do
				if prop.Kind == kind or (kind == "breast" and prop.Kind == "breastCloth") then
					if prop.Weld and prop.CF then
						pcall(function()
							prop.Weld.C0 = prop.CF
							if prop.Spring then
								prop.Spring.Position = Vector3.zero
								prop.Spring.Velocity = Vector3.zero
							end
						end)
					end
					phys[part] = nil
				end
			end
			return
		end

		if not Character then return end

		local morph = Character:FindFirstChild("Morph")
		if not morph then return end
		local Extra = { UVToggle = data.UVToggle }

		if kind == "breast" then
			Function.ClearClothWrap(Data)
			-- Clear any old breast springs so asym on/off rebuilds correctly
			for part, prop in pairs(phys) do
				if prop.Kind == "breast" or prop.Kind == "breastCloth" then phys[part] = nil end
			end
			if data and data.AsymBounce == true and data.UVToggle ~= true then
				-- Naked-only asym: root + L/R skin springs
				local root = morph:FindFirstChild("Torso") and morph.Torso:FindFirstChild("BreastsRoot")
				if root then
					pcall(function()
						root:SetAttribute("PhysicsKind", "breast")
						root:SetAttribute("AsymSide", nil)
					end)
					if not data.CurrentPartList.BodyPartPhysics[root] then
						local Torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
						if Torso then
							Function.SpringCreate(
								root, Torso,
								Vector3.new(1,1,1) * 5, Vector3.zero,
								10, 0.2,
								{X = "Y", Y = "Z", Z = "X"}, {X = 0, Y = 0, Z = 0},
								{X = "Y", Y = "Z", Z = "X"}, {X = 5, Y = -5, Z = 5},
								Data
							)
						end
					end
				end
				for _, d in ipairs(morph:GetDescendants()) do
					if d:IsA("BasePart") then
						local n = string.lower(d.Name)
						if n:find("root") or n:find("texture") or n:find("uv") or n:find("pant") or n:find("cloth") then
							-- skip
						elseif (n:find("breast") or n:find("boob") or n:find("nipple")) then
							Function.BreastPhysics(d, Character, Extra, Data)
						end
					end
				end
			else
				local root = morph:FindFirstChild("Torso") and morph.Torso:FindFirstChild("BreastsRoot")
				if root then
					Function.BreastPhysics(root, Character, Extra, Data)
				else
					for _, d in ipairs(morph:GetDescendants()) do
						if d:IsA("BasePart") then
							local n = string.lower(d.Name)
							if (n:find("breast") or n:find("boob")) and not n:find("uv") and not n:find("texture") then
								Function.BreastPhysics(d, Character, Extra, Data)
							end
						end
					end
				end
			end
		elseif kind == "butt" then
			for _, d in ipairs(morph:GetDescendants()) do
				if d:IsA("BasePart") then
					local n = string.lower(d.Name)
					if (n:find("butt") or n:find("ass")) and not n:find("uv") and not n:find("skin") and not n:find("texture") then
						Function.ButtPhysics(d, Character, Extra, Data)
					end
				end
			end
		elseif kind == "soft" then
			Function.ApplySoftBody(Character, Data, enabled)
		end
	end

	function Function.ButtPhysics(ObjectInstance, Character, Extra, Data)
		-- Optimized: one spring per butt mesh, no per-frame Size squash (Scale=false),
		-- higher damper, skip if already registered or disabled.
		if not PlayerData[Data].BodyPartPhysics then return end
		if PlayerData[Data].ButtPhysicsEnabled == false then return end
		-- Parent-to-legs + spring fight each other → no butt physics while parented
		if PlayerData[Data].ButtsParentToLegs == true then return end
		if not ObjectInstance or not ObjectInstance.Parent then return end

		-- Only root meshes (Left/Right Butt), not UV/skin layers
		local n = string.lower(ObjectInstance.Name or "")
		if n:find("uv") or n:find("skin") or n:find("texture") or n:find("pant") then
			return
		end
		if PlayerData[Data].CurrentPartList.BodyPartPhysics[ObjectInstance] then return end

		-- Always drive from torso — leg as Base makes PositionDistance explode when walking
		local base = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
		if not base then return end

		pcall(function() ObjectInstance:SetAttribute("PhysicsKind", "butt") end)

		-- Soft, stable, no Size squash
		Function.SpringCreate(
			ObjectInstance,
			base,
			Vector3.new(1, 1, 1) * 3.5,
			Vector3.new(0, 0, 0),
			9,
			0.35,
			{X = "X", Y = "Y", Z = "Z"},
			{X = 0.003, Y = 0.004, Z = 0.003},
			{X = "Z", Y = "Y", Z = "X"},
			{X = 1.6, Y = -2.8, Z = -1.2},
			Data,
			false
		)
	end

	-- R6 only: classic Torso present, no R15 UpperTorso
	function Function.IsR6Character(Character)
		if not Character then return false end
		return Character:FindFirstChild("Torso") ~= nil and Character:FindFirstChild("UpperTorso") == nil
	end

	-- Eligible morph part for soft body (torso / limbs / head — not organs, not UV)
	function Function.IsSoftBodyPartName(name)
		local n = (name or ""):lower()
		if n == "" then return false end
		if n:find("breast") or n:find("boob") or n:find("nipple") or n:find("butt") or n:find("ass") then
			return false
		end
		if n:find("uv") or n:find("skin") or n:find("texture") or n:find("shirt") or n:find("pant") or n:find("cloth") then
			return false
		end
		if n:find("vagina") or n:find("vulva") or n:find("clitoris") or n:find("majora") or n:find("closed") then
			return false
		end
		if n:find("root") or n:find("areola") then
			return false
		end
		if n:find("torso") or n:find("leg") or n:find("arm") or n:find("head") then
			return true
		end
		return false
	end

	-- Find Motor6D that drives this part (child, or character joint with Part1 = part)
	function Function.FindMotorForPart(Character, Part)
		if not Part then return nil end
		local m = Part:FindFirstChildOfClass("Motor6D")
		if m then return m end
		-- R6 joints live on Torso (Neck, Shoulders, Hips) with Part1 = limb/head
		if Character then
			for _, d in ipairs(Character:GetDescendants()) do
				if d:IsA("Motor6D") and d.Part1 == Part then
					return d
				end
			end
		end
		return nil
	end

	-- Cheek-style soft spring (Morph meshes OR real R6 Head/Arms/Legs)
	function Function.SoftBodyPhysics(ObjectInstance, Character, Extra, Data)
		local data = getPlayerData(Data)
		if not data or not data.BodyPartPhysics then return end
		if data.SoftBodyEnabled == false then return end
		if not Function.IsR6Character(Character) then return end
		if not ObjectInstance or not ObjectInstance.Parent then return end
		if not ObjectInstance:IsA("BasePart") then return end
		if not Function.IsSoftBodyPartName(ObjectInstance.Name) then return end
		if data.CurrentPartList and data.CurrentPartList.BodyPartPhysics[ObjectInstance] then
			return
		end

		local Weld = Function.FindMotorForPart(Character, ObjectInstance)
		if not Weld then return end

		local base = Character:FindFirstChild("Torso")
		if not base then return end

		pcall(function() ObjectInstance:SetAttribute("PhysicsKind", "soft") end)

		-- Register spring with resolved Motor6D (may live on Torso for real limbs)
		local CF = Weld.C0
		local CF1 = Weld.C1
		local SpringInst = Spring.new(Vector3.new(0, 0, 0))
		SpringInst.Target = Vector3.new(1, 1, 1) * 3.5
		SpringInst.Velocity = Vector3.zero
		SpringInst.Speed = 9
		SpringInst.Damper = 0.35

		data.CurrentPartList.BodyPartPhysics[ObjectInstance] = {
			Spring = SpringInst,
			Base = base,
			Weld = Weld,
			CF = CF,
			CF1 = CF1,
			OriginCFrame = base.CFrame,
			PositionOffset = {X = "X", Y = "Y", Z = "Z"},
			Position = {X = 0.003, Y = 0.004, Z = 0.003},
			RotationOffset = {X = "Z", Y = "Y", Z = "X"},
			Rotation = {X = 1.6, Y = -2.8, Z = -1.2},
			Size = ObjectInstance.Size,
			Scale = false,
			Kind = "soft",
			AsymSide = nil,
			AsymPhase = math.random() * 6.28,
			AsymNoise = 0.7 + math.random() * 0.6,
			LastOffset = Vector3.zero,
			LastRot = Vector3.zero,
			IsRealLimb = (ObjectInstance.Parent == Character), -- head/arms/legs on character
		}
	end

	-- Scan Morph + real R6 Head/Arms/Legs for soft body springs
	function Function.ApplySoftBody(Character, Data, enabled)
		local data = getPlayerData(Data)
		if not data or not data.CurrentPartList then return end
		local phys = data.CurrentPartList.BodyPartPhysics
		if not phys then return end

		for part, prop in pairs(phys) do
			if prop and prop.Kind == "soft" then
				if prop.Weld and prop.CF then
					pcall(function()
						prop.Weld.C0 = prop.CF
						if prop.Spring then
							prop.Spring.Position = Vector3.zero
							prop.Spring.Velocity = Vector3.zero
						end
					end)
				end
				phys[part] = nil
			end
		end

		if enabled ~= true then return end
		if not Character or not Function.IsR6Character(Character) then return end

		local Extra = { UVToggle = data.UVToggle }

		-- 1) Morph body meshes (torso/leg overlays, etc.)
		local morph = Character:FindFirstChild("Morph")
		if morph then
			for _, d in ipairs(morph:GetDescendants()) do
				if d:IsA("BasePart") and Function.IsSoftBodyPartName(d.Name) then
					pcall(function()
						Function.SoftBodyPhysics(d, Character, Extra, Data)
					end)
				end
			end
		end

		-- 2) Real R6 parts that have no custom morph mesh (Head, Arms; Legs if no morph leg)
		--    Motor6Ds are on Torso (Neck / Shoulders / Hips), Part1 = these parts.
		local realNames = {"Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
		for _, name in ipairs(realNames) do
			local part = Character:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				pcall(function()
					Function.SoftBodyPhysics(part, Character, Extra, Data)
				end)
			end
		end
	end


	function Function.CreateR6(CF)
		local R6 = Instance.new("Model")
		local R6Humanoid = Instance.new("Humanoid", R6)

		local RootPart = Instance.new("Part", R6)
		RootPart.Name = "HumanoidRootPart"
		RootPart.Size = Vector3.new(2,2,1)
		RootPart.Anchored = true
		RootPart.Transparency = 1

		R6.PrimaryPart = RootPart

		for Name, Property in pairs(R6Map) do
			local Part = Instance.new("Part", R6)
			Part.Size = Property.Size
			Part.CFrame = RootPart.CFrame * Property.Offset
			Part.Anchored = true
			Part.Name = Name

			if Name == "Head" then
				local SpecialMesh = Instance.new("SpecialMesh", Part)
				SpecialMesh.MeshType = Enum.MeshType.Head
				SpecialMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
			end
		end

		for Name, Property in pairs(R6Joints) do
			local Joint = Instance.new("Motor6D",R6[Property["Part0"]])
			Joint.Name = Name
			Joint.C0 = Property["C0"]
			Joint.C1 = Property["C1"]
			Joint.Part0 = Property["Part0"]
			Joint.Part1 = Property["Part1"]
		end


		return R6
	end

	function Function.PlayerDataAdd(Name)
		if not PlayerData[Name] then
			PlayerData[Name] = Function.PlayerDataDefault()
		end
	end

	function Function.Weld(PartConfig, Character,Extra,Data)
		local tokenAtStart = PlayerData[Data] and PlayerData[Data].WeldToken or 0
		task.spawn(function()
			-- Drop work from cancelled / superseded applies (stops lag accumulation)
			if not PlayerData[Data] or PlayerData[Data].WeldToken ~= tokenAtStart then
				return
			end
			if not Character or not Character.Parent then return end
			local INSTANCE = PartConfig["Instance"]
			local NAME = PartConfig["Name"]
			-- print("Processing "..NAME)
			local CFRAME = PartConfig["Joint"]["CFrame"]
			local CFRAME1 = PartConfig["Joint"]["CFrame1"]

			local TRANSPARENCY = PartConfig["Transparency"]
			local MATERIAL = PartConfig["Material"]
			local COLOR = PartConfig["Color"]

			local PARENT = PartConfig["Parent"]
			local FUNCTION = PartConfig["Function"]

			local SCALE = PartConfig["Scale"]
			local SIZE = PartConfig["Size"]
			local ADJUSTSCALE = PartConfig["AdjustScale"]

			local MESHID = PartConfig["MeshId"]
			local TEXTUREID = PartConfig["TextureId"]

			local SHAPE = PartConfig["Shape"]

			local PHYSICS = PartConfig["Physics"]
			local EXTRA = PartConfig["Extra"]

			if PARENT[1] == nil then
				PARENT[1] = "Torso"
			end
			-- Prefer Morph anchor; fall back to R6 Torso or R15 UpperTorso
			local BodyPart = Character.Morph and Character.Morph:FindFirstChild(PARENT[1])
			if not BodyPart then
				BodyPart = Character:FindFirstChild(PARENT[1])
			end
			if not BodyPart then
				BodyPart = Character:FindFirstChild("Torso")
					or Character:FindFirstChild("UpperTorso")
			end
			if BodyPart then
				local sizeKey = BodyPart.Name
				if sizeKey == "UpperTorso" or sizeKey == "LowerTorso" then
					sizeKey = "Torso"
				elseif sizeKey == "LeftUpperLeg" or sizeKey == "LeftLowerLeg" or sizeKey == "LeftFoot" then
					sizeKey = "Left Leg"
				elseif sizeKey == "RightUpperLeg" or sizeKey == "RightLowerLeg" or sizeKey == "RightFoot" then
					sizeKey = "Right Leg"
				elseif sizeKey == "LeftUpperArm" or sizeKey == "LeftLowerArm" or sizeKey == "LeftHand" then
					sizeKey = "Left Arm"
				elseif sizeKey == "RightUpperArm" or sizeKey == "RightLowerArm" or sizeKey == "RightHand" then
					sizeKey = "Right Arm"
				end
				local baseSize = BodyPartSize[sizeKey] or Vector3.new(2, 2, 1)
				local XMultiply, YMultiply, ZMultiply = Function.MultiplyCalculate(BodyPart.Size, baseSize)
				local ObjectInstance
				-- print(XMultiply,YMultiply,ZMultiply)
				local Parent = Character.Morph
				local Scale = 1
				-- Combined overall * axis (Size, joints, SpecialMesh)
				local sx, sy, sz = 1, 1, 1
				local scaleSize = true
				local scaleC0 = false
				local scaleC1 = false

				for Index = 1, #PARENT do
					if Parent == nil then break end
					Parent = Parent:FindFirstChild(PARENT[Index])
				end

				if Parent == nil then warn("Parent of "..NAME.." is missing!... Missing Parent: "..PARENT[#PARENT]..".. Deferring Weld.") 
					if not PlayerData[Data].deferredWelds[PARENT[#PARENT]] then
						PlayerData[Data].deferredWelds[PARENT[#PARENT]] = {PartConfig}
					else
						table.insert(PlayerData[Data].deferredWelds[PARENT[#PARENT]], PartConfig)
					end
					return end

				if SCALE then
					local overall = tonumber(PlayerData[Data][SCALE]) or 1
					if overall >= 1 then
						Scale = 1 + ((overall - 1) / 5)
					else
						Scale = 1 + ((overall - 1) / 10)
					end
					if overall == 1 then Scale = 1 end

					-- Per-axis multipliers
					-- Clothing/UV: Width↔Depth swapped (MeshPart local axes)
					-- Breast mesh + nipples: no swap (UI labels match)
					-- Butts: Width→X, Height→Y, Depth→Z
					local axis = {X = 1, Y = 1, Z = 1}
					if SCALE == "BreastsScale" and PlayerData[Data].BreastsAxis then
						local a = PlayerData[Data].BreastsAxis
						local n = string.lower(NAME or "")
						local isCloth = n:find("uv") or n:find("texture") or n:find("pant") or n:find("shirt") or n:find("cloth")
						local isNipple = n:find("nipple")
						local isBreastMesh = (n:find("breast") or n:find("boob")) and not isCloth
						if isBreastMesh or isNipple then
							axis = {X = a.X or 1, Y = a.Y or 1, Z = a.Z or 1}
						else
							axis = {X = a.Z or 1, Y = a.Y or 1, Z = a.X or 1}
						end
					elseif SCALE == "ButtsScale" and PlayerData[Data].ButtsAxis then
						-- Same axis for solid cheek, UV, and skin so naked/clothed stay matched
						axis = PlayerData[Data].ButtsAxis
					end
					sx = Scale * (axis.X or 1)
					sy = Scale * (axis.Y or 1)
					sz = Scale * (axis.Z or 1)

					-- What to scale (AdjustScale nil = Size + CFrame1, matching original clothing behavior)
					if ADJUSTSCALE ~= nil then
						scaleSize = table.find(ADJUSTSCALE, "Size") ~= nil
						scaleC0 = table.find(ADJUSTSCALE, "CFrame") ~= nil
						scaleC1 = table.find(ADJUSTSCALE, "CFrame1") ~= nil
					else
						scaleSize = true
						scaleC0 = false
						scaleC1 = true
					end
				end

				if INSTANCE == "Mesh" then
					ObjectInstance = IS:CreateMeshPartAsync(MESHID, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Performance)
					if not PlayerData[Data] or PlayerData[Data].WeldToken ~= tokenAtStart then
						if ObjectInstance then pcall(function() ObjectInstance:Destroy() end) end
						return
					end
					if TEXTUREID ~= nil then
						ObjectInstance.TextureID = TEXTUREID
					end
					pcall(function()
						ObjectInstance.CastShadow = false -- high-poly morph shadows are expensive
						ObjectInstance.CanTouch = false
						local n = (NAME or ""):lower()
						-- DoubleSided doubles fill-rate; only for clothing UV and only in third person
						-- (FP optimizer will force it off while in first person)
						if n:find("uv") or n:find("texture") or n:find("skin") or n:find("shirt") or n:find("pant") then
							local wantDS = true
							if PlayerData[Data] and PlayerData[Data].UVDoubleSided == false then
								wantDS = false
							end
							ObjectInstance.DoubleSided = wantDS
							ObjectInstance:SetAttribute("MorphWantDoubleSided", wantDS)
						end
					end)
				end

				if INSTANCE == "Part" then
					local MeshConfig = PartConfig["Mesh"]

					ObjectInstance = Instance.new("Part")
					ObjectInstance.Shape = SHAPE

					if MeshConfig ~= nil then
						local Mesh = Instance.new("SpecialMesh",ObjectInstance)
						Mesh.Name = NAME..".Mesh"

						local meshScale = Function.TabletoVector(MeshConfig["Scale"])
						Mesh.Scale = meshScale
						Mesh.MeshId = MeshConfig["MeshId"]
						Mesh.MeshType = MeshConfig["MeshType"]
						Mesh.TextureId = MeshConfig["TextureId"]
						if MeshConfig["MeshType"] == Enum.MeshType.FileMesh then
							Mesh.Scale = Function.Vector3Multiply(meshScale, {X = XMultiply, Y = YMultiply, Z = ZMultiply})
							-- Per-axis sx/sy/sz so Width/Height/Depth match clothing MeshParts
							if SCALE and scaleSize then
								Mesh.Scale = Function.Vector3Multiply(Mesh.Scale, {X = sx, Y = sy, Z = sz})
							end
						end
					end
				end

				if EXTRA ~= nil then
					for Name, Property in pairs(EXTRA) do

						local Instance = Instance.new("Decal",ObjectInstance)
						Instance.Name = Name
						Instance.Transparency = Property["Transparency"]
						Instance.ZIndex = Property["ZIndex"]
						Instance.Face = Property["Face"]
						Instance.Texture = Property["Texture"]
						Instance.Color3 = Function.DarkenColor((Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Head")).Color,0.32)
					end
				end


				ObjectInstance.CanCollide = false
				ObjectInstance.CanQuery = false
				ObjectInstance.CanTouch = false
				ObjectInstance.Massless = true
				pcall(function() ObjectInstance.CastShadow = false end)
				-- Optional organ collision (breasts / butts hit world)
				do
					local pd = PlayerData[Data]
					local n = (NAME or ""):lower()
					local isUV = n:find("uv") or n:find("texture") or n:find("skin") or n:find("shirt") or n:find("pant") or n:find("cloth")
					local isOrgan = (not isUV) and (n:find("breast") or n:find("boob") or n:find("butt") or n:find("ass") or n:find("nipple"))
					if pd and pd.OrganCollision and isOrgan then
						ObjectInstance.CanCollide = true
						ObjectInstance.CanQuery = true
						ObjectInstance.CanTouch = true
						ObjectInstance.Massless = true
						-- Soft contact materials (massless keeps jiggle independent of density)
						pcall(function()
							ObjectInstance.CustomPhysicalProperties = PhysicalProperties.new(
								0.01, -- density (irrelevant while Massless)
								0.15, -- friction (slide, not stick)
								1,    -- elasticity (bouncy contact)
								1,    -- friction weight
								1     -- elasticity weight
							)
						end)
					end
				end

				ObjectInstance.Name = NAME
				ObjectInstance.Transparency = TRANSPARENCY
				do
					local pd = PlayerData[Data]
					local shiny = pd and pd.ShinyBody == true
					ObjectInstance.Material = shiny and Enum.Material.SmoothPlastic or Enum.Material.Plastic
					ObjectInstance.Reflectance = shiny and 0.04 or 0
					local nLow = (NAME or ""):lower()
					if nLow:find("nipple") then
						if pd and pd.CurrentPartList then
							pd.CurrentPartList.NippleParts = pd.CurrentPartList.NippleParts or {}
							pd.CurrentPartList.NippleParts[ObjectInstance] = true
						end
					end
					if nLow:find("uv") or nLow:find("texture") or nLow:find("skin") or nLow:find("shirt") or nLow:find("pant") or nLow:find("cloth") then
						ObjectInstance.CanCollide = false
						ObjectInstance.CanQuery = false
						ObjectInstance.CanTouch = false
					end
				end


				local WeldInstance = Instance.new("Motor6D", ObjectInstance)
				WeldInstance.Name = NAME.." Weld"

				-- Apply breast/butt scale once here (avoids double CFrame1 / broken Size after Vector3 convert)
				local sizeVec = Function.TabletoVector(SIZE)
				local c0 = Function.Table2CF(CFRAME)
				local c1 = Function.Table2CF(CFRAME1)
				if SCALE then
					if scaleSize then
						sizeVec = Function.Vector3Multiply(sizeVec, {X = sx, Y = sy, Z = sz})
					end
					if scaleC0 then
						c0 = Function.CFrameMultiply(c0, {X = sx, Y = sy, Z = sz})
					end
					if scaleC1 then
						c1 = Function.CFrameMultiply(c1, {X = sx, Y = sy, Z = sz})
					end
				end

				ObjectInstance.Parent = Parent

				ObjectInstance.Size = Function.Vector3Multiply(sizeVec, {X = XMultiply, Y = YMultiply, Z = ZMultiply})

				WeldInstance.C0 = Function.CFrameMultiply(c0, {X = XMultiply, Y = YMultiply, Z = ZMultiply})
				WeldInstance.C1 = Function.CFrameMultiply(c1, {X = XMultiply, Y = YMultiply, Z = ZMultiply})

				-- Position offsets in STUD units (supports decimals). Does not modify partlist.
				-- Applied in parent space (Torso). Layers welded under Left/Right Butt follow
				-- the root automatically; layers welded to Torso get the same stud offset.
				pcall(function()
					local n = string.lower(NAME)
					local parentName = Parent and Parent.Name or ""
					local parentIsTorso = (parentName == "Torso")

					-- Breasts: offset the SHARED root only so skin + UV/clothing move together.
					-- Hierarchy: Torso -> BreastsRoot -> BreastTexture -> Left/Right Breasts + UV
					-- User studs: X = left/right, Y = up/down, Z = forward/back
					-- R6 Torso local: +X right, +Y up, +Z back  => forward = -Z
					if n == "breastsroot" then
						local o = PlayerData[Data].BreastsOffset
						if o then
							local ox = tonumber(o.X) or 0
							local oy = tonumber(o.Y) or 0
							local oz = tonumber(o.Z) or 0
							WeldInstance.C0 = WeldInstance.C0 + Vector3.new(ox, oy, -oz)
						end
					elseif (string.find(n, "breast") or string.find(n, "boob")) and parentIsTorso
						and n ~= "breasttexture" and n ~= "breastpantsuv" then
						-- Alternate packs: individual breast meshes welded directly to Torso
						local o = PlayerData[Data].BreastsOffset
						if o then
							local ox = tonumber(o.X) or 0
							local oy = tonumber(o.Y) or 0
							local oz = tonumber(o.Z) or 0
							WeldInstance.C0 = WeldInstance.C0 + Vector3.new(ox, oy, -oz)
						end
					-- Never offset Left/Right Breasts under BreastTexture (that desyncs UV)

					elseif string.find(n, "butt") then
						local o = PlayerData[Data].ButtsOffset
						if o then
							local isRoot = (n == "left butt" or n == "right butt")
							-- Roots always; clothing/UV/Skin only if they share Torso parent
							-- (if parented under the root butt they already follow in studs)
							if isRoot or parentIsTorso then
								local ox = tonumber(o.X) or 0
								local oy = tonumber(o.Y) or 0
								local oz = tonumber(o.Z) or 0
								local spacing = tonumber(PlayerData[Data].ButtsSpacing) or 0
								if string.find(n, "left") then
									ox = ox - spacing
								elseif string.find(n, "right") then
									ox = ox + spacing
								end
								WeldInstance.C0 = WeldInstance.C0 + Vector3.new(ox, oy, oz)
							end
						end
					end
				end)

				WeldInstance.Part0 = Parent
				WeldInstance.Part1 = ObjectInstance
				if PHYSICS and PHYSICS["PhysicsRotationOffset"] then
					ObjectInstance:SetAttribute("PhysicsRotationOffset",Function.TabletoString(PartConfig["Physics"]["PhysicsRotationOffset"]))
				end

				if COLOR ~= nil and COLOR ~= "Base" then
					ObjectInstance.Color = Function.DarkenColor((Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Head")).Color,PlayerData[Data].colorConfig.Values["110, 110, 111"])

				else
					ObjectInstance.Color = (Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Head")).Color
				end


				if FUNCTION ~= "" then
					if typeof(FUNCTION) == "string" then
						Function[FUNCTION](ObjectInstance, Character, Extra, Data)
					elseif typeof(FUNCTION) == "table" then
						for i, v in pairs(FUNCTION) do
							if typeof(i) == "number" then
							Function[v](ObjectInstance, Character, Extra, Data)
							else
