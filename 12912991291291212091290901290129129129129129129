				if not draggingSV and not draggingHue then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					if draggingSV then updateFromSV(input) end
					if draggingHue then updateFromHue(input) end
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSV = false
					draggingHue = false
				end
			end)
			local function setColor(c)
				if typeof(c) ~= "Color3" then return end
				h, s, v = Color3.toHSV(c)
				dot.Position = UDim2.new(s, 0, 1 - v, 0)
				hueDot.Position = UDim2.new(0.5, 0, h, 0)
				sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				preview.BackgroundColor3 = c
				colorInfo.Text = formatColorText(c)
				colorInfo.TextColor3 = c:Lerp(Color3.new(1, 1, 1), 0.35)
			end
			return setColor, orderIn + 2
		end

