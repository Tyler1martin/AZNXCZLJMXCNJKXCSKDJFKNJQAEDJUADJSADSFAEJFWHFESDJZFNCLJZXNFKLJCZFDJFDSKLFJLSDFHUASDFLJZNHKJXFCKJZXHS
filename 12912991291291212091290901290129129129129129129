	local ThemeImageCache = {} 
	local ThemeImagePending = {}
	function extractAssetNumber(raw)
		if type(raw) ~= "string" and type(raw) ~= "number" then return nil end
		local s = tostring(raw):gsub("%s", "")
		if s == "" or s == "0" then return nil end
		local n = s:match("(%d+)")
		return n and tonumber(n) or nil
	end
	function themeAssetId(raw)
		local n = extractAssetNumber(raw)
		if not n then return "" end
		if ThemeImageCache[n] then
			return ThemeImageCache[n]
		end
		
		local thumb = string.format("rbxthumb://type=Asset&id=%d&w=420&h=420", n)
		ThemeImageCache[n] = thumb
		if not ThemeImagePending[n] then
			ThemeImagePending[n] = true
			task.spawn(function()
				local resolved = thumb
				
				local loadOk, model = pcall(function()
					return IS:LoadAsset(n)
				end)
				if loadOk and model then
					local decal = model:FindFirstChildWhichIsA("Decal", true)
						or model:FindFirstChildWhichIsA("Texture", true)
					if decal then
						local tex = decal.Texture
						if type(tex) == "string" and tex ~= "" and tex ~= "rbxassetid://0" then
							resolved = tex
						end
					end
					
					if resolved == thumb then
						local infoOk, info = pcall(function()
							return game:GetService("MarketplaceService"):GetProductInfo(n)
						end)
						local assetType = infoOk and info and info.AssetTypeId or nil
						if assetType == 1 then 
