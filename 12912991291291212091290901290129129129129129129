			return true
		end

		local function findMainBreasts()
			local found = {}
			local morph = Character:FindFirstChild("Morph")
			for _, root in ipairs({ morph, Character }) do
				if root then
					for _, d in ipairs(root:GetDescendants()) do
						if isBreastMain(d) then
							local n = string.lower(d.Name or "")
							if n:find("left") then
								found.left = found.left or d
							elseif n:find("right") then
								found.right = found.right or d
							end
						end
					end
				end
			end
			return found
		end

		local function destroyDupe(side)
			local dupe = cpl.AreolaResizeDupes[side]
			if dupe and dupe.Parent then
				pcall(function() dupe:Destroy() end)
			end
			cpl.AreolaResizeDupes[side] = nil
		end

		local function ensureDupe(side, main)
			local dupe = cpl.AreolaResizeDupes[side]
			if dupe and dupe.Parent then
				return dupe
			end
			dupe = main:Clone()
			for _, ch in ipairs(dupe:GetChildren()) do
				local keep = ch:IsA("SpecialMesh") or ch:IsA("DataModelMesh")
				if not keep then
					pcall(function() ch:Destroy() end)
				end
			end
			dupe.Name = (side == "left") and "AreolaResizeDupeL" or "AreolaResizeDupeR"
			dupe.Transparency = 1
			dupe.LocalTransparencyModifier = 1
			dupe.CanCollide = false
			dupe.CanQuery = false
			dupe.CanTouch = false
			dupe.Massless = true
			dupe.CastShadow = false
			dupe.Anchored = false
			dupe:SetAttribute("AreolaResizeBody", true)
			dupe:SetAttribute("AreolaResizeSide", side)
			dupe.Parent = main.Parent or Character:FindFirstChild("Morph") or Character
			pcall(function() dupe.CFrame = main.CFrame end)
			local w = Instance.new("Weld")
			w.Name = "AreolaResizeWeld"
			w.Part0 = main
			w.Part1 = dupe
			w.C0 = CFrame.new()
			w.C1 = CFrame.new()
			w.Parent = dupe
			dupe:SetAttribute("AreolaDupeBaseSX", main.Size.X)
			dupe:SetAttribute("AreolaDupeBaseSY", main.Size.Y)
			dupe:SetAttribute("AreolaDupeBaseSZ", main.Size.Z)
			local sm = main:FindFirstChildOfClass("SpecialMesh")
			if sm then
				dupe:SetAttribute("AreolaDupeMeshSX", sm.Scale.X)
				dupe:SetAttribute("AreolaDupeMeshSY", sm.Scale.Y)
				dupe:SetAttribute("AreolaDupeMeshSZ", sm.Scale.Z)
			end
			cpl.AreolaResizeDupes[side] = dupe
			return dupe
		end

		local mains = findMainBreasts()

		if not resizeOn then
			for Decal, host in pairs(cpl.AreolaDecal or {}) do
				if Decal and Decal.Parent then
					local side = Decal:GetAttribute("NippleSide") or Function.SideOfNippleName((host and host.Name) or Decal.Parent.Name)
					local main = (side == "right") and mains.right or mains.left
					if main then
						Decal.Parent = main
						cpl.AreolaDecal[Decal] = main
					end
					Decal.Transparency = 0
				end
			end
			for part, _ in pairs(cpl.NippleParts or {}) do
				if part and part.Parent and part:IsA("BasePart") then
					local side = Function.SideOfNippleName(part.Name)
					local main = (side == "right") and mains.right or mains.left
					if main then
						local joint = findJoint(part)
						if joint then joint.Part0 = main end
						part:SetAttribute("AreolaResizeNipple", nil)
					end
					part.Transparency = 0
					part.LocalTransparencyModifier = 0
				end
			end
			destroyDupe("left")
			destroyDupe("right")
			for _, root in ipairs({ Character:FindFirstChild("Morph"), Character }) do
				if root then
					for _, d in ipairs(root:GetDescendants()) do
						if d.Name == "AreolaScaleDisc" or d:GetAttribute("AreolaResizeBody") then
							pcall(function() d:Destroy() end)
						end
					end
				end
			end
		else
			for side, main in pairs(mains) do
				if typeof(side) == "string" and main then
					local dupe = ensureDupe(side, main)
					local bx = dupe:GetAttribute("AreolaDupeBaseSX") or main.Size.X
					local by = dupe:GetAttribute("AreolaDupeBaseSY") or main.Size.Y
					local bz = dupe:GetAttribute("AreolaDupeBaseSZ") or main.Size.Z
					dupe.Size = Vector3.new(bx * as, by * as, bz * as)
					local sm = dupe:FindFirstChildOfClass("SpecialMesh")
					if sm then
						local mx = dupe:GetAttribute("AreolaDupeMeshSX") or 1
						local my = dupe:GetAttribute("AreolaDupeMeshSY") or 1
						local mz = dupe:GetAttribute("AreolaDupeMeshSZ") or 1
						sm.Scale = Vector3.new(mx * as, my * as, mz * as)
					end
					dupe.Transparency = 1
					dupe.LocalTransparencyModifier = 1
					dupe.Color = main.Color
					
					
					
					local w = dupe:FindFirstChild("AreolaResizeWeld")
					if w then
						local sx = ax
						if side == "right" then sx = -ax end
						w.C0 = CFrame.new(sx, ay, az)
						w.C1 = CFrame.new()
					end
					for _, ch in ipairs(main:GetChildren()) do
						if ch:IsA("Decal") and string.lower(ch.Name or ""):find("areola") then
							ch.Parent = dupe
							cpl.AreolaDecal[ch] = dupe
						end
					end
				end
			end
			for Decal, host in pairs(cpl.AreolaDecal or {}) do
				if Decal and Decal.Parent then
					local side = Decal:GetAttribute("NippleSide") or Function.SideOfNippleName((host and host.Name) or "")
					local dupe = cpl.AreolaResizeDupes[side]
					if dupe then
						Decal.Parent = dupe
						cpl.AreolaDecal[Decal] = dupe
						Decal.Transparency = 0
					end
				end
			end
			for part, _ in pairs(cpl.NippleParts or {}) do
				if part and part.Parent and part:IsA("BasePart") then
					local side = Function.SideOfNippleName(part.Name)
					local dupe = cpl.AreolaResizeDupes[side]
					if dupe then
						local joint = findJoint(part)
						if joint then joint.Part0 = dupe end
						part:SetAttribute("AreolaResizeNipple", true)
						part.Transparency = 0
						part.LocalTransparencyModifier = 0
					end
				end
			end
		end

		
		for part, _ in pairs(cpl.NippleParts or {}) do
			if part and part.Parent and part:IsA("BasePart") then
				if not part:GetAttribute("NippleBaseSX") then
					part:SetAttribute("NippleBaseSX", part.Size.X)
					part:SetAttribute("NippleBaseSY", part.Size.Y)
					part:SetAttribute("NippleBaseSZ", part.Size.Z)
				end
				local bx = part:GetAttribute("NippleBaseSX") or part.Size.X
				local by = part:GetAttribute("NippleBaseSY") or part.Size.Y
				local bz = part:GetAttribute("NippleBaseSZ") or part.Size.Z
				part.Size = Vector3.new(bx * ns, by * ns, bz * ns)
				part.Transparency = 0
				part.LocalTransparencyModifier = 0

				local joint = findJoint(part)
				if joint then
					if not part:GetAttribute("NippleBaseC0Set") then
						local c0 = joint.C0
						part:SetAttribute("NippleBaseC0X", c0.X)
						part:SetAttribute("NippleBaseC0Y", c0.Y)
						part:SetAttribute("NippleBaseC0Z", c0.Z)
						local rx, ry, rz = c0:ToEulerAnglesYXZ()
						part:SetAttribute("NippleBaseC0RX", rx)
						part:SetAttribute("NippleBaseC0RY", ry)
						part:SetAttribute("NippleBaseC0RZ", rz)
						part:SetAttribute("NippleBaseC0Set", true)
					end
					local bx0 = part:GetAttribute("NippleBaseC0X") or 0
					local by0 = part:GetAttribute("NippleBaseC0Y") or 0
					local bz0 = part:GetAttribute("NippleBaseC0Z") or 0
					local rx = part:GetAttribute("NippleBaseC0RX") or 0
					local ry = part:GetAttribute("NippleBaseC0RY") or 0
					local rz = part:GetAttribute("NippleBaseC0RZ") or 0
					local side = Function.SideOfNippleName(part.Name)
					local sx = ox
					if side == "right" then sx = -ox end
					
					local scaleMul = resizeOn and as or 1
					local pos = Vector3.new((bx0 + sx) * scaleMul, (by0 + oy) * scaleMul, (bz0 + oz) * scaleMul)
					joint.C0 = CFrame.new(pos) * CFrame.fromEulerAnglesYXZ(rx, ry, rz)
				end
			else
				if cpl.NippleParts then cpl.NippleParts[part] = nil end
			end
		end
	end

function Function.ApplyBodyShine(Character, Data)
		local pd = (type(Data) == "table" and Data) or PlayerData[Data]
		if not pd or not Character then return end
		local shiny = pd.ShinyBody == true
		local mat = shiny and Enum.Material.SmoothPlastic or Enum.Material.Plastic
		local limbRefl = shiny and 0.06 or 0
		local morphRefl = shiny and 0.04 or 0
		local naked = pd.UVToggle ~= true
		local morph = Character:FindFirstChild("Morph")
		if morph then
			for _, d in ipairs(morph:GetDescendants()) do
				if d:IsA("BasePart") then
					local n = string.lower(d.Name or "")
					
					if naked and n:find("arm") then
						d.Material = Enum.Material.Plastic
						d.Reflectance = 0
					else
						d.Material = mat
						d.Reflectance = morphRefl
					end
				end
			end
		end
		for _, d in ipairs(Character:GetChildren()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
				if d.Name == "Head" then
					d.Material = Enum.Material.Plastic
					d.Reflectance = 0
				elseif naked and (d.Name == "Left Arm" or d.Name == "Right Arm") then
					d.Material = Enum.Material.Plastic
					d.Reflectance = 0
				else
					d.Material = mat
					d.Reflectance = limbRefl
				end
			end
		end
	end

	
	function Function.GetMilkTintColorForSide(side)
		local data = PlayerData[Player.Name]
		if not data then return nil end
		if not data.MilkColorSync and not (MilkFlavorSystem and MilkFlavorSystem.Enabled) then return nil end
		if data.RainbowAreola then
			return Color3.fromHSV((os.clock() * 0.35) % 1, 0.85, 1)
		end
		side = side or "both"
		if Function.ResolveNippleAreolaColor then
			local torso = Player.Character and (Player.Character:FindFirstChild("Torso") or Player.Character:FindFirstChild("UpperTorso"))
			local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
			local col = Function.ResolveNippleAreolaColor(data, side, skin)
			
			if side == "left" and typeof(data.NippleAreolaColorL) == "Color3" then return data.NippleAreolaColorL end
			if side == "right" and typeof(data.NippleAreolaColorR) == "Color3" then return data.NippleAreolaColorR end
			if typeof(data.NippleAreolaColor) == "Color3" then return data.NippleAreolaColor end
			return nil
		end
		if typeof(data.NippleAreolaColor) == "Color3" then return data.NippleAreolaColor end
		return nil
	end

	function Function.GetMilkTintColor()
		
		return Function.GetMilkTintColorForSide("both")
	end

	function Function.ClassifyNipplePrimary(col)
		if typeof(col) ~= "Color3" then return "strawberry" end
		local best, bestD = "strawberry", math.huge
		for id, def in pairs(MilkFlavorPrimaries) do
			local c = def.color
			local dr, dg, db = col.R - c.R, col.G - c.G, col.B - c.B
			local d = dr * dr + dg * dg + db * db
			if d < bestD then bestD, best = d, id end
		end
		return best
	end

	function Function.UpdateMilkFlavor(heated)
		if not MilkFlavorSystem or not MilkFlavorSystem.Enabled then
			MilkFlavorSystem.Id = "plain"
			MilkFlavorSystem.Name = "Milk"
			MilkFlavorSystem.Color = Color3.fromRGB(255, 255, 255)
			MilkFlavorSystem.SizeScale = 1
			return MilkFlavorSystem
		end
		local data = PlayerData[Player.Name]
		if data and data.RainbowAreola == true then
			local key = heated and "rainbow|rainbow|hot" or "rainbow|rainbow"
			local mix = MilkFlavorMix[key] or MilkFlavorMix["rainbow|rainbow"]
			MilkFlavorSystem.LeftBase, MilkFlavorSystem.RightBase = "rainbow", "rainbow"
			MilkFlavorSystem.Id = mix.id
			MilkFlavorSystem.Name = mix.name
			MilkFlavorSystem.Color = Color3.fromHSV((os.clock() * 0.35) % 1, 0.85, 1)
			MilkFlavorSystem.SizeScale = 0.80 + math.random() * 0.10
			MilkFlavorSystem._mixDef = mix
			return MilkFlavorSystem
		end
		local torso = Player.Character and (Player.Character:FindFirstChild("Torso") or Player.Character:FindFirstChild("UpperTorso"))
		local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
		local colL = Function.ResolveNippleAreolaColor(data, "left", skin)
		local colR = Function.ResolveNippleAreolaColor(data, "right", skin)
		local leftB = Function.ClassifyNipplePrimary(colL)
		local rightB = Function.ClassifyNipplePrimary(colR)
		MilkFlavorSystem.LeftBase, MilkFlavorSystem.RightBase = leftB, rightB
		local key = leftB .. "|" .. rightB
		if heated then
			if math.random() < 0.28 then
				key = key .. "|peak"
			else
				key = key .. "|hot"
			end
		end
		local mix = MilkFlavorMix[key] or MilkFlavorMix[leftB .. "|" .. rightB .. (heated and "|hot" or "")] or MilkFlavorMix[leftB .. "|" .. rightB]
		if not mix then
			mix = { id = "blend", name = "Mystery Blend", color = Color3.new((colL.R+colR.R)/2, (colL.G+colR.G)/2, (colL.B+colR.B)/2), buff = 6, durMin = 4, durMax = 8 }
		end
		MilkFlavorSystem.Id = mix.id
		MilkFlavorSystem.Name = mix.name
		MilkFlavorSystem.Color = mix.color
		local now = os.clock()
		if (now - (MilkFlavorSystem.LastRoll or 0)) > 2.5 or (MilkFlavorSystem.SizeScale or 1) >= 0.99 then
			MilkFlavorSystem.SizeScale = 0.80 + math.random() * 0.10
			MilkFlavorSystem.LastRoll = now
		end
		MilkFlavorSystem._mixDef = mix
		return MilkFlavorSystem
	end

