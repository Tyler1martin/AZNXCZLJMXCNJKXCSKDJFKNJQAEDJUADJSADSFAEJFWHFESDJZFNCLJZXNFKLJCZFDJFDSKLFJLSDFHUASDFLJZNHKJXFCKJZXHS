				end
			end)
			hueHit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingHue = true
					readHue(input.Position)
				end
			end)
			-- MouseButton1Down alternative for reliability
			svHit.MouseButton1Down:Connect(function()
				draggingSV = true
			end)
			hueHit.MouseButton1Down:Connect(function()
				draggingHue = true
			end)

			trackConn(UIS.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					if draggingSV then
						readSV(input.Position)
					elseif draggingHue then
						readHue(input.Position)
					end
				end
			end))
			trackConn(UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSV = false
					draggingHue = false
				end
			end))

			return order + 2
		end

