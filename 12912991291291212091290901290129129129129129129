	function destroyGlassTool(tool)
		tool = tool or getEquippedGlass() or GlassSystem.Tool
		pcall(function()
			if tool and tool.Parent then tool:Destroy() end
		end)
		if GlassSystem.Tool == tool then
			GlassSystem.Tool = nil
		end
		GlassSystem.HasGlass = countMilkGlasses() > 0
		GlassSystem.Filled = false
		GlassSystem.Heated = false
		GlassSystem.HoldAcc = 0
		GlassSystem.FlavorId, GlassSystem.FlavorName, GlassSystem.FlavorColor = nil, nil, nil
