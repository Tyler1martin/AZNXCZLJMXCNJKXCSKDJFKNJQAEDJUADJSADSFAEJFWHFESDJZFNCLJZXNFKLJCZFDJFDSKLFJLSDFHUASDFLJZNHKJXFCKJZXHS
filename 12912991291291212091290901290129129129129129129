			local function commit()
				local col = Color3.fromHSV(h, s, v)
				CustomTheme.Config[key] = col
				preview.BackgroundColor3 = col
				sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				svDot.Position = UDim2.new(s, 0, 1 - v, 0)
				hueDot.Position = UDim2.new(0.5, 0, h, 0)
				if CustomTheme.Enabled then applyCustomTheme() end
			end

			local function setColor(c)
				if typeof(c) ~= "Color3" then return end
				h, s, v = Color3.toHSV(c)
				commit()
			end
			ThemeColorPickers[key] = { setColor = setColor }

			local draggingSV, draggingHue = false, false
			local function readSV(pos)
				local ap = sv.AbsolutePosition
				local asz = sv.AbsoluteSize
				s = math.clamp((pos.X - ap.X) / math.max(asz.X, 1), 0, 1)
				v = 1 - math.clamp((pos.Y - ap.Y) / math.max(asz.Y, 1), 0, 1)
				commit()
			end
			local function readHue(pos)
				local ap = hueBar.AbsolutePosition
				local asz = hueBar.AbsoluteSize
				h = math.clamp((pos.Y - ap.Y) / math.max(asz.Y, 1), 0, 1)
				commit()
			end

			svHit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSV = true
					readSV(input.Position)
				end
			end)
			hueHit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingHue = true
					readHue(input.Position)
				end
			end)
			
			svHit.MouseButton1Down:Connect(function()
				draggingSV = true
			end)
			hueHit.MouseButton1Down:Connect(function()
				draggingHue = true
			end)

			trackConn(UIS.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					if draggingSV then
						readSV(input.Position)
					elseif draggingHue then
						readHue(input.Position)
					end
				end
			end))
			trackConn(UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSV = false
					draggingHue = false
				end
			end))

			return order + 2
		end

		local function refreshThemeFields()
			for key, box in pairs(ThemeFieldBoxes) do
				if box and box.Parent then
					box.Text = tostring(CustomTheme.Config[key] or "")
				end
			end
			for key, picker in pairs(ThemeColorPickers) do
				if picker and picker.setColor then
					local c = CustomTheme.Config[key]
					if typeof(c) == "Color3" then
						picker.setColor(c)
					end
				end
			end
			if SliderRefs.ThemeTransparency then SliderRefs.ThemeTransparency(CustomTheme.Config.Transparency or 0) end
			if SliderRefs.ThemeScale then SliderRefs.ThemeScale(CustomTheme.Config.Scale or 1) end
		end
