	end

	-- Theme Palette matching Realistic.txt (Dark Charcoal / Gotham)
	local BG_PANEL = Color3.fromRGB(39, 41, 43)
	local BG_PANEL_HOVER = Color3.fromRGB(50, 53, 56)
	local TEXT_BRIGHT = Color3.fromRGB(255, 255, 255)
	local TEXT_MUTED = Color3.fromRGB(145, 148, 155)
	local STROKE_COLOR = Color3.fromRGB(70, 72, 76)

	-- Slot Container Frame (Placed directly after Preset Share box)
	local slotContainer = Instance.new("Frame")
