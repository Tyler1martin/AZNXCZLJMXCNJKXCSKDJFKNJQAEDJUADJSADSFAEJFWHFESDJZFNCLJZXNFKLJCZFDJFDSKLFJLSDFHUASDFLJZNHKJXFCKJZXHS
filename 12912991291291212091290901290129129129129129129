end

local function isProtectedInstance(inst)
    if inst:IsA("LuaSourceContainer") or inst:IsA("ValueBase") or inst:IsA("Folder") or inst:IsA("Configuration")
        or inst:IsA("Animator") or inst:IsA("Animation") or inst:IsA("Sound") then
        return true
    end
    if inst:IsA("Constraint") or inst:IsA("BallSocketConstraint") or inst:IsA("HingeConstraint")
        or inst:IsA("JointInstance") or inst:IsA("Motor6D") or inst:IsA("Weld") or inst:IsA("WeldConstraint")
        or inst:IsA("Attachment") then
        return true
    end
    local lowerName = inst.Name:lower()
    if lowerName:find("ragdoll") or lowerName == "neck" or lowerName:find("joint") then return true end
    if lowerName:find("emote") or lowerName:find("anim") or lowerName:find("dance") or lowerName:find("pose") or lowerName:find("prop") then
        return true
    end
    if inst.Parent and (inst.Parent.Name:lower():find("emote") or inst.Parent.Name:lower():find("anim")) then
        return true
    end
    return false
end

local function applyOutfitFromFile(filePath, character)
    if not character then character = LocalPlayer.Character end
    if not character then return end
    if not (isfile and isfile(filePath)) then return end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(filePath))
    end)
    if not ok or not data then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function() humanoid:RemoveAccessories() end)
    end

    local isR15 = (currentMode == "R15")

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accoutrement") or child:IsA("Accessory") or child:IsA("Hat")
            or child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
            if not isProtectedInstance(child) then
                child:Destroy()
            end
        end
    end

    if not isR15 then
        local coreR6Parts = {
            HumanoidRootPart = true, Torso = true,
            ["Left Arm"] = true, ["Right Arm"] = true,
            ["Left Leg"] = true, ["Right Leg"] = true, Head = true
        }

        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("CharacterMesh") then
                if not isProtectedInstance(child) then child:Destroy() end
            elseif (child:IsA("BasePart") or child:IsA("MeshPart") or child:IsA("Model")) and not coreR6Parts[child.Name] then
                if not isProtectedInstance(child) then child:Destroy() end
            end
        end

        for _, descendant in ipairs(character:GetDescendants()) do
            if (descendant:IsA("MeshPart") or descendant:IsA("SpecialMesh")) and descendant.Name ~= "OutfitMesh" then
                if descendant.Parent and not coreR6Parts[descendant.Parent.Name] and not isProtectedInstance(descendant) then
                    descendant:Destroy()
                end
            end
        end

        local head = character:FindFirstChild("Head")
        if head then
            for _, item in ipairs(head:GetChildren()) do
                if item.Name == "OutfitMesh" or item.Name == "OutfitWeld" then
                    item:Destroy()
                elseif not isProtectedInstance(item) then
                    if item:IsA("SpecialMesh") or item:IsA("MeshPart") or item:IsA("Decal") then
                        item:Destroy()
                    end
                end
            end
        end

        if data.HeadData and head then
            local mesh = Instance.new("SpecialMesh")
            mesh.Name = "OutfitMesh"
            mesh.Parent = head
            if data.HeadData.MeshId and data.HeadData.MeshId ~= "" then
                mesh.MeshType = Enum.MeshType.FileMesh
                mesh.MeshId = data.HeadData.MeshId
                mesh.TextureId = data.HeadData.TextureId or ""
            else
                mesh.MeshType = Enum.MeshType.Head
            end
            if data.HeadData.Scale then
                mesh.Scale = Vector3.new(data.HeadData.Scale[1], data.HeadData.Scale[2], data.HeadData.Scale[3])
            end
        end

        if data.CharacterMeshes then
            for _, meshData in ipairs(data.CharacterMeshes) do
                local cMesh = Instance.new("CharacterMesh")
                cMesh.BodyPart = Enum.BodyPart:GetEnumItems()[meshData.BodyPart + 1] or Enum.BodyPart.Torso
                cMesh.MeshId = meshData.MeshId
                cMesh.BaseTextureId = meshData.BaseTextureId
                cMesh.OverlayTextureId = meshData.OverlayTextureId
                cMesh.Parent = character
            end
        end
    end

    if data.ShirtTemplate and data.ShirtTemplate ~= "" then
        local shirt = Instance.new("Shirt", character)
        shirt.ShirtTemplate = data.ShirtTemplate
    end
    if data.PantsTemplate and data.PantsTemplate ~= "" then
        local pants = Instance.new("Pants", character)
        pants.PantsTemplate = data.PantsTemplate
    end
    if data.ShirtGraphic and data.ShirtGraphic ~= "" then
        local sg = Instance.new("ShirtGraphic", character)
        sg.Graphic = data.ShirtGraphic
    end

    if data.BodyColors then
        local bc = character:FindFirstChildOfClass("BodyColors") or Instance.new("BodyColors", character)
        bc.HeadColor3 = hexToColor3(data.BodyColors.HeadColor3)
        bc.TorsoColor3 = hexToColor3(data.BodyColors.TorsoColor3)
        bc.LeftArmColor3 = hexToColor3(data.BodyColors.LeftArmColor3)
        bc.RightArmColor3 = hexToColor3(data.BodyColors.RightArmColor3)
        bc.LeftLegColor3 = hexToColor3(data.BodyColors.LeftLegColor3)
        bc.RightLegColor3 = hexToColor3(data.BodyColors.RightLegColor3)
    end

    if data.Accessories then
        for _, accData in ipairs(data.Accessories) do
            if accData.MeshId and accData.MeshId ~= "" then
                local acc = Instance.new("Accessory")
                acc.Name = accData.Name or "LoadedCustomAccessory"

                local handle = Instance.new("Part")
                handle.Name = "Handle"
                handle.Size = Vector3.new(0.5, 0.5, 0.5)
                handle.CanCollide = false
                handle.CanTouch = false
                handle.CanQuery = false
                handle.Massless = true
                handle.Parent = acc

                local mesh = Instance.new("SpecialMesh", handle)
                mesh.MeshId = accData.MeshId
                mesh.TextureId = accData.TextureId or ""
                if accData.Scale then
                    mesh.Scale = Vector3.new(accData.Scale[1], accData.Scale[2], accData.Scale[3])
                end

                local attName = accData.AttachmentName or "HatAttachment"
                local targetAttachment = nil
                local targetPart = nil

                for _, descendant in ipairs(character:GetDescendants()) do
                    if descendant:IsA("Attachment") and descendant.Name == attName then
                        targetAttachment = descendant
                        targetPart = descendant.Parent
                        break
                    end
                end

                if not targetPart then
                    targetPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                end

                acc.Parent = character

                if targetAttachment and accData.AttachmentCFrame then
                    local handleAttCFrame = CFrame.new(unpack(accData.AttachmentCFrame))
                    handle.CFrame = targetAttachment.WorldCFrame * handleAttCFrame:Inverse()
                else
                    handle.CFrame = targetPart.CFrame
                end

                local weld = Instance.new("WeldConstraint")
                weld.Part0 = handle
                weld.Part1 = targetPart
                weld.Parent = handle
            end
        end
    end

    if not isR15 then
        removeAllFaceDecals(character)
    end
end

local function saveCurrentOutfit(name)
    local character = LocalPlayer.Character
    if not character then return false end

    local targetFilePath = currentFolder .. "/" .. name .. ".json"
    local isR15 = (currentMode == "R15")

    local headData = nil
    if not isR15 then
        local head = character:FindFirstChild("Head")
        if head then
            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            if head:IsA("MeshPart") then
                headData = {
                    IsMeshPart = true,
                    MeshId = head.MeshId,
                    TextureId = head.TextureID
                }
            elseif mesh then
                headData = {
                    IsMeshPart = false,
                    MeshId = mesh.MeshId,
                    TextureId = mesh.TextureId,
                    Scale = {mesh.Scale.X, mesh.Scale.Y, mesh.Scale.Z}
                }
            end
        end
    end

    local savedMeshes = {}
    if not isR15 then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("CharacterMesh") then
                table.insert(savedMeshes, {
                    BodyPart = child.BodyPart.Value,
                    MeshId = child.MeshId,
                    BaseTextureId = child.BaseTextureId,
                    OverlayTextureId = child.OverlayTextureId
                })
            end
        end
    end

    local savedAccessories = {}
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accoutrement") or child:IsA("Accessory") or child:IsA("Hat") then
            local handle = child:FindFirstChild("Handle")
            if handle then
                local mesh = handle:FindFirstChildOfClass("SpecialMesh")
                local att = handle:FindFirstChildOfClass("Attachment")
                table.insert(savedAccessories, {
                    Name = child.Name,
                    MeshId = handle:IsA("MeshPart") and handle.MeshId or (mesh and mesh.MeshId or ""),
                    TextureId = handle:IsA("MeshPart") and handle.TextureID or (mesh and mesh.TextureId or ""),
                    Scale = mesh and {mesh.Scale.X, mesh.Scale.Y, mesh.Scale.Z} or {1, 1, 1},
                    AttachmentName = att and att.Name or "HatAttachment",
                    AttachmentCFrame = att and {att.CFrame:GetComponents()} or nil
                })
            end
        end
    end

    local shirt = character:FindFirstChildOfClass("Shirt")
    local pants = character:FindFirstChildOfClass("Pants")
    local shirtGraphic = character:FindFirstChildOfClass("ShirtGraphic")
    local bodyColors = character:FindFirstChildOfClass("BodyColors")

    local shirtTemplate = ""
    if shirt and shirt.ShirtTemplate and shirt.ShirtTemplate ~= "" then
        shirtTemplate = shirt.ShirtTemplate
    end
    local pantsTemplate = ""
    if pants and pants.PantsTemplate and pants.PantsTemplate ~= "" then
        pantsTemplate = pants.PantsTemplate
    end
    local graphicTemplate = ""
    if shirtGraphic and shirtGraphic.Graphic and shirtGraphic.Graphic ~= "" then
        graphicTemplate = shirtGraphic.Graphic
    end

    local outfitData = {
        HeadData = headData,
        ShirtTemplate = shirtTemplate,
        PantsTemplate = pantsTemplate,
        ShirtGraphic = graphicTemplate,
        CharacterMeshes = savedMeshes,
        BodyColors = bodyColors and {
            HeadColor3 = bodyColors.HeadColor3:ToHex(),
            TorsoColor3 = bodyColors.TorsoColor3:ToHex(),
            LeftArmColor3 = bodyColors.LeftArmColor3:ToHex(),
            RightArmColor3 = bodyColors.RightArmColor3:ToHex(),
            LeftLegColor3 = bodyColors.LeftLegColor3:ToHex(),
            RightLegColor3 = bodyColors.RightLegColor3:ToHex()
        } or nil,
        Accessories = savedAccessories
    }

    writefile(targetFilePath, HttpService:JSONEncode(outfitData))
    return true
end

local function exportAllOutfits()
    local exportData = { R6 = {}, R15 = {} }

    if listfiles and isfolder(FOLDER_R6) then
        for _, filePath in ipairs(listfiles(FOLDER_R6)) do
            if filePath:sub(-5) == ".json" then
                local name = filePath:match("([^/\\]+)%.json$") or "unknown"
                local ok, data = pcall(function()
                    return HttpService:JSONDecode(readfile(filePath))
                end)
                if ok and data then
                    exportData.R6[name] = data
                end
            end
        end
    end

    if listfiles and isfolder(FOLDER_R15) then
        for _, filePath in ipairs(listfiles(FOLDER_R15)) do
            if filePath:sub(-5) == ".json" then
                local name = filePath:match("([^/\\]+)%.json$") or "unknown"
                local ok, data = pcall(function()
                    return HttpService:JSONDecode(readfile(filePath))
                end)
                if ok and data then
                    exportData.R15[name] = data
                end
            end
        end
    end

    return HttpService:JSONEncode(exportData)
end

local function importAllOutfits(jsonString)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(jsonString)
    end)
    if not ok or type(data) ~= "table" then
        return false, "Invalid JSON"
    end

    local imported = 0

    if data.R6 and type(data.R6) == "table" then
        for name, outfit in pairs(data.R6) do
            local safeName = tostring(name):gsub("[^%w%s_]", "")
            if safeName ~= "" then
                writefile(FOLDER_R6 .. "/" .. safeName .. ".json", HttpService:JSONEncode(outfit))
                imported = imported + 1
            end
        end
    end

    if data.R15 and type(data.R15) == "table" then
        for name, outfit in pairs(data.R15) do
            local safeName = tostring(name):gsub("[^%w%s_]", "")
            if safeName ~= "" then
                writefile(FOLDER_R15 .. "/" .. safeName .. ".json", HttpService:JSONEncode(outfit))
                imported = imported + 1
            end
        end
    end

    return true, imported
end

