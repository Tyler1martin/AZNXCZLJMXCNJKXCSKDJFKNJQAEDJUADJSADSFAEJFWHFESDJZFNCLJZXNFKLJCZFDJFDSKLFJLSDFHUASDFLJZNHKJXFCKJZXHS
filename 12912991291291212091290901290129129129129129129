				anim.AnimationId = GlassSystem.DrinkAnimId
				local track = animator:LoadAnimation(anim)
				track.Priority = Enum.AnimationPriority.Action4
				track:Play(0.1, 1, GlassSystem.DrinkSpeed or 1.5)
				GlassSystem.DrinkTrack = track
