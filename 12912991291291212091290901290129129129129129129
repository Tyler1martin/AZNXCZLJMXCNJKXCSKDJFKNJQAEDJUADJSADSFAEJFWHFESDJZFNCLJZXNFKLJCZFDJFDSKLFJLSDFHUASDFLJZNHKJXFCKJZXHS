		local sm = ObjectInstance:FindFirstChildOfClass("SpecialMesh")
		local meshBase = sm and sm.Scale or Vector3.new(1, 1, 1)
		data.CurrentPartList.BodyPartPhysics[ObjectInstance] = {
			Spring = nil,
			Base = base,
			Weld = Weld,
			CF = Weld.C0,
			CF1 = Weld.C1,
