			local track = Instance.new("Frame")
			track.Size = UDim2.new(1, -68, 0, 6)
			track.Position = UDim2.new(0, 0, 0.5, -3)
			track.BackgroundColor3 = Color3.fromRGB(25, 10, 20)
			track.BorderSizePixel = 0
			track.Parent = row
