			colorInfo.TextColor3 = Color3.fromRGB(220, 220, 230)
			colorInfo.Text = formatColorText(init)
			colorInfo.Parent = root

			local function applyCol(col)
				preview.BackgroundColor3 = col
				colorInfo.Text = formatColorText(col)
				colorInfo.TextColor3 = col:Lerp(Color3.new(1, 1, 1), 0.35)
				if onApply then onApply(col) end
			end
			local draggingSV, draggingHue = false, false
			local function updateFromSV(input)
				local rel = sv.AbsolutePosition
				local sz = sv.AbsoluteSize
				if sz.X <= 0 or sz.Y <= 0 then return end
				s = math.clamp((input.Position.X - rel.X) / sz.X, 0, 1)
				v = math.clamp(1 - (input.Position.Y - rel.Y) / sz.Y, 0, 1)
				dot.Position = UDim2.new(s, 0, 1 - v, 0)
				applyCol(Color3.fromHSV(h, s, v))
			end
			local function updateFromHue(input)
				local rel = hueBar.AbsolutePosition
				local sz = hueBar.AbsoluteSize
				if sz.Y <= 0 then return end
				h = math.clamp((input.Position.Y - rel.Y) / sz.Y, 0, 1)
