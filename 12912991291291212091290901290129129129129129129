		if not HoldCheek.Holding or not HoldCheek.Enabled then return end
		local char = Player.Character
		if not char then return end
		holdCheekCacheBind(char)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
		for side, joint in pairs(HoldCheek.Joints) do
			if joint and joint.Parent then
				local bind = HoldCheek.BindC0[side]
				if bind then
					
					joint.C0 = bind
				end
				
				
				joint.Transform = holdCheekPoseCF(side)
			end
		end
	end

