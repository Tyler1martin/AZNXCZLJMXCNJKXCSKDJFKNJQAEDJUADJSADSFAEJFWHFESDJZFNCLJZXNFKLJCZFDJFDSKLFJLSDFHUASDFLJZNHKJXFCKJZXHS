	updateHeartSound = function()
		if not App.SystemActive or not HeartSFX.Enabled or App.MasterSFXMute or HeartSFX.Dead then
			stopHeartSound()
			return
		end
		local char = Player.Character
		if not char then
			stopHeartSound()
			return
		end
		local humCheck = char:FindFirstChildOfClass("Humanoid")
		if humCheck and humCheck.Health <= 0 then
			HeartSFX.Dead = true
			stopHeartSound()
			return
		end
		
		local host = char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("Torso")
			or char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Head")
		if not host then return end

		local snd = HeartSFX.Sound
		if not snd or not snd.Parent or not snd.Parent.Parent then
			if snd then pcall(function() snd:Stop(); snd:Destroy() end) end
			snd = Instance.new("Sound")
			snd.Name = "MorphHeartbeat"
			snd.SoundId = HeartSFX.SoundId
			snd.Looped = true
			snd.RollOffMaxDistance = 40
			snd.Parent = host
			HeartSFX.Sound = snd
			pcall(function() snd:Play() end)
		elseif snd.Parent ~= host then
			snd.Parent = host
		end

		
		local heat = 0
		if HeatMeter and HeatMeter.Enabled then
			heat = math.clamp(tonumber(HeatMeter.Fill) or 0, 0, 1)
		end
		local sweat = 0
		if SweatSystem and SweatSystem.Enabled and SweatSystem.Sweating then
			sweat = math.clamp(tonumber(SweatSystem.Intensity) or 0.35, 0, 1)
		end
		local milkStream = 0
		if MilkMeter and MilkMeter.Enabled and not MilkMeter.Paused then
			local streaming = false
			pcall(function()
				if MilkMeter.StreamSound and MilkMeter.StreamSound.IsPlaying then
					streaming = true
				end
			end)
			if not streaming then
				
				if MilkMeter.StreamDroplets and #MilkMeter.StreamDroplets > 0 then
					streaming = true
				end
			end
			if streaming then milkStream = 0.85 end
		end
		local hpFactor = 0
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.MaxHealth > 0 then
			local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
			hpFactor = (1 - ratio) 
		end

		local drive = math.clamp(
			heat * 0.45 + sweat * 0.35 + milkStream * 0.4 + hpFactor * 0.5,
			0, 1
		)

		local pitch = HeartSFX.BasePitch + (HeartSFX.MaxPitch - HeartSFX.BasePitch) * drive
		pitch = math.clamp(pitch, HeartSFX.BasePitch, HeartSFX.MaxPitch)
		
		local vol = HeartSFX.BaseVolume + (HeartSFX.MaxVolume - HeartSFX.BaseVolume) * (drive * 0.85 + (pitch - HeartSFX.BasePitch) / math.max(0.01, HeartSFX.MaxPitch - HeartSFX.BasePitch) * 0.15)
		vol = math.clamp(vol, 0, HeartSFX.MaxVolume)

		snd.PlaybackSpeed = pitch
		snd.Volume = vol
		if not snd.IsPlaying then
			pcall(function() snd:Play() end)
		end
	end

function updateBreathSound()
		if not App.SystemActive or not BreathSFX.Enabled or App.MasterSFXMute then
			stopBreathSound()
			return
		end
		local char = Player.Character
		if not char then
			stopBreathSound()
			return
		end
		local host = char:FindFirstChild("Head")
			or char:FindFirstChild("Torso")
			or char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("HumanoidRootPart")
		if not host then return end

		local snd = BreathSFX.Sound
		if not snd or not snd.Parent then
			snd = Instance.new("Sound")
			snd.Name = "MorphBreathing"
			snd.SoundId = BreathSFX.SoundId
			snd.Looped = true
			snd.RollOffMaxDistance = 50
			snd.Parent = host
			BreathSFX.Sound = snd
		elseif snd.Parent ~= host then
			snd.Parent = host
		end

		local heat = math.clamp(HeatMeter.Fill or 0, 0, 1)
		local maxV = BreathSFX.MaxVolume or 0.1
		local maxP = BreathSFX.MaxPitch or 1.65
		local baseV = BreathSFX.BaseVolume or 0.025
		local baseP = BreathSFX.BasePitch or 0.4
		
		local vol = baseV + (maxV - baseV) * heat
		local pitch = baseP + (maxP - baseP) * heat

		local sweating = false
		if SweatSystem and SweatSystem.Enabled then
			if SweatSystem.AlwaysActive then
				sweating = true
			else
				local hum = char:FindFirstChildOfClass("Humanoid")
				local moving = hum and hum.MoveDirection.Magnitude > 0.05
				sweating = moving or heat >= 0.15
			end
		end
		if sweating then
			vol = vol * 1.5
			pitch = pitch * 1.1
		end

		vol = math.clamp(vol, 0, maxV)
		pitch = math.clamp(pitch, 0.05, maxP)
		snd.Volume = vol
		snd.PlaybackSpeed = pitch
		if not snd.IsPlaying then
			pcall(function() snd:Play() end)
		end
	end

	function milkSideOf(name)
		local n = (name or ""):lower()
		if n:find("nipplel") or n:find("nipple_l") then return "left" end
		if n:find("nippler") or n:find("nipple_r") then return "right" end
		if n == "nipple.1" or n:find("nipple.1") then return "left" end
		if n == "nipple" and not n:find("left") then return "right" end
		if n:find("nipple") then
			if n:find("l") and not n:find("r") then return "left" end
			if n:find("r") and not n:find("l") then return "right" end
		end
		return nil
	end

