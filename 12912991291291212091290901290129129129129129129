	-- Resolves Image OR Decal ids for ImageLabel.Image
	-- Decal asset ids do NOT work as rbxassetid:// on ImageLabels; use rbxthumb or Decal.Texture
	local ThemeImageCache = {} -- [numericId] = content string
	local ThemeImagePending = {}
	local function extractAssetNumber(raw)
		if type(raw) ~= "string" and type(raw) ~= "number" then return nil end
		local s = tostring(raw):gsub("%s", "")
		if s == "" or s == "0" then return nil end
		local n = s:match("(%d+)")
		return n and tonumber(n) or nil
	end
	local function themeAssetId(raw)
		local n = extractAssetNumber(raw)
		if not n then return "" end
		if ThemeImageCache[n] then
			return ThemeImageCache[n]
		end
		-- rbxthumb accepts Decal + Image asset ids on ImageLabel (immediate)
		local thumb = string.format("rbxthumb://type=Asset&id=%d&w=420&h=420", n)
		ThemeImageCache[n] = thumb
		if not ThemeImagePending[n] then
			ThemeImagePending[n] = true
			task.spawn(function()
				local resolved = thumb
				-- Prefer real texture from LoadAsset when possible (full res)
				local loadOk, model = pcall(function()
					return IS:LoadAsset(n)
				end)
				if loadOk and model then
					local decal = model:FindFirstChildWhichIsA("Decal", true)
						or model:FindFirstChildWhichIsA("Texture", true)
					if decal then
						local tex = decal.Texture
						if type(tex) == "string" and tex ~= "" and tex ~= "rbxassetid://0" then
							resolved = tex
						end
					end
					-- Some image assets load as MeshPart/other with no Decal — keep thumb or try rbxassetid
					if resolved == thumb then
						local infoOk, info = pcall(function()
							return game:GetService("MarketplaceService"):GetProductInfo(n)
						end)
						local assetType = infoOk and info and info.AssetTypeId or nil
						if assetType == 1 then -- Image
							resolved = "rbxassetid://" .. tostring(n)
						end
					end
					pcall(function() model:Destroy() end)
				else
					-- LoadAsset failed: try direct image id as secondary fallback
					local infoOk, info = pcall(function()
						return game:GetService("MarketplaceService"):GetProductInfo(n)
					end)
					local assetType = infoOk and info and info.AssetTypeId or nil
					if assetType == 1 then
						resolved = "rbxassetid://" .. tostring(n)
					end
					-- else keep rbxthumb (best for decals when LoadAsset is blocked)
				end
				ThemeImageCache[n] = resolved
				ThemeImagePending[n] = nil
				task.defer(function()
					pcall(applyCustomTheme)
				end)
			end)
		end
		return ThemeImageCache[n]
	end
	local function colorToStr(c)
		if typeof(c) ~= "Color3" then return "255,255,255" end
		return string.format("%d,%d,%d", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
	end
	local function parseColor3(str, fallback)
		if typeof(str) == "Color3" then return str end
		if type(str) ~= "string" then return fallback end
		local r,g,b = str:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
		if not r then
			local h = str:match("#?(%x%x%x%x%x%x)")
			if h then
				r = tonumber(h:sub(1,2), 16)
				g = tonumber(h:sub(3,4), 16)
				b = tonumber(h:sub(5,6), 16)
			end
		end
		if r and g and b then
			return Color3.fromRGB(math.clamp(tonumber(r),0,255), math.clamp(tonumber(g),0,255), math.clamp(tonumber(b),0,255))
		end
		return fallback
	end
