	function holdCheekFindJoint(char, jointName)
		if not char or not jointName then return nil end
		local j = char:FindFirstChild(jointName, true)
		if j and j:IsA("Motor6D") then return j end
		local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
		if torso then
			j = torso:FindFirstChild(jointName)
			if j and j:IsA("Motor6D") then return j end
		end
		return nil
	end

	
	function holdCheekCacheBind(char)
		if not char then return end
		if HoldCheek.Char ~= char then
			HoldCheek.Char = char
			HoldCheek.BindC0 = {}
			HoldCheek.Joints = {}
		end
		for side, jointName in pairs(holdCheekJointNames(char)) do
			local joint = holdCheekFindJoint(char, jointName)
			if joint then
				HoldCheek.Joints[side] = joint
				if HoldCheek.BindC0[side] == nil and not HoldCheek.Holding then
					HoldCheek.BindC0[side] = joint.C0
				end
			end
		end
	end

	function holdCheekClearPose()
		local char = Player.Character
		if char then holdCheekCacheBind(char) end
		for side, joint in pairs(HoldCheek.Joints) do
			if joint and joint.Parent then
				pcall(function()
					
					joint.Transform = CFrame.new()
					local bind = HoldCheek.BindC0[side]
					if bind then
						joint.C0 = bind
					end
				end)
			end
		end
	end

	function holdCheekPoseCF(side)
		local pe = HoldCheek.PoseEdit
		if not pe then return CFrame.new() end
		
		if side == "LeftElbow" or side == "RightElbow" then
			return CFrame.new()
		end
		local pose = pe[side]
		if not pose then return CFrame.new() end
		local x = tonumber(pose.MoveX) or 0
		local y = tonumber(pose.MoveY) or 0
		local z = tonumber(pose.MoveZ) or 0
		local pitch = tonumber(pose.Pitch) or 0
		local yaw = tonumber(pose.Yaw) or 0
		local roll = tonumber(pose.Roll) or 0
		return CFrame.new(x, y, z) * CFrame.Angles(math.rad(pitch), math.rad(yaw), math.rad(roll))
	end

