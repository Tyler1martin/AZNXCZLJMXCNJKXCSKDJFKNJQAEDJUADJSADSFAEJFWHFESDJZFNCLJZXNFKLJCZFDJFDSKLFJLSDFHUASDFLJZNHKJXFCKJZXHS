	function storeCurrentGlassInFridge()
		local eq = getEquippedGlass()
		if eq then syncGlassStateFromTool(eq) end
		local filled = GlassSystem.Filled == true or (eq and eq:GetAttribute("MilkFilled") == true) or type(GlassSystem.LastFilledFlavor) == "table"
		if not filled then
			return false, "No filled glass"
		end
		if #GlassFridge >= GlassFridgeMax then
			return false, "Fridge full (10/10)"
		end
		local snap = snapshotFilledGlass()
		table.insert(GlassFridge, snap)
		
		local tool = eq or GlassSystem.Tool
		pcall(function()
			if tool and tool.Parent then tool:Destroy() end
		end)
		GlassSystem.Tool = nil
		GlassSystem.Filled = false
		GlassSystem.Heated = false
		GlassSystem.HoldAcc = 0
		GlassSystem.FlavorId, GlassSystem.FlavorName, GlassSystem.FlavorColor = nil, nil, nil
		GlassSystem.FlavorSizeScale, GlassSystem.FlavorHeated = 1, false
		GlassSystem.LastFilledFlavor = nil
		GlassSystem.HasGlass = countMilkGlasses() > 0
		
		local data = PlayerData[Player.Name]
		if data then data.GlassFridge = GlassFridge end
		pcall(function()
			if SyncMorphUI and SyncMorphUI.RefreshGlassFridge then
				SyncMorphUI.RefreshGlassFridge()
			end
		end)
		return true, snap.name
	end

