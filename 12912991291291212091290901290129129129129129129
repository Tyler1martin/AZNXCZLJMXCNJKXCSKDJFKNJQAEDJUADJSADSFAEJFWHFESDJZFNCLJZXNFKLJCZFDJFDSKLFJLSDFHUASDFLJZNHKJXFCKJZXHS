						if MorphLoadState.Token ~= myToken then return end
						local deferred = PlayerData[Data] and PlayerData[Data].deferredWelds
						local pending = false
						if deferred then
							for parentName, list in pairs(deferred) do
								if type(list) == "table" then
									for index, object in pairs(list) do
										if object then
											pending = true
											-- Only retry if parent now exists under Morph
											local parentOk = false
											pcall(function()
												local morph = Character and Character:FindFirstChild("Morph")
												if not morph then return end
												local node = morph
												-- Walk common single-name parents
												parentOk = morph:FindFirstChild(parentName, true) ~= nil
													or Character:FindFirstChild(parentName) ~= nil
											end)
											if parentOk then
												pcall(function()
													Function.Weld(object, Character, Extra, Data)
												end)
												list[index] = nil
											end
										end
									end
								end
							end
						end
						if not pending then break end
						task.wait(0.08)
					end
					task.wait(0.1)
					if MorphLoadState.Token ~= myToken then return end
					pcall(function()
						if MorphLoadState.SmartCacheClean then MorphLoadState.SmartCacheClean() end
					end)
					pcall(function()
						if Function.ApplyNippleAreolaColors then
							Function.ApplyNippleAreolaColors(Character, Data)
						end
						if Function.ApplyBodyShine then
							Function.ApplyBodyShine(Character, Data)
						end
					end)
					Function.ApplyRealisticMovement(Character, Data)
					if SyncMorphUI.UpdateMode then pcall(SyncMorphUI.UpdateMode) end
				end)

			end
			end) -- pcall body
			if not ok then
				warn("[Morph] CharacterExecute error:", err)
			end
			release()
		end)
	end

