	local PhysicsConnect = trackConn(RunService.Stepped:Connect(function(_, dt)
		pcall(function() computeSoftWorldOrganCollision(dt) end)
		pcall(function() computeLimbOrganContact(dt) end)
		local cam = workspace.CurrentCamera
		if not cam then return end
		local camPos = cam.CFrame.Position

		local localChar = Player.Character
		local localHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
		local isFirstPerson = false
		if Player:GetAttribute("ForceFP") == true then
			isFirstPerson = true
		elseif localHum and cam.CameraSubject == localHum then
			local focusDist = (cam.CFrame.Position - cam.Focus.Position).Magnitude
			if focusDist <= 0.75 then
				isFirstPerson = true
			else
				local head = localChar and localChar:FindFirstChild("Head")
				if head then
					local dx = camPos.X - head.Position.X
					local dy = camPos.Y - head.Position.Y
					local dz = camPos.Z - head.Position.Z
					if (dx*dx + dy*dy + dz*dz) < (1.5 * 1.5) then
						isFirstPerson = true
					end
				end
			end
		end

		for PlayerName, DataList in pairs(PlayerData) do
			local physicsList = DataList.CurrentPartList.BodyPartPhysics
			if not next(physicsList) then continue end

			for Part, Property in pairs(physicsList) do
				if not Part.Parent then
					physicsList[Part] = nil
					continue
				end
				
				local kind = Property.Kind or "generic"
				if kind == "breastCloth" then
					continue
				end
				if kind == "breast" and (DataList.BreastPhysicsEnabled == false or DataList.JigglePhysicsMaster == false) then
					continue
				end
				if kind == "butt" and (DataList.ButtPhysicsEnabled == false or DataList.ButtsParentToLegs == true or DataList.JigglePhysicsMaster == false) then
					continue
				end
				if kind == "soft" and DataList.SoftBodyEnabled == false then
					continue
				end
				if Part.Position.Y < workspace.FallenPartsDestroyHeight then
					physicsList[Part] = nil
					continue
				end

				local Base = Property.Base
				if not Base or not Base.Parent then continue end

				local CurrentCFrame = Base.CFrame
				local basePos = Base.Position
				local dx = camPos.X - basePos.X
				local dy = camPos.Y - basePos.Y
				local dz = camPos.Z - basePos.Z
				local distSq = dx*dx + dy*dy + dz*dz

				if distSq >= App.DistSqLimit then
					Property.OriginCFrame = CurrentCFrame
					continue
				end

				local isLocalPart = isFirstPerson and localChar and Base:IsDescendantOf(localChar)

				if not isLocalPart then
					local _, onScreen = cam:WorldToScreenPoint(basePos)
					if not onScreen then
						Property.OriginCFrame = CurrentCFrame
						continue
					end
				end

				local Weld = Property.Weld
				local CF = Property.CF
				local Spring = Property.Spring
				local OriginCFrame = Property.OriginCFrame
				local PositionOffset = Property.PositionOffset
				local RotationOffset = Property.RotationOffset
				local Position = Property.Position
				local Rotation = Property.Rotation

				local op = OriginCFrame.Position
				local PositionDistance = Vector3.new(op.X - CurrentCFrame.Position.X, op.Y - CurrentCFrame.Position.Y, op.Z - CurrentCFrame.Position.Z)

				
				local distMag = math.sqrt(PositionDistance.X*PositionDistance.X + PositionDistance.Y*PositionDistance.Y + PositionDistance.Z*PositionDistance.Z)
				if distMag > 6 then
					Property.OriginCFrame = CurrentCFrame
					Property.LastCFrame = CurrentCFrame
					if Spring then
						pcall(function()
							Spring.Position = Vector3.zero
							Spring.Velocity = Vector3.zero
						end)
					end
					if Weld and CF then
						pcall(function() Weld.C0 = CF end)
					end
					continue
				end

				local ol = OriginCFrame.LookVector
				local cl = CurrentCFrame.LookVector
				local LookVectorAxis = Vector3.new(ol.X - cl.X, ol.Y - cl.Y, 0)

				
				local prevCF = Property.LastCFrame or CurrentCFrame
				Property.LastCFrame = CurrentCFrame
				local lookDelta = prevCF.LookVector - CurrentCFrame.LookVector
				local rightDelta = prevCF.RightVector - CurrentCFrame.RightVector
				local turnMag = lookDelta.Magnitude + rightDelta.Magnitude
				local turnImpulse = Vector3.zero
				if turnMag > 0.012 then
					turnImpulse = Vector3.new(
						(lookDelta.X + rightDelta.X) * 2.0,
						(lookDelta.Y + rightDelta.Y) * 2.0,
						(lookDelta.Z + rightDelta.Z) * 2.0
					)
				end

				Spring:TimeSkip(dt)
				local worldSoft = SoftWorldImpulses[Part]
				if worldSoft then
					Spring:Impulse(PositionDistance + LookVectorAxis * 1.25 + turnImpulse + worldSoft)
				else
					Spring:Impulse(PositionDistance + LookVectorAxis * 1.25 + turnImpulse)
				end

				
				if kind == "soft" and Spring then
					local maxV = 4.5
					local sv = Spring.Velocity
					local sm = math.sqrt(sv.X*sv.X + sv.Y*sv.Y + sv.Z*sv.Z)
					if sm > maxV then
						Spring.Velocity = sv * (maxV / sm)
					end
				end

				local vel = Spring.Velocity
				local vx, vy, vz = vel.X, vel.Y, vel.Z

				local moving = math.abs(vx) > 0.0015 or math.abs(vy) > 0.0015 or math.abs(vz) > 0.0015
				local hasContact = Property.HasContact
					or (Property.CollisionSquish and Property.CollisionSquish.Magnitude > 1e-4)
				if not moving and not hasContact then
					Property.OriginCFrame = CurrentCFrame
					continue
				end

				
				App.PosList.X, App.PosList.Y, App.PosList.Z = 0, 0, 0
				App.RotList.X, App.RotList.Y, App.RotList.Z = 0, 0, 0

				if moving then
					local boost = 1
					if os.clock() < (JiggleMeter.BoostUntil or 0) then
						boost = JiggleMeter.PhysicsBoost or 1
					else
						JiggleMeter.PhysicsBoost = 1
					end
					local posM, rotM
					if kind == "butt" then
						posM = (PhysicsSettings.ButtPosMult or PhysicsSettings.PositionPhysicsMultiply or 10) * boost
						rotM = (PhysicsSettings.ButtRotMult or PhysicsSettings.RotationPhysicsMultiply or 1) * boost
						if DataList.UVToggle == true
							and PhysicsSettings.ClothedDampingMaster ~= false
							and PhysicsSettings.ClothedCheekDampingEnabled ~= false
						then
							local cs = tonumber(PhysicsSettings.ClothedCheekJiggleScale) or (1 / 1.5)
							posM = posM * cs
							rotM = rotM * cs
						end
						
						local sq = (CheekImpact and CheekImpact.Squish) or 0
						if sq > 0.05 then
							posM = posM * (1 + sq * 0.35)
							rotM = rotM * (1 + sq * 0.25)
						end
					elseif kind == "soft" then
						local intens = math.clamp(tonumber(DataList.SoftBodyIntensity) or 0.5, 0, 2)
						local softPos = tonumber(DataList.SoftBodyPosMult) or 0.3
						local softRot = tonumber(DataList.SoftBodyRotMult) or 0.35
						local limbBoost = 1
						if Property.IsRealLimb then
							limbBoost = math.clamp(tonumber(DataList.SoftBodyLimbBoost) or 2.75, 1, 6)
						end
						local walkBoost = 1
						if DataList.SoftBodyWalkBoost == true then
							local plr = Players:FindFirstChild(PlayerName)
							local char = plr and plr.Character
							local hum = char and char:FindFirstChildOfClass("Humanoid")
							if hum and hum.MoveDirection.Magnitude > 0.05 then
								walkBoost = 1 + math.clamp(tonumber(DataList.SoftBodyWalkBoostIntensity) or 0.35, 0, 2)
							end
						end
						posM = softPos * intens * limbBoost * boost * walkBoost
						rotM = softRot * intens * limbBoost * boost * walkBoost
					else
						posM = (PhysicsSettings.BreastPosMult or PhysicsSettings.PositionPhysicsMultiply or 10) * boost
						rotM = (PhysicsSettings.BreastRotMult or PhysicsSettings.RotationPhysicsMultiply or 1) * boost
					end
					if kind == "breast" and DataList.UVToggle == true
						and PhysicsSettings.ClothedDampingMaster ~= false
						and PhysicsSettings.ClothedBreastDampingEnabled ~= false
					then
						local cs = tonumber(PhysicsSettings.ClothedBreastJiggleScale) or (1 / 1.5)
						posM = posM * cs
						rotM = rotM * cs
					end
					if HoldBreast and HoldBreast.Holding and kind == "breast" then
						local hs = math.clamp(tonumber(HoldBreast.JiggleScale) or 0.08, 0, 1)
						posM = posM * hs
						rotM = rotM * hs
					end
					if HoldCheek and HoldCheek.Holding and kind == "butt" then
						local hs = math.clamp(tonumber(HoldCheek.JiggleScale) or 0.08, 0, 1)
						posM = posM * hs
						rotM = rotM * hs
					end
					if DataList and DataList.AsymBounce == true and DataList.UVToggle ~= true and kind == "breast" and Property.AsymSide then
						local sideSign = (Property.AsymSide == "left") and -1 or 1
						local lean = 0
						if turnImpulse then
							lean = math.clamp(turnImpulse.X * sideSign * 0.55, -0.4, 0.4)
						end
						local ph = Property.AsymPhase or 0
						local ns = Property.AsymNoise or 1
						local tc = os.clock()
						local noise = math.sin(tc * (1.3 * ns) + ph) * 0.12 + math.sin(tc * (2.1 * ns) + ph * 1.7) * 0.07
						lean = math.clamp(lean + noise * sideSign, -0.45, 0.45)
						posM = posM * (1 + lean)
						rotM = rotM * (1 + lean * 1.25)
					end
					for From, To in pairs(PositionOffset) do
						App.PosList[From] = (Position[To] * vel[To]) * posM
					end
					for From, To in pairs(RotationOffset) do
						App.RotList[From] = math.rad(Rotation[To] * vel[To]) * rotM
					end
				end

				
				if kind == "butt" and CheekLegTrack then
					local dataLT = DataList
					if dataLT and dataLT.CheekLegTrack == true and dataLT.ButtsParentToLegs ~= true then
						local pn = string.lower(Part.Name or "")
						local off = Vector3.zero
						local space = CheekLegTrack.SpacingAdd or 0
						if pn:find("left") then
							off = CheekLegTrack.LeftOff or Vector3.zero
							App.PosList.X = App.PosList.X - space * 0.5
						elseif pn:find("right") then
							off = CheekLegTrack.RightOff or Vector3.zero
							App.PosList.X = App.PosList.X + space * 0.5
						end
						App.PosList.X = App.PosList.X + off.X
						App.PosList.Y = App.PosList.Y + off.Y
						App.PosList.Z = App.PosList.Z + off.Z
					end
				end

				
				if kind == "butt" and CheekImpact and (CheekImpact.Squish or 0) > 0.01 then
					local s = CheekImpact.Squish
					local pull = (CheekImpact.PosPull or 0.22) * s
					App.PosList.Y = App.PosList.Y - pull
					
					if Property.AsymSide == "left" then
						App.PosList.X = App.PosList.X + pull * 0.35
					elseif Property.AsymSide == "right" then
						App.PosList.X = App.PosList.X - pull * 0.35
					end
				end

				
				local sq = Property.CollisionSquish
				if sq and sq.Magnitude > 1e-4 then
					local localSq = CurrentCFrame:VectorToObjectSpace(sq)
					App.PosList.X = App.PosList.X + localSq.X
					App.PosList.Y = App.PosList.Y + localSq.Y
					App.PosList.Z = App.PosList.Z + localSq.Z
				end

				local sx, sy, sz = 1, 1, 1
				if Property.Scale then
					sx = math.clamp(1 + App.RotList.X / 4, 0.8, 1.1)
					sy = math.clamp(1 + App.RotList.Y / 4, 0.8, 1.1)
					sz = math.clamp(1 + App.RotList.Z / 4, 0.8, 1.1)
					local scaleVector = Vector3.new(sx, sy, sz)
					Part.Size = Property.Size * scaleVector
					local mesh = Part:FindFirstChildOfClass("SpecialMesh")
					if mesh then
						mesh.Scale = Property.Size * scaleVector
					end
				end

				local px, py, pz = App.PosList.X, App.PosList.Y, App.PosList.Z
				local rx, ry, rz = App.RotList.X, App.RotList.Y, App.RotList.Z
				if kind == "soft" then
					local hs = tonumber(Property.SoftHeadScale) or 1
					if hs ~= 1 then
						px, py, pz = px * hs, py * hs, pz * hs
						rx, ry, rz = rx * hs, ry * hs, rz * hs
					end
					local mir = tonumber(Property.SoftMirror) or 0
					if mir ~= 0 then
						
						px = px * mir
						ry = ry * mir
						rz = rz * mir
					end
					
					local sideM = 1
					if mir < 0 then
						sideM = math.clamp(tonumber(DataList.SoftBodyLeftMult) or 2, 0, 3)
						px, py, pz = px * sideM, py * sideM, pz * sideM
						rx, ry, rz = rx * (0.85 + 0.15 * sideM), ry * (0.85 + 0.15 * sideM), rz * (0.85 + 0.15 * sideM)
					elseif mir > 0 then
						sideM = math.clamp(tonumber(DataList.SoftBodyRightMult) or 1, 0, 3)
						
						px, py, pz = px * sideM, py * sideM, pz * sideM
						rx, ry, rz = rx * (0.8 + 0.2 * sideM), ry * (0.8 + 0.2 * sideM), rz * (0.8 + 0.2 * sideM)
					else
						
						local lm = math.clamp(tonumber(DataList.SoftBodyLeftMult) or 2, 0, 3)
						local rm = math.clamp(tonumber(DataList.SoftBodyRightMult) or 1, 0, 3)
						sideM = (lm + rm) * 0.5
						px, py, pz = px * sideM, py * sideM, pz * sideM
						rx, ry, rz = rx * sideM, ry * sideM, rz * sideM
					end
				end

				Weld.C0 = CF
					* Function.CFrameMultiply(
						CFrame.new(px, py, pz),
						{X = sx, Y = sy, Z = sz}
					)
					* CFrame.Angles(rx, ry, -rz)

				if kind == "breast" and Property.AsymSide then
					Property.LastOffset = Vector3.new(App.PosList.X, App.PosList.Y, App.PosList.Z)
					Property.LastRot = Vector3.new(App.RotList.X, App.RotList.Y, App.RotList.Z)
				end

				Property.OriginCFrame = CurrentCFrame
			end 

		end 

		end))

	
