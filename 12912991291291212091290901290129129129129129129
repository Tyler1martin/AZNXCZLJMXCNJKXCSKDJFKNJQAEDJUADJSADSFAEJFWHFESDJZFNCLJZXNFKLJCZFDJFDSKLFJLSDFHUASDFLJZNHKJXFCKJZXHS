	MorphLoadState.PostResetClean = function()
		
		
		pcall(function()
			if Function.InvalidateFPCache then Function.InvalidateFPCache() end
		end)
		pcall(function()
			if SoftWorldImpulses then table.clear(SoftWorldImpulses) end
		end)

		
		pcall(function()
			if clearMilkStream then clearMilkStream() end
		end)

		local char = Player.Character
		if char then
			
			local morphs = {}
			for _, c in ipairs(char:GetChildren()) do
				if c.Name == "Morph" then
					table.insert(morphs, c)
				end
			end
			
			if #morphs > 1 then
				table.sort(morphs, function(a, b)
					return (a:GetAttribute("MorphGen") or 0) < (b:GetAttribute("MorphGen") or 0)
				end)
				for i = 1, #morphs - 1 do
					pcall(function() morphs[i]:Destroy() end)
				end
			end
		end

		for _, pd in pairs(PlayerData) do
			if type(pd) ~= "table" then continue end
			pd.deferredWelds = pd.deferredWelds or {}
			
			
			
			pd.ClothWrap = nil

			local cpl = pd.CurrentPartList
			if not cpl then continue end

			local function pruneMap(map)
				if type(map) ~= "table" then return end
				for k, v in pairs(map) do
					local inst = (typeof(k) == "Instance" and k) or (typeof(v) == "Instance" and v) or nil
					if inst and not inst.Parent then
						map[k] = nil
					elseif typeof(k) == "Instance" and not k.Parent then
						map[k] = nil
					end
				end
			end

			pruneMap(cpl.BodyPartPhysics)
			pruneMap(cpl.AreolaDecal)
			pruneMap(cpl.NippleParts)
			if cpl.RealtimeUpdateList then
				pruneMap(cpl.RealtimeUpdateList.Mesh)
				pruneMap(cpl.RealtimeUpdateList.Accessory)
			end
			
			for _, listName in ipairs({"Organ", "Accessory", "Clothes"}) do
				local list = cpl[listName]
				if type(list) == "table" then
					for i = #list, 1, -1 do
						local v = list[i]
						if typeof(v) == "Instance" and not v.Parent then
							table.remove(list, i)
						elseif type(v) == "table" then
							
						end
					end
					
					for k, v in pairs(list) do
						if typeof(v) == "Instance" and not v.Parent then
							list[k] = nil
						elseif typeof(k) == "Instance" and not k.Parent then
							list[k] = nil
						end
					end
				end
			end
		end

		
		if MilkMeter and MilkMeter.Emitters then
			for att, pe in pairs(MilkMeter.Emitters) do
				if (att and not att.Parent) or (pe and not pe.Parent) then
					pcall(function() if pe then pe:Destroy() end end)
					pcall(function() if att then att:Destroy() end end)
					MilkMeter.Emitters[att] = nil
				end
			end
		end
	end

