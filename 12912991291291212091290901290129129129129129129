	function Function.MultiplyCalculate(Base, Default)
		local X = Base.X / Default.X
		local Y = Base.Y / Default.Y
		local Z = Base.Z / Default.Z

		return X,Y,Z
	end

	function Function.TabletoVector(Table)
		if typeof(Table) == "Vector3" then
			return Table
		end
		if type(Table) ~= "table" then
			return Vector3.zero
		end
		return Vector3.new(
			tonumber(Table["x"] or Table["X"]) or 0,
			tonumber(Table["y"] or Table["Y"]) or 0,
			tonumber(Table["z"] or Table["Z"]) or 0
		)
	end

	function Function.StringtoColor3(str)
		local r, g, b = str:match("([^,]+),([^,]+),([^,]+)")
		return Color3.fromRGB(math.round(tonumber(r)), math.round(tonumber(g)), math.round(tonumber(b)))
	end
	function Function.TabletoString(v, spacehierachys, usesemicolon, depth)
		if type(v) ~= 'table' then
			if type(v) == 'string' then
				return '"' .. v .. '"'
			else
				return tostring(v)
			end
		elseif not next(v) then
			return '{}'
		end
		local spaces = 4
		depth = depth or 1

		local space = (" "):rep(depth * spaces)
		local sep = usesemicolon and ";" or ","
		local concatenationBuilder = {"{"}

		for k, x in next, v do
			table.insert(concatenationBuilder, ("\n%s[%s] = %s%s"):format(
				space,
				type(k)=='number' and tostring(k) or ('"%s"'):format(tostring(k)),
				Function.TabletoString(x, spaces, usesemicolon, depth+1),
				sep))
		end

		local s = table.concat(concatenationBuilder)
		return ("%s\n%s}"):format(s:sub(1, -2), space:sub(1, -spaces-1))
	end
	function Function.StringtoTable(str)
		local tbl = {}
		for key, value in str:gmatch('%[\"(.-)\"%] = \"(.-)\"') do
			tbl[key] = value
		end
		return tbl

	end

	function Function.Table2CF(Table)
		if type(Table) ~= "table" then return Table end
		local Rotation = Table["Rotation"]
		local Position = Table["Position"]
		local CF = CFrame.new(Position.x,Position.y,Position.z)

		local CA = CFrame.fromEulerAnglesYXZ(math.rad(Rotation.x),math.rad(Rotation.y),math.rad(Rotation.z))

		return CF*CA
	end

	function Function.DarkenColor(color,amount)
		return color:Lerp(Color3.new(0,0,0), amount)
	end


	function Function.SideOfNippleName(n)
		n = (n or ""):lower()
		if n:find("left") or n:find("nipplel") or n:find("nipple.1") or n:find("nipple_l") then
			return "left"
		end
		if n:find("right") or n:find("nippler") or n:find("nipple_r") then
			return "right"
		end
		return "both"
	end

	function Function.ResolveNippleAreolaColor(pd, side, skin)
		skin = skin or Color3.fromRGB(163, 162, 165)
		if not pd then
			return Function.DarkenColor(skin, 0.32)
		end
		if side == "left" and typeof(pd.NippleAreolaColorL) == "Color3" then
			return pd.NippleAreolaColorL
		end
		if side == "right" and typeof(pd.NippleAreolaColorR) == "Color3" then
			return pd.NippleAreolaColorR
		end
		if typeof(pd.NippleAreolaColor) == "Color3" then
			return pd.NippleAreolaColor
		end
		return Function.DarkenColor(skin, 0.32)
	end

	function Function.AreolaDecalCreate(ObjectInstance, Character, Extra, Data)
		for _, ch in ipairs(ObjectInstance:GetChildren()) do
			if ch:IsA("Decal") and ch.Name:lower():find("areola") then
				ch:Destroy()
			end
		end
		local uv = Extra and Extra.UVToggle == true
		local keepNipples = Extra and Extra.NipplesOnClothed == true
		if uv and not keepNipples then
			return
		end
		local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
		local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
		local pd = PlayerData[Data]
		local side = Function.SideOfNippleName(ObjectInstance and ObjectInstance.Name)
		local baseColor = Function.ResolveNippleAreolaColor(pd, side, skin)
		local Decal = Instance.new("Decal")
		Decal.Name = "Areola Decal"
		Decal.Texture = "http://www.roblox.com/asset/?id=9065282081"
		Decal.Face = Enum.NormalId.Right
		Decal.Color3 = baseColor
		Decal.Transparency = 0
		Decal:SetAttribute("BaseColorR", baseColor.R)
		Decal:SetAttribute("BaseColorG", baseColor.G)
		Decal:SetAttribute("BaseColorB", baseColor.B)
		Decal:SetAttribute("NippleSide", side)
		Decal.Parent = ObjectInstance
		PlayerData[Data].CurrentPartList.AreolaDecal[Decal] = ObjectInstance
	end

	function Function.ApplyNippleAreolaColors(Character, Data)
		local pd = (type(Data) == "table" and Data) or PlayerData[Data]
		if not pd or not Character then return end
		local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
		local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
		local cpl = pd.CurrentPartList
		if not cpl then return end
		for Decal, host in pairs(cpl.AreolaDecal or {}) do
			if Decal and Decal.Parent then
				local hostName = (host and host.Name) or (Decal.Parent and Decal.Parent.Name) or ""
				local side = Decal:GetAttribute("NippleSide") or Function.SideOfNippleName(hostName)
				local col = Function.ResolveNippleAreolaColor(pd, side, skin)
				Decal:SetAttribute("BaseColorR", col.R)
				Decal:SetAttribute("BaseColorG", col.G)
				Decal:SetAttribute("BaseColorB", col.B)
				Decal.Color3 = col
			end
		end
		for part, _ in pairs(cpl.NippleParts or {}) do
			if part and part.Parent then
				local side = Function.SideOfNippleName(part.Name)
				local col = Function.ResolveNippleAreolaColor(pd, side, skin)
				part:SetAttribute("MilkBaseR", col.R)
				part:SetAttribute("MilkBaseG", col.G)
				part:SetAttribute("MilkBaseB", col.B)
				part.Color = col
			else
				cpl.NippleParts[part] = nil
			end
		end
	end

	function Function.ApplyBodyShine(Character, Data)
		local pd = (type(Data) == "table" and Data) or PlayerData[Data]
		if not pd or not Character then return end
		local shiny = pd.ShinyBody == true
		local mat = shiny and Enum.Material.SmoothPlastic or Enum.Material.Plastic
		local limbRefl = shiny and 0.06 or 0
		local morphRefl = shiny and 0.04 or 0
		local naked = pd.UVToggle ~= true
		local morph = Character:FindFirstChild("Morph")
		if morph then
			for _, d in ipairs(morph:GetDescendants()) do
				if d:IsA("BasePart") then
					local n = string.lower(d.Name or "")
					-- Naked: skip shine on arm meshes (avoids look issues / lag on arms)
					if naked and n:find("arm") then
						d.Material = Enum.Material.Plastic
						d.Reflectance = 0
					else
						d.Material = mat
						d.Reflectance = morphRefl
					end
				end
			end
		end
		for _, d in ipairs(Character:GetChildren()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
				if d.Name == "Head" then
					d.Material = Enum.Material.Plastic
					d.Reflectance = 0
				elseif naked and (d.Name == "Left Arm" or d.Name == "Right Arm") then
					d.Material = Enum.Material.Plastic
					d.Reflectance = 0
				else
					d.Material = mat
					d.Reflectance = limbRefl
				end
			end
		end
	end

	-- Per-side stream tint (each nipple keeps its own color). Flavor mix is glass-only.
	function Function.GetMilkTintColorForSide(side)
		local data = PlayerData[Player.Name]
		if not data or not data.MilkColorSync then return nil end
		if data.RainbowAreola then
			return Color3.fromHSV((os.clock() * 0.35) % 1, 0.85, 1)
		end
		side = side or "both"
		if Function.ResolveNippleAreolaColor then
			local torso = Player.Character and (Player.Character:FindFirstChild("Torso") or Player.Character:FindFirstChild("UpperTorso"))
			local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
			local col = Function.ResolveNippleAreolaColor(data, side, skin)
			-- Only return if player actually set a custom color (not pure skin-default guess)
			if side == "left" and typeof(data.NippleAreolaColorL) == "Color3" then return data.NippleAreolaColorL end
			if side == "right" and typeof(data.NippleAreolaColorR) == "Color3" then return data.NippleAreolaColorR end
			if typeof(data.NippleAreolaColor) == "Color3" then return data.NippleAreolaColor end
			return nil
		end
		if typeof(data.NippleAreolaColor) == "Color3" then return data.NippleAreolaColor end
		return nil
	end

	function Function.GetMilkTintColor()
		-- Legacy shared tint (no flavor mix — used only if no side given)
		return Function.GetMilkTintColorForSide("both")
	end

	function Function.ClassifyNipplePrimary(col)
		if typeof(col) ~= "Color3" then return "strawberry" end
		local best, bestD = "strawberry", math.huge
		for id, def in pairs(MilkFlavorPrimaries) do
			local c = def.color
			local dr, dg, db = col.R - c.R, col.G - c.G, col.B - c.B
			local d = dr * dr + dg * dg + db * db
			if d < bestD then bestD, best = d, id end
		end
		return best
	end

	function Function.UpdateMilkFlavor(heated)
		if not MilkFlavorSystem or not MilkFlavorSystem.Enabled then
			MilkFlavorSystem.Id = "plain"
			MilkFlavorSystem.Name = "Milk"
			MilkFlavorSystem.Color = Color3.fromRGB(255, 255, 255)
			MilkFlavorSystem.SizeScale = 1
			return MilkFlavorSystem
		end
		local data = PlayerData[Player.Name]
		if data and data.RainbowAreola == true then
			local key = heated and "rainbow|rainbow|hot" or "rainbow|rainbow"
			local mix = MilkFlavorMix[key] or MilkFlavorMix["rainbow|rainbow"]
			MilkFlavorSystem.LeftBase, MilkFlavorSystem.RightBase = "rainbow", "rainbow"
			MilkFlavorSystem.Id = mix.id
			MilkFlavorSystem.Name = mix.name
			MilkFlavorSystem.Color = Color3.fromHSV((os.clock() * 0.35) % 1, 0.85, 1)
			MilkFlavorSystem.SizeScale = 0.80 + math.random() * 0.10
			MilkFlavorSystem._mixDef = mix
			return MilkFlavorSystem
		end
		local torso = Player.Character and (Player.Character:FindFirstChild("Torso") or Player.Character:FindFirstChild("UpperTorso"))
		local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
		local colL = Function.ResolveNippleAreolaColor(data, "left", skin)
		local colR = Function.ResolveNippleAreolaColor(data, "right", skin)
		local leftB = Function.ClassifyNipplePrimary(colL)
		local rightB = Function.ClassifyNipplePrimary(colR)
		MilkFlavorSystem.LeftBase, MilkFlavorSystem.RightBase = leftB, rightB
		local key = leftB .. "|" .. rightB
		if heated then
			if math.random() < 0.28 then
				key = key .. "|peak"
			else
				key = key .. "|hot"
			end
		end
		local mix = MilkFlavorMix[key] or MilkFlavorMix[leftB .. "|" .. rightB .. (heated and "|hot" or "")] or MilkFlavorMix[leftB .. "|" .. rightB]
		if not mix then
			mix = { id = "blend", name = "Mystery Blend", color = Color3.new((colL.R+colR.R)/2, (colL.G+colR.G)/2, (colL.B+colR.B)/2), buff = 6, durMin = 4, durMax = 8 }
		end
		MilkFlavorSystem.Id = mix.id
		MilkFlavorSystem.Name = mix.name
		MilkFlavorSystem.Color = mix.color
		local now = os.clock()
		if (now - (MilkFlavorSystem.LastRoll or 0)) > 2.5 or (MilkFlavorSystem.SizeScale or 1) >= 0.99 then
			MilkFlavorSystem.SizeScale = 0.80 + math.random() * 0.10
			MilkFlavorSystem.LastRoll = now
		end
		MilkFlavorSystem._mixDef = mix
		return MilkFlavorSystem
	end

