local function applyRandomAvatar(char)
    local outfits = getSavedOutfitPaths()
    if #outfits > 0 then
        applyOutfitFromFile(outfits[math.random(1, #outfits)], char)
    end
end

local function tryAutoload(char)
    if not char then return end
    char:WaitForChild("Head", 5)
    task.wait(0.1)

    local randomFile = getRandomAutoloadFile()
    local autoFile = getAutoloadFile()

    if isfile and isfile(randomFile) and readfile(randomFile) == "true" then
        applyRandomAvatar(char)
        return
    end

    if isfile and isfile(autoFile) then
        local path = readfile(autoFile)
        if path and path ~= "" and isfile(path) then
            applyOutfitFromFile(path, char)
        end
    end
end

