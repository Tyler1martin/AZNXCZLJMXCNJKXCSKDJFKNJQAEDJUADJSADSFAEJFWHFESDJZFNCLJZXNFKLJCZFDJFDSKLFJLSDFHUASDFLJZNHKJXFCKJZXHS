				if App.MasterSFXMute then return end
				local host = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
				if not host then return end
				local s = GlassSystem.GulpSound
				if not s or not s.Parent then
					s = Instance.new("Sound")
					s.Name = "MilkGulp"
					s.SoundId = GlassSystem.GulpSoundId
					s.Volume = 1
					s.Parent = host
					GlassSystem.GulpSound = s
				end
				s.TimePosition = 0
				s:Play()
			end)
			
