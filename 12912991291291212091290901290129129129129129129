	function FlavorCatalogList()
		local seen, list = {}, {}
		for _, mix in pairs(MilkFlavorMix) do
			if mix and mix.id and not seen[mix.id] then
				seen[mix.id] = true
				table.insert(list, mix)
			end
		end
		table.sort(list, function(a, b) return tostring(a.name) < tostring(b.name) end)
		return list
	end

	local FlavorPrimaryNames = {}
	for pid, def in pairs(MilkFlavorPrimaries) do
		FlavorPrimaryNames[pid] = def.name or pid
	end
	FlavorPrimaryNames["rainbow"] = "Rainbow"

	local FlavorRarityColor = {
		Common = Color3.fromRGB(180, 180, 185),
		Uncommon = Color3.fromRGB(80, 200, 120),
		Rare = Color3.fromRGB(70, 140, 255),
		["Very Rare"] = Color3.fromRGB(180, 90, 255),
		["Super Rare"] = Color3.fromRGB(255, 170, 40),
	}

	function flavorBasesFromId(id)
		id = tostring(id or "")
		local base = id:gsub("_hot$", ""):gsub("_peak$", "")
		if MilkFlavorPrimaries[base] or base == "rainbow" then
			return base, base
		end
		for a, _ in pairs(MilkFlavorPrimaries) do
			for b, _ in pairs(MilkFlavorPrimaries) do
				if base == (a .. "_" .. b) or base == (b .. "_" .. a) then
					return a, b
				end
			end
		end
		return nil, nil
	end

	function computeFlavorRarity(id, hard)
		id = tostring(id or "")
		if id:find("_peak") then return "Super Rare" end
		if id == "rainbow" or id == "rainbow_hot" then return "Very Rare" end
		local a, b = flavorBasesFromId(id)
		if not a then return hard and "Very Rare" or "Common" end
		local function tier(p)
			if p == "strawberry" or p == "blueberry" or p == "greenapple" then return 1 end
			if p == "pink" or p == "yellow" then return 2 end
			if p == "cyan" or p == "purple" or p == "white" then return 3 end
			if p == "black" or (type(p) == "string" and string.sub(p, 1, 4) == "dark") then return 4 end
			return 2
		end
		local t = math.max(tier(a), tier(b))
		if hard and t < 4 then t = 4 end
		if t <= 1 then return "Common"
		elseif t == 2 then return "Uncommon"
		elseif t == 3 then return "Rare"
		else return "Very Rare" end
	end

	function EnsureFlavorMeta()
		for key, mix in pairs(MilkFlavorMix) do
			if mix and mix.id then
				mix.rarity = computeFlavorRarity(mix.id, mix.hard == true)
				local a, b = flavorBasesFromId(mix.id)
				
				if type(key) == "string" then
					local p1, p2 = string.match(key, "^([^|]+)|([^|]+)")
					if p1 and p2 and p1 ~= "hot" and p2 ~= "hot" and p1 ~= "peak" and p2 ~= "peak" then
						a, b = p1, p2
					end
				end
				mix.baseA, mix.baseB = a, b
				local na = a and (FlavorPrimaryNames[a] or a) or "?"
				local nb = b and (FlavorPrimaryNames[b] or b) or "?"
				local suffix = ""
				local id = tostring(mix.id)
				if id:find("_peak") then suffix = " (Deluxe / peak heat)"
				elseif id:find("_hot") then suffix = " (Heated)" end
				if a and a == b then
					mix.recipe = string.format("Both nipples: %s%s", na, suffix)
				elseif a then
					mix.recipe = string.format("One %s + one %s%s", na, nb, suffix)
				else
					mix.recipe = "Unknown recipe"
				end
				if type(key) == "string" then
					local p1, p2 = string.match(key, "^([^|]+)|([^|]+)")
					if p1 and p2 and p1 ~= "hot" and p2 ~= "hot" and p1 ~= "peak" and p2 ~= "peak" then
						local n1 = FlavorPrimaryNames[p1] or p1
						local n2 = FlavorPrimaryNames[p2] or p2
						local suf = ""
						if string.find(key, "peak", 1, true) then suf = " (Deluxe / peak heat)"; mix.rarity = "Super Rare"
						elseif string.find(key, "hot", 1, true) then suf = " (Heated)" end
						if p1 == p2 then mix.recipe = string.format("Both nipples: %s%s", n1, suf)
						else mix.recipe = string.format("One %s + one %s%s", n1, n2, suf) end
					end
				end
			end
		end
	end
