	function Function.SetupClothEditable(meshPart, Data)
		
		
		local data = getPlayerData(Data)
		if not data then return end
		if not meshPart or not meshPart:IsA("BasePart") then return end
		
		if not meshPart:IsA("MeshPart") then
			return
		end
		data.ClothWrap = data.ClothWrap or {}
		for _, e in ipairs(data.ClothWrap) do
			if e.part == meshPart then return end 
		end

		local AssetService = game:GetService("AssetService")
		local meshId = meshPart.MeshId
		if typeof(meshId) ~= "string" or meshId == "" or meshId == "rbxassetid://0" then return end

		local ok, em = pcall(function()
			return AssetService:CreateEditableMeshAsync(Content.fromUri(meshId))
		end)
		if not ok or not em then
			warn("[Morph] Cloth EditableMesh failed:", tostring(em))
			return
		end

		local vertIds = {}
		pcall(function()
			vertIds = em:GetVertices()
		end)
		if type(vertIds) ~= "table" or #vertIds == 0 then
			pcall(function() em:Destroy() end)
			return
		end

		local minX, maxX = math.huge, -math.huge
		local minY, maxY = math.huge, -math.huge
		local positions = {}
		for _, id in ipairs(vertIds) do
			local pos = em:GetPosition(id)
			positions[id] = pos
			minX, maxX = math.min(minX, pos.X), math.max(maxX, pos.X)
			minY, maxY = math.min(minY, pos.Y), math.max(maxY, pos.Y)
		end
		local spanX = math.max(maxX - minX, 1e-3)
		local spanY = math.max(maxY - minY, 1e-3)

		local verts = {}
		for _, id in ipairs(vertIds) do
			local pos = positions[id]
			local tx = (pos.X - minX) / spanX 
			local ty = (pos.Y - minY) / spanY
			
			local wR = tx * tx * (3 - 2 * tx) 
			local wL = 1 - wR
			
			local front = math.clamp(1 - math.abs(pos.Z) / math.max(math.abs(minX), math.abs(maxX), 0.5), 0.35, 1)
			table.insert(verts, {
				id = id,
				rest = pos,
				wL = wL,
				wR = wR,
				front = front,
				
				radial = Vector3.new(pos.X - (minX + maxX) * 0.5, pos.Y - (minY + maxY) * 0.5, pos.Z).Unit,
			})
		end

		local restoreContent = nil
		pcall(function() restoreContent = meshPart.MeshContent end)
		local applied = pcall(function()
			meshPart.MeshContent = Content.fromObject(em)
		end)
		if not applied then
			pcall(function() em:Destroy() end)
			warn("[Morph] Could not apply EditableMesh to", meshPart.Name)
			return
		end

		table.insert(data.ClothWrap, {
			part = meshPart,
			em = em,
			verts = verts,
			restoreContent = restoreContent,
		})
	end

	function Function.RegisterBreastCloth(ObjectInstance, Character, Extra, Data)
