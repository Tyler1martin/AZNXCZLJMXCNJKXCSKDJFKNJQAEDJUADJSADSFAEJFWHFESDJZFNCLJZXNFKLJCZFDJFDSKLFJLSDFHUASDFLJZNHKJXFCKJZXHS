			end
			return
		end
		JiggleMeter._HeatGlowActive = true
		local col = Color3.fromRGB(255, 70, 105) 
		local ht = math.clamp(heatFill, 0, 1)
		
		local centerT = 0.97 - ht * 0.08 
		local edgeT = 0.90 - ht * 0.18 
		flash.BackgroundColor3 = col
		flash.BackgroundTransparency = centerT
		for _, child in ipairs(flash:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = col
				child.BackgroundTransparency = edgeT
			end
		end
	end

	
