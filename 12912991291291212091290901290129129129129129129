		local function applyPresetTable(t)
			if type(t) ~= "table" then return false end
			local data = PlayerData[Player.Name]
			if not data then return false end
			
			data.BreastsScale = tonumber(t.BreastsScale) or 1
			data.ButtsScale = tonumber(t.ButtsScale) or 1
			data.BreastsAxis = t.BreastsAxis or {X=1,Y=1,Z=1}
			data.ButtsAxis = t.ButtsAxis or {X=1,Y=1,Z=1}
			data.BreastsOffset = t.BreastsOffset or {X=0,Y=0,Z=0}
			if t.CurvyLegsEnabled ~= nil then data.CurvyLegsEnabled = t.CurvyLegsEnabled == true end
			if t.CurvyArmsEnabled ~= nil then data.CurvyArmsEnabled = t.CurvyArmsEnabled == true end
			if t.CurvyTorsoEnabled ~= nil then data.CurvyTorsoEnabled = t.CurvyTorsoEnabled == true end
			data.LegsScale = tonumber(t.LegsScale) or tonumber(t.LeftLegScale) or tonumber(t.RightLegScale) or 1
			data.ArmsScale = tonumber(t.ArmsScale) or 1
			data.TorsoScale = tonumber(t.TorsoScale) or 1
			data.LegsAxis = t.LegsAxis or t.LeftLegAxis or t.RightLegAxis or {X=1,Y=1,Z=1}
			data.ArmsAxis = t.ArmsAxis or {X=1.02,Y=0.5,Z=1.02}
			data.TorsoAxis = t.TorsoAxis or {X=1,Y=1,Z=1}
			data.LegsOffset = t.LegsOffset or t.LeftLegOffset or t.RightLegOffset or {X=0,Y=0,Z=0}
			data.ArmsOffset = t.ArmsOffset or {X=0,Y=0,Z=0}
			data.TorsoOffset = t.TorsoOffset or {X=0,Y=0,Z=0}
			data.LegsRotation = t.LegsRotation or t.LeftLegRotation or t.RightLegRotation or {X=0,Y=0,Z=0}
			data.TorsoRotation = t.TorsoRotation or {X=0,Y=0,Z=0}
			data.BreastsRotation = t.BreastsRotation or {X=0,Y=0,Z=0}
			data.ButtsOffset = t.ButtsOffset or {X=0,Y=0,Z=0}
			data.ButtsRotationL = t.ButtsRotationL or {X=0,Y=0,Z=0}
			data.ButtsRotationR = t.ButtsRotationR or {X=0,Y=0,Z=0}
			data.ButtsSpacing = tonumber(t.ButtsSpacing) or 0
			
			pcall(function()
				local br = data.BreastsRotation
				if SliderRefs.BreastRotX and br then SliderRefs.BreastRotX(tonumber(br.X) or 0) end
				if SliderRefs.BreastRotY and br then SliderRefs.BreastRotY(tonumber(br.Y) or 0) end
				if SliderRefs.BreastRotZ and br then SliderRefs.BreastRotZ(tonumber(br.Z) or 0) end
				local bl = data.ButtsRotationL
				if SliderRefs.ButtRotLX and bl then SliderRefs.ButtRotLX(tonumber(bl.X) or 0) end
				if SliderRefs.ButtRotLY and bl then SliderRefs.ButtRotLY(tonumber(bl.Y) or 0) end
				if SliderRefs.ButtRotLZ and bl then SliderRefs.ButtRotLZ(tonumber(bl.Z) or 0) end
				local brt = data.ButtsRotationR
				if SliderRefs.ButtRotRX and brt then SliderRefs.ButtRotRX(tonumber(brt.X) or 0) end
				if SliderRefs.ButtRotRY and brt then SliderRefs.ButtRotRY(tonumber(brt.Y) or 0) end
				if SliderRefs.ButtRotRZ and brt then SliderRefs.ButtRotRZ(tonumber(brt.Z) or 0) end
				if SliderRefs.CheekLegMaxDist then SliderRefs.CheekLegMaxDist(tonumber(data.CheekLegTrackMaxDist) or 0.3) end
				if SliderRefs.CheekLegMaxSpacing then SliderRefs.CheekLegMaxSpacing(tonumber(data.CheekLegTrackMaxSpacing) or 0.2) end
			end)
			data.BreastsEnabled = t.BreastsEnabled ~= false
			data.ButtsEnabled = t.ButtsEnabled ~= false
			data.OrganCollision = t.OrganCollision == true
			data.LimbOrganCollision = t.LimbOrganCollision == true
			data.LimbOrganImpulse = tonumber(t.LimbOrganImpulse) or data.LimbOrganImpulse or 2
			data.SkipCustomBody = t.SkipCustomBody == true
			if t.BreastPhysicsEnabled ~= nil then data.BreastPhysicsEnabled = t.BreastPhysicsEnabled ~= false end
			if t.ButtPhysicsEnabled ~= nil then data.ButtPhysicsEnabled = t.ButtPhysicsEnabled ~= false end
			if t.SoftBodyEnabled ~= nil then data.SoftBodyEnabled = t.SoftBodyEnabled ~= false end
			if t.SoftBodyIntensity ~= nil then data.SoftBodyIntensity = math.clamp(tonumber(t.SoftBodyIntensity) or 0.5, 0, 2) end
			if t.SoftBodyPosMult ~= nil then data.SoftBodyPosMult = math.clamp(tonumber(t.SoftBodyPosMult) or 0.3, 0, 40) end
			if t.SoftBodyRotMult ~= nil then data.SoftBodyRotMult = math.clamp(tonumber(t.SoftBodyRotMult) or 0.35, 0, 10) end
			if t.SoftBodyLimbBoost ~= nil then data.SoftBodyLimbBoost = math.clamp(tonumber(t.SoftBodyLimbBoost) or 2.75, 1, 6) end
			if t.SoftBodyLeftMult ~= nil then data.SoftBodyLeftMult = math.clamp(tonumber(t.SoftBodyLeftMult) or 2.0, 0, 3) end
			if t.SoftBodyRightMult ~= nil then data.SoftBodyRightMult = math.clamp(tonumber(t.SoftBodyRightMult) or 1.0, 0, 3) end
			if t.AllowSpeedChanges ~= nil then data.AllowSpeedChanges = t.AllowSpeedChanges == true end
			if t.AllowJumpChanges ~= nil then data.AllowJumpChanges = t.AllowJumpChanges == true end
			if t.SweatDebuffsEnabled ~= nil and SweatSystem then
				SweatSystem.DebuffsEnabled = t.SweatDebuffsEnabled == true
			end
			if t.FlavorBuffsEnabled ~= nil and GlassSystem then
				GlassSystem.FlavorBuffsEnabled = t.FlavorBuffsEnabled == true
			end
			if t.AsymBounce ~= nil then data.AsymBounce = t.AsymBounce == true end
			data.BreastRetract = tonumber(t.BreastRetract) or 0.3
			data.ButtsParentToLegs = t.ButtsParentToLegs == true
			data.CheekLegTrack = t.CheekLegTrack == true
			data.CheekLegTrackMaxDist = tonumber(t.CheekLegTrackMaxDist) or 0.3
			data.CheekLegTrackMaxSpacing = tonumber(t.CheekLegTrackMaxSpacing) or 0.2
			CheekLegTrack.MaxDist = data.CheekLegTrackMaxDist
			CheekLegTrack.MaxSpacing = data.CheekLegTrackMaxSpacing
			data.UVToggle = t.UVToggle == true
			data.NipplesOnClothed = t.NipplesOnClothed == true
			if t.UVDoubleSided ~= nil then data.UVDoubleSided = t.UVDoubleSided ~= false end
			data.ShinyBody = t.ShinyBody == true
			data.RainbowAreola = t.RainbowAreola == true
			if t.RainbowInterval ~= nil then
				data.RainbowInterval = math.clamp(tonumber(t.RainbowInterval) or 0.05, 0.016, 0.5)
			end
			data.MilkColorSync = t.MilkColorSync == true
			if type(t.NippleAreolaColor) == "table" and t.NippleAreolaColor.R then
				data.NippleAreolaColor = Color3.new(tonumber(t.NippleAreolaColor.R) or 0, tonumber(t.NippleAreolaColor.G) or 0, tonumber(t.NippleAreolaColor.B) or 0)
			elseif t.NippleAreolaColor == nil then
				data.NippleAreolaColor = nil
			end
			if type(t.NippleAreolaColorL) == "table" and t.NippleAreolaColorL.R then
				data.NippleAreolaColorL = Color3.new(tonumber(t.NippleAreolaColorL.R) or 0, tonumber(t.NippleAreolaColorL.G) or 0, tonumber(t.NippleAreolaColorL.B) or 0)
			elseif rawget(t, "NippleAreolaColorL") ~= nil then
				data.NippleAreolaColorL = nil
			end
			if type(t.NippleAreolaColorR) == "table" and t.NippleAreolaColorR.R then
				data.NippleAreolaColorR = Color3.new(tonumber(t.NippleAreolaColorR.R) or 0, tonumber(t.NippleAreolaColorR.G) or 0, tonumber(t.NippleAreolaColorR.B) or 0)
			elseif rawget(t, "NippleAreolaColorR") ~= nil then
				data.NippleAreolaColorR = nil
			end
			if t.NippleScale ~= nil then data.NippleScale = math.clamp(tonumber(t.NippleScale) or 1, 0.15, 4) end
			if t.AreolaScale ~= nil then data.AreolaScale = math.clamp(tonumber(t.AreolaScale) or 1, 0.15, 4) end
			if t.AreolaResizeEnabled ~= nil then data.AreolaResizeEnabled = t.AreolaResizeEnabled == true end
			if ToggleBtns.AreolaResize then
				ToggleBtns.AreolaResize.Text = data.AreolaResizeEnabled and "Areola resize: On" or "Areola resize: Off"
			end
			if type(t.NippleOffset) == "table" then
				data.NippleOffset = {
					X = math.clamp(tonumber(t.NippleOffset.X) or 0, -0.5, 0.5),
					Y = math.clamp(tonumber(t.NippleOffset.Y) or 0, -0.5, 0.5),
					Z = math.clamp(tonumber(t.NippleOffset.Z) or 0, -0.5, 0.5),
				}
			end
			if type(t.AreolaOffset) == "table" then
				data.AreolaOffset = {
					X = math.clamp(tonumber(t.AreolaOffset.X) or 0, -0.8, 0.8),
					Y = math.clamp(tonumber(t.AreolaOffset.Y) or 0, -0.8, 0.8),
					Z = math.clamp(tonumber(t.AreolaOffset.Z) or 0, -0.8, 0.8),
				}
			end
			if SliderRefs.NippleScale then SliderRefs.NippleScale(data.NippleScale or 1) end
			if SliderRefs.AreolaScale then SliderRefs.AreolaScale(data.AreolaScale or 1) end
			if SliderRefs.NipplePosX then SliderRefs.NipplePosX((data.NippleOffset and data.NippleOffset.X) or 0) end
			if SliderRefs.NipplePosY then SliderRefs.NipplePosY((data.NippleOffset and data.NippleOffset.Y) or 0) end
			if SliderRefs.NipplePosZ then SliderRefs.NipplePosZ((data.NippleOffset and data.NippleOffset.Z) or 0) end
			if SliderRefs.AreolaPosX then SliderRefs.AreolaPosX((data.AreolaOffset and data.AreolaOffset.X) or 0) end
			if SliderRefs.AreolaPosY then SliderRefs.AreolaPosY((data.AreolaOffset and data.AreolaOffset.Y) or 0) end
			if SliderRefs.AreolaPosZ then SliderRefs.AreolaPosZ((data.AreolaOffset and data.AreolaOffset.Z) or 0) end
			if t.MilkFlavorsEnabled ~= nil then
				data.MilkFlavorsEnabled = t.MilkFlavorsEnabled == true
				if MilkFlavorSystem then MilkFlavorSystem.Enabled = data.MilkFlavorsEnabled end
			end
			if t.UVTransparency ~= nil then
				data.UVTransparency = math.clamp(tonumber(t.UVTransparency) or 0, 0, 1)
				if Player.Character then pcall(function() Function.ApplyUVTransparency(Player.Character, Player.Name) end) end
			end
			if t.SoftBodyWalkBoost ~= nil then data.SoftBodyWalkBoost = t.SoftBodyWalkBoost == true end
			if t.SoftBodyWalkBoostIntensity ~= nil then
				data.SoftBodyWalkBoostIntensity = math.clamp(tonumber(t.SoftBodyWalkBoostIntensity) or 0.35, 0, 2)
			end
			if type(t.UnlockedAchievements) == "table" then
				data.UnlockedAchievements = data.UnlockedAchievements or {}
				for k, v in pairs(t.UnlockedAchievements) do
					if v then
						data.UnlockedAchievements[tostring(k)] = true
						if Function.AchievementRuntime then
							Function.AchievementRuntime.Unlocked[tostring(k)] = true
						end
					end
				end
				if Function.AchievementRuntime and Function.AchievementRuntime.UIRefresh then
					pcall(Function.AchievementRuntime.UIRefresh)
				end
			end
			if type(t.FavoriteFlavors) == "table" then
				data.FavoriteFlavors = data.FavoriteFlavors or {}
				for k, v in pairs(t.FavoriteFlavors) do
					if v then data.FavoriteFlavors[tostring(k)] = true end
				end
			end
			
			if type(t.DiscoveredFlavors) == "table" then
				data.DiscoveredFlavors = data.DiscoveredFlavors or {}
				for id, info in pairs(t.DiscoveredFlavors) do
					local key = tostring(id)
					if type(info) == "table" then
						data.DiscoveredFlavors[key] = info
						FlavorDiscoveryStore[key] = info
					elseif info == true then
						local e = { name = key, r = 1, g = 1, b = 1, t = 0 }
						data.DiscoveredFlavors[key] = e
						FlavorDiscoveryStore[key] = e
					end
				end
			end
			if type(t.GlassFridge) == "table" then
				for i = #GlassFridge, 1, -1 do GlassFridge[i] = nil end
				for _, e in ipairs(t.GlassFridge) do
					if type(e) == "table" and (e.id or e.name) then
						table.insert(GlassFridge, {
							id = tostring(e.id or "plain"),
							name = tostring(e.name or "Milk"),
							r = tonumber(e.r) or 1,
							g = tonumber(e.g) or 1,
							b = tonumber(e.b) or 1,
							heated = e.heated == true,
							left = e.left, right = e.right,
							sizeScale = tonumber(e.sizeScale) or 1,
						})
					end
				end
				data.GlassFridge = GlassFridge
				pcall(function()
					if SyncMorphUI and SyncMorphUI.RefreshGlassFridge then
						SyncMorphUI.RefreshGlassFridge()
					end
				end)
			end
			if t.SlowApplyEnabled ~= nil then data.SlowApplyEnabled = t.SlowApplyEnabled == true end
			if t.SlowApplyRate ~= nil then data.SlowApplyRate = tonumber(t.SlowApplyRate) or 10 end
			if t.JigglePhysicsMaster ~= nil then data.JigglePhysicsMaster = t.JigglePhysicsMaster ~= false end
			data.RealisticMovement = t.RealisticMovement == true
			data.AutoApplyOnSpawn = t.AutoApplyOnSpawn == true
			data.AutoApplyDelay = math.clamp(tonumber(t.AutoApplyDelay) or 5, 0.1, 30)
			
			PhysicsSettings.BreastPosMult = tonumber(t.BreastPosPhys) or tonumber(t.PosPhys) or 10
			PhysicsSettings.BreastRotMult = tonumber(t.BreastRotPhys) or tonumber(t.RotPhys) or 1
			PhysicsSettings.ButtPosMult = tonumber(t.ButtPosPhys) or tonumber(t.PosPhys) or 10
			PhysicsSettings.ButtRotMult = tonumber(t.ButtRotPhys) or tonumber(t.RotPhys) or 1
			PhysicsSettings.PositionPhysicsMultiply = PhysicsSettings.BreastPosMult
			PhysicsSettings.RotationPhysicsMultiply = PhysicsSettings.BreastRotMult
			if t.ClothedDampingMaster ~= nil then PhysicsSettings.ClothedDampingMaster = t.ClothedDampingMaster ~= false end
			if t.ClothedBreastDampingEnabled ~= nil then PhysicsSettings.ClothedBreastDampingEnabled = t.ClothedBreastDampingEnabled ~= false end
			if t.ClothedCheekDampingEnabled ~= nil then PhysicsSettings.ClothedCheekDampingEnabled = t.ClothedCheekDampingEnabled ~= false end
			if t.ClothedBreastJiggleScale ~= nil then PhysicsSettings.ClothedBreastJiggleScale = math.clamp(tonumber(t.ClothedBreastJiggleScale) or (1/1.5), 0.2, 1) end
			if t.ClothedCheekJiggleScale ~= nil then PhysicsSettings.ClothedCheekJiggleScale = math.clamp(tonumber(t.ClothedCheekJiggleScale) or (1/1.5), 0.2, 1) end
			App.MasterSFXMute = t.MasterSFXMute == true
			if t.BloodEffectsEnabled ~= nil then
				bloodSetEnabled(t.BloodEffectsEnabled == true)
			end
			if t.BloodIntensity ~= nil then
				BloodSystem.Intensity = math.clamp(tonumber(t.BloodIntensity) or 0.5, 0, 1)
				if PlayerData[Player.Name] then PlayerData[Player.Name].BloodIntensity = BloodSystem.Intensity end
				if SliderRefs and SliderRefs.BloodIntensity then pcall(function() SliderRefs.BloodIntensity(BloodSystem.Intensity) end) end
			end
			if t.HeartSFXEnabled ~= nil then
				HeartSFX.Enabled = t.HeartSFXEnabled == true
				if not HeartSFX.Enabled then
					pcall(stopHeartSound)
				end
			end
			if t.HeartBaseVolume ~= nil then
				HeartSFX.BaseVolume = math.clamp(tonumber(t.HeartBaseVolume) or 0.25, 0, 2)
			end
			if t.HeartBasePitch ~= nil then
				HeartSFX.BasePitch = math.clamp(tonumber(t.HeartBasePitch) or 1, 0.5, 1.75)
			end
			if t.HeartMaxVolume ~= nil then
				HeartSFX.MaxVolume = math.clamp(tonumber(t.HeartMaxVolume) or 2, 0.05, 2)
			end
			if t.HeartMaxPitch ~= nil then
				HeartSFX.MaxPitch = math.clamp(tonumber(t.HeartMaxPitch) or 1.75, 0.5, 1.75)
			end
			if SliderRefs and SliderRefs.HeartBaseVolume then
				pcall(function() SliderRefs.HeartBaseVolume(HeartSFX.BaseVolume) end)
			end
			if SliderRefs and SliderRefs.HeartBasePitch then
				pcall(function() SliderRefs.HeartBasePitch(HeartSFX.BasePitch) end)
			end
			
			data.JiggleMeterEnabled = t.JiggleMeterEnabled == true
			JiggleMeter.Sensitivity = tonumber(t.JiggleSens) or 1
			JiggleMeter.DecayRate = tonumber(t.JiggleDecay) or 0.22
			JiggleMeter.MuteSounds = t.JiggleMute == true
			if data.JiggleMeterEnabled then
				if not JiggleMeter.Gui then createJiggleMeterUI() end
				if JiggleMeter.Gui then JiggleMeter.Gui.Enabled = true end
			elseif JiggleMeter.Gui and not MilkMeter.Enabled then
				JiggleMeter.Gui.Enabled = false
			end
			
			BlushSystem.Enabled = t.BlushEnabled == true
			BlushSystem.VelocityMode = t.BlushVelocityMode == true
			BlushSystem.Duration = math.clamp(tonumber(t.BlushDuration) or 5, 0.5, 60)
			if t.BlushVelocitySpike ~= nil then BlushSystem.VelocitySpike = tonumber(t.BlushVelocitySpike) or 1.65 end
			if not BlushSystem.Enabled then
				clearBlushGlow()
				BlushSystem.Until = 0
			end
			if type(t.HoldBreastKey) == "string" and Enum.KeyCode[t.HoldBreastKey] then
				HoldBreast.Key = Enum.KeyCode[t.HoldBreastKey]
			end
			if t.HoldBreastJiggleScale ~= nil then HoldBreast.JiggleScale = tonumber(t.HoldBreastJiggleScale) or 0.08 end
			setHoldBreastEnabled(t.HoldBreastEnabled == true)
			setHoldBreastButtonVisible(t.HoldBreastShowButton == true)
			if t.HoldCheekEnabled ~= nil then
				setHoldCheekEnabled(t.HoldCheekEnabled == true)
			end
			if t.HoldCheekShowButton ~= nil then
				setHoldCheekButtonVisible(t.HoldCheekShowButton == true)
			end
			if t.CensorOverlayEnabled ~= nil then
				CensorOverlay.Enabled = t.CensorOverlayEnabled == true
				if not CensorOverlay.Enabled then pcall(hideCensorOverlay) end
			end
			if t.HoldCheekJiggleScale ~= nil then
				HoldCheek.JiggleScale = math.clamp(tonumber(t.HoldCheekJiggleScale) or 0.08, 0, 1)
			end
			if type(t.HoldCheekKey) == "string" and t.HoldCheekKey ~= "" then
				pcall(function()
					HoldCheek.Key = Enum.KeyCode[t.HoldCheekKey] or HoldCheek.Key
				end)
			end
			if t.JiggleSpikeThreshold ~= nil then
				JiggleMeter.SpikeThreshold = tonumber(t.JiggleSpikeThreshold) or 3.45
				JiggleMeter.MinSpikeVel = tonumber(t.JiggleMinSpikeVel) or (JiggleMeter.SpikeThreshold * 0.78)
			end
			if t.BounceBreastSpike ~= nil then
				BounceSFX.BreastSpike = tonumber(t.BounceBreastSpike) or 1.65
				BounceSFX.BreastMinVel = BounceSFX.BreastSpike * 1.18
			end
			if t.BounceButtSpike ~= nil then
				BounceSFX.ButtSpike = tonumber(t.BounceButtSpike) or 1.35
