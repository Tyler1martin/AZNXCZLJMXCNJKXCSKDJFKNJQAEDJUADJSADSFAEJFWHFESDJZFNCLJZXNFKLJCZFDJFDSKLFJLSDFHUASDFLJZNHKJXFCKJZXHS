			if MilkMeter.TrackR then MilkMeter.TrackR.Visible = false end
			if MilkMeter.SwellTrackL then MilkMeter.SwellTrackL.Visible = false end
			if MilkMeter.SwellTrackR then MilkMeter.SwellTrackR.Visible = false end
			if MilkMeter.WarnLabel then MilkMeter.WarnLabel.Visible = false end
			if MilkMeter.PauseBtn then MilkMeter.PauseBtn.Visible = false end
			-- Do NOT clearMilkEmitters() here — that also clears StreamDroplets and
			-- would destroy squirt particles while milk meter is off.
			-- Only stop nipple particle emitters / milk sound, keep droplet list.
			for att, pe in pairs(MilkMeter.Emitters) do
				if pe then pcall(function() pe:Destroy() end) end
				if att and att.Parent then pcall(function() att:Destroy() end) end
				MilkMeter.Emitters[att] = nil
			end
			if MilkMeter.StreamSound and (not HeatMeter or HeatMeter.SquirtState == "idle") then
				pcall(function() MilkMeter.StreamSound:Stop() end)
			end
			setMilkGlow(false, false)
			-- Heat / glass / squirt still run without milk meter
			pcall(function() stepMilkStream(dt) end)
			pcall(function() updateHeatAndGlass(dt) end)
			pcall(function() updateBreathSound() end)
			return
		end

		if not MilkMeter.TrackL then
			if not JiggleMeter.Gui then createJiggleMeterUI() end
		end
		if JiggleMeter.Gui then JiggleMeter.Gui.Enabled = true end
		if MilkMeter.TrackL then MilkMeter.TrackL.Visible = true end
		if MilkMeter.TrackR then MilkMeter.TrackR.Visible = true end
		if MilkMeter.PauseBtn then
			MilkMeter.PauseBtn.Visible = true
			MilkMeter.PauseBtn.Text = MilkMeter.Paused and "Resume" or "Pause"
		end
		if MilkMeter.WarnLabel then MilkMeter.WarnLabel.Visible = true end
		local showSwell = MilkMeter.SwellEnabled
		if MilkMeter.SwellTrackL then MilkMeter.SwellTrackL.Visible = showSwell end
		if MilkMeter.SwellTrackR then MilkMeter.SwellTrackR.Visible = showSwell end

		local clothed = data.UVToggle == true
		local canDeplete = ((not clothed) or MilkMeter.WorkClothed) and not MilkMeter.Paused
		local now = os.clock()
		local onCdL = now < (MilkMeter.CooldownUntilL or 0)
		local onCdR = now < (MilkMeter.CooldownUntilR or 0)
		local target = MilkMeter.TargetBreast or "both"
		local doL = (target == "both" or target == "left")
		local doR = (target == "both" or target == "right")

		local cap = getMilkCapacity()
		-- Off cooldown: grant 20% of capacity on that side
		if MilkMeter.WasOnCooldownL and not onCdL then
			MilkMeter.FillL = math.max(MilkMeter.FillL or 0, 0.20 * cap)
			MilkMeter.CooldownLatchedL = false
			MilkMeter.DepleteAccL = 0
		end
		if MilkMeter.WasOnCooldownR and not onCdR then
			MilkMeter.FillR = math.max(MilkMeter.FillR or 0, 0.20 * cap)
			MilkMeter.CooldownLatchedR = false
			MilkMeter.DepleteAccR = 0
		end
		-- Clamp to current capacity (breast scale)
		MilkMeter.FillL = math.clamp(MilkMeter.FillL or 0, 0, cap)
		MilkMeter.FillR = math.clamp(MilkMeter.FillR or 0, 0, cap)
		MilkMeter.WasOnCooldownL = onCdL
		MilkMeter.WasOnCooldownR = onCdR

		-- Jiggle decay refill: split across sides that are actually able to stream
		if not MilkMeter.AlwaysFull then
			local jFill = JiggleMeter.Fill or 0
			local prev = MilkMeter.LastJiggleFill
			if prev == nil then prev = jFill end
			local decayed = prev - jFill
			if decayed > 0.0005 then
				local decayRate = math.max(JiggleMeter.DecayRate or 0.22, 0.05)
				local speedFactor = math.clamp(0.22 / decayRate, 0.35, 2.5)
				local milkGain = (decayed / 0.05) * 0.015 * speedFactor
				local receivers = 0
				local recvL = doL and not onCdL and (MilkMeter.FillL or 0) > 0
				local recvR = doR and not onCdR and (MilkMeter.FillR or 0) > 0
				if recvL then receivers = receivers + 1 end
				if recvR then receivers = receivers + 1 end
				if receivers > 0 then
					local share = milkGain / receivers
					if recvL then
						MilkMeter.FillL = math.clamp((MilkMeter.FillL or 0) + share, 0, cap)
					end
					if recvR then
						MilkMeter.FillR = math.clamp((MilkMeter.FillR or 0) + share, 0, cap)
					end
				end
			end
			MilkMeter.LastJiggleFill = jFill
		else
			MilkMeter.LastJiggleFill = JiggleMeter.Fill or 0
		end

		if MilkMeter.AlwaysFull then
			MilkMeter.FillL, MilkMeter.FillR = cap, cap
			onCdL, onCdR = false, false
			MilkMeter.CooldownUntilL, MilkMeter.CooldownUntilR = 0, 0
			MilkMeter.CooldownLatchedL, MilkMeter.CooldownLatchedR = false, false
		elseif canDeplete then
			-- Explicit L/R deplete so one side on CD never blocks the other
			local function tickSide(isLeft)
				local fill = isLeft and (MilkMeter.FillL or 0) or (MilkMeter.FillR or 0)
				local acc = isLeft and (MilkMeter.DepleteAccL or 0) or (MilkMeter.DepleteAccR or 0)
				local onCd = isLeft and onCdL or onCdR
				local latch = isLeft and MilkMeter.CooldownLatchedL or MilkMeter.CooldownLatchedR
				local targeted = isLeft and doL or doR

				if not targeted then return end
				if onCd then return end

				-- Stuck empty with latch but CD expired: soft recover
				if fill <= 0 and latch then
					fill = 0.20
					latch = false
					acc = 0
					if isLeft then
						MilkMeter.FillL, MilkMeter.CooldownLatchedL, MilkMeter.DepleteAccL = fill, latch, acc
					else
						MilkMeter.FillR, MilkMeter.CooldownLatchedR, MilkMeter.DepleteAccR = fill, latch, acc
					end
					return
				end
				if fill <= 0 then return end

				acc = acc + dt
				while acc >= 0.25 and fill > 0 do
					acc = acc - 0.25
					fill = math.max(0, fill - 0.02)
				end

				if fill <= 0 then
					fill = 0
					if not latch then
						latch = true
						if isLeft then
							MilkMeter.CooldownUntilL = os.clock() + 10
							onCdL = true
						else
							MilkMeter.CooldownUntilR = os.clock() + 10
							onCdR = true
						end
					end
				else
					latch = false
				end

				if isLeft then
					MilkMeter.FillL = fill
					MilkMeter.DepleteAccL = acc
					MilkMeter.CooldownLatchedL = latch
				else
					MilkMeter.FillR = fill
					MilkMeter.DepleteAccR = acc
					MilkMeter.CooldownLatchedR = latch
				end
			end
			tickSide(true)
			tickSide(false)
		end

		local fillL = math.clamp(MilkMeter.FillL or 0, 0, cap)
		local fillR = math.clamp(MilkMeter.FillR or 0, 0, cap)
		local fill = math.min(fillL, fillR) -- for glow/compat

		-- Swell per side only while that side is depleting
		local intensity = math.clamp((MilkMeter.SwellIntensity or 1) * (MilkMeter._HeatSwellBoost or 1), 0, 5)
		local function swellSide(side, depleting)
			local sk = side == "left" and "SwellL" or "SwellR"
			local ak = side == "left" and "SwellAccL" or "SwellAccR"
			local fk = side == "left" and "FillL" or "FillR"
			local cdk = side == "left" and "CooldownUntilL" or "CooldownUntilR"
			if depleting and MilkMeter.SwellEnabled and not MilkMeter.AlwaysFull and not MilkMeter.Paused then
				local pressure = (MilkMeter.TargetBreast ~= "both") and 2 or 1
				MilkMeter[ak] = (MilkMeter[ak] or 0) + dt
				while MilkMeter[ak] >= 2 do
					MilkMeter[ak] = MilkMeter[ak] - 2
					MilkMeter[sk] = math.clamp((MilkMeter[sk] or 0) + 0.02 * intensity * pressure, 0, 1)
				end
				if (MilkMeter[sk] or 0) >= 1 then
					MilkMeter[sk] = 0
					MilkMeter[ak] = 0
					MilkMeter[fk] = 0
					MilkMeter[cdk] = os.clock() + 10
					if side == "left" then
						MilkMeter.CooldownLatchedL = true
						onCdL = true
						fillL = 0
					else
						MilkMeter.CooldownLatchedR = true
						onCdR = true
						fillR = 0
					end
					MilkMeter.DebuffUntil = os.clock() + 15
				end
			else
				MilkMeter[sk] = math.max(0, (MilkMeter[sk] or 0) - dt * 0.08)
				MilkMeter[ak] = 0
			end
		end
		local depL = doL and canDeplete and not onCdL and fillL > 0
		local depR = doR and canDeplete and not onCdR and fillR > 0
		swellSide("left", depL)
		swellSide("right", depR)

		-- Visual swell scale (per side)
		do
			local char = Player.Character
			if data and char and data.CurrentPartList and data.CurrentPartList.BodyPartPhysics then
				for Part, Property in pairs(data.CurrentPartList.BodyPartPhysics) do
					if Part and Part.Parent and Property.Size then
						local n = Part.Name:lower()
						if n:find("breast") or n:find("boob") then
							local isL = n:find("left") or (n:find("l") and not n:find("r"))
							local isR = n:find("right") or (n:find("r") and not n:find("l"))
							local sw = 0
							if isL then sw = MilkMeter.SwellL or 0
							elseif isR then sw = MilkMeter.SwellR or 0
							else sw = math.max(MilkMeter.SwellL or 0, MilkMeter.SwellR or 0)
							end
							if sw > 0 then
								local s = 1 + sw * 0.35
								Part.Size = Property.Size * s
							end
						end
					end
				end
			end
		end

		-- Particles: only sides that are depleting
		local amt = math.clamp(MilkMeter.ParticleAmount or 0.7, 0, 5)
		-- particles per second per side (steady stream)
		local rateBase = 22 * amt
		local rL = depL and rateBase or 0
		local rR = depR and rateBase or 0
		if target ~= "both" then
			if depL then rL = rateBase * 2 end
			if depR then rR = rateBase * 2 end
		end
		setMilkParticleRate(rL, rR, dt)
		ensureMilkSound(rL > 0 or rR > 0)

		-- UI fills (milk % is absolute vs size-1 baseline; bar is fill/capacity)
		local function setMilkBar(fillBar, pctLabel, absoluteFill)
			local frac = cap > 1e-4 and math.clamp(absoluteFill / cap, 0, 1) or 0
			if fillBar then
				fillBar.Size = UDim2.new(frac, -6 * frac, 1, -6)
			end
			if pctLabel then
				pctLabel.Text = string.format("%d%%", math.floor(absoluteFill * 100 + 0.5))
			end
		end
		local function setBar(fillBar, pctLabel, track, v)
			if fillBar then
				fillBar.Size = UDim2.new(v, -6 * v, 1, -6)
			end
			if pctLabel then
				pctLabel.Text = string.format("%d%%", math.floor(v * 100 + 0.5))
			end
		end
		setMilkBar(MilkMeter.FillBarL, MilkMeter.PctLabelL, fillL)
		setMilkBar(MilkMeter.FillBarR, MilkMeter.PctLabelR, fillR)
		setBar(MilkMeter.SwellFillL, MilkMeter.SwellPctL, MilkMeter.SwellTrackL, math.clamp(MilkMeter.SwellL or 0, 0, 1))
		setBar(MilkMeter.SwellFillR, MilkMeter.SwellPctR, MilkMeter.SwellTrackR, math.clamp(MilkMeter.SwellR or 0, 0, 1))

		if MilkMeter.WarnLabel then
			if MilkMeter.Paused then
				MilkMeter.WarnLabel.Text = "Paused — recovering"
				MilkMeter.WarnLabel.TextColor3 = Color3.fromRGB(120, 255, 180)
			elseif onCdL and onCdR then
				MilkMeter.WarnLabel.Text = "Both breasts on cooldown"
				MilkMeter.WarnLabel.TextColor3 = Color3.fromRGB(255, 100, 120)
			elseif onCdL then
				MilkMeter.WarnLabel.Text = "Left breast on cooldown"
				MilkMeter.WarnLabel.TextColor3 = Color3.fromRGB(255, 100, 120)
			elseif onCdR then
				MilkMeter.WarnLabel.Text = "Right breast on cooldown"
				MilkMeter.WarnLabel.TextColor3 = Color3.fromRGB(255, 100, 120)
			elseif (doL and fillL > 0 and fillL <= 0.2) or (doR and fillR > 0 and fillR <= 0.2) then
				MilkMeter.WarnLabel.Text = "Warning: low on milk"
				MilkMeter.WarnLabel.TextColor3 = Color3.fromRGB(255, 180, 80)
			else
				MilkMeter.WarnLabel.Text = ""
			end
		end

		-- pink cooldown tint per breast
		do
			local char = Player.Character
			local function sideOfName(n)
				n = (n or ""):lower()
				if n:find("left") or n:find("nipplel") or n:find("nipple.1") then return "left" end
				if n:find("right") or n:find("nippler") then return "right" end
				if n:find("l") and not n:find("r") then return "left" end
				if n:find("r") and not n:find("l") then return "right" end
				return "both"
			end
			local function shouldPink(n)
				local s = sideOfName(n)
				if s == "left" then return onCdL end
				if s == "right" then return onCdR end
				return onCdL or onCdR
			end
			local torso = char and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
			local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
			local pink = Color3.new(
				math.clamp(skin.R * 0.75 + 0.42, 0, 1),
				math.clamp(skin.G * 0.45 + 0.18, 0, 1),
				math.clamp(skin.B * 0.50 + 0.22, 0, 1)
			)
			-- Cache only — no Morph GetDescendants
			if not data.RainbowAreola then
				local cpl = data.CurrentPartList
				if cpl then
					for Decal, host in pairs(cpl.AreolaDecal or {}) do
						if Decal and Decal.Parent then
							local hostName = (host and host.Name) or (Decal.Parent and Decal.Parent.Name) or ""
							if shouldPink(hostName) then
								Decal.Color3 = pink
							else
								local r = Decal:GetAttribute("BaseColorR")
								if r then
									Decal.Color3 = Color3.new(r, Decal:GetAttribute("BaseColorG"), Decal:GetAttribute("BaseColorB"))
								else
									Decal.Color3 = Function.DarkenColor(skin, 0.32)
								end
							end
						end
					end
					for part, _ in pairs(cpl.NippleParts or {}) do
						if part and part.Parent then
							if not part:GetAttribute("MilkBaseR") then
								part:SetAttribute("MilkBaseR", part.Color.R)
								part:SetAttribute("MilkBaseG", part.Color.G)
								part:SetAttribute("MilkBaseB", part.Color.B)
							end
							if shouldPink(part.Name) then
								part.Color = pink
							else
								part.Color = Color3.new(part:GetAttribute("MilkBaseR"), part:GetAttribute("MilkBaseG"), part:GetAttribute("MilkBaseB"))
							end
						else
							cpl.NippleParts[part] = nil
						end
					end
				end
			end
		end

		-- Soft inward milk glow (white while active, gray when swollen/cooldown)
		do
			local swollen = onCdL or onCdR or (MilkMeter.SwellL or 0) > 0.55 or (MilkMeter.SwellR or 0) > 0.55
				or os.clock() < (MilkMeter.DebuffUntil or 0)
			local glowOn = MilkMeter.Enabled and not MilkMeter.Paused and not MilkMeter.AlwaysFull
				and ((fillL or 0) > 0 or (fillR or 0) > 0 or swollen)
			setMilkGlow(glowOn, swollen)
		end

		-- Clothing buildup droplet simulation
		pcall(function() stepMilkStream(dt) end)
		pcall(function() updateHeatAndGlass(dt) end)
		pcall(function() updateBreathSound() end)

		-- Walk speed throttled (was every Heartbeat)
		MilkMeter._moveAcc = (MilkMeter._moveAcc or 0) + (dt or 0)
		if MilkMeter._moveAcc >= 0.2 then
			MilkMeter._moveAcc = 0
			if Player.Character then
				Function.ApplyRealisticMovement(Player.Character, Player.Name)
			end
		end
	end

	-- Rainbow: same path as color slider. Interval from RainbowInterval (default 0.05s).
	local rainbowAcc = 0
	trackConn(RunService.Heartbeat:Connect(function(dt)
		if not SystemActive then return end
		updateMilkMeter(dt)
		local data = PlayerData[Player.Name]
		if not data or not data.RainbowAreola then
			rainbowAcc = 0
			return
		end
		rainbowAcc = rainbowAcc + dt
		local interval = tonumber(data.RainbowInterval) or 0.05
		if interval < 0.016 then interval = 0.016 end -- cap ~60fps
		if rainbowAcc < interval then return end
		rainbowAcc = 0
		-- Cycle speed scales with interval so hue still sweeps full range over time
		local speed = 0.35 * (0.05 / interval)
		local col = Color3.fromHSV((os.clock() * math.max(speed, 0.1)) % 1, 0.9, 1)
		data.NippleAreolaColor = col
		data.NippleAreolaColorL = col
		data.NippleAreolaColorR = col
		if Player.Character then
			Function.ApplyNippleAreolaColors(Player.Character, Player.Name)
		end
	end))

	-- FP: only force Areola Decal.LocalTransparencyModifier (not parent parts / full morph scan).
	-- Decals get their own LTM from the camera; hosts are already visible with custom FP body.
	local function forceAreolaDecalsVisible()
		local data = PlayerData[Player.Name]
		if not data or not data.CurrentPartList or not data.CurrentPartList.AreolaDecal then return end
		for Decal, _ in pairs(data.CurrentPartList.AreolaDecal) do
			if Decal and Decal.Parent then
				Decal.Transparency = 0
				pcall(function()
					Decal.LocalTransparencyModifier = 0
				end)
			end
		end
	end

	pcall(function()
		RunService:UnbindFromRenderStep("MorphAreolaFPVisible")
	end)
	-- Only force areola decals. Body LTM is handled once on FP state change
	-- in HeadOrbitFP.Conn (fpApplyVisibility). Calling it every frame here
	-- was a major lag source with custom torso + legs.
		RunService:BindToRenderStep("MorphAreolaFPVisible", Enum.RenderPriority.Last.Value, function()
		if not SystemActive then return end
		-- External ForceFP or close camera — only areolas (body LTM handled by optimizer on state change)
		if isFirstPersonLocal() then
			forceAreolaDecalsVisible()
		end
	end)

	-- ============================================================
	-- FP render optimizer (torso + legs stay VISIBLE, but cheaper)
	-- Causes of FP lag: camera inside high-poly torso stack, DoubleSided UV
	-- overdraw, morph shadows, invisible layers still in the draw list.
	-- ============================================================
	local fpMorphOpt = {
		WasFP = false,
		Saved = {}, -- [BasePart] = { DoubleSided, CastShadow }
	}
	-- Smart cache cleaner: call on every reset / re-apply so mode-switching
	-- does not accumulate dead MeshParts, physics keys, FP opt state, or droplets.
	MorphLoadState.PostResetClean = function()
		table.clear(fpMorphOpt.Saved)
		fpMorphOpt.WasFP = false
		pcall(function()
			if SoftWorldImpulses then table.clear(SoftWorldImpulses) end
		end)

		-- Drop milk/squirt droplet parts left in camera/workspace
		pcall(function()
			if clearMilkStream then clearMilkStream() end
		end)

		local char = Player.Character
		if char then
			-- Extra Morph folders from raced applies
			local morphs = {}
			for _, c in ipairs(char:GetChildren()) do
				if c.Name == "Morph" then
					table.insert(morphs, c)
				end
			end
			-- Keep newest Morph only
			if #morphs > 1 then
				table.sort(morphs, function(a, b)
					return (a:GetAttribute("MorphGen") or 0) < (b:GetAttribute("MorphGen") or 0)
				end)
				for i = 1, #morphs - 1 do
					pcall(function() morphs[i]:Destroy() end)
				end
			end
		end

		for _, pd in pairs(PlayerData) do
			if type(pd) ~= "table" then continue end
			pd.deferredWelds = pd.deferredWelds or {}
			-- Do NOT wipe deferredWelds here. Layered meshes (butt UV/skin, torso UV)
			-- often still wait on CreateMeshPartAsync parents; wiping caused missing
			-- UV/skin until reload. CharacterReset already clears deferred on re-apply.
			pd.ClothWrap = nil

			local cpl = pd.CurrentPartList
			if not cpl then continue end

			local function pruneMap(map)
				if type(map) ~= "table" then return end
				for k, v in pairs(map) do
					local inst = (typeof(k) == "Instance" and k) or (typeof(v) == "Instance" and v) or nil
					if inst and not inst.Parent then
						map[k] = nil
					elseif typeof(k) == "Instance" and not k.Parent then
						map[k] = nil
					end
				end
			end

			pruneMap(cpl.BodyPartPhysics)
			pruneMap(cpl.AreolaDecal)
			pruneMap(cpl.NippleParts)
			if cpl.RealtimeUpdateList then
				pruneMap(cpl.RealtimeUpdateList.Mesh)
				pruneMap(cpl.RealtimeUpdateList.Accessory)
			end
			-- Organ / Accessory / Clothes are arrays of Instances
			for _, listName in ipairs({"Organ", "Accessory", "Clothes"}) do
				local list = cpl[listName]
				if type(list) == "table" then
					for i = #list, 1, -1 do
						local v = list[i]
						if typeof(v) == "Instance" and not v.Parent then
							table.remove(list, i)
						elseif type(v) == "table" then
							-- skip non-instance entries
						end
					end
					-- also clear by pairs for dict-style inserts
					for k, v in pairs(list) do
						if typeof(v) == "Instance" and not v.Parent then
							list[k] = nil
						elseif typeof(k) == "Instance" and not k.Parent then
							list[k] = nil
						end
					end
				end
			end
		end

		-- Milk emitters map can hold destroyed attachments
		if MilkMeter and MilkMeter.Emitters then
			for att, pe in pairs(MilkMeter.Emitters) do
				if (att and not att.Parent) or (pe and not pe.Parent) then
					pcall(function() if pe then pe:Destroy() end end)
					pcall(function() if att then att:Destroy() end end)
					MilkMeter.Emitters[att] = nil
				end
			end
		end
	end

	MorphLoadState.SmartCacheClean = MorphLoadState.PostResetClean

	local function isTorsoOrLegMorphName(n)
		n = string.lower(n or "")
		if n:find("breast") or n:find("boob") or n:find("butt") or n:find("ass")
			or n:find("nipple") or n:find("areola") then
			return false
		end
		return n:find("torso") or n:find("leg") or n:find("arm")
			or n:find("shirt") or n:find("pant") or n:find("uv") or n:find("texture")
			or n:find("mesh")
	end

	local function setFPMorphOptimize(enable)
		local char = Player.Character
		local morph = char and char:FindFirstChild("Morph")
		if not morph then return end

		if enable then
			-- Optimize ALL morph BaseParts when camera is inside the body (not just torso/legs).
			-- Main remaining FP cost is GPU fill-rate from stacked MeshParts + DoubleSided + shadows.
			for _, d in ipairs(morph:GetDescendants()) do
				if not d:IsA("BasePart") then continue end

				local n = string.lower(d.Name or "")
				local isSoft = n:find("breast") or n:find("boob") or n:find("butt")
