		tool:SetAttribute("GlassSlot", slot)
		tool:SetAttribute("MilkFilled", true)
		tool:SetAttribute("MilkHeated", false)
		tool:SetAttribute("MilkHoldAcc", 5)
		tool:SetAttribute("FlavorId", entry.id)
		tool:SetAttribute("FlavorName", entry.name)
		tool:SetAttribute("FlavorR", entry.r)
		tool:SetAttribute("FlavorG", entry.g)
		tool:SetAttribute("FlavorB", entry.b)
		tool:SetAttribute("FlavorHeated", false)
		if entry.left then tool:SetAttribute("FlavorLeft", tostring(entry.left)) end
		if entry.right then tool:SetAttribute("FlavorRight", tostring(entry.right)) end
		local handle = Instance.new("Part")
