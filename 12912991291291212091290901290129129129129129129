	local function setFlavorDrinkGlow(color, untilTime)
		JiggleMeter._FlavorGlowColor = (typeof(color) == "Color3") and color or Color3.fromRGB(255, 200, 220)
		JiggleMeter._FlavorGlowUntil = untilTime or 0
		JiggleMeter._FlavorGlowActive = (untilTime or 0) > os.clock()
	end

	local function stepFlavorDrinkGlow()
		local flash = JiggleMeter.FlashFrame
		if not flash then return end
		local untilT = JiggleMeter._FlavorGlowUntil or 0
		if untilT <= os.clock() then
			if JiggleMeter._FlavorGlowActive then
				JiggleMeter._FlavorGlowActive = false
			end
			return
		end
		if os.clock() < (JiggleMeter.PinkFlashUntil or 0) then return end
		if JiggleMeter._MilkGlowActive then return end
		local col = JiggleMeter._FlavorGlowColor or Color3.fromRGB(255, 200, 220)
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 3.2)
		local centerT = math.clamp(0.82 - pulse * 0.08, 0.7, 0.92)
		local edgeT = math.clamp(0.7 - pulse * 0.1, 0.55, 0.88)
		flash.BackgroundColor3 = col
		flash.BackgroundTransparency = centerT
		for _, child in ipairs(flash:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = col
				child.BackgroundTransparency = edgeT
			end
		end
		JiggleMeter._FlavorGlowActive = true
	end

	local function playPinkFlash(intensity, duration)
		-- intensity 0-1 (higher = brighter), duration seconds — always pink (jiggle boost / super)
		local flash = JiggleMeter.FlashFrame
		if not flash then return end
		local TweenService = game:GetService("TweenService")
		local pink = Color3.fromRGB(255, 105, 180)
		JiggleMeter.PinkFlashUntil = os.clock() + (duration or 0.8) + 0.05
		local centerT = math.clamp(1 - (0.04 + intensity * 0.22), 0.55, 0.97)
		local edgeT = math.clamp(1 - (0.1 + intensity * 0.28), 0.4, 0.95)
		flash.BackgroundColor3 = pink
		flash.BackgroundTransparency = centerT
		for _, child in ipairs(flash:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = pink
				child.BackgroundTransparency = edgeT
			end
		end
		task.spawn(function()
			task.wait(duration * 0.5)
			local tInfo = TweenInfo.new(duration * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(flash, tInfo, {BackgroundTransparency = 1}):Play()
			for _, child in ipairs(flash:GetChildren()) do
				if child:IsA("Frame") then
					TweenService:Create(child, tInfo, {BackgroundTransparency = 1}):Play()
				end
			end
		end)
	end

	-- Heat glow: red-pink inward glow, weaker than milk, scales with heat fill
	local function setHeatGlow(active, heatFill)
		local flash = JiggleMeter.FlashFrame
		if not flash then return end
		if os.clock() < (JiggleMeter.PinkFlashUntil or 0) then
			return -- jiggle flash wins
		end
		if JiggleMeter._FlavorGlowActive and os.clock() < (JiggleMeter._FlavorGlowUntil or 0) then
			return -- flavor drink glow
		end
		if JiggleMeter._MilkGlowActive then
			return -- milk glow takes priority when streaming
		end
		if not active or not heatFill or heatFill <= 0.02 then
			if JiggleMeter._HeatGlowActive then
				flash.BackgroundTransparency = 1
				for _, child in ipairs(flash:GetChildren()) do
					if child:IsA("Frame") then child.BackgroundTransparency = 1 end
				end
				JiggleMeter._HeatGlowActive = false
			end
			return
		end
		JiggleMeter._HeatGlowActive = true
		local col = Color3.fromRGB(255, 70, 105) -- red + pink tint
		local ht = math.clamp(heatFill, 0, 1)
		-- Noticeable but still under milk/jiggle flash intensity
		local centerT = 0.97 - ht * 0.08 -- ~0.97 → 0.89
		local edgeT = 0.90 - ht * 0.18 -- ~0.90 → 0.72
		flash.BackgroundColor3 = col
		flash.BackgroundTransparency = centerT
		for _, child in ipairs(flash:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = col
				child.BackgroundTransparency = edgeT
			end
		end
	end

	-- Soft milk glow (much weaker than jiggle): white while milking, gray when swollen
	local function setMilkGlow(active, swollen)
		local flash = JiggleMeter.FlashFrame
		if not flash then return end
		-- Never overwrite jiggle boost / superjiggle pink flash
		if os.clock() < (JiggleMeter.PinkFlashUntil or 0) then
			return
		end
		if not active then
			JiggleMeter._MilkGlowActive = false
			if flash.BackgroundTransparency > 0.9 then
				flash.BackgroundTransparency = 1
				for _, child in ipairs(flash:GetChildren()) do
					if child:IsA("Frame") then child.BackgroundTransparency = 1 end
				end
			end
			return
		end
		JiggleMeter._MilkGlowActive = true
		JiggleMeter._HeatGlowActive = false
		local col = swollen and Color3.fromRGB(150, 150, 155) or Color3.fromRGB(255, 255, 255)
		-- very subtle: center almost invisible, edges soft
		local centerT = swollen and 0.94 or 0.96
		local edgeT = swollen and 0.82 or 0.88
		flash.BackgroundColor3 = col
		flash.BackgroundTransparency = centerT
		for _, child in ipairs(flash:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = col
				child.BackgroundTransparency = edgeT
			end
		end
	end

	local function getMilkCapacity()
		local data = PlayerData[Player.Name]
		local scale = 1
		if data then
			scale = math.max(0.05, tonumber(data.BreastsScale) or 1)
		end
		-- Capacity scales with breast size (1.0 at default scale)
		return math.clamp(scale, 0.4, 3)
	end

	local function addMilkFromBoost(amount)
		if not MilkMeter or not MilkMeter.Enabled then return end
		if MilkMeter.AlwaysFull then return end
		local now = os.clock()
		local target = MilkMeter.TargetBreast or "both"
		local cap = getMilkCapacity()
		-- amount is a fraction of capacity (0.05 = +5% of current capacity)
		local gain = amount * cap
		if (target == "both" or target == "left") and now >= (MilkMeter.CooldownUntilL or 0) then
			MilkMeter.FillL = math.clamp((MilkMeter.FillL or 0) + gain, 0, cap)
		end
		if (target == "both" or target == "right") and now >= (MilkMeter.CooldownUntilR or 0) then
			MilkMeter.FillR = math.clamp((MilkMeter.FillR or 0) + gain, 0, cap)
		end
	end

	local function triggerJiggleTier(tier)
		ensureJiggleSounds()
		local now = os.clock()
		local muted = MasterSFXMute or JiggleMeter.MuteSounds
		if tier == 3 then
			if now < JiggleMeter.SuperCooldownUntil then
				return false
			end
			JiggleMeter.SuperCooldownUntil = now + 3
			JiggleMeter.PhysicsBoost = math.max(JiggleMeter.PhysicsBoost, 1.85)
			JiggleMeter.BoostUntil = now + 1.4
			addMilkFromBoost(0.05) -- super +5%
			if HeatMeter and HeatMeter.Enabled then HeatMeter.Fill = math.clamp((HeatMeter.Fill or 0) + 0.01, 0, 1) end
			if not muted and JiggleMeter.SoundB then
				JiggleMeter.SoundB.TimePosition = 0
				JiggleMeter.SoundB.PlaybackSpeed = 1
				JiggleMeter.SoundB.Volume = 1
				JiggleMeter.SoundB:Play()
			end
			playPinkFlash(0.55, 1 + math.random() * 1)
			return true
		elseif tier == 2 then
			JiggleMeter.PhysicsBoost = math.max(JiggleMeter.PhysicsBoost, 1.45)
			JiggleMeter.BoostUntil = now + 1.0
			addMilkFromBoost(0.03) -- 70% +3%
			if HeatMeter and HeatMeter.Enabled then HeatMeter.Fill = math.clamp((HeatMeter.Fill or 0) + 0.02, 0, 1) end
			if not muted and JiggleMeter.SoundA then
				JiggleMeter.SoundA.TimePosition = 0
				JiggleMeter.SoundA.PlaybackSpeed = 1.15
				JiggleMeter.SoundA.Volume = 0.85
				JiggleMeter.SoundA:Play()
			end
			playPinkFlash(0.14, 0.7 + math.random() * 0.3)
			return true
		elseif tier == 1 then
			JiggleMeter.PhysicsBoost = math.max(JiggleMeter.PhysicsBoost, 1.2)
			JiggleMeter.BoostUntil = now + 0.7
			addMilkFromBoost(0.02) -- normal +2%
			if HeatMeter and HeatMeter.Enabled then HeatMeter.Fill = math.clamp((HeatMeter.Fill or 0) + 0.02, 0, 1) end
			if not muted and JiggleMeter.SoundA then
				JiggleMeter.SoundA.TimePosition = 0
				JiggleMeter.SoundA.PlaybackSpeed = 1
				JiggleMeter.SoundA.Volume = 0.55
				JiggleMeter.SoundA:Play()
			end
			return true
		end
		return false
	end

	local function updateJiggleMeter(dt)
		local data = PlayerData[Player.Name]
		if JiggleMeter.ToggleBtn and JiggleMeter.ToggleBtn.Parent then
			JiggleMeter.ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
		if not data or not data.JiggleMeterEnabled then
			if JiggleMeter.Gui then JiggleMeter.Gui.Enabled = false end
			JiggleMeter.PhysicsBoost = 1
			return
		end
		if not JiggleMeter.Gui then
			createJiggleMeterUI()
		end
		JiggleMeter.Gui.Enabled = true

		-- Sample breast spring velocities
		local maxVel = 0
		local physicsList = data.CurrentPartList and data.CurrentPartList.BodyPartPhysics
		if physicsList then
			for Part, Property in pairs(physicsList) do
				if Part and Part.Parent and Property.Spring then
					local n = string.lower(Part.Name)
					if string.find(n, "breast") or string.find(n, "boob") then
						local v = Property.Spring.Velocity
						local mag = math.sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z)
						if mag > maxVel then maxVel = mag end
					end
				end
			end
		end

		-- Spike-only fill: compare to EMA baseline so steady walk does not charge the meter
		local ema = JiggleMeter.VelEMA or 0
		ema = ema * 0.90 + maxVel * 0.10
		JiggleMeter.VelEMA = ema
		local spikeAmt = maxVel - ema
		local spikeTh = JiggleMeter.SpikeThreshold or 1.15
		local minVel = JiggleMeter.MinSpikeVel or 0.9
		local sens = math.clamp(JiggleMeter.Sensitivity or 1, 0.25, 3)
		local impulse = 0
		if maxVel >= minVel and spikeAmt >= spikeTh then
			impulse = math.clamp(spikeAmt * 0.045 * sens, 0, 0.18 * sens)
		end
		JiggleMeter.Fill = math.clamp(JiggleMeter.Fill + impulse, 0, 1)
		-- Decay
		JiggleMeter.Fill = math.max(0, JiggleMeter.Fill - dt * (JiggleMeter.DecayRate or 0.22))

		local fill = JiggleMeter.Fill
		local JIGGLE_PINK = Color3.fromRGB(255, 105, 180)
		local JIGGLE_PINK_SOFT = Color3.fromRGB(255, 150, 200)

		if JiggleMeter.FillBar then
			JiggleMeter.FillBar.Size = UDim2.new(1, -8, fill, -8)
			JiggleMeter.FillBar.BackgroundColor3 = JIGGLE_PINK
		end
		if JiggleMeter.TrackStroke then
			JiggleMeter.TrackStroke.Color = Color3.fromRGB(80, 82, 86)
		end
		if JiggleMeter.PctLabel then
			JiggleMeter.PctLabel.Text = string.format("%d%%", math.floor(fill * 100 + 0.5))
			JiggleMeter.PctLabel.TextColor3 = JIGGLE_PINK_SOFT
		end

		-- Tier triggers: independent rising-edge crosses so 40% / 70% / 100% always fire
		local prevFill = JiggleMeter.PrevFill or 0
		if fill >= 0.4 and prevFill < 0.4 then
			triggerJiggleTier(1)
			JiggleMeter.LastTier = math.max(JiggleMeter.LastTier or 0, 1)
		end
		if fill >= 0.7 and prevFill < 0.7 then
			triggerJiggleTier(2)
			JiggleMeter.LastTier = math.max(JiggleMeter.LastTier or 0, 2)
		end
		if fill >= 0.98 and prevFill < 0.98 then
			if triggerJiggleTier(3) then
				JiggleMeter.LastTier = 3
			end
		end
		if fill < 0.35 then
			JiggleMeter.LastTier = 0
		end
		JiggleMeter.PrevFill = fill

		-- Rainbow label + toggle button text
		if JiggleMeter.Gui then
			local lab = JiggleMeter.Gui:FindFirstChild("Track") and JiggleMeter.Gui.Track:FindFirstChild("Label")
			if lab then
				lab.TextColor3 = Color3.fromRGB(255, 150, 200)
			end
		end
		if JiggleMeter.ToggleBtn and JiggleMeter.ToggleBtn.Parent then
			JiggleMeter.ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
