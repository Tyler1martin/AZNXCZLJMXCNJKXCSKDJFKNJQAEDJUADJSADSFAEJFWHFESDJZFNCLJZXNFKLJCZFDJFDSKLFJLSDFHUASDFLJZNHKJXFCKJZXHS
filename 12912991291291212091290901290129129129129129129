	function getMilkCapacity()
		local data = PlayerData[Player.Name]
		local scale = 1
		if data then
			scale = math.max(0.05, tonumber(data.BreastsScale) or 1)
		end
		
		return math.clamp(scale, 0.4, 3)
	end

	function addMilkFromBoost(amount)
		if not MilkMeter or not MilkMeter.Enabled then return end
		if MilkMeter.AlwaysFull then return end
		local now = os.clock()
		local target = MilkMeter.TargetBreast or "both"
		local cap = getMilkCapacity()
		
		local gain = amount * cap
		if (target == "both" or target == "left") and now >= (MilkMeter.CooldownUntilL or 0) then
			MilkMeter.FillL = math.clamp((MilkMeter.FillL or 0) + gain, 0, cap)
		end
		if (target == "both" or target == "right") and now >= (MilkMeter.CooldownUntilR or 0) then
			MilkMeter.FillR = math.clamp((MilkMeter.FillR or 0) + gain, 0, cap)
		end
	end

	function triggerJiggleTier(tier)
		ensureJiggleSounds()
		local now = os.clock()
		local muted = App.MasterSFXMute or JiggleMeter.MuteSounds
		if tier == 3 then
			if now < JiggleMeter.SuperCooldownUntil then
				return false
			end
			JiggleMeter.SuperCooldownUntil = now + 3
			JiggleMeter.PhysicsBoost = math.max(JiggleMeter.PhysicsBoost, 1.85)
			JiggleMeter.BoostUntil = now + 1.4
			addMilkFromBoost(0.05) 
			if HeatMeter and HeatMeter.Enabled then HeatMeter.Fill = math.clamp((HeatMeter.Fill or 0) + 0.01, 0, 1) end
			if not muted and JiggleMeter.SoundB then
				JiggleMeter.SoundB.TimePosition = 0
				JiggleMeter.SoundB.PlaybackSpeed = 1
				JiggleMeter.SoundB.Volume = 1
				JiggleMeter.SoundB:Play()
			end
			playPinkFlash(0.55, 1 + math.random() * 1)
			return true
		elseif tier == 2 then
			JiggleMeter.PhysicsBoost = math.max(JiggleMeter.PhysicsBoost, 1.45)
			JiggleMeter.BoostUntil = now + 1.0
			addMilkFromBoost(0.03) 
			if HeatMeter and HeatMeter.Enabled then HeatMeter.Fill = math.clamp((HeatMeter.Fill or 0) + 0.02, 0, 1) end
			if not muted and JiggleMeter.SoundA then
				JiggleMeter.SoundA.TimePosition = 0
				JiggleMeter.SoundA.PlaybackSpeed = 1.15
				JiggleMeter.SoundA.Volume = 0.85
				JiggleMeter.SoundA:Play()
			end
			playPinkFlash(0.14, 0.7 + math.random() * 0.3)
			return true
		elseif tier == 1 then
			JiggleMeter.PhysicsBoost = math.max(JiggleMeter.PhysicsBoost, 1.2)
			JiggleMeter.BoostUntil = now + 0.7
			addMilkFromBoost(0.02) 
			if HeatMeter and HeatMeter.Enabled then HeatMeter.Fill = math.clamp((HeatMeter.Fill or 0) + 0.02, 0, 1) end
			if not muted and JiggleMeter.SoundA then
				JiggleMeter.SoundA.TimePosition = 0
				JiggleMeter.SoundA.PlaybackSpeed = 1
				JiggleMeter.SoundA.Volume = 0.55
				JiggleMeter.SoundA:Play()
			end
			return true
		end
		return false
	end

	function updateJiggleMeter(dt)
		local data = PlayerData[Player.Name]
		if JiggleMeter.ToggleBtn and JiggleMeter.ToggleBtn.Parent then
			JiggleMeter.ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
		if not data or not data.JiggleMeterEnabled then
			if JiggleMeter.Gui then JiggleMeter.Gui.Enabled = false end
			JiggleMeter.PhysicsBoost = 1
			return
		end
		if not JiggleMeter.Gui then
			createJiggleMeterUI()
		end
		JiggleMeter.Gui.Enabled = true

		
		local maxVel = 0
		local physicsList = data.CurrentPartList and data.CurrentPartList.BodyPartPhysics
		if physicsList then
			for Part, Property in pairs(physicsList) do
				if Part and Part.Parent and Property.Spring then
					local n = string.lower(Part.Name)
					if string.find(n, "breast") or string.find(n, "boob") then
						local v = Property.Spring.Velocity
						local mag = math.sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z)
						if mag > maxVel then maxVel = mag end
					end
				end
			end
		end

		
		local ema = JiggleMeter.VelEMA or 0
		ema = ema * 0.90 + maxVel * 0.10
		JiggleMeter.VelEMA = ema
		local spikeAmt = maxVel - ema
		local spikeTh = JiggleMeter.SpikeThreshold or 1.15
		local minVel = JiggleMeter.MinSpikeVel or 0.9
		local sens = math.clamp(JiggleMeter.Sensitivity or 1, 0.25, 3)
		local impulse = 0
		if maxVel >= minVel and spikeAmt >= spikeTh then
			impulse = math.clamp(spikeAmt * 0.045 * sens, 0, 0.18 * sens)
		end
		JiggleMeter.Fill = math.clamp((JiggleMeter.Fill or 0) + impulse, 0, 1)
		
		if (JiggleMeter.Fill or 0) >= 0.995 then
			pcall(function()
				if Function.GrantAchievement then Function.GrantAchievement("jiggly") end
			end)
		end
		
		JiggleMeter.Fill = math.max(0, (JiggleMeter.Fill or 0) - dt * (JiggleMeter.DecayRate or 0.22))

		local fill = JiggleMeter.Fill
		local JIGGLE_PINK = Color3.fromRGB(255, 105, 180)
		local JIGGLE_PINK_SOFT = Color3.fromRGB(255, 150, 200)

		if JiggleMeter.FillBar then
			JiggleMeter.FillBar.Size = UDim2.new(1, -8, fill, -8)
			JiggleMeter.FillBar.BackgroundColor3 = JIGGLE_PINK
		end
		if JiggleMeter.TrackStroke then
			JiggleMeter.TrackStroke.Color = Color3.fromRGB(80, 82, 86)
		end
		if JiggleMeter.PctLabel then
			JiggleMeter.PctLabel.Text = string.format("%d%%", math.floor(fill * 100 + 0.5))
			JiggleMeter.PctLabel.TextColor3 = JIGGLE_PINK_SOFT
		end

		
		local prevFill = JiggleMeter.PrevFill or 0
		if fill >= 0.4 and prevFill < 0.4 then
			triggerJiggleTier(1)
			JiggleMeter.LastTier = math.max(JiggleMeter.LastTier or 0, 1)
		end
		if fill >= 0.7 and prevFill < 0.7 then
			triggerJiggleTier(2)
			JiggleMeter.LastTier = math.max(JiggleMeter.LastTier or 0, 2)
		end
		if fill >= 0.98 and prevFill < 0.98 then
			if triggerJiggleTier(3) then
				JiggleMeter.LastTier = 3
			end
		end
		if fill < 0.35 then
			JiggleMeter.LastTier = 0
		end
		JiggleMeter.PrevFill = fill

		
		if JiggleMeter.Gui then
			local lab = JiggleMeter.Gui:FindFirstChild("Track") and JiggleMeter.Gui.Track:FindFirstChild("Label")
			if lab then
				lab.TextColor3 = Color3.fromRGB(255, 150, 200)
			end
		end
		if JiggleMeter.ToggleBtn and JiggleMeter.ToggleBtn.Parent then
			JiggleMeter.ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
		if HeatMeter and HeatMeter.Enabled then
			local prevJ = HeatMeter.PrevJiggleFill or fill
			if prevJ > fill then
				local lost = prevJ - fill
				HeatMeter.Fill = math.clamp((HeatMeter.Fill or 0) + (lost / 0.10) * 0.005, 0, 1)
			end
			HeatMeter.PrevJiggleFill = fill
		end
	end

