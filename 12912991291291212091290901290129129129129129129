	function Function.FindMotorForPart(Character, Part)
		if not Part then return nil end
		
		
		local preferred = {
			["Head"] = "Neck",
			["Left Arm"] = "Left Shoulder",
			["Right Arm"] = "Right Shoulder",
			["Left Leg"] = "Left Hip",
			["Right Leg"] = "Right Hip",
		}
		local jname = preferred[Part.Name]
		if jname and Character then
			local torso = Character:FindFirstChild("Torso")
			if torso then
				local joint = torso:FindFirstChild(jname)
				if joint and joint:IsA("Motor6D") then
					if joint.Part1 == nil or joint.Part1 == Part then
						return joint
					end
				end
			end
		end
		
		if Character then
			for _, d in ipairs(Character:GetDescendants()) do
				if d:IsA("Motor6D") and d.Part1 == Part then
					
					if d.Part0 ~= Part then
						return d
					end
				end
			end
			
			for _, d in ipairs(Character:GetDescendants()) do
				if d:IsA("Motor6D") and d.Part1 == Part then
					return d
				end
			end
		end
		local m = Part:FindFirstChildOfClass("Motor6D")
		if m then return m end
		return nil
	end

	
	function Function.SoftBodyPhysics(ObjectInstance, Character, Extra, Data)
		local data = getPlayerData(Data)
		if not data or not data.BodyPartPhysics then return end
		if data.SoftBodyEnabled == false then return end
		if not Function.IsR6Character(Character) then return end
		if not ObjectInstance or not ObjectInstance.Parent then return end
		if not ObjectInstance:IsA("BasePart") then return end
		if not Function.IsSoftBodyPartName(ObjectInstance.Name) then return end

		
		if data.CurrentPartList and data.CurrentPartList.BodyPartPhysics[ObjectInstance] then
			local old = data.CurrentPartList.BodyPartPhysics[ObjectInstance]
			if type(old) == "table" and old.Weld then
				pcall(function()
					if old.CF then old.Weld.C0 = old.CF end
					if old.CF1 then old.Weld.C1 = old.CF1 end
					if old.Spring then
						old.Spring.Position = Vector3.zero
						old.Spring.Velocity = Vector3.zero
					end
				end)
			end
			data.CurrentPartList.BodyPartPhysics[ObjectInstance] = nil
		end

		local Weld = Function.FindMotorForPart(Character, ObjectInstance)
		if not Weld then
			
			local map = {
				["Head"] = "Neck",
				["Left Arm"] = "Left Shoulder",
				["Right Arm"] = "Right Shoulder",
				["Left Leg"] = "Left Hip",
				["Right Leg"] = "Right Hip",
			}
			local jn = map[ObjectInstance.Name]
			local torso = Character and Character:FindFirstChild("Torso")
			if jn and torso then
				local j = torso:FindFirstChild(jn)
				if j and j:IsA("Motor6D") then Weld = j end
			end
		end
		if not Weld then return end

		local base = Character:FindFirstChild("Torso")
		if not base then return end

		pcall(function() ObjectInstance:SetAttribute("PhysicsKind", "soft") end)

		local CF = Weld.C0
		local CF1 = Weld.C1
		local SpringInst = Spring.new(Vector3.new(0, 0, 0))
		SpringInst.Target = Vector3.new(1, 1, 1) * 3.5
		SpringInst.Velocity = Vector3.zero
		SpringInst.Speed = 9
		SpringInst.Damper = 0.35

		local pname = ObjectInstance.Name or ""
		local mirror = 1
		if pname == "Left Arm" or pname == "Left Leg" or pname:lower():find("left") then
			mirror = -1
		elseif pname == "Right Arm" or pname == "Right Leg" or pname:lower():find("right") then
			mirror = 1
		else
			mirror = 0
		end
		local isHead = (pname == "Head" or pname:lower():find("head"))
		data.CurrentPartList.BodyPartPhysics[ObjectInstance] = {
			Spring = SpringInst,
			Base = base,
			Weld = Weld,
			CF = CF,
			CF1 = CF1,
			OriginCFrame = base.CFrame,
			PositionOffset = {X = "X", Y = "Y", Z = "Z"},
			Position = {X = 0.0028, Y = 0.0032, Z = 0.0028},
			RotationOffset = {X = "X", Y = "Y", Z = "Z"},
			Rotation = {X = 1.35, Y = 1.35, Z = 1.35},
			Size = ObjectInstance.Size,
			Scale = false,
			Kind = "soft",
			AsymSide = nil,
			AsymPhase = 0,
			AsymNoise = 1,
			LastOffset = Vector3.zero,
			LastRot = Vector3.zero,
			IsRealLimb = (ObjectInstance.Parent == Character),
			SoftMirror = mirror,
			SoftHeadScale = isHead and 0.5 or 1,
		}
	end

	
	function Function.ApplySoftBody(Character, Data, enabled)
		local data = getPlayerData(Data)
		if not data or not data.CurrentPartList then return end
		local phys = data.CurrentPartList.BodyPartPhysics
		if not phys then return end

		
		data.SoftBodyToken = (data.SoftBodyToken or 0) + 1
		local mySoftToken = data.SoftBodyToken

		
		local toClear = {}
		for part, prop in pairs(phys) do
			if prop and (prop.Kind == "soft" or (typeof(part) == "Instance" and part:GetAttribute("PhysicsKind") == "soft")) then
				table.insert(toClear, part)
			end
		end
		for _, part in ipairs(toClear) do
			local prop = phys[part]
			if prop and prop.Weld then
				pcall(function()
					if prop.CF then prop.Weld.C0 = prop.CF end
					if prop.CF1 then prop.Weld.C1 = prop.CF1 end
					if prop.Spring then
						prop.Spring.Position = Vector3.zero
						prop.Spring.Velocity = Vector3.zero
					end
				end)
			end
			phys[part] = nil
			pcall(function()
				if typeof(part) == "Instance" then part:SetAttribute("PhysicsKind", nil) end
			end)
		end

		if enabled ~= true then return end
		if not Character or not Function.IsR6Character(Character) then return end
		if data.SoftBodyToken ~= mySoftToken then return end

		local Extra = { UVToggle = data.UVToggle }

		
		local morph = Character:FindFirstChild("Morph")
		if morph then
			for _, d in ipairs(morph:GetDescendants()) do
				if data.SoftBodyToken ~= mySoftToken then return end
				if d:IsA("BasePart") and Function.IsSoftBodyPartName(d.Name) then
					pcall(function()
						Function.SoftBodyPhysics(d, Character, Extra, Data)
					end)
				end
			end
		end

		
		local realNames = {"Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
		for _, name in ipairs(realNames) do
			if data.SoftBodyToken ~= mySoftToken then return end
			local part = Character:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				pcall(function()
					Function.SoftBodyPhysics(part, Character, Extra, Data)
				end)
			end
		end
	end

	function Function.CreateR6(CF)
		local R6 = Instance.new("Model")
		local R6Humanoid = Instance.new("Humanoid", R6)

		local RootPart = Instance.new("Part", R6)
		RootPart.Name = "HumanoidRootPart"
		RootPart.Size = Vector3.new(2,2,1)
		RootPart.Anchored = true
		RootPart.Transparency = 1

		R6.PrimaryPart = RootPart

		for Name, Property in pairs(R6Map) do
			local Part = Instance.new("Part", R6)
			Part.Size = Property.Size
			Part.CFrame = RootPart.CFrame * Property.Offset
			Part.Anchored = true
			Part.Name = Name

			if Name == "Head" then
				local SpecialMesh = Instance.new("SpecialMesh", Part)
				SpecialMesh.MeshType = Enum.MeshType.Head
				SpecialMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
			end
		end

		for Name, Property in pairs(R6Joints) do
			local Joint = Instance.new("Motor6D",R6[Property["Part0"]])
			Joint.Name = Name
			Joint.C0 = Property["C0"]
			Joint.C1 = Property["C1"]
			Joint.Part0 = Property["Part0"]
			Joint.Part1 = Property["Part1"]
		end

		return R6
	end

