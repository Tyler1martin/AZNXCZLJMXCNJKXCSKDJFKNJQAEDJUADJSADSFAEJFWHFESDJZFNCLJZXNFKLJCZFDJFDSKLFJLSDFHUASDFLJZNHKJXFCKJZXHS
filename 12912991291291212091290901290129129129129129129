					if p then pcall(function() p:Destroy() end) end
				end
			end
			return
		end
		local uvT = math.clamp(tonumber(data.UVTransparency) or 0, 0, 1)
		local clothed = data.UVToggle == true
		local primary = Character.PrimaryPart

		local function findClothing(className)
			local c = Character:FindFirstChildOfClass(className)
			if c then return c end
			if primary then
				c = primary:FindFirstChildOfClass(className)
				if c then return c end
			end
			return nil
		end
		local shirt = findClothing("Shirt")
		local shirtTex = (shirt and shirt.ShirtTemplate) or ""

		
		local armsScale = tonumber(data.ArmsScale) or 1
		local axis = data.ArmsAxis or {X = 1.02, Y = 0.49, Z = 1.02}
		local off = data.ArmsOffset or {X = 0, Y = 0.01, Z = 0}
		local ax = (tonumber(axis.X) or 1.02) * armsScale
		local ay = (tonumber(axis.Y) or 0.49) * armsScale
		local az = (tonumber(axis.Z) or 1.02) * armsScale
		local ox = tonumber(off.X) or 0
		local oy = tonumber(off.Y) or 0
		local oz = tonumber(off.Z) or 0
		
		local ARM_UV_SIZE_MULT = Vector3.new(1.01, 1.01, 1.01)

		
		local sides = {
			{
				armName = "Left Arm",
				solidName = "Left Arm Mesh",
				uvName = "Left Arm Mesh UV",
				fallback = "rbxassetid://11617989163",
			},
			{
				armName = "Right Arm",
				solidName = "Right Arm Mesh",
				uvName = "Right Arm Mesh UV",
				fallback = "rbxassetid://11617988681",
			},
		}

		
		local function resolveCharArm(armName)
			local p = Character:FindFirstChild(armName)
			if p then return p end
			local hum = Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.RigType == Enum.HumanoidRigType.R15 then
				local map = {
					["Left Arm"] = "LeftLowerArm",
					["Right Arm"] = "RightLowerArm",
				}
				local mapped = map[armName]
				return mapped and Character:FindFirstChild(mapped) or nil
			end
			return nil
		end

		for _, side in ipairs(sides) do
			local meshId, solidSrc = resolveArmMeshId(
				Character, morph, side.armName, side.solidName, side.fallback
			)
			local charArm = resolveCharArm(side.armName)

			
			local solid = morph and morph:FindFirstChild(side.solidName, true)
			if morph and not (solid and solid:IsA("MeshPart")) then
				solid = Instance.new("MeshPart")
				solid.Name = side.solidName
				solid.Anchored = false
				solid.CanCollide = false
				solid.Massless = true
				solid.CastShadow = true
				solid.Material = Enum.Material.SmoothPlastic
				solid.Color = charArm and charArm.Color or Color3.fromRGB(255, 204, 153)
				solid.Transparency = 0
				solid.Parent = morph
				if charArm then
					solid.Size = Vector3.new(
						charArm.Size.X * ax,
						charArm.Size.Y * ay,
						charArm.Size.Z * az
					)
					solid.CFrame = charArm.CFrame * CFrame.new(ox, oy, oz)
				else
					solid.Size = Vector3.new(1 * ax, 2 * ay, 1 * az)
				end
			end

			if solid and solid:IsA("MeshPart") then
				pcall(function()
					if solid.MeshId ~= meshId then
						solid.MeshId = meshId
					end
				end)
				
				pcall(function()
					local sa = solid:FindFirstChildOfClass("SurfaceAppearance")
					if sa then sa:Destroy() end
					solid.TextureID = ""
					solid.Transparency = 0
					solid.LocalTransparencyModifier = 0
					if charArm then
						solid.Color = charArm.Color
						solid.Size = Vector3.new(
							charArm.Size.X * ax,
							charArm.Size.Y * ay,
							charArm.Size.Z * az
						)
					end
				end)
				
				if charArm and charArm:IsA("BasePart") then
					pcall(function()
						for _, j in ipairs(solid:GetChildren()) do
							if j:IsA("WeldConstraint") or j:IsA("Weld") or j:IsA("Motor6D") then
								j:Destroy()
							end
						end
						solid.CFrame = charArm.CFrame * CFrame.new(ox, oy, oz)
						local w = Instance.new("Weld")
						w.Name = "ArmSolidWeld"
						w.Part0 = charArm
						w.Part1 = solid
						w.C0 = CFrame.new(ox, oy, oz)
						w.C1 = CFrame.new()
						w.Parent = solid
					end)
					
					charArm.Transparency = 1
					pcall(function() charArm.LocalTransparencyModifier = 0 end)
				end
			end

			
			local uv = morph and morph:FindFirstChild(side.uvName, true)
			if uv and not uv:IsA("MeshPart") then
				uv:Destroy()
				uv = nil
			end
			if morph and not uv then
				uv = Instance.new("MeshPart")
				uv.Name = side.uvName
				uv.Anchored = false
				uv.CanCollide = false
				uv.CanQuery = false
				uv.CanTouch = false
				uv.Massless = true
				uv.CastShadow = false
				uv.Color = Color3.new(1, 1, 1)
				uv.Material = Enum.Material.SmoothPlastic
				uv.Transparency = 1
				uv.Parent = morph
			end

			if uv and uv:IsA("MeshPart") then
				pcall(function()
					if uv.MeshId ~= meshId then
						uv.MeshId = meshId
					end
				end)
				local baseSize = (solid and solid.Size) or (charArm and charArm.Size) or Vector3.new(1, 2, 1)
				uv.Size = Vector3.new(
					baseSize.X * ARM_UV_SIZE_MULT.X,
					baseSize.Y * ARM_UV_SIZE_MULT.Y,
					baseSize.Z * ARM_UV_SIZE_MULT.Z
				)

				
				local weldTo = (solid and solid.Parent) and solid or charArm
				if weldTo and weldTo:IsA("BasePart") then
					pcall(function()
						for _, j in ipairs(uv:GetChildren()) do
							if j:IsA("WeldConstraint") or j:IsA("Weld") or j:IsA("Motor6D") then
								j:Destroy()
							end
						end
						
						uv.CFrame = weldTo.CFrame
						local w = Instance.new("Weld")
						w.Name = "ArmUVWeld"
						w.Part0 = weldTo
						w.Part1 = uv
						w.C0 = CFrame.new()
						w.C1 = CFrame.new()
						w.Parent = uv
					end)
				end

				if clothed and shirtTex ~= "" then
					local ok = applyUVSurfaceAppearance(uv, shirtTex, uvT)
					pcall(function()
						uv.DoubleSided = false
						uv.LocalTransparencyModifier = 0
						uv.CanCollide = false
						uv.Massless = true
						uv.CastShadow = false
						uv.Color = Color3.new(1, 1, 1)
						uv.Material = Enum.Material.SmoothPlastic
					end)
					if not ok then
						pcall(function()
							uv.TextureID = shirtTex
							uv.Transparency = (uvT > 0.001) and uvT or 0
						end)
					end
				else
					
					pcall(function()
						uv.Transparency = 1
						local sa = uv:FindFirstChildOfClass("SurfaceAppearance")
						if sa then sa:Destroy() end
						uv.TextureID = ""
					end)
				end
			end
		end

		
		
		if clothed and primary then
			for _, className in ipairs({"Shirt", "Pants", "ShirtGraphic"}) do
				local c = Character:FindFirstChildOfClass(className)
				if c then
					pcall(function() c.Parent = primary end)
				end
			end
		end
	end

	function Function.ForceLegUVGlassSafe(Character, Data)
		if not Character then return end
		local morph = Character:FindFirstChild("Morph")
		if not morph then return end
		local data = type(Data) == "table" and Data or PlayerData[Data]
		local uvT = math.clamp(tonumber(data and data.UVTransparency) or 0, 0, 1)
		local primary = Character.PrimaryPart

		local function findClothing(className)
			local c = Character:FindFirstChildOfClass(className)
			if c then return c end
			if primary then
				c = primary:FindFirstChildOfClass(className)
				if c then return c end
			end
			return nil
		end
		local pants = findClothing("Pants")
		local pantsTex = (pants and pants.PantsTemplate) or ""
		local clothed = data and data.UVToggle == true

		local function isUVName(name)
			local n = string.lower(name or "")
			return n:find("uv") ~= nil or n:find("texture") ~= nil
		end

		local function fixUVMesh(p, tex)
			if not p or not p:IsA("MeshPart") then return false end
			if not clothed then
				p.Transparency = 1
				local sa = p:FindFirstChildOfClass("SurfaceAppearance")
				if sa then pcall(function() sa:Destroy() end) end
				pcall(function() p.TextureID = "" end)
				return false
			end
			local useTex = tex
			if (not useTex or useTex == "") and p.TextureID and p.TextureID ~= "" then
				useTex = p.TextureID
			end
			if (not useTex or useTex == "") then
				local sa = p:FindFirstChildOfClass("SurfaceAppearance")
				if sa and sa.ColorMap and sa.ColorMap ~= "" then
					useTex = sa.ColorMap
				end
			end
			if useTex and useTex ~= "" then
				applyUVSurfaceAppearance(p, useTex, uvT)
				pcall(function()
					p.DoubleSided = true
					p.LocalTransparencyModifier = 0
					p.CanCollide = false
					p.Massless = true
					p.Color = Color3.new(1, 1, 1)
				end)
				return true
			end
			return false
		end

		
		for _, name in ipairs({"Left Leg UV", "Right Leg UV"}) do
			fixUVMesh(morph:FindFirstChild(name, true), pantsTex)
		end
		for _, side in ipairs({"Left Leg", "Right Leg"}) do
			local container = morph:FindFirstChild(side)
			if container then
				for _, d in ipairs(container:GetDescendants()) do
					if d:IsA("BasePart") then
						if isUVName(d.Name) then
							if d:IsA("MeshPart") then fixUVMesh(d, pantsTex) end
						else
							d.Transparency = 0
							pcall(function()
								d.LocalTransparencyModifier = 0
								local sa = d:FindFirstChildOfClass("SurfaceAppearance")
								if sa then sa:Destroy() end
								d.TextureID = ""
							end)
						end
					end
				end
			end
		end

		
		pcall(function() Function.ApplyArmUV(Character, Data) end)
	end

	function getPlayerData(Data)
		if type(Data) == "table" then return Data end
		if type(Data) == "string" then return PlayerData[Data] end
		return nil
	end

	function Function.SpringCreate(Object, Base, Target, Velocity, Speed, Damper, PositionOffset, Position, RotationOffset, Rotation, Data , Scale)
		local data = getPlayerData(Data)
		if not data or not data.CurrentPartList or not data.CurrentPartList.BodyPartPhysics then return end
		if not Object or not Object.Parent then return end
		local Weld = Object:FindFirstChildOfClass("Motor6D")
		if not Weld then return end
		local CF = Weld.C0
		local CF1 = Weld.C1

		local Spring = Spring.new(Vector3.new(0,0,0))
		Spring.Target = Target;
		Spring.Velocity = Velocity;
		Spring.Speed = Speed;
		Spring.Damper = Damper;

		if Object:GetAttribute("PhysicsRotationOffset") ~= nil then
			RotationOffset = Function.StringtoTable(Object:GetAttribute("PhysicsRotationOffset"))
		end

		data.CurrentPartList.BodyPartPhysics[Object] = {
			Spring = Spring,
			Base = Base,
			Weld = Weld,
			CF = CF,
			CF1 = CF1,
			OriginCFrame = Base.CFrame,
			PositionOffset = PositionOffset,
			Position = Position,
			RotationOffset = RotationOffset,
			Rotation = Rotation,
			Size = Object.Size,
			Scale = Scale,
			Kind = Object:GetAttribute("PhysicsKind") or "generic",
			AsymSide = Object:GetAttribute("AsymSide"),
			AsymPhase = math.random() * 6.28,
			AsymNoise = 0.7 + math.random() * 0.6,
			LastOffset = Vector3.zero,
			LastRot = Vector3.zero,
		}
	end

	function Function.CFrameMultiply(CF, Multiply)
		return CFrame.new(
			CF.Position.X * Multiply.X,
			CF.Position.Y * Multiply.Y,
			CF.Position.Z * Multiply.Z
		) * CF.Rotation
	end

	function Function.Vector3Multiply(Vector, Multiply)
		return Vector3.new(
			Vector.X * Multiply.X,
			Vector.Y * Multiply.Y,
			Vector.Z * Multiply.Z
		)
	end

	function Function.CompareVector3(Vector1, Vector2)
		return math.abs(Vector1.X) <= Vector2.X,  math.abs(Vector1.Y) <= Vector2.Y, math.abs(Vector1.Z) <= Vector2.Z

	end

	function Function.FallenPartCheck(Object)
		if Object:IsA("BasePart") then
			return Object.Position.Y < game.Workspace.FallenPartsDestroyHeight
		end
	end

	function Function.ClearClothWrap(Data)
		local data = PlayerData[Data]
		if not data or not data.ClothWrap then return end
		for _, entry in ipairs(data.ClothWrap) do
			if entry.part and entry.part.Parent and entry.restoreContent then
				pcall(function()
					entry.part.MeshContent = entry.restoreContent
				end)
			end
			if entry.em then
				pcall(function() entry.em:Destroy() end)
			end
