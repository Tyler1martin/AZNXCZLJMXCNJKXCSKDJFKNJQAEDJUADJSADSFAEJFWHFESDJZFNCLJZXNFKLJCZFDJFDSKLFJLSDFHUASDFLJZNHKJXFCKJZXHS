		if not main or not main.Parent then return end
		-- Scale + transparency always use Config (work even if custom theme colors are off)
		local scale = math.clamp(tonumber(CustomTheme.Config.Scale) or 1, 0.7, 1.4)
		local base = ThemeUI.BaseSize or Vector2.new(442, 370)
		local tw = math.floor(base.X * scale + 0.5)
