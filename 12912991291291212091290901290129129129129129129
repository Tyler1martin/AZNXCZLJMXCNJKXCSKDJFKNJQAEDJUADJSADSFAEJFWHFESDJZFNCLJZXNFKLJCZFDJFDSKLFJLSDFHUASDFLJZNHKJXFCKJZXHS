-- Save Avatar Action
SaveBtn.MouseButton1Click:Connect(function()
    local SubFrame, Scroll = createSubWindow("Save Current Avatar")
    
    local NameBox = Instance.new("TextBox", Scroll)
    NameBox.Size = UDim2.new(1, 0, 0, 35)
    NameBox.PlaceholderText = "Enter outfit name..."
    NameBox.Text = ""
    NameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    NameBox.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    NameBox.Font = Enum.Font.SourceSans
    NameBox.TextSize = 14
    NameBox.ZIndex = 7
    Instance.new("UICorner", NameBox).CornerRadius = UDim.new(0, 6)
    
    local ConfirmSave = Instance.new("TextButton", Scroll)
    ConfirmSave.Size = UDim2.new(1, 0, 0, 35)
    ConfirmSave.Text = "Confirm Save"
    ConfirmSave.TextColor3 = Color3.fromRGB(255, 255, 255)
    ConfirmSave.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
    ConfirmSave.Font = Enum.Font.SourceSansBold
    ConfirmSave.TextSize = 14
    ConfirmSave.ZIndex = 7
    Instance.new("UICorner", ConfirmSave).CornerRadius = UDim.new(0, 6)
    
    ConfirmSave.MouseButton1Click:Connect(function()
        local name = NameBox.Text:gsub("[^%w%s_%-]", "")
        if name == "" then return end
        
        local targetFilePath = FOLDER_NAME .. "/" .. name .. ".json"
        
        if not isfile(targetFilePath) and getOutfitCount() >= MAX_SAVED_OUTFITS then
            ConfirmSave.Text = "Limit Reached (100 Max)"
            ConfirmSave.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
            task.wait(2)
            if ConfirmSave and ConfirmSave.Parent then
                ConfirmSave.Text = "Confirm Save"
                ConfirmSave.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
            end
            return
        end

        local character = LocalPlayer.Character
        if not character then return end
        
        -- 1. Save Head Data
        local headData = nil
        local head = character:FindFirstChild("Head")
        if head then
            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            
            if head:IsA("MeshPart") then
                headData = {
                    IsMeshPart = true,
                    MeshId = head.MeshId,
                    TextureId = head.TextureID
                }
            elseif mesh then
                headData = {
                    IsMeshPart = false,
                    MeshId = mesh.MeshId,
                    TextureId = mesh.TextureId,
                    Scale = {mesh.Scale.X, mesh.Scale.Y, mesh.Scale.Z}
                }
            end
        end

        -- 2. Save R6 CharacterMesh Objects
        local savedMeshes = {}
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("CharacterMesh") then
                table.insert(savedMeshes, {
                    BodyPart = child.BodyPart.Value,
                    MeshId = child.MeshId,
                    BaseTextureId = child.BaseTextureId,
                    OverlayTextureId = child.OverlayTextureId
                })
            end
        end
        
        -- 3. Save Accessories / Hats
        local savedAccessories = {}
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Accoutrement") or child:IsA("Accessory") or child:IsA("Hat") then
                local handle = child:FindFirstChild("Handle")
                if handle then
                    local mesh = handle:FindFirstChildOfClass("SpecialMesh")
                    local att = handle:FindFirstChildOfClass("Attachment")
                    
                    table.insert(savedAccessories, {
                        Name = child.Name,
                        MeshId = handle:IsA("MeshPart") and handle.MeshId or (mesh and mesh.MeshId or ""),
                        TextureId = handle:IsA("MeshPart") and handle.TextureID or (mesh and mesh.TextureId or ""),
                        Scale = mesh and {mesh.Scale.X, mesh.Scale.Y, mesh.Scale.Z} or {1, 1, 1},
                        AttachmentName = att and att.Name or "HatAttachment",
                        AttachmentCFrame = att and {att.CFrame:GetComponents()} or nil
                    })
                end
            end
        end
        
        local shirt = character:FindFirstChildOfClass("Shirt")
        local pants = character:FindFirstChildOfClass("Pants")
        local bodyColors = character:FindFirstChildOfClass("BodyColors")
        
        local outfitData = {
            HeadData = headData,
            ShirtTemplate = shirt and shirt.ShirtTemplate or "",
            PantsTemplate = pants and pants.PantsTemplate or "",
            CharacterMeshes = savedMeshes,
            BodyColors = bodyColors and {
                HeadColor3 = bodyColors.HeadColor3:ToHex(),
                TorsoColor3 = bodyColors.TorsoColor3:ToHex(),
                LeftArmColor3 = bodyColors.LeftArmColor3:ToHex(),
                RightArmColor3 = bodyColors.RightArmColor3:ToHex(),
                LeftLegColor3 = bodyColors.LeftLegColor3:ToHex(),
                RightLegColor3 = bodyColors.RightLegColor3:ToHex()
            } or nil,
            Accessories = savedAccessories
        }
        
        writefile(targetFilePath, HttpService:JSONEncode(outfitData))
        SubFrame:Destroy()
    end)
end)

