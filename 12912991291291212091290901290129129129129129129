	function Function.GrantAchievement(id)
		id = tostring(id or "")
		if id == "" then return false end
		local rt = Function.AchievementRuntime
		if rt.Unlocked[id] then return false end
		local def = nil
		for _, d in ipairs(Function.AchievementDefs) do
			if d.id == id then def = d break end
		end
		if not def then return false end
		rt.Unlocked[id] = true
		local data = PlayerData[Player.Name]
		if data then
			data.UnlockedAchievements = data.UnlockedAchievements or {}
			data.UnlockedAchievements[id] = true
		end
		local col = AchievementDiffColor[def.diff] or Color3.fromRGB(255, 220, 240)
		Function.ShowAchievementNotify("Achievement unlocked", def.name, col)
		if rt.UIRefresh then pcall(rt.UIRefresh) end
		return true
	end

	function Function.CompleteChallenge(id)
		id = tostring(id or "")
		if id == "" then return false end
		local rt = Function.AchievementRuntime
		if not rt then return false end
		if not rt.ChallengeRowIndex then
			pcall(function() Function.PickChallengeRow() end)
		end
		if rt.ChallengeDone[id] then return false end
		local def = nil
		local row = Function.ChallengeRows[rt.ChallengeRowIndex or 1]
		if row then
			for i = 1, #row do
				local c = row[i]
				if type(c) == "table" and c.id == id then
					def = c
					break
				end
			end
		end
		if not def then return false end
		rt.ChallengeDone[id] = true
		rt.ChallengePendingRewards = rt.ChallengePendingRewards or {}
		rt.ChallengeClaimed = rt.ChallengeClaimed or {}
		if not rt.ChallengeClaimed[id] then
			rt.ChallengePendingRewards[id] = {
				diff = tostring(def.diff or "Easy"),
				claimed = false,
				name = tostring(def.name or id),
			}
		end
		local col = AchievementDiffColor[def.diff] or Color3.fromRGB(255, 220, 240)
		Function.ShowAchievementNotify("Challenge complete", def.name .. " — claim reward", col)
		if rt.UIRefresh then pcall(rt.UIRefresh) end
		return true
	end

	function Function.PickChallengeRow()
		local rt = Function.AchievementRuntime
		if not rt then return end
		if rt.ChallengeRowIndex then return end
		rt.ChallengeRowIndex = math.random(1, #Function.ChallengeRows)
		rt.ChallengeDone = {}
		rt.ChallengeProg = {}
		rt.ChallengePendingRewards = {}
		rt.ChallengeClaimed = {}
	end

	local function pickChallengeRewardFlavor(preferNew, exclude)
		exclude = exclude or {}
		local data = PlayerData and PlayerData[Player.Name]
		local all = {}
		pcall(function()
			if FlavorCatalogList then all = FlavorCatalogList() or {} end
		end)
		local poolNew, poolAny = {}, {}
		for _, mix in ipairs(all) do
			if type(mix) == "table" and mix.id and mix.id ~= "plain" then
				local sid = tostring(mix.id)
				if not exclude[sid] then
					local isVariant = sid:find("_hot", 1, true) or sid:find("_peak", 1, true)
					if not isVariant then
						poolAny[#poolAny + 1] = mix
						local discovered = false
						pcall(function()
							if isFlavorDiscovered then discovered = isFlavorDiscovered(data, sid) == true end
						end)
						if not discovered then
							poolNew[#poolNew + 1] = mix
						end
					end
				end
			end
		end
		local pool = preferNew and poolNew or poolAny
		if #pool == 0 then pool = poolAny end
		if #pool == 0 then return nil end
		return pool[math.random(1, #pool)]
	end

	local function giveChallengeRewardGlass(mix)
		if type(mix) ~= "table" or not mix.id then return false, "No flavor" end
		local col = mix.color
		if typeof(col) ~= "Color3" then col = Color3.fromRGB(255, 255, 255) end
		local entry = {
			id = tostring(mix.id),
			name = tostring(mix.name or mix.id),
			r = col.R, g = col.G, b = col.B,
			heated = false,
			left = mix.baseA,
			right = mix.baseB,
			sizeScale = 1,
			rarity = mix.rarity,
		}
		
		local bp = Player:FindFirstChild("Backpack")
		if not bp then return false, "No backpack" end
		local maxG = (App and App.GlassMax) or 3
		local cur = 0
		pcall(function() if countMilkGlasses then cur = countMilkGlasses() end end)
