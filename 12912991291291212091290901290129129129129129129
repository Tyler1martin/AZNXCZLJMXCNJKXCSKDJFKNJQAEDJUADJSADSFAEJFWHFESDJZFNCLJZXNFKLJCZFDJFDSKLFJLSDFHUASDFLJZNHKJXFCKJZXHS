	function scheduleAutoApply(char, reason)
		Function.PlayerDataAdd(App.ExecutePlayer and App.ExecutePlayer.Name or Player.Name)
		local pname = (App.ExecutePlayer and App.ExecutePlayer.Name) or Player.Name
		local d = PlayerData[pname]
		if not d or not d.AutoApplyOnSpawn then return end
		local delay = tonumber(d.AutoApplyDelay) or 5
		delay = math.clamp(delay, 0.1, 10)
		
		MorphLoadState.AutoToken = (MorphLoadState.AutoToken or 0) + 1
		local myAuto = MorphLoadState.AutoToken
		task.spawn(function()
			task.wait(delay)
			if myAuto ~= MorphLoadState.AutoToken then return end
			if not char or not char.Parent then return end
			if MorphLoadState.Busy then return end
			local dd = PlayerData[pname]
			if dd and dd.AutoApplyOnSpawn then
				Function.CharacterExecute(char, pname)
			end
		end)
	end

