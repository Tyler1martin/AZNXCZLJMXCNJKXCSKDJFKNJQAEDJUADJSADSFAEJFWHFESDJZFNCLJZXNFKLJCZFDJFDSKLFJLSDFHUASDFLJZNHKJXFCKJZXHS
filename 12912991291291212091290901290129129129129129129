	isMilkActivelyStreaming = function()
		if not canMilkDrainInMode() then return false end
		if MilkMeter.AlwaysFull then return true end
		local now = os.clock()
		local leftOk = (MilkMeter.FillL or 0) > 0 and now >= (MilkMeter.CooldownUntilL or 0)
		local rightOk = (MilkMeter.FillR or 0) > 0 and now >= (MilkMeter.CooldownUntilR or 0)
		return leftOk or rightOk
	end

	function sampleBreastMaxVel()
		local data = PlayerData[Player.Name]
		local maxVel = 0
		local physicsList = data and data.CurrentPartList and data.CurrentPartList.BodyPartPhysics
		if not physicsList then return 0 end
		for Part, Property in pairs(physicsList) do
			if Part and Part.Parent and Property.Spring then
				local n = string.lower(Part.Name)
				if string.find(n, "breast") or string.find(n, "boob") then
					local v = Property.Spring.Velocity
					local mag = math.sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z)
					if mag > maxVel then maxVel = mag end
				end
			end
		end
		return maxVel
	end

	function updateBlush(dt)
		dt = typeof(dt) == "number" and dt or 0.016
		if not BlushSystem.Enabled then
			BlushSystem.TargetAlpha = 0
			BlushSystem.Until = 0
		else
			local now = os.clock()
			local dur = math.max(0.5, tonumber(BlushSystem.Duration) or 5)
			if BlushSystem.VelocityMode then
				if now >= (BlushSystem.VelocityCooldown or 0) then
					local maxVel = sampleBreastMaxVel()
					if maxVel >= (BlushSystem.VelocitySpike or 0.55) then
						BlushSystem.Until = now + dur
						BlushSystem.VelocityCooldown = now + dur
					end
				end
			end

			local jiggleHigh = (JiggleMeter.Fill or 0) >= (BlushSystem.JiggleThreshold or 0.40)
			local milkOn = isMilkActivelyStreaming()
			local meterActive = jiggleHigh or milkOn
			local spikeActive = now < (BlushSystem.Until or 0)
			local shouldShow = meterActive or spikeActive

			if shouldShow then
				local strength = 0.55
				if spikeActive and not meterActive then
					local left = math.clamp((BlushSystem.Until - now) / dur, 0, 1)
					strength = 0.35 + left * 0.50
				elseif jiggleHigh and milkOn then
					strength = 1.0
				elseif jiggleHigh then
					strength = 0.80
				elseif milkOn then
					strength = 0.55
				end
				setBlushGlowVisible(true, strength)
				BlushSystem.Active = true
			else
				setBlushGlowVisible(false)
				BlushSystem.Active = false
			end
		end

		
		local speed = BlushSystem.FadeSpeed or 2.2
		local cur = BlushSystem.FadeAlpha or 0
		local tgt = BlushSystem.TargetAlpha or 0
		if cur < tgt then
			cur = math.min(tgt, cur + dt * speed)
		elseif cur > tgt then
			cur = math.max(tgt, cur - dt * speed)
		end
		BlushSystem.FadeAlpha = cur
		applyBlushVisual(cur, BlushSystem.TargetStrength or 0.5)
	end

	
	
