		if data.CurrentPartList.BodyPartPhysics[ObjectInstance] then return end
		local Weld = ObjectInstance:FindFirstChildOfClass("Motor6D") or ObjectInstance:FindFirstChildOfClass("Weld")
		if not Weld then return end
		local base = Character and (Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso"))
		local sm = ObjectInstance:FindFirstChildOfClass("SpecialMesh")
