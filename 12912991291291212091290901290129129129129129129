	function drinkFromFridge(index)
		index = tonumber(index)
		if not index or index < 1 or index > #GlassFridge then return false, "Empty slot" end
		local entry = GlassFridge[index]
		if type(entry) ~= "table" then return false, "Empty slot" end
		local col = Color3.new(tonumber(entry.r) or 1, tonumber(entry.g) or 1, tonumber(entry.b) or 1)
		local heatedDrink = entry.heated == true
		local dur, spd = 5, (heatedDrink and 10 or 5)
		pcall(function()
			if entry.id and entry.id ~= "plain" then
				local lb = entry.left or "strawberry"
				local rb = entry.right or "strawberry"
				local key = tostring(lb) .. "|" .. tostring(rb)
				if heatedDrink then key = key .. "|hot" end
				local mix = MilkFlavorMix and (MilkFlavorMix[key] or MilkFlavorMix[tostring(lb) .. "|" .. tostring(rb)])
				if mix then
					local d0, d1 = tonumber(mix.durMin) or 4, tonumber(mix.durMax) or 8
					dur = d0 + math.random() * math.max(0.1, d1 - d0)
					spd = tonumber(mix.buff) or spd
				end
				if heatedDrink then dur = dur + 3; spd = math.max(spd, 10) end
			elseif heatedDrink then
				dur = 8; spd = 10
			end
		end)
		if GlassSystem.FlavorBuffsEnabled ~= false then
			GlassSystem.BuffSpeed = spd
			GlassSystem.BuffUntil = os.clock() + dur
			pcall(function() if setFlavorDrinkGlow then setFlavorDrinkGlow(col, GlassSystem.BuffUntil) end end)
		pcall(function()
			if Function.OnGlassDrunk then
				local flavored = entry and (entry.left or entry.right or entry.id) and tostring(entry.id or "") ~= "milk" and tostring(entry.id or "") ~= "" and not (entry.id == nil and not entry.left)
				
				local fid = entry and (entry.id or entry.flavorId)
				local isFlav = fid ~= nil and tostring(fid) ~= "" and tostring(fid) ~= "milk" and tostring(fid) ~= "normal"
				Function.OnGlassDrunk({
					flavored = isFlav,
					heated = entry and entry.heated == true,
					rarity = entry and entry.rarity or "",
				})
			end
		end)
		else
			GlassSystem.BuffSpeed = 0
			GlassSystem.BuffUntil = 0
		end
		pcall(function()
			if App.MasterSFXMute then return end
			local char = Player.Character
			local host = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
			if not host then return end
			local s = GlassSystem.GulpSound
			if not s or not s.Parent then
				s = Instance.new("Sound")
				s.Name = "MilkGulp"
				s.SoundId = GlassSystem.GulpSoundId
				s.Volume = 1
				s.Parent = host
				GlassSystem.GulpSound = s
			end
			s.TimePosition = 0
			s:Play()
		end)
		if entry.id and tostring(entry.id) ~= "plain" then
			pcall(function() DiscoverFlavor(tostring(entry.id), entry.name or entry.id, col) end)
		end
		pcall(function()
			local char = Player.Character
			if char and Function.ApplyRealisticMovement then Function.ApplyRealisticMovement(char, Player.Name) end
		end)
		table.remove(GlassFridge, index)
		local data = PlayerData[Player.Name]
		if data then data.GlassFridge = GlassFridge end
		pcall(function()
			if SyncMorphUI and SyncMorphUI.RefreshGlassFridge then SyncMorphUI.RefreshGlassFridge() end
		end)
		return true, entry.name
	end

	function hookGlassTool(tool)
		if not tool or tool:GetAttribute("GlassHooked") then return end
		tool:SetAttribute("GlassHooked", true)
		tool.Equipped:Connect(function()
			syncGlassStateFromTool(tool)
			GlassSystem.HasGlass = true
		end)
		tool.Unequipped:Connect(function()
			writeGlassStateToTool(tool)
			GlassSystem.HasGlass = countMilkGlasses() > 0
			local eq = getEquippedGlass()
			if eq then syncGlassStateFromTool(eq) end
		end)
		tool.Activated:Connect(function()
			syncGlassStateFromTool(tool)
			local filled = GlassSystem.Filled == true or tool:GetAttribute("MilkFilled") == true or type(GlassSystem.LastFilledFlavor) == "table"
			if filled then
				task.defer(function()
					if SyncMorphUI.DrinkGlass then SyncMorphUI.DrinkGlass() end
				end)
			end
		end)
	end

	function ensureGlassTool()
		local bp = Player:FindFirstChild("Backpack")
		if not bp then return nil end
		local n = countMilkGlasses()
		if n >= GlassMax then
			for _, t in ipairs(listMilkGlasses()) do
				if t:GetAttribute("MilkFilled") ~= true then
					hookGlassTool(t)
					GlassSystem.Tool = t
					GlassSystem.HasGlass = true
					return t
				end
			end
			local first = listMilkGlasses()[1]
			if first then
				hookGlassTool(first)
				GlassSystem.Tool = first
				GlassSystem.HasGlass = true
			end
			return first
		end
		local slot = n + 1
		local tool = Instance.new("Tool")
		tool.Name = "Glass"
		tool.RequiresHandle = true
		tool.CanBeDropped = false
		tool.ToolTip = string.format("Empty glass %d/%d — equip & hold while milking", slot, GlassMax)
		tool:SetAttribute("IsMilkGlass", true)
		tool:SetAttribute("MilkFilled", false)
		tool:SetAttribute("MilkHoldAcc", 0)
		tool:SetAttribute("GlassSlot", slot)
		local handle = Instance.new("Part")
		handle.Name = "Handle"
		handle.Size = Vector3.new(0.96, 0.48, 0.48)
		handle.Color = Color3.fromRGB(200, 220, 255)
		handle.Material = Enum.Material.Glass
		handle.Transparency = 0.35
		handle.CanCollide = false
		handle.Massless = true
		handle.Parent = tool
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Cylinder
		mesh.Scale = Vector3.new(1, 1, 1)
		mesh.Parent = handle
		tool.Grip = CFrame.new(0, -0.12, 0.02) * CFrame.Angles(0, 0, math.rad(90))
		tool.Parent = bp
		hookGlassTool(tool)
		GlassSystem.Tool = tool
		GlassSystem.HasGlass = true
		GlassSystem.Filled = false
		GlassSystem.Heated = false
		GlassSystem.HoldAcc = 0
		return tool
	end

	function glassDisplayName(tool)
		tool = tool or getEquippedGlass() or GlassSystem.Tool
		local filled, heated, fid, fname = false, false, nil, nil
		if tool then
			filled = tool:GetAttribute("MilkFilled") == true
			heated = tool:GetAttribute("MilkHeated") == true
			fid = tool:GetAttribute("FlavorId")
			fname = tool:GetAttribute("FlavorName")
		else
			filled = GlassSystem.Filled == true
			heated = GlassSystem.Heated == true or GlassSystem.FlavorHeated == true
			fid = GlassSystem.FlavorId
			fname = GlassSystem.FlavorName
		end
		if not filled then
			return "Glass"
		end
		fid = fid or (GlassSystem.LastFilledFlavor and GlassSystem.LastFilledFlavor.id)
		fname = fname or (GlassSystem.LastFilledFlavor and GlassSystem.LastFilledFlavor.name)
		if fid and tostring(fid) ~= "" and tostring(fid) ~= "plain" then
			local base = tostring(fname or fid):gsub("^Heated%s+", "")
			if heated then return "Heated " .. base .. " glass" end
			return base .. " glass"
		end
		if heated then return "Heated milk glass" end
		return "Milk glass"
	end

	function refreshGetGlassButtonLabel()
		pcall(function()
			if ToggleBtns and ToggleBtns.GetGlass and ToggleBtns.GetGlass.Parent then
				ToggleBtns.GetGlass.Text = string.format("Get glass (%d/3)", countMilkGlasses())
			end
		end)
	end

	function updateGlassToolVisual()
		local tool = getEquippedGlass() or GlassSystem.Tool
		if not tool or not tool.Parent then
			local glasses = listMilkGlasses()
			tool = glasses[1]
			GlassSystem.Tool = tool
		end
		if not tool then
			refreshGetGlassButtonLabel()
			return
		end
		local eq = getEquippedGlass()
		if eq then
			tool = eq
			syncGlassStateFromTool(tool)
		end
		local handle = tool:FindFirstChild("Handle")
		local slot = tool:GetAttribute("GlassSlot") or 1
		local filled = tool:GetAttribute("MilkFilled") == true
		local heated = tool:GetAttribute("MilkHeated") == true
		local disp = glassDisplayName(tool)
		pcall(function() tool.Name = disp end)
		if filled then
			tool.ToolTip = string.format("[%d/%d] %s — activate to drink", slot, GlassMax, disp)
			if handle then
				local fr, fg, fb = tool:GetAttribute("FlavorR"), tool:GetAttribute("FlavorG"), tool:GetAttribute("FlavorB")
				if fr and fg and fb then
					local fcol = Color3.new(fr, fg, fb)
					handle.Color = heated and fcol:Lerp(Color3.fromRGB(255, 120, 100), 0.35) or fcol
				else
					handle.Color = heated and Color3.fromRGB(255, 140, 150) or Color3.fromRGB(255, 255, 255)
				end
				handle.Transparency = 0.15
			end
		else
			local hold = tonumber(tool:GetAttribute("MilkHoldAcc")) or 0
			local pct = math.clamp(hold / (GlassSystem.FillTime or 5), 0, 1)
			if pct > 0.02 then
				tool.ToolTip = string.format("[%d/%d] Filling %.0f%% — keep holding while milking", slot, GlassMax, pct * 100)
				pcall(function() tool.Name = string.format("Glass (%.0f%%)", pct * 100) end)
			else
				tool.ToolTip = string.format("[%d/%d] Empty glass — equip & hold while milking", slot, GlassMax)
				pcall(function() tool.Name = "Glass" end)
			end
			if handle then
				handle.Color = Color3.fromRGB(200, 220, 255)
				handle.Transparency = 0.35 - pct * 0.15
			end
		end
		refreshGetGlassButtonLabel()
	end

	function updateHeatAndGlass(dt)
		if not App.SystemActive then return end
		dt = math.clamp(dt or 0.016, 0, 0.1)
		local data = PlayerData[Player.Name]
		local char = Player.Character
		local heated = (HeatMeter.Fill or 0) > 0.5

		
		local jiggleHard = false
		local maxVel = 0
		if data and data.CurrentPartList and data.CurrentPartList.BodyPartPhysics then
			for Part, Property in pairs(data.CurrentPartList.BodyPartPhysics) do
				if Part and Part.Parent and Property.Spring then
					local v = Property.Spring.Velocity
					local mag = math.sqrt(v.X*v.X + v.Y*v.Y + v.Z*v.Z)
					if mag > maxVel then maxVel = mag end
				end
			end
		end
		jiggleHard = maxVel >= 1.0
		local gainMult = jiggleHard and 1.2 or 1

		if HeatMeter.Enabled then
			local gain = 0
			
			local milkStreaming = false
			if isMilkActivelyStreaming and isMilkActivelyStreaming() then
				
				milkStreaming = true
			end
			if milkStreaming then
				gain = gain + 0.01 * dt 
			end
			if SweatSystem and SweatSystem.Enabled and SweatSystem.Sweating then
				gain = gain + 0.0175 * dt 
			end
			
			local fill = HeatMeter.Fill or 0
			fill = fill + gain * gainMult
			fill = fill - (HeatMeter.DecayPerSec or 0.0025) * dt
			HeatMeter.Fill = math.clamp(fill, 0, 1)

			
			local hf = HeatMeter.Fill or 0
			if HeatMeter.FillBar then
				
				HeatMeter.FillBar.Size = UDim2.new(1, -6, hf, -6)
				HeatMeter.FillBar.BackgroundColor3 = heated and Color3.fromRGB(255, 55, 95) or Color3.fromRGB(255, 80, 115)
			end
			if HeatMeter.PctLabel then
				HeatMeter.PctLabel.Text = string.format("%d%%", math.floor(hf * 100 + 0.5))
			end
			if HeatMeter.Track then
				HeatMeter.Track.Visible = true
			end
			pcall(function() setHeatGlow(true, HeatMeter.Fill or 0) end)
			
			pcall(function() stepSquirt(dt) end)
		else
			if HeatMeter.Track then HeatMeter.Track.Visible = false end
			pcall(function() setHeatGlow(false, 0) end)
			pcall(function()
				if HeatMeter.SquirtState ~= "idle" then stopSquirtFX() end
			end)
		end

		
		if MilkMeter and heated and MilkMeter.SwellEnabled then
			MilkMeter._HeatSwellBoost = 1.75
		elseif MilkMeter then
			MilkMeter._HeatSwellBoost = 1
		end

		
		local milkStreaming = isMilkActivelyStreaming and isMilkActivelyStreaming() or false
		if MilkMeter and MilkMeter.AlwaysFull then
			
			milkStreaming = isMilkActivelyStreaming and isMilkActivelyStreaming() or false
		end
		local glassEquipped = isGlassEquipped()
		if glassEquipped then
			local eq = getEquippedGlass()
			if eq then syncGlassStateFromTool(eq) end
		end
		if glassEquipped and not GlassSystem.Filled and HoldBreast and HoldBreast.Holding and milkStreaming then
			GlassSystem.HasGlass = true
			GlassSystem.HoldAcc = (GlassSystem.HoldAcc or 0) + dt
			if GlassSystem.HoldAcc >= (GlassSystem.FillTime or 5) then
				GlassSystem.Filled = true
				GlassSystem.Heated = heated
				GlassSystem.HoldAcc = GlassSystem.FillTime or 5
				do
					local pdata = PlayerData[Player.Name]
					if pdata and pdata.MilkFlavorsEnabled == true then
						MilkFlavorSystem.Enabled = true
					end
				end
				if MilkFlavorSystem and MilkFlavorSystem.Enabled then
					pcall(function() Function.UpdateMilkFlavor(heated) end)
					GlassSystem.FlavorId = tostring(MilkFlavorSystem.Id or "blend")
					GlassSystem.FlavorName = tostring(MilkFlavorSystem.Name or "Mystery Blend")
					GlassSystem.FlavorColor = MilkFlavorSystem.Color or Color3.fromRGB(255, 255, 255)
					GlassSystem.FlavorSizeScale = MilkFlavorSystem.SizeScale or (0.80 + math.random() * 0.10)
					GlassSystem.FlavorHeated = heated
					GlassSystem._flavorLeft = MilkFlavorSystem.LeftBase
					GlassSystem._flavorRight = MilkFlavorSystem.RightBase
				else
					GlassSystem.FlavorId = "plain"
					GlassSystem.FlavorName = heated and "Heated Milk" or "Milk"
					GlassSystem.FlavorColor = Color3.fromRGB(255, 255, 255)
					GlassSystem.FlavorSizeScale = 1
					GlassSystem.FlavorHeated = heated
				end
				
				GlassSystem.LastFilledFlavor = {
					id = tostring(GlassSystem.FlavorId or "plain"),
					name = tostring(GlassSystem.FlavorName or "Milk"),
					color = (typeof(GlassSystem.FlavorColor) == "Color3") and GlassSystem.FlavorColor or Color3.fromRGB(255, 255, 255),
					heated = GlassSystem.FlavorHeated == true,
				}
				local eq = getEquippedGlass()
				if eq then writeGlassStateToTool(eq) end
			else
				local eq = getEquippedGlass()
				if eq then eq:SetAttribute("MilkHoldAcc", GlassSystem.HoldAcc or 0) end
			end
		end
		if MilkFlavorSystem and MilkFlavorSystem.Enabled then
			pcall(function() Function.UpdateMilkFlavor(heated) end)
		end
		pcall(updateGlassToolVisual)

		
		if ToggleBtns and ToggleBtns.DrinkGlass and ToggleBtns.DrinkGlass.Parent then
			if not GlassSystem.HasGlass then
				ToggleBtns.DrinkGlass.Text = "Drink glass (no glass)"
			elseif not GlassSystem.Filled then
				local pct = math.floor(((GlassSystem.HoldAcc or 0) / (GlassSystem.FillTime or 5)) * 100)
				local tip = (MilkFlavorSystem and MilkFlavorSystem.Enabled and MilkFlavorSystem.Name) and (" — " .. MilkFlavorSystem.Name) or ""
				ToggleBtns.DrinkGlass.Text = string.format("Glass filling %d%%%s", math.clamp(pct, 0, 99), tip)
			else
				local n = GlassSystem.FlavorName or "milk"
				ToggleBtns.DrinkGlass.Text = (GlassSystem.Heated and ("Drink heated " .. n) or ("Drink " .. n))
			end
		end

		
		if GlassSystem.BuffUntil > 0 and os.clock() > GlassSystem.BuffUntil then
			GlassSystem.BuffUntil = 0
			GlassSystem.BuffSpeed = 0
			JiggleMeter._FlavorGlowUntil = 0
			JiggleMeter._FlavorGlowActive = false
			if char then
				pcall(function() Function.ApplyRealisticMovement(char, Player.Name) end)
			end
		end
		pcall(stepFlavorDrinkGlow)
	end

	stepMilkStream = function(dt)
		local char = Player.Character
		local exclude = {getMilkStreamFolder()}
		if char then table.insert(exclude, char) end
		milkGroundRay.FilterDescendantsInstances = exclude

		local i = 1
		while i <= #MilkMeter.StreamDroplets do
			local d = MilkMeter.StreamDroplets[i]
			local p = d.part
			if not p or not p.Parent then
				table.remove(MilkMeter.StreamDroplets, i)
			else
				d.age = d.age + dt
				if d.age >= d.life then
					p:Destroy()
					table.remove(MilkMeter.StreamDroplets, i)
				else
					local fade = d.age / d.life
					if d.img then
						d.img.ImageTransparency = 0.05 + fade * 0.9
						d.img.BackgroundTransparency = 0.2 + fade * 0.7
					end
					d.vel = d.vel + Vector3.new(0, -28, 0) * dt
					local pos = p.Position
					local step = d.vel * dt
					
					local hit = workspace:Raycast(pos, step.Magnitude > 0.01 and step or Vector3.new(0, -0.15, 0), milkGroundRay)
					if not hit then
						hit = workspace:Raycast(pos, Vector3.new(0, -0.2, 0), milkGroundRay)
					end
					if hit then
						p:Destroy()
						table.remove(MilkMeter.StreamDroplets, i)
					else
						p.CFrame = CFrame.new(pos + step)
						i = i + 1
					end
				end
			end
		end
	end

	function setMilkParticleRate(rateL, rateR, dt)
		local char = Player.Character
		if not char then
			clearMilkEmitters()
			return
		end
		rateL = rateL or 0
		rateR = rateR or 0
		dt = math.clamp(dt or 0.016, 0, 0.05)

		
		for att, pe in pairs(MilkMeter.Emitters) do
			if pe then pcall(function() pe:Destroy() end) end
			if att and att.Parent then pcall(function() att:Destroy() end) end
			MilkMeter.Emitters[att] = nil
		end

		if rateL <= 0 and rateR <= 0 then
			MilkMeter.StreamSpawnAccL = 0
			MilkMeter.StreamSpawnAccR = 0
			return
		end

		local hosts = collectNippleHosts(char)
		if #hosts == 0 then return end

		
		MilkMeter.StreamSpawnAccL = (MilkMeter.StreamSpawnAccL or 0) + rateL * dt
		MilkMeter.StreamSpawnAccR = (MilkMeter.StreamSpawnAccR or 0) + rateR * dt

		local function spawnFromSide(side, accKey)
			while (MilkMeter[accKey] or 0) >= 1 do
				if #MilkMeter.StreamDroplets >= (MilkMeter.StreamMax or 90) then
					
					MilkMeter[accKey] = math.min(MilkMeter[accKey], 1.5)
					break
				end
				MilkMeter[accKey] = MilkMeter[accKey] - 1
				local candidates = {}
				for _, entry in ipairs(hosts) do
					local s = entry[2]
					if s == side or (s ~= "left" and s ~= "right") then
						table.insert(candidates, entry)
					end
				end
				if #candidates == 0 then break end
				local pick = candidates[math.random(1, #candidates)]
				local part = pick[1]
				local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
				local wp = part.Position
				if root then
					wp = wp + root.CFrame.LookVector * 0.05 - root.CFrame.UpVector * 0.04
				end
				wp = wp + Vector3.new((math.random() - 0.5) * 0.03, (math.random() - 0.5) * 0.02, (math.random() - 0.5) * 0.03)
				spawnMilkStreamDroplet(wp, side)
			end
		end
		if rateL > 0 then spawnFromSide("left", "StreamSpawnAccL") end
		if rateR > 0 then spawnFromSide("right", "StreamSpawnAccR") end
	end

	
	
	
	
	
	HeadOrbitFP = {
		Enabled = false,
		HeightAdjust = -1.4,
		SmoothSpeed = 0.25,
		MaxHorizontalOffset = 0.5,
		ForwardOffsetAmount = 1,
		FirstPersonThreshold = 2.3,
		CurrentOffset = Vector3.zero,
		WasFP = false,
	}

	local FPTorsoNames = {
		Torso = true, UpperTorso = true, LowerTorso = true, HumanoidRootPart = true,
	}

	function fpIsHeadItem(part, head)
		if not head or not part then return false end
		if FPTorsoNames[part.Name] then return false end
		if part == head or part:IsDescendantOf(head) then return true end
		local parentModel = part.Parent
		if parentModel and parentModel:IsA("Accessory") then
			local handle = parentModel:FindFirstChild("Handle")
			if handle then
				local attachment = handle:FindFirstChildOfClass("Attachment")
				if attachment and string.find(string.lower(attachment.Name), "head") then
					return true
				end
				for _, joint in ipairs(handle:GetJoints()) do
					if (joint:IsA("Weld") or joint:IsA("Motor6D") or joint:IsA("WeldConstraint"))
						and (joint.Part0 == head or joint.Part1 == head) then
						return true
					end
				end
			end
		end
		return false
	end

	function isFirstPersonLocal()
		if not App.SystemActive then return false end
		local cam = workspace.CurrentCamera
		local char = Player.Character
		if not (cam and char) then return false end
		if Player.CameraMode == Enum.CameraMode.LockFirstPerson then return true end
		local focusDist = (cam.CFrame.Position - cam.Focus.Position).Magnitude
		if focusDist <= 0.75 then return true end
		local head = char:FindFirstChild("Head")
		if head then
			local d = cam.CFrame.Position - head.Position
			if (d.X * d.X + d.Y * d.Y + d.Z * d.Z) <= (1.25 * 1.25) then
				return true
			end
		end
		return false
	end

	
	
	
	function fpShouldSkipLTM(inst)
		if not inst then return true end
		local n = string.lower(inst.Name or "")
		if n == "head" or n:find("^head") or n:find("_head") or n:find("head_") then
			if not n:find("breast") and not n:find("boob") then
				return true
			end
		end
		
		if n:find("cheek") or n:find("butt") or n:find("booty") or n:find("ass") then
			return true
		end
		
		local p = inst.Parent
		if p then
			local pn = string.lower(p.Name or "")
			if pn:find("cheek") or pn:find("butt") or pn:find("booty") or pn == "head"
				or pn:find("^head") then
				return true
			end
		end
		return false
	end

	
	local FP_FORCE_VISIBLE_NAMES = {
		"TorsoMesh", "TorsoMesh2", "Torso Mesh",
		"ShirtTexture", "PantsTexture",
		"BreastsRoot", "BreastTexture", "BreastPantsUV",
		"Left Breasts", "Right Breasts",
		"Left Breast", "Right Breast",
		"NippleL", "NippleR",
		"Areola Decal", 
		"Areola Decal 1", "Areola Decal 2",
