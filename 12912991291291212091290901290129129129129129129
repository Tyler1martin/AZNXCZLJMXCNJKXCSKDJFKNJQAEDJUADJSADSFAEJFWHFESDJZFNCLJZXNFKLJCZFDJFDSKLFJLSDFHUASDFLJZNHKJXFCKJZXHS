	function setFlavorDrinkGlow(color, untilTime)
		JiggleMeter._FlavorGlowColor = (typeof(color) == "Color3") and color or Color3.fromRGB(255, 200, 220)
		JiggleMeter._FlavorGlowUntil = untilTime or 0
		JiggleMeter._FlavorGlowActive = (untilTime or 0) > os.clock()
	end

	function stepFlavorDrinkGlow()
		local flash = JiggleMeter.FlashFrame
		if not flash then return end
		local untilT = JiggleMeter._FlavorGlowUntil or 0
		if untilT <= os.clock() then
			if JiggleMeter._FlavorGlowActive then
				JiggleMeter._FlavorGlowActive = false
			end
			return
		end
		if os.clock() < (JiggleMeter.PinkFlashUntil or 0) then return end
		if JiggleMeter._MilkGlowActive then return end
		local col = JiggleMeter._FlavorGlowColor or Color3.fromRGB(255, 200, 220)
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 3.2)
		local centerT = math.clamp(0.82 - pulse * 0.08, 0.7, 0.92)
		local edgeT = math.clamp(0.7 - pulse * 0.1, 0.55, 0.88)
		flash.BackgroundColor3 = col
		flash.BackgroundTransparency = centerT
		for _, child in ipairs(flash:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = col
				child.BackgroundTransparency = edgeT
			end
		end
		JiggleMeter._FlavorGlowActive = true
	end

	function playPinkFlash(intensity, duration)
		
		local flash = JiggleMeter.FlashFrame
		if not flash then return end
		local TweenService = game:GetService("TweenService")
		local pink = Color3.fromRGB(255, 105, 180)
		JiggleMeter.PinkFlashUntil = os.clock() + (duration or 0.8) + 0.05
