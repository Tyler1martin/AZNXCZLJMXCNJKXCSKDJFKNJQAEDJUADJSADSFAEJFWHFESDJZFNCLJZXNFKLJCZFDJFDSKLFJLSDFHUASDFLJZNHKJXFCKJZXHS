	function canMilkDrainInMode()
		if not MilkMeter or not MilkMeter.Enabled or MilkMeter.Paused then return false end
		local data = PlayerData[Player.Name]
		local clothed = data and data.UVToggle == true
		if clothed and not MilkMeter.WorkClothed then return false end
