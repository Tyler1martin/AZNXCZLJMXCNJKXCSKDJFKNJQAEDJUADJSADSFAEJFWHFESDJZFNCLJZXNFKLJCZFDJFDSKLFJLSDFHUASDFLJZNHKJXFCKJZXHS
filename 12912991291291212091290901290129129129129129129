	function applyBlushVisual(alpha, strength)
		local sg = ensureBlushGlowUI()
		if not sg then return end
		alpha = math.clamp(alpha or 0, 0, 1)
		strength = math.clamp(strength or 0.5, 0, 1)
		if alpha < 0.01 then
			sg.Enabled = false
			for _, e in ipairs(BlushSystem.Edges) do
				if e then e.BackgroundTransparency = 1 end
			end
			for _, ln in ipairs(BlushSystem.Lines or {}) do
				if ln then ln.BackgroundTransparency = 1 end
			end
			return
		end
		sg.Enabled = true
		local edgeBase = 0.88 - strength * 0.18
		local edgeT = 1 - (1 - edgeBase) * alpha
		for _, e in ipairs(BlushSystem.Edges) do
			if e then
				e.BackgroundColor3 = App.BlushCol
				e.BackgroundTransparency = edgeT
			end
		end
		local lineBase = 0.82 - strength * 0.20
		local lineT = 1 - (1 - lineBase) * alpha
		for _, ln in ipairs(BlushSystem.Lines or {}) do
			if ln then
				ln.BackgroundColor3 = App.BlushCol2
				ln.BackgroundTransparency = lineT
			end
		end
	end

