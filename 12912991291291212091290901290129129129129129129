		local isCloth = n:find("texture") or n:find("uv") or n:find("pant") or n:find("cloth")
			or n:find("breastpants") or n == "breasttexture"
		if not isCloth then
			if not (n:find("breast") and not n:find("left") and not n:find("right") and not n:find("root") and not n:find("nipple")) then
				return
