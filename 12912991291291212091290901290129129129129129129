	local function sampleBreastMaxVel()
		local data = PlayerData[Player.Name]
		local maxVel = 0
		local physicsList = data and data.CurrentPartList and data.CurrentPartList.BodyPartPhysics
		if not physicsList then return 0 end
		for Part, Property in pairs(physicsList) do
			if Part and Part.Parent and Property.Spring then
				local n = string.lower(Part.Name)
				if string.find(n, "breast") or string.find(n, "boob") then
					local v = Property.Spring.Velocity
					local mag = math.sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z)
					if mag > maxVel then maxVel = mag end
				end
			end
		end
		return maxVel
	end

	local function updateBlush(dt)
		dt = typeof(dt) == "number" and dt or 0.016
		if not BlushSystem.Enabled then
			BlushSystem.TargetAlpha = 0
			BlushSystem.Until = 0
		else
			local now = os.clock()
			local dur = math.max(0.5, tonumber(BlushSystem.Duration) or 5)
			if BlushSystem.VelocityMode then
				if now >= (BlushSystem.VelocityCooldown or 0) then
					local maxVel = sampleBreastMaxVel()
					if maxVel >= (BlushSystem.VelocitySpike or 0.55) then
						BlushSystem.Until = now + dur
						BlushSystem.VelocityCooldown = now + dur
					end
				end
			end

			local jiggleHigh = (JiggleMeter.Fill or 0) >= (BlushSystem.JiggleThreshold or 0.40)
			local milkOn = isMilkActivelyStreaming()
			local meterActive = jiggleHigh or milkOn
			local spikeActive = now < (BlushSystem.Until or 0)
			local shouldShow = meterActive or spikeActive

			if shouldShow then
				local strength = 0.55
				if spikeActive and not meterActive then
					local left = math.clamp((BlushSystem.Until - now) / dur, 0, 1)
					strength = 0.35 + left * 0.50
				elseif jiggleHigh and milkOn then
					strength = 1.0
				elseif jiggleHigh then
					strength = 0.80
				elseif milkOn then
					strength = 0.55
				end
				setBlushGlowVisible(true, strength)
				BlushSystem.Active = true
			else
				setBlushGlowVisible(false)
				BlushSystem.Active = false
			end
		end

		-- Smooth fade in / out
		local speed = BlushSystem.FadeSpeed or 2.2
		local cur = BlushSystem.FadeAlpha or 0
		local tgt = BlushSystem.TargetAlpha or 0
		if cur < tgt then
			cur = math.min(tgt, cur + dt * speed)
		elseif cur > tgt then
			cur = math.max(tgt, cur - dt * speed)
		end
		BlushSystem.FadeAlpha = cur
		applyBlushVisual(cur, BlushSystem.TargetStrength or 0.5)
	end

	-- ---------- Hold Breast helpers ----------
	-- Organ contact (simplified):
	--   Butts  → hard CanCollide only (no soft retract)
	--   Breasts → fixed weld retract away from wall (helps crawl/crouch clipping)
	local SoftWorldImpulses = {}
	local softRayParams = RaycastParams.new()
	softRayParams.FilterType = Enum.RaycastFilterType.Exclude
	softRayParams.IgnoreWater = true
	local softOverlap = OverlapParams.new()
	softOverlap.FilterType = Enum.RaycastFilterType.Exclude
	softOverlap.MaxParts = 8

	local function computeSoftWorldOrganCollision(dt)
		table.clear(SoftWorldImpulses)
		local char = Player.Character
		if not char then return end
		local data = PlayerData[Player.Name]
		if not data or not data.OrganCollision then return end
		local retractDist = tonumber(data.BreastRetract) or 0.3
		local physicsList = data.CurrentPartList and data.CurrentPartList.BodyPartPhysics
		if not physicsList then return end

		softRayParams.FilterDescendantsInstances = { char }
		softOverlap.FilterDescendantsInstances = { char }
		dt = typeof(dt) == "number" and dt or 0.016

		-- UV CanCollide set once at weld — no rescan

		local dirs = {
			Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
			Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
			Vector3.new(0.7, 0.1, 0.7).Unit, Vector3.new(-0.7, 0.1, 0.7).Unit,
			Vector3.new(0.7, 0.1, -0.7).Unit, Vector3.new(-0.7, 0.1, -0.7).Unit,
		}

		for Part, Property in pairs(physicsList) do
			if not (Part and Part.Parent and Property.Spring) then continue end
			local pn = string.lower(Part.Name)
			local isBreast = pn:find("breast") or pn:find("boob") or pn == "breastsroot"
			local isButt = pn:find("butt") or pn:find("ass")
			if not isBreast and not isButt then continue end
			if pn:find("uv") or pn:find("texture") or pn:find("skin") then
				Part.CanCollide = false
				continue
			end
			if not Part.CanCollide then
				Part.CanCollide = true
				Part.Massless = true
			end

			-- Butts: collision only, clear any old soft offsets
			if isButt then
				Property.CollisionSquish = Vector3.zero
				Property.ContactRot = Vector3.zero
				Property.HasContact = false
				continue
			end

			-- Breasts: detect nearby walls
			local push = Vector3.zero
			local hit = false
			local rayLen = math.clamp(math.max(Part.Size.X, Part.Size.Z) * 0.75, 0.7, 1.6)
			for _, dir in ipairs(dirs) do
				local origin = Part.Position + dir * rayLen
				local result = workspace:Raycast(origin, -dir * rayLen, softRayParams)
				if result and result.Normal then
					local distFromPart = (result.Position - Part.Position).Magnitude
					if distFromPart < rayLen * 0.9 then
						push = push + result.Normal
						hit = true
					end
				end
			end
			local nearby = workspace:GetPartBoundsInRadius(Part.Position, math.max(Part.Size.Magnitude * 0.45, 0.85), softOverlap)
			for _, other in ipairs(nearby) do
				if other:IsA("BasePart") and other.CanCollide then
					local delta = Part.Position - other.Position
					if delta.Magnitude > 1e-3 then
						push = push + delta.Unit
						hit = true
					end
				end
			end

			Property.ContactRot = Vector3.zero
			if hit then
				-- Retract BACK into the chest: torso -LookVector (flatten Y so it doesn't pull down)
				local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
				local dir
				if torso then
					dir = -torso.CFrame.LookVector
				else
					dir = -Part.CFrame.LookVector
				end
				dir = Vector3.new(dir.X, 0, dir.Z)
				if dir.Magnitude > 1e-4 then
					dir = dir.Unit
				else
					dir = Vector3.new(0, 0, -1)
				end
				Property.CollisionSquish = dir * retractDist
				Property.HasContact = true
			else
				-- Ease back when free
				local prev = Property.CollisionSquish or Vector3.zero
				Property.CollisionSquish = prev * 0.8
				if Property.CollisionSquish.Magnitude < 0.02 then
					Property.CollisionSquish = Vector3.zero
				end
				Property.HasContact = Property.CollisionSquish.Magnitude > 1e-4
			end
		end
	end

