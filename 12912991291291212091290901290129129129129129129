		GlassSystem.Tool = tool
		GlassSystem.HasGlass = true
		GlassSystem.Filled = tool:GetAttribute("MilkFilled") == true
		GlassSystem.Heated = tool:GetAttribute("MilkHeated") == true
		GlassSystem.HoldAcc = tonumber(tool:GetAttribute("MilkHoldAcc")) or 0
		GlassSystem.FlavorId = tool:GetAttribute("FlavorId")
		GlassSystem.FlavorName = tool:GetAttribute("FlavorName")
		local fr, fg, fb = tool:GetAttribute("FlavorR"), tool:GetAttribute("FlavorG"), tool:GetAttribute("FlavorB")
		if fr and fg and fb then
			GlassSystem.FlavorColor = Color3.new(fr, fg, fb)
		else
			GlassSystem.FlavorColor = nil
		end
		GlassSystem.FlavorHeated = tool:GetAttribute("FlavorHeated") == true
		GlassSystem._flavorLeft = tool:GetAttribute("FlavorLeft")
		GlassSystem._flavorRight = tool:GetAttribute("FlavorRight")
