	function Function.MultiplyCalculate(Base, Default)
		if typeof(Base) ~= "Vector3" then
			Base = Vector3.new(2, 2, 1)
		end
		if typeof(Default) ~= "Vector3" then
			Default = Vector3.new(2, 2, 1)
		end
		local dx = Default.X ~= 0 and Default.X or 1
		local dy = Default.Y ~= 0 and Default.Y or 1
		local dz = Default.Z ~= 0 and Default.Z or 1
		return Base.X / dx, Base.Y / dy, Base.Z / dz
	end

	function Function.TabletoVector(Table)
		if typeof(Table) == "Vector3" then
			return Table
		end
		if type(Table) ~= "table" then
			return Vector3.zero
		end
		return Vector3.new(
			tonumber(Table["x"] or Table["X"]) or 0,
			tonumber(Table["y"] or Table["Y"]) or 0,
			tonumber(Table["z"] or Table["Z"]) or 0
		)
	end

	function Function.StringtoColor3(str)
		local r, g, b = str:match("([^,]+),([^,]+),([^,]+)")
		return Color3.fromRGB(math.round(tonumber(r)), math.round(tonumber(g)), math.round(tonumber(b)))
	end
	function Function.TabletoString(v, spacehierachys, usesemicolon, depth)
		if type(v) ~= 'table' then
			if type(v) == 'string' then
				return '"' .. v .. '"'
			else
				return tostring(v)
			end
		elseif not next(v) then
			return '{}'
		end
		local spaces = 4
		depth = depth or 1

		local space = (" "):rep(depth * spaces)
		local sep = usesemicolon and ";" or ","
		local concatenationBuilder = {"{"}

		for k, x in next, v do
			table.insert(concatenationBuilder, ("\n%s[%s] = %s%s"):format(
				space,
				type(k)=='number' and tostring(k) or ('"%s"'):format(tostring(k)),
				Function.TabletoString(x, spaces, usesemicolon, depth+1),
				sep))
		end

		local s = table.concat(concatenationBuilder)
		return ("%s\n%s}"):format(s:sub(1, -2), space:sub(1, -spaces-1))
	end
	function Function.StringtoTable(str)
		local tbl = {}
		for key, value in str:gmatch('%[\"(.-)\"%] = \"(.-)\"') do
			tbl[key] = value
		end
		return tbl

	end

	function Function.Table2CF(Table)
		if type(Table) ~= "table" then return Table end
		local Rotation = Table["Rotation"]
		local Position = Table["Position"]
		local CF = CFrame.new(Position.x,Position.y,Position.z)

		local CA = CFrame.fromEulerAnglesYXZ(math.rad(Rotation.x),math.rad(Rotation.y),math.rad(Rotation.z))

		return CF*CA
	end

	function Function.DarkenColor(color,amount)
		return color:Lerp(Color3.new(0,0,0), amount)
	end

	function Function.SideOfNippleName(n)
		n = (n or ""):lower()
		if n:find("left") or n:find("nipplel") or n:find("nipple.1") or n:find("nipple_l") then
			return "left"
		end
		if n:find("right") or n:find("nippler") or n:find("nipple_r") then
			return "right"
		end
		return "both"
	end

	function Function.ResolveNippleAreolaColor(pd, side, skin)
		skin = skin or Color3.fromRGB(163, 162, 165)
		if not pd then
			return Function.DarkenColor(skin, 0.32)
		end
		if side == "left" and typeof(pd.NippleAreolaColorL) == "Color3" then
			return pd.NippleAreolaColorL
		end
		if side == "right" and typeof(pd.NippleAreolaColorR) == "Color3" then
			return pd.NippleAreolaColorR
		end
		if typeof(pd.NippleAreolaColor) == "Color3" then
			return pd.NippleAreolaColor
		end
		return Function.DarkenColor(skin, 0.32)
	end

	function Function.AreolaDecalCreate(ObjectInstance, Character, Extra, Data)
		for _, ch in ipairs(ObjectInstance:GetChildren()) do
			if ch:IsA("Decal") and ch.Name:lower():find("areola") then
				ch:Destroy()
			end
		end
		local uv = Extra and Extra.UVToggle == true
		local keepNipples = Extra and Extra.NipplesOnClothed == true
		if uv and not keepNipples then
			return
		end
		local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
		local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
		local pd = PlayerData[Data]
		local side = Function.SideOfNippleName(ObjectInstance and ObjectInstance.Name)
		local baseColor = Function.ResolveNippleAreolaColor(pd, side, skin)
		local Decal = Instance.new("Decal")
		Decal.Name = "Areola Decal"
		Decal.Texture = "http://www.roblox.com/asset/?id=9065282081"
		Decal.Face = Enum.NormalId.Right
		Decal.Color3 = baseColor
		Decal.Transparency = 0
		Decal:SetAttribute("BaseColorR", baseColor.R)
		Decal:SetAttribute("BaseColorG", baseColor.G)
		Decal:SetAttribute("BaseColorB", baseColor.B)
		Decal:SetAttribute("NippleSide", side)
		Decal.Parent = ObjectInstance
		PlayerData[Data].CurrentPartList.AreolaDecal[Decal] = ObjectInstance
	end

	function Function.ApplyNippleAreolaColors(Character, Data)
		local pd = (type(Data) == "table" and Data) or PlayerData[Data]
		if not pd or not Character then return end
		local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
		local skin = torso and torso.Color or Color3.fromRGB(163, 162, 165)
		local cpl = pd.CurrentPartList
		if not cpl then return end
		for Decal, host in pairs(cpl.AreolaDecal or {}) do
			if Decal and Decal.Parent then
				local hostName = (host and host.Name) or (Decal.Parent and Decal.Parent.Name) or ""
				local side = Decal:GetAttribute("NippleSide") or Function.SideOfNippleName(hostName)
				local col = Function.ResolveNippleAreolaColor(pd, side, skin)
				Decal:SetAttribute("BaseColorR", col.R)
				Decal:SetAttribute("BaseColorG", col.G)
				Decal:SetAttribute("BaseColorB", col.B)
				Decal.Color3 = col
			end
		end
		for part, _ in pairs(cpl.NippleParts or {}) do
			if part and part.Parent then
				local side = Function.SideOfNippleName(part.Name)
				local col = Function.ResolveNippleAreolaColor(pd, side, skin)
				part:SetAttribute("MilkBaseR", col.R)
				part:SetAttribute("MilkBaseG", col.G)
				part:SetAttribute("MilkBaseB", col.B)
				part.Color = col
			else
				cpl.NippleParts[part] = nil
			end
		end
		pcall(function() Function.ApplyNippleAreolaTransform(Character, pd) end)
	end

