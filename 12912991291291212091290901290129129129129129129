		local function makeSlider(labelText, order, minV, maxV, defaultV, onChanged, stepSize)
			makeLabel(labelText, order)
			-- stepSize: quantize value (default 0.01 so studs/fine values work; was ~0.03 from pixel drag)
			local step = tonumber(stepSize) or 0.01
			if step <= 0 then step = 0.01 end

			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 26)
