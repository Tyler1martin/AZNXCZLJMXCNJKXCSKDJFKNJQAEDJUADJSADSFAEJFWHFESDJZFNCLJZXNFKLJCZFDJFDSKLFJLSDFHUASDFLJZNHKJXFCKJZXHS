	function computeLimbOrganContact(dt)
		local char = Player.Character
		if not char then return end
		local data = PlayerData[Player.Name]
		if not data or data.LimbOrganCollision ~= true then return end
		local physicsList = data.CurrentPartList and data.CurrentPartList.BodyPartPhysics
		if not physicsList then return end

		local limbs = {}
		for _, p in ipairs(char:GetChildren()) do
			if p:IsA("BasePart") then
				local n = p.Name
				if isArmPartName(n) then
					limbs[#limbs + 1] = { part = p, isLeg = false }
				elseif isLegPartName(n) then
					limbs[#limbs + 1] = { part = p, isLeg = true }
				end
			end
		end
		if #limbs == 0 then return end

		local breastScale = math.clamp(tonumber(data.BreastsScale) or 1, 0.5, 3)
		local buttScale = math.clamp(tonumber(data.ButtsScale) or 1, 0.5, 3)

		for Part, Property in pairs(physicsList) do
			if not (Part and Part.Parent and Property and Property.Spring) then continue end
			local kind = Property.Kind or "generic"
			local pn = string.lower(Part.Name or "")
			
			if pn:find("uv") or pn:find("texture") or pn:find("skin") or pn:find("cloth") or pn:find("pant") or pn:find("shirt") then
				continue
			end
			local isBreast = kind == "breast" or pn:find("breast") or pn:find("boob") or pn:find("breastsroot")
			local isButt = kind == "butt" or pn:find("butt") or pn:find("ass")
			if not isBreast and not isButt then continue end

			
			local organR = isBreast
				and math.max(0.55 * breastScale, 0.5)
				or math.max(0.38 * buttScale, 0.35) 
			local push = Vector3.zero
			for i = 1, #limbs do
				local L = limbs[i]
				if isButt and L.isLeg then continue end 
				local limb = L.part
				local delta = Part.Position - limb.Position
				local dist = delta.Magnitude
				local limbR = math.max(limb.Size.Magnitude * 0.22, 0.22)
				local reach = organR + limbR
				if dist < reach and dist > 1e-4 then
					local depth = (reach - dist) / reach
					push = push + (delta / dist) * depth
				end
			end

			if push.Magnitude > 0.08 then
				
				local mult = math.clamp(tonumber(data.LimbOrganImpulse) or 2, 0, 10)
				pcall(function()
					Property.Spring:Impulse(push.Unit * math.min(push.Magnitude, 0.6) * (isBreast and 3.2 or 2.4) * mult)
				end)
			end
		end
	end

	
	
	
	
	local SoftWorldImpulses = {}
	local softRayParams = RaycastParams.new()
	softRayParams.FilterType = Enum.RaycastFilterType.Exclude
	softRayParams.IgnoreWater = true
	local softOverlap = OverlapParams.new()
	softOverlap.FilterType = Enum.RaycastFilterType.Exclude
	softOverlap.MaxParts = 8

	function computeSoftWorldOrganCollision(dt)
		table.clear(SoftWorldImpulses)
		local char = Player.Character
		if not char then return end
		local data = PlayerData[Player.Name]
		if not data or not data.OrganCollision then return end
		local retractDist = tonumber(data.BreastRetract) or 0.3
		local physicsList = data.CurrentPartList and data.CurrentPartList.BodyPartPhysics
		if not physicsList then return end

		softRayParams.FilterDescendantsInstances = { char }
		softOverlap.FilterDescendantsInstances = { char }
		dt = typeof(dt) == "number" and dt or 0.016

		

		local dirs = {
			Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
			Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
			Vector3.new(0.7, 0.1, 0.7).Unit, Vector3.new(-0.7, 0.1, 0.7).Unit,
			Vector3.new(0.7, 0.1, -0.7).Unit, Vector3.new(-0.7, 0.1, -0.7).Unit,
		}

		for Part, Property in pairs(physicsList) do
			if not (Part and Part.Parent and Property.Spring) then continue end
			local pn = string.lower(Part.Name)
			local isBreast = pn:find("breast") or pn:find("boob") or pn == "breastsroot"
			local isButt = pn:find("butt") or pn:find("ass")
			if not isBreast and not isButt then continue end
			if pn:find("uv") or pn:find("texture") or pn:find("skin") then
				Part.CanCollide = false
				continue
			end
			if not Part.CanCollide then
				Part.CanCollide = true
				Part.Massless = true
			end

			
			if isButt then
				Property.CollisionSquish = Vector3.zero
				Property.ContactRot = Vector3.zero
				Property.HasContact = false
				continue
			end

			
			local push = Vector3.zero
			local hit = false
			local rayLen = math.clamp(math.max(Part.Size.X, Part.Size.Z) * 0.75, 0.7, 1.6)
			for _, dir in ipairs(dirs) do
				local origin = Part.Position + dir * rayLen
				local result = workspace:Raycast(origin, -dir * rayLen, softRayParams)
				if result and result.Normal then
					local distFromPart = (result.Position - Part.Position).Magnitude
					if distFromPart < rayLen * 0.9 then
						push = push + result.Normal
						hit = true
					end
				end
			end
			local nearby = workspace:GetPartBoundsInRadius(Part.Position, math.max(Part.Size.Magnitude * 0.45, 0.85), softOverlap)
			for _, other in ipairs(nearby) do
				if other:IsA("BasePart") and other.CanCollide then
					local delta = Part.Position - other.Position
					if delta.Magnitude > 1e-3 then
						push = push + delta.Unit
						hit = true
					end
				end
			end

			Property.ContactRot = Vector3.zero
			if hit then
				
				local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
				local dir
				if torso then
					dir = -torso.CFrame.LookVector
				else
					dir = -Part.CFrame.LookVector
				end
				dir = Vector3.new(dir.X, 0, dir.Z)
				if dir.Magnitude > 1e-4 then
					dir = dir.Unit
				else
					dir = Vector3.new(0, 0, -1)
				end
				Property.CollisionSquish = dir * retractDist
				Property.HasContact = true
			else
				
				local prev = Property.CollisionSquish or Vector3.zero
				Property.CollisionSquish = prev * 0.8
				if Property.CollisionSquish.Magnitude < 0.02 then
					Property.CollisionSquish = Vector3.zero
				end
				Property.HasContact = Property.CollisionSquish.Magnitude > 1e-4
			end
		end
	end

