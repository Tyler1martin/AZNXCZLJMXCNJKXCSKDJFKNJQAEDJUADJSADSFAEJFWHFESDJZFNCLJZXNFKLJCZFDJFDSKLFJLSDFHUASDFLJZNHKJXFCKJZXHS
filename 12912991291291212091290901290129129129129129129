	function Function.HookAchievementTouches(Character)
		if not Character then return end
		local rt = Function.AchievementRuntime
		local morph = Character:FindFirstChild("Morph")
		if not morph then return end
		for _, d in ipairs(morph:GetDescendants()) do
			if d:IsA("BasePart") then
				local n = string.lower(d.Name or "")
				if n:find("breast") or n:find("boob") or n:find("butt") or n:find("cheek") then
					if not rt.TouchHooked[d] then
						rt.TouchHooked[d] = true
						d.CanTouch = true
						d.Touched:Connect(function(hit)
							if not hit or not hit.Parent then return end
							local other = Players:GetPlayerFromCharacter(hit.Parent)
							if not other and hit.Parent.Parent then
								other = Players:GetPlayerFromCharacter(hit.Parent.Parent)
							end
							if other and other ~= Player then
								Function.GrantAchievement("hey_dont_touch")
							end
						end)
					end
				end
			end
		end
	end

	function Function.OnGlassDrunk(info)
		info = info or {}
		local flavored = info.flavored == true
		local heated = info.heated == true
		local rarity = tostring(info.rarity or "")
		local rt = Function.AchievementRuntime
		rt.SessionDrinks = (rt.SessionDrinks or 0) + 1
		local now = os.clock()
		table.insert(rt.DrinkTimestamps, now)
		local cut = now - 120
		local kept = {}
		for _, t in ipairs(rt.DrinkTimestamps) do
			if t >= cut then kept[#kept + 1] = t end
		end
		rt.DrinkTimestamps = kept
		if not flavored and not heated then
			Function.GrantAchievement("yummy")
			rt.ChallengeProg.normal_drinks = (rt.ChallengeProg.normal_drinks or 0) + 1
		end
		if not flavored and heated then
			Function.GrantAchievement("ahh_bit_hot")
			rt.ChallengeProg.heated_drinks = (rt.ChallengeProg.heated_drinks or 0) + 1
		end
		if flavored then
			Function.GrantAchievement("has_flavors")
			rt.ChallengeProg.flavored_drinks = (rt.ChallengeProg.flavored_drinks or 0) + 1
			if rarity == "Super Rare" then
				rt.ChallengeProg.super_rare_drinks = (rt.ChallengeProg.super_rare_drinks or 0) + 1
			end
		end
		if rt.SessionDrinks >= 5 then Function.GrantAchievement("addicted") end
		if #rt.DrinkTimestamps >= 10 then Function.GrantAchievement("chest_hurt") end
		local n = rt.ChallengeProg.normal_drinks or 0
		local h = rt.ChallengeProg.heated_drinks or 0
		local f = rt.ChallengeProg.flavored_drinks or 0
		local sr = rt.ChallengeProg.super_rare_drinks or 0
		if n >= 2 and h >= 1 then Function.CompleteChallenge("just_beginning") end
		if f >= 5 then Function.CompleteChallenge("chugging") end
		if f >= 6 and n >= 3 and h >= 3 and sr >= 1 then Function.CompleteChallenge("drunk") end
		if rarity == "Super Rare" then
			Function.GrantAchievement("deluxe_sip")
		end
		local fid = tostring(info.id or info.flavorId or "")
		if fid:find("rainbow") or tostring(info.name or ""):lower():find("rainbow") then
			Function.GrantAchievement("spectrum")
		end
		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.MaxHealth > 0 then
			local ratio = hum.Health / hum.MaxHealth
			if ratio < 0.5 then
				Function.GrantAchievement("glass_cannon")
			end
			if ratio <= 0.25 and hum.Health > 0 then
				Function.GrantAchievement("clutch_sip")
			end
		end
	end

	function Function.OnFlavorDiscoveredCount()
		local data = PlayerData[Player.Name]
		local n = 0
		if data and type(data.DiscoveredFlavors) == "table" then
			local seen = {}
			for k, v in pairs(data.DiscoveredFlavors) do
				local key = tostring(k)
				if not string.find(key, "name:", 1, true) and (v == true or type(v) == "table") then
					if not seen[key] then seen[key] = true; n = n + 1 end
				end
			end
		end
		if n >= 3 then Function.GrantAchievement("flavor_baddie_1") end
		if n >= 10 then Function.GrantAchievement("flavor_baddie_2") end
		if n >= 30 then Function.GrantAchievement("flavor_baddie_3") end
	end

	function Function.CheckBodyAchievements()
		local data = PlayerData and PlayerData[Player.Name]
		if not data then return end
		
		local bs = tonumber(data.BreastsScale) or 1
		local bt = tonumber(data.ButtsScale) or 1
		local ls = tonumber(data.LegsScale) or 1
		local ts = tonumber(data.TorsoScale) or 1
		if bs > 1.001 or bt > 1.001 then
			Function.GrantAchievement("not_big_enough")
		end
		if bs >= 1.7 then
			Function.GrantAchievement("backpain")
		end
		if bs >= 2.0 then
			Function.GrantAchievement("heavy_chest")
		end
		if bt >= 1.5 then
			Function.GrantAchievement("cheek_day")
		end
		if ls >= 1.25 then
			Function.GrantAchievement("leg_day")
		end
		if bs >= 1.2 and bt >= 1.2 and ls >= 1.2 and ts >= 1.2 then
			Function.GrantAchievement("full_package")
		end
		if data.ShinyBody == true then
			Function.GrantAchievement("mirror_finish")
			if data.UVToggle ~= true then
				Function.CompleteChallenge("sunny_day")
			end
		end
		if data.SoftBodyWalkBoost == true then
			Function.GrantAchievement("soft_steps")
			Function.CompleteChallenge("walk_it_out")
		end
		if data.JigglePhysicsMaster == false then
			Function.GrantAchievement("cheap")
		end
		if bs >= 1.5 and bt >= 1.5 and ls >= 1.2 then
			Function.CompleteChallenge("full_figure")
		end
	end

	function Function.TickAchievements(dt)
		local rt = Function.AchievementRuntime
		if not rt then return end
		dt = typeof(dt) == "number" and dt or 0.03
		local data = PlayerData and PlayerData[Player.Name]
		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hpRatio = nil
		if hum then
			local hp = hum.Health
			local maxhp = math.max(hum.MaxHealth, 1)
			hpRatio = hp / maxhp
			if rt.LastKnownHealth ~= nil then
				local dmg = rt.LastKnownHealth - hp
				if dmg > 0.05 then
					rt.HoldBreastSafeStart = nil
					if char and char:FindFirstChild("Morph") then
						Function.GrantAchievement("first_wound")
					end
					if HoldCheek and HoldCheek.Holding then
						Function.CompleteChallenge("bandaged")
					end
					if hpRatio <= 0.5 or hp <= 0 then
						Function.CompleteChallenge("bloody_mess")
					end
				end
			end
			if hp <= 0 then Function.CompleteChallenge("bloody_mess") end
			if hp > 0 and hpRatio <= 0.10 then
				Function.GrantAchievement("last_stand")
			end
			if hp > 0 and hpRatio <= 0.25 then
				Function.GrantAchievement("close_call")
				rt.WasCriticalHP = true
			end
			if rt.WasCriticalHP and hpRatio >= 0.999 and hp > 0 then
				Function.GrantAchievement("rebound")
				rt.WasCriticalHP = false
			end
			if hp > 0 and hpRatio <= 0.40 then
				rt.UntouchableAcc = (rt.UntouchableAcc or 0) + dt
				if rt.UntouchableAcc >= 90 then
					Function.CompleteChallenge("untouchable")
				end
			else
				rt.UntouchableAcc = 0
			end
			rt.LastKnownHealth = hp
		end
		if HoldBreast and HoldBreast.Holding then
			rt.HeldBreastsSession = true
			if not rt.HoldBreastSafeStart then rt.HoldBreastSafeStart = os.clock() end
			if (os.clock() - rt.HoldBreastSafeStart) >= 60 then
				Function.CompleteChallenge("keeping_milk_safe")
			end
		else
			rt.HoldBreastSafeStart = nil
		end
		if HoldCheek and HoldCheek.Holding then
			rt.HeldCheeksSession = true
			rt.HoldCheekAcc = (rt.HoldCheekAcc or 0) + dt
			if rt.HoldCheekAcc >= 20 then
				Function.CompleteChallenge("stretch")
			end
		else
			rt.HoldCheekAcc = 0
		end
		if rt.HeldBreastsSession and rt.HeldCheeksSession then
			Function.GrantAchievement("hands_on")
		end
		if MilkMeter and MilkMeter.Enabled and not MilkMeter.Paused and not MilkMeter.AlwaysFull then
			local fillL = tonumber(MilkMeter.FillL) or 0
			local fillR = tonumber(MilkMeter.FillR) or 0
			local streaming = false
			pcall(function()
				if isMilkActivelyStreaming then streaming = isMilkActivelyStreaming() == true end
			end)
			if not streaming then
				local clothed = data and data.UVToggle == true
				local canDep = ((not clothed) or MilkMeter.WorkClothed) and not MilkMeter.Paused
				if canDep and (fillL > 0.001 or fillR > 0.001) then
					streaming = true
				end
			end
			if streaming then
				rt.WasMilkStreaming = true
				rt.MarathonStreamAcc = (rt.MarathonStreamAcc or 0) + dt
				if rt.MarathonStreamAcc >= 60 then
					Function.CompleteChallenge("marathon_stream")
				end
				if hpRatio and hpRatio < 0.75 and hpRatio > 0 then
					rt.MilkUnderFireAcc = (rt.MilkUnderFireAcc or 0) + dt
					if rt.MilkUnderFireAcc >= 20 then
						Function.CompleteChallenge("milk_under_fire")
					end
				else
					rt.MilkUnderFireAcc = 0
				end
			else
				rt.MilkUnderFireAcc = 0
			end
			if rt.WasMilkStreaming and fillL <= 0.001 and fillR <= 0.001 then
				Function.CompleteChallenge("milky_mess")
				rt.WasMilkStreaming = false
			end
			if fillL <= 0.001 and fillR <= 0.001 then
				rt.DryTankAcc = (rt.DryTankAcc or 0) + dt
				if rt.DryTankAcc >= 20 then
					Function.GrantAchievement("dry_tank")
				end
			else
				rt.DryTankAcc = 0
			end
		else
			rt.WasMilkStreaming = false
			rt.MilkUnderFireAcc = 0
			rt.DryTankAcc = 0
		end
		if data and MilkMeter and MilkMeter.Enabled and data.UVToggle == true and not MilkMeter.WorkClothed then
			if not rt.ClothedMilkStart then rt.ClothedMilkStart = os.clock() end
			if (os.clock() - rt.ClothedMilkStart) >= 180 then
				Function.CompleteChallenge("later")
			end
		else
			rt.ClothedMilkStart = nil
		end
		if data and data.ShinyBody == true and data.UVToggle ~= true then
			Function.CompleteChallenge("sunny_day")
		end
		if JiggleMeter and (tonumber(JiggleMeter.Fill) or 0) >= 0.99 then
			Function.GrantAchievement("jiggly")
			local streaming = false
			pcall(function()
				if isMilkActivelyStreaming then streaming = isMilkActivelyStreaming() == true end
			end)
			if streaming or (MilkMeter and MilkMeter.Enabled and not MilkMeter.Paused and not MilkMeter.AlwaysFull
				and ((MilkMeter.FillL or 0) > 0.01 or (MilkMeter.FillR or 0) > 0.01)) then
				Function.GrantAchievement("pink_rush")
			end
		end
		if HeatMeter and HeatMeter.Enabled then
			local hf = tonumber(HeatMeter.Fill) or 0
			if hf >= 0.995 then
				Function.GrantAchievement("boiling_point")
				if not rt.HeatMaxLatched then
					rt.HeatMaxLatched = true
					rt.HeatMaxCount = (rt.HeatMaxCount or 0) + 1
					if rt.HeatMaxCount >= 2 then
						Function.CompleteChallenge("pressure_cooker")
					end
				end
			elseif hf < 0.85 then
				rt.HeatMaxLatched = false
			end
			if hf > 0.50 then
				rt.HeatSoakAcc = (rt.HeatSoakAcc or 0) + dt
				if rt.HeatSoakAcc >= 45 then
					Function.GrantAchievement("heat_soak")
				end
			else
				rt.HeatSoakAcc = 0
			end
			if hf > 0.25 then
				rt.WarmUpAcc = (rt.WarmUpAcc or 0) + dt
				if rt.WarmUpAcc >= 30 then
					Function.CompleteChallenge("warm_up")
				end
			else
				rt.WarmUpAcc = 0
			end
			if hf >= 0.40 and hf <= 0.70 then
				rt.BalanceAcc = (rt.BalanceAcc or 0) + dt
				if rt.BalanceAcc >= 45 then
					Function.CompleteChallenge("balance")
				end
			else
				rt.BalanceAcc = 0
			end
			if rt.AftershockUntil and os.clock() < rt.AftershockUntil and hf >= 0.50 then
				Function.CompleteChallenge("aftershock")
				rt.AftershockUntil = nil
			elseif rt.AftershockUntil and os.clock() >= rt.AftershockUntil then
				rt.AftershockUntil = nil
			end
		end
		if MilkMeter and MilkMeter.Enabled then
			if (tonumber(MilkMeter.FillL) or 0) > 1.0 and (tonumber(MilkMeter.FillR) or 0) > 1.0 then
				Function.GrantAchievement("overfilled")
			end
		end
		if data and data.SoftBodyWalkBoost == true and hum and hum.MoveDirection.Magnitude > 0.05 then
			rt.SoftSprintAcc = (rt.SoftSprintAcc or 0) + dt
			if rt.SoftSprintAcc >= 45 then
				Function.CompleteChallenge("soft_sprint")
			end
		else
			rt.SoftSprintAcc = 0
		end
		
		if hum and hum.Health > 0 then
			local moving = hum.MoveDirection.Magnitude > 0.08
			if moving then
				rt.JoggerAcc = (rt.JoggerAcc or 0) + dt
				if rt.JoggerAcc >= 30 then
					Function.CompleteChallenge("jogger")
				end
				if hpRatio and hpRatio <= 0.50 then
					rt.SurvivorSprintAcc = (rt.SurvivorSprintAcc or 0) + dt
					if rt.SurvivorSprintAcc >= 20 then
						Function.CompleteChallenge("survivor_sprint")
					end
				else
					rt.SurvivorSprintAcc = 0
				end
			else
				rt.SurvivorSprintAcc = 0
			end
			
			local st = hum:GetState()
			local airborne = st == Enum.HumanoidStateType.Jumping
				or st == Enum.HumanoidStateType.Freefall
			if airborne and not rt.WasAirborne then
				rt.JumpCount = (rt.JumpCount or 0) + 1
				if rt.JumpCount >= 15 then
					Function.CompleteChallenge("air_time")
				end
			end
			rt.WasAirborne = airborne
		end
		if #GlassFridge >= 5 then
			Function.GrantAchievement("cold_storage")
		end
		if #GlassFridge >= 10 then
			Function.GrantAchievement("stocked")
		end
		rt._bodyChkAcc = (rt._bodyChkAcc or 0) + dt
		if rt._bodyChkAcc >= 1.0 then
			rt._bodyChkAcc = 0
			pcall(function() Function.CheckBodyAchievements() end)
		end
	end

