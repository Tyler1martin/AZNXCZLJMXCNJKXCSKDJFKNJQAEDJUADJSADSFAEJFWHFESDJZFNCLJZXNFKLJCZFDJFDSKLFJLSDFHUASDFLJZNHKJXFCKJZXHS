	function Function.ApplyRealisticMovement(Character, Data)
		local data = PlayerData[Data]
		if not data or not Character then return end
		local hum = Character:FindFirstChildOfClass("Humanoid")
		if not hum then return end

		local allowSpeed = data.AllowSpeedChanges ~= false
		local allowJump = data.AllowJumpChanges ~= false
		if not allowSpeed and not allowJump then
			return
		end

		if data.BaseWalkSpeed == nil then
			data.BaseWalkSpeed = hum.WalkSpeed
			data.BaseJumpPower = hum.JumpPower
			data.BaseJumpHeight = hum.JumpHeight
		end

		local milkMult = 1
		local milkJumpMult = 1
		if MilkMeter and MilkMeter.Enabled and not MilkMeter.Paused and (MilkMeter.BuffsEnabled ~= false) then
			local clothed = data.UVToggle == true
			local canDrain = (not clothed) or MilkMeter.WorkClothed
			if canDrain then
				local now = os.clock()
				local leftOk = (MilkMeter.FillL or 0) > 0 and now >= (MilkMeter.CooldownUntilL or 0)
				local rightOk = (MilkMeter.FillR or 0) > 0 and now >= (MilkMeter.CooldownUntilR or 0)
				local milkActive = MilkMeter.AlwaysFull or leftOk or rightOk
				if milkActive and now >= (MilkMeter.DebuffUntil or 0) then
					milkMult = 1.30
					milkJumpMult = 1.20
				end
			end
		end
		if MilkMeter and os.clock() < (MilkMeter.DebuffUntil or 0) then
			milkMult = 0.70
			milkJumpMult = 0.70
		end
		if SweatSystem and SweatSystem.Enabled and SweatSystem.DebuffsEnabled ~= false and SweatSystem.Sweating then
			milkMult = milkMult * 0.92
			milkJumpMult = milkJumpMult * 0.95
		end

		if not data.RealisticMovement then
			local extra = 0
			if GlassSystem and GlassSystem.FlavorBuffsEnabled ~= false and GlassSystem.BuffUntil and os.clock() < GlassSystem.BuffUntil then
				extra = GlassSystem.BuffSpeed or 5
			end
			if allowSpeed then
				hum.WalkSpeed = data.BaseWalkSpeed * milkMult + extra
			end
			if allowJump then
				hum.JumpPower = data.BaseJumpPower * milkJumpMult
				hum.JumpHeight = data.BaseJumpHeight * milkJumpMult
			end
			return
		end

		local breastPen = 0
		local buttPen = 0
		if data.BreastsEnabled ~= false then
			breastPen = 0.07 * math.max(0, data.BreastsScale or 1)
		end
		if data.ButtsEnabled ~= false then
			buttPen = 0.05 * math.max(0, data.ButtsScale or 1)
		end
		local total = math.min(0.30, breastPen + buttPen)
		local mult = 1 - total

		local glassExtra = 0
		if GlassSystem and GlassSystem.FlavorBuffsEnabled ~= false and GlassSystem.BuffUntil and os.clock() < GlassSystem.BuffUntil then
			glassExtra = GlassSystem.BuffSpeed or 5
		end
		if allowSpeed then
			hum.WalkSpeed = data.BaseWalkSpeed * mult * milkMult + glassExtra
		end
		if allowJump then
			hum.JumpPower = data.BaseJumpPower * mult * milkJumpMult
			hum.JumpHeight = data.BaseJumpHeight * mult * milkJumpMult
		end
	end

