	function updateMilkMeter(dt)
		local data = PlayerData[Player.Name]
		if MilkMeter.ToggleBtn and MilkMeter.ToggleBtn.Parent then
			MilkMeter.ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end

		if not data or not MilkMeter.Enabled then
			if MilkMeter.TrackL then MilkMeter.TrackL.Visible = false end
			if MilkMeter.TrackR then MilkMeter.TrackR.Visible = false end
			if MilkMeter.SwellTrackL then MilkMeter.SwellTrackL.Visible = false end
			if MilkMeter.SwellTrackR then MilkMeter.SwellTrackR.Visible = false end
			if MilkMeter.WarnLabel then MilkMeter.WarnLabel.Visible = false end
			if MilkMeter.PauseBtn then MilkMeter.PauseBtn.Visible = false end
			
			
			
			for att, pe in pairs(MilkMeter.Emitters) do
				if pe then pcall(function() pe:Destroy() end) end
				if att and att.Parent then pcall(function() att:Destroy() end) end
				MilkMeter.Emitters[att] = nil
			end
			if MilkMeter.StreamSound and (not HeatMeter or HeatMeter.SquirtState == "idle") then
				pcall(function() MilkMeter.StreamSound:Stop() end)
			end
			setMilkGlow(false, false)
			
			pcall(function() stepMilkStream(dt) end)
			pcall(function() updateHeatAndGlass(dt) end)
			pcall(function() updateBreathSound() end)
		pcall(function() updateHeartSound() end)
			return
		end

		if not MilkMeter.TrackL then
			if not JiggleMeter.Gui then createJiggleMeterUI() end
		end
		if JiggleMeter.Gui then JiggleMeter.Gui.Enabled = true end
		if MilkMeter.TrackL then MilkMeter.TrackL.Visible = true end
		if MilkMeter.TrackR then MilkMeter.TrackR.Visible = true end
		if MilkMeter.PauseBtn then
			MilkMeter.PauseBtn.Visible = true
			MilkMeter.PauseBtn.Text = MilkMeter.Paused and "Resume" or "Pause"
		end
		if MilkMeter.WarnLabel then MilkMeter.WarnLabel.Visible = true end
		local showSwell = MilkMeter.SwellEnabled
		if MilkMeter.SwellTrackL then MilkMeter.SwellTrackL.Visible = showSwell end
		if MilkMeter.SwellTrackR then MilkMeter.SwellTrackR.Visible = showSwell end

		local clothed = data.UVToggle == true
		local canDeplete = ((not clothed) or MilkMeter.WorkClothed) and not MilkMeter.Paused
		local now = os.clock()
		local onCdL = now < (MilkMeter.CooldownUntilL or 0)
		local onCdR = now < (MilkMeter.CooldownUntilR or 0)
		local target = MilkMeter.TargetBreast or "both"
		local doL = (target == "both" or target == "left")
		local doR = (target == "both" or target == "right")

		local cap = getMilkCapacity()
		
		if MilkMeter.WasOnCooldownL and not onCdL then
			MilkMeter.FillL = math.max(MilkMeter.FillL or 0, 0.20 * cap)
			MilkMeter.CooldownLatchedL = false
			MilkMeter.DepleteAccL = 0
		end
		if MilkMeter.WasOnCooldownR and not onCdR then
			MilkMeter.FillR = math.max(MilkMeter.FillR or 0, 0.20 * cap)
			MilkMeter.CooldownLatchedR = false
			MilkMeter.DepleteAccR = 0
		end
		
		MilkMeter.FillL = math.clamp(MilkMeter.FillL or 0, 0, cap)
		MilkMeter.FillR = math.clamp(MilkMeter.FillR or 0, 0, cap)
		MilkMeter.WasOnCooldownL = onCdL
		MilkMeter.WasOnCooldownR = onCdR

		
		if not MilkMeter.AlwaysFull then
			local jFill = JiggleMeter.Fill or 0
			local prev = MilkMeter.LastJiggleFill
			if prev == nil then prev = jFill end
			local decayed = prev - jFill
			if decayed > 0.0005 then
				local decayRate = math.max(JiggleMeter.DecayRate or 0.22, 0.05)
				local speedFactor = math.clamp(0.22 / decayRate, 0.35, 2.5)
				local milkGain = (decayed / 0.05) * 0.008 * speedFactor 
				local receivers = 0
				local recvL = doL and not onCdL and (MilkMeter.FillL or 0) > 0
				local recvR = doR and not onCdR and (MilkMeter.FillR or 0) > 0
				if recvL then receivers = receivers + 1 end
				if recvR then receivers = receivers + 1 end
				if receivers > 0 then
					local share = milkGain / receivers
					if recvL then
						MilkMeter.FillL = math.clamp((MilkMeter.FillL or 0) + share, 0, cap)
					end
					if recvR then
						MilkMeter.FillR = math.clamp((MilkMeter.FillR or 0) + share, 0, cap)
					end
				end
			end
			MilkMeter.LastJiggleFill = jFill
		else
			MilkMeter.LastJiggleFill = JiggleMeter.Fill or 0
		end

		if MilkMeter.AlwaysFull then
			MilkMeter.FillL, MilkMeter.FillR = cap, cap
			onCdL, onCdR = false, false
			MilkMeter.CooldownUntilL, MilkMeter.CooldownUntilR = 0, 0
			MilkMeter.CooldownLatchedL, MilkMeter.CooldownLatchedR = false, false
		elseif canDeplete then
			
			local function tickSide(isLeft)
				local fill = isLeft and (MilkMeter.FillL or 0) or (MilkMeter.FillR or 0)
				local acc = isLeft and (MilkMeter.DepleteAccL or 0) or (MilkMeter.DepleteAccR or 0)
				local onCd = isLeft and onCdL or onCdR
				local latch = isLeft and MilkMeter.CooldownLatchedL or MilkMeter.CooldownLatchedR
				local targeted = isLeft and doL or doR

				if not targeted then return end
				if onCd then return end

				
				if fill <= 0 and latch then
					fill = 0.20
					latch = false
					acc = 0
					if isLeft then
						MilkMeter.FillL, MilkMeter.CooldownLatchedL, MilkMeter.DepleteAccL = fill, latch, acc
					else
						MilkMeter.FillR, MilkMeter.CooldownLatchedR, MilkMeter.DepleteAccR = fill, latch, acc
					end
					return
				end
				if fill <= 0 then return end

				acc = acc + dt
				local steps = 0
				while acc >= 0.25 and fill > 0 and steps < 40 do
					acc = acc - 0.25
					fill = math.max(0, fill - 0.02)
					steps = steps + 1
				end

				if fill <= 0 then
					fill = 0
					if not latch then
						latch = true
						if isLeft then
							MilkMeter.CooldownUntilL = os.clock() + 10
							onCdL = true
						else
							MilkMeter.CooldownUntilR = os.clock() + 10
							onCdR = true
						end
					end
				else
					latch = false
				end

				if isLeft then
					MilkMeter.FillL = fill
					MilkMeter.DepleteAccL = acc
					MilkMeter.CooldownLatchedL = latch
				else
					MilkMeter.FillR = fill
					MilkMeter.DepleteAccR = acc
					MilkMeter.CooldownLatchedR = latch
				end
			end
			tickSide(true)
			tickSide(false)
		end

		local fillL = math.clamp(MilkMeter.FillL or 0, 0, cap)
		local fillR = math.clamp(MilkMeter.FillR or 0, 0, cap)
		local fill = math.min(fillL, fillR) 

		
		local intensity = math.clamp((MilkMeter.SwellIntensity or 1) * (MilkMeter._HeatSwellBoost or 1), 0, 5)
		local function swellSide(side, depleting)
			local sk = side == "left" and "SwellL" or "SwellR"
			local ak = side == "left" and "SwellAccL" or "SwellAccR"
			local fk = side == "left" and "FillL" or "FillR"
			local cdk = side == "left" and "CooldownUntilL" or "CooldownUntilR"
			if depleting and MilkMeter.SwellEnabled and not MilkMeter.AlwaysFull and not MilkMeter.Paused then
				local pressure = (MilkMeter.TargetBreast ~= "both") and 2 or 1
				MilkMeter[ak] = (MilkMeter[ak] or 0) + dt
				while MilkMeter[ak] >= 2 do
					MilkMeter[ak] = MilkMeter[ak] - 2
					MilkMeter[sk] = math.clamp((MilkMeter[sk] or 0) + 0.02 * intensity * pressure, 0, 1)
				end
				if (MilkMeter[sk] or 0) >= 1 then
					MilkMeter[sk] = 0
					MilkMeter[ak] = 0
					MilkMeter[fk] = 0
					MilkMeter[cdk] = os.clock() + 10
					if side == "left" then
						MilkMeter.CooldownLatchedL = true
						onCdL = true
						fillL = 0
					else
						MilkMeter.CooldownLatchedR = true
						onCdR = true
						fillR = 0
					end
					MilkMeter.DebuffUntil = os.clock() + 15
				end
			else
				MilkMeter[sk] = math.max(0, (MilkMeter[sk] or 0) - dt * 0.08)
				MilkMeter[ak] = 0
			end
		end
		local depL = doL and canDeplete and not onCdL and fillL > 0
		local depR = doR and canDeplete and not onCdR and fillR > 0
		swellSide("left", depL)
		swellSide("right", depR)

		
		do
			local char = Player.Character
			if data and char and data.CurrentPartList and data.CurrentPartList.BodyPartPhysics then
				for Part, Property in pairs(data.CurrentPartList.BodyPartPhysics) do
					if Part and Part.Parent and Property.Size then
						local n = Part.Name:lower()
						if n:find("breast") or n:find("boob") then
							local isL = n:find("left") or (n:find("l") and not n:find("r"))
							local isR = n:find("right") or (n:find("r") and not n:find("l"))
							local sw = 0
							if isL then sw = MilkMeter.SwellL or 0
							elseif isR then sw = MilkMeter.SwellR or 0
							else sw = math.max(MilkMeter.SwellL or 0, MilkMeter.SwellR or 0)
							end
							if sw > 0 then
								local s = 1 + sw * 0.35
								Part.Size = Property.Size * s
							end
						end
					end
				end
			end
		end

		
		local amt = math.clamp(MilkMeter.ParticleAmount or 0.7, 0, 5)
		
		local rateBase = 22 * amt
		local rL = depL and rateBase or 0
		local rR = depR and rateBase or 0
		if target ~= "both" then
			if depL then rL = rateBase * 2 end
			if depR then rR = rateBase * 2 end
		end
		setMilkParticleRate(rL, rR, dt)
		ensureMilkSound(rL > 0 or rR > 0)

		
		local function setMilkBar(fillBar, pctLabel, absoluteFill)
			local frac = cap > 1e-4 and math.clamp(absoluteFill / cap, 0, 1) or 0
			if fillBar then
				fillBar.Size = UDim2.new(frac, -6 * frac, 1, -6)
			end
			if pctLabel then
				pctLabel.Text = string.format("%d%%", math.floor(absoluteFill * 100 + 0.5))
			end
		end
		local function setBar(fillBar, pctLabel, track, v)
			if fillBar then
				fillBar.Size = UDim2.new(v, -6 * v, 1, -6)
			end
			if pctLabel then
				pctLabel.Text = string.format("%d%%", math.floor(v * 100 + 0.5))
			end
		end
		setMilkBar(MilkMeter.FillBarL, MilkMeter.PctLabelL, fillL)
		setMilkBar(MilkMeter.FillBarR, MilkMeter.PctLabelR, fillR)
