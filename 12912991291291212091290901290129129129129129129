		local function isButtRoot(part)
			local n = string.lower(part.Name)
			if n:find("uv") or n:find("skin") or n:find("texture") or n:find("pant") then
				return false
			end
			if not (n:find("butt") or n:find("ass")) then return false end
			local p = part.Parent
			if p and p:IsA("BasePart") then
				local pn = string.lower(p.Name)
				if pn:find("butt") or pn:find("ass") then return false end
			end
			return true
		end

		local function pickLeg(part, n)
			if n:find("left") and not n:find("right") then
				return leftLeg
			end
			if n:find("right") then
				return rightLeg
			end
			local root = Character:FindFirstChild("HumanoidRootPart")
				or Character:FindFirstChild("Torso")
				or Character:FindFirstChild("UpperTorso")
			if root then
				if part.Position.X >= root.Position.X then
					return rightLeg
				else
					return leftLeg
				end
			end
			return rightLeg
		end

		local rebound, gotLeft, gotRight = 0, false, false
		for _, d in ipairs(morph:GetDescendants()) do
			if not d:IsA("BasePart") then continue end
			if not isButtRoot(d) then continue end
			local n = string.lower(d.Name)
			local leg = pickLeg(d, n)
			if not leg then continue end

			local weld = findWeld(d)
			if not weld then continue end

			if weld.Part0 == leg then
				if leg == leftLeg then gotLeft = true end
				if leg == rightLeg then gotRight = true end
				continue
			end

			local worldCF = d.CFrame
			weld.Part0 = leg
			weld.Part1 = d
			local c1 = weld.C1
			if typeof(c1) ~= "CFrame" then c1 = CFrame.new() end
			weld.C0 = leg.CFrame:ToObjectSpace(worldCF) * c1

			local pd = PlayerData[Data]
			local physList = pd and pd.CurrentPartList and pd.CurrentPartList.BodyPartPhysics
			if physList and physList[d] then
				
				
				physList[d].Weld = weld
				physList[d].CF = weld.C0
				physList[d].CF1 = weld.C1
				local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
				if torso then
					physList[d].Base = torso
					physList[d].OriginCFrame = torso.CFrame
				end
				if physList[d].Spring then
					physList[d].Spring.Position = Vector3.zero
					physList[d].Spring.Velocity = Vector3.zero
				end
			end
			rebound += 1
			if leg == leftLeg then gotLeft = true end
			if leg == rightLeg then gotRight = true end
		end
		return rebound, gotLeft, gotRight
	end

	function Function.ApplyPhysicsToggle(Character, Data, kind, enabled)
		
