	function beginSquirtSequence()
		if not HeatMeter.SquirtEnabled then return end
		if HeatMeter.SquirtState ~= "idle" then return end
		local now = os.clock()
		HeatMeter.SquirtState = "delay"
		HeatMeter.SquirtDelayUntil = now + 3
		HeatMeter.SquirtLatched = true
		
		local data = PlayerData[Player.Name]
		if data and data.UVToggle == true then
			data.UVToggle = false
			if SyncMorphUI.UpdateMode then pcall(SyncMorphUI.UpdateMode) end
			if Player.Character then
				pcall(function() Function.CharacterExecute(Player.Character, Player.Name) end)
			end
		end
		print("[Heat] Squirt delay 3s — forcing naked")
	end

	function stepSquirt(dt)
		if not HeatMeter.Enabled or not HeatMeter.SquirtEnabled then
			if HeatMeter.SquirtState ~= "idle" then stopSquirtFX() end
			return
		end
		local now = os.clock()
		local fill = HeatMeter.Fill or 0

		
		if HeatMeter.SquirtLatched and HeatMeter.SquirtState == "idle" and fill < 0.85 then
			HeatMeter.SquirtLatched = false
		end

		if HeatMeter.SquirtState == "idle" then
			if fill >= 0.995 and not HeatMeter.SquirtLatched then
				beginSquirtSequence()
			end
			return
		end

		if HeatMeter.SquirtState == "delay" then
			if now >= HeatMeter.SquirtDelayUntil then
				HeatMeter.SquirtState = "active"
				pcall(function()
					if Function.GrantAchievement then Function.GrantAchievement("squirter") end
				end)
				pcall(function()
					if Function.CompleteChallenge then Function.CompleteChallenge("cant_hold_it") end
				end)
				pcall(function()
					local rt = Function.AchievementRuntime
					if rt then rt.AftershockUntil = os.clock() + 60 end
				end)
				HeatMeter.SquirtActiveUntil = now + 2
				HeatMeter.SquirtSpawnAcc = 0
				
				HeatMeter.Fill = 0
				ensureSquirtSound(true)
				print("[Heat] Squirt active 2s")
			end
			return
		end

		if HeatMeter.SquirtState == "active" then
			if now >= HeatMeter.SquirtActiveUntil then
				stopSquirtFX()
				HeatMeter.Fill = 0
				return
			end
			ensureSquirtSound(true)
			HeatMeter.Fill = 0 
			local mess = HeatMeter.SquirtMessiness or 1
			
			local rate = 18 + mess * 22 
			HeatMeter.SquirtSpawnAcc = (HeatMeter.SquirtSpawnAcc or 0) + dt * rate
			local char = Player.Character
			local part, cf = findVaginaOrigin(char)
			if cf then
				while HeatMeter.SquirtSpawnAcc >= 1 do
					HeatMeter.SquirtSpawnAcc = HeatMeter.SquirtSpawnAcc - 1
					spawnSquirtDroplet(cf, mess)
				end
			end
		end
	end

