						CastShadow = d.CastShadow,
						CanQuery = d.CanQuery,
						CanTouch = d.CanTouch,
					}
				end

				-- Shadows off on everything near the camera (big win)
				d.CastShadow = false
				-- Raycast/touch off while in FP (physics/sweat don't need them every frame)
				d.CanQuery = false
