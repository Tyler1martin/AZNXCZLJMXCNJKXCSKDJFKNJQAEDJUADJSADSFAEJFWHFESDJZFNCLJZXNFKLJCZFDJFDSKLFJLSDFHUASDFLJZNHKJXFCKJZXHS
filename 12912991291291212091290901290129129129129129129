			if typeof(GlassSystem.LastFilledFlavor.color) == "Color3" then
				col = GlassSystem.LastFilledFlavor.color
			end
		end
		return {
			id = tostring(id or "plain"),
			name = tostring(name or "Milk"),
			r = col.R, g = col.G, b = col.B,
			heated = GlassSystem.Heated == true or GlassSystem.FlavorHeated == true,
			left = GlassSystem._flavorLeft,
			right = GlassSystem._flavorRight,
			sizeScale = GlassSystem.FlavorSizeScale or 1,
		}
	end

