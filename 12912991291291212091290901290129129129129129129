--[[
	FP helper
	- Head hide + camera orbit + 1 stud forward in FP
	- Body/morph/clothing LTM override (set USE_LTM_OVERRIDE false if you forked PlayerModule)
	- Rebuilds cache when Morph is removed/re-added (no F7 toggle needed)
]]

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

------------------------------------------------------------
local HeightAdjust = -1.4
local SmoothSpeed = 0.35
local MaxHorizontalOffset = 0.5
local ForwardOffsetAmount = 1.0
local FirstPersonThreshold = 2.5
local BIND_NAME = "FP_Helper"
-- Prefer PlayerModule fork, then set this false to remove lag from LTM fight
local USE_LTM_OVERRIDE = true
------------------------------------------------------------

local Enabled = false
local CurrentOffset = Vector3.zero
local LastFP = false
local LastChar = nil
local HeadParts = {}
local BodyParts = {}
local WatchConns = {}
local MorphGen = 0

local function disconnectWatches()
	for _, c in ipairs(WatchConns) do pcall(function() c:Disconnect() end) end
	table.clear(WatchConns)
end

local function clearCaches()
	disconnectWatches()
	table.clear(HeadParts)
	table.clear(BodyParts)
end

local function alreadyIn(list, p)
	for i = 1, #list do if list[i] == p then return true end end
	return false
end

local function isHeadAccessory(acc, head)
	if not acc or not acc:IsA("Accessory") then return false end
	local handle = acc:FindFirstChild("Handle")
	if not handle then return false end
	local att = handle:FindFirstChildOfClass("Attachment")
	if att and string.find(string.lower(att.Name), "head") then return true end
	for _, j in ipairs(handle:GetJoints()) do
		if j.Part0 == head or j.Part1 == head then return true end
	end
	return false
end

local function shouldKeepVisible(part)
	if not part:IsA("BasePart") then return false end
	local name = part.Name
	if name == "Head" or name == "HumanoidRootPart" or name == "BreastsRoot" then return false end
	if name == "TorsoMesh" and part.Transparency >= 0.99 then return false end
	return true -- solids + clothing UV/texture
end

local function addHead(part)
	if not part then return end
	if not (part:IsA("BasePart") or part:IsA("Decal")) then return end
	if alreadyIn(HeadParts, part) then return end
	HeadParts[#HeadParts + 1] = part
end

local function addBody(part)
	if not shouldKeepVisible(part) then return end
	if alreadyIn(BodyParts, part) then return end
	if alreadyIn(HeadParts, part) then return end
	BodyParts[#BodyParts + 1] = part
end

local function sweepMorph(morph)
	for _, d in ipairs(morph:GetDescendants()) do addBody(d) end
end

local function ingestMorph(morph, gen)
	sweepMorph(morph)
	WatchConns[#WatchConns + 1] = morph.DescendantAdded:Connect(function(d)
		if gen ~= MorphGen then return end
		addBody(d)
	end)
	-- async welds
	task.spawn(function()
		for _ = 1, 12 do
			task.wait(0.1)
			if gen ~= MorphGen or not morph.Parent then return end
			sweepMorph(morph)
		end
		print(string.format("[FP] morph settled: body=%d", #BodyParts))
	end)
end

local function rebuild(char)
	MorphGen = MorphGen + 1
	local gen = MorphGen
	clearCaches()
	if not char then return end
	local head = char:FindFirstChild("Head")
	if not head then return end

	addHead(head)
	for _, d in ipairs(head:GetDescendants()) do addHead(d) end

	for _, child in ipairs(char:GetChildren()) do
		if isHeadAccessory(child, head) then
			local handle = child:FindFirstChild("Handle")
			if handle then
				addHead(handle)
				for _, d in ipairs(handle:GetDescendants()) do addHead(d) end
			end
		elseif child:IsA("BasePart") then
			addBody(child)
		elseif child:IsA("Accessory") then
			local handle = child:FindFirstChild("Handle")
			if handle then addBody(handle) end
		elseif child.Name == "Morph" then
			ingestMorph(child, gen)
		end
	end

	WatchConns[#WatchConns + 1] = char.ChildAdded:Connect(function(c)
		if gen ~= MorphGen then return end
		if c.Name == "Morph" then
			ingestMorph(c, gen)
		elseif c:IsA("BasePart") then
			addBody(c)
		end
	end)

	WatchConns[#WatchConns + 1] = char.ChildRemoved:Connect(function(c)
		if c.Name == "Morph" then
			-- full rebuild next frame
			task.defer(function()
				if Player.Character == char and Enabled then
					rebuild(char)
				end
			end)
		end
	end)

	print(string.format("[FP] cache head=%d body=%d", #HeadParts, #BodyParts))
end

local function applyHead(hidden)
	local v = hidden and 1 or 0
	for _, p in ipairs(HeadParts) do
		if p and p.Parent then p.LocalTransparencyModifier = v end
	end
end

local function applyBody()
	for _, p in ipairs(BodyParts) do
		if p and p.Parent then p.LocalTransparencyModifier = 0 end
	end
end

local function onRender()
	local char = Player.Character
	if not char then return end
	if char ~= LastChar then
		LastChar = char
		rebuild(char)
		LastFP = false
		CurrentOffset = Vector3.zero
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	local head = char:FindFirstChild("Head")
	if not (hum and root and head) then return end

	local cam = workspace.CurrentCamera
	if not cam then return end
	if cam.CameraType ~= Enum.CameraType.Custom then
		cam.CameraType = Enum.CameraType.Custom
	end
	cam.CameraSubject = hum

	local zoom = (cam.CFrame.Position - root.Position).Magnitude
	local isFP = zoom <= FirstPersonThreshold

	if isFP then
		applyHead(true)
		if USE_LTM_OVERRIDE then
			applyBody()
		end
	elseif LastFP then
		applyHead(false)
	end

	LastFP = isFP
	Player:SetAttribute("ForceFP", isFP)

	local raw = root.CFrame:PointToObjectSpace(head.Position)
	local horiz = Vector3.new(raw.X, 0, raw.Z)
	if horiz.Magnitude > MaxHorizontalOffset then
		horiz = horiz.Unit * MaxHorizontalOffset
	end
	local forward = isFP and Vector3.new(0, 0, -ForwardOffsetAmount) or Vector3.zero
	local target = Vector3.new(horiz.X + forward.X, raw.Y + HeightAdjust, horiz.Z + forward.Z)
	CurrentOffset = CurrentOffset:Lerp(target, SmoothSpeed)
	hum.CameraOffset = CurrentOffset
end

local function enable()
	pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)
	LastChar = nil
	LastFP = false
	CurrentOffset = Vector3.zero
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Last.Value, onRender)
	print("[FP] ON")
end

local function disable()
	pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)
	Player:SetAttribute("ForceFP", false)
	local char = Player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.CameraOffset = Vector3.zero end
		applyHead(false)
	end
	clearCaches()
	LastFP = false
	LastChar = nil
	print("[FP] OFF")
end

UIS.InputBegan:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.F7 then
		Enabled = not Enabled
		if Enabled then enable() else disable() end
	end
end)

Player.CharacterAdded:Connect(function()
	task.wait(0.5)
	if Enabled then enable() end
end)

print("[FP] Ready. F7 toggle.")









