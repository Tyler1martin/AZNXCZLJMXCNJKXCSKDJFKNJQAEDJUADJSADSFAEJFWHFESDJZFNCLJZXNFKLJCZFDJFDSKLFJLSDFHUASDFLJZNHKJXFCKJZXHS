	function isFlavorDiscovered(data, id)
		if id == nil then return false end
		id = tostring(id)
		if FlavorDiscoveryStore[id] ~= nil then return true end
		if data and type(data.DiscoveredFlavors) == "table" then
			local e = data.DiscoveredFlavors[id]
			if e == true or type(e) == "table" then return true end
		end
		return false
	end

	function DiscoverFlavor(id, name, color)
		if id == nil or id == "" or id == "plain" then return false end
		id = tostring(id)
		name = tostring(name or id)
		local r = (typeof(color) == "Color3") and color.R or 1
		local g = (typeof(color) == "Color3") and color.G or 1
		local b = (typeof(color) == "Color3") and color.B or 1
		local entry = { name = name, r = r, g = g, b = b, t = os.clock() }

		local function unlock(key)
			if not key or key == "" or key == "plain" then return false end
			key = tostring(key)
			if FlavorDiscoveryStore[key] ~= nil then return false end
			FlavorDiscoveryStore[key] = entry
			return true
		end

		local isNew = unlock(id)
		local baseId = string.gsub(string.gsub(id, "_hot$", ""), "_peak$", "")
		if baseId ~= id and unlock(baseId) then isNew = true end
		local lowerName = string.lower(name)
		if MilkFlavorMix then
			for _, mix in pairs(MilkFlavorMix) do
				if mix and mix.id and mix.name and string.lower(tostring(mix.name)) == lowerName then
					if unlock(tostring(mix.id)) then isNew = true end
					local bid = string.gsub(string.gsub(tostring(mix.id), "_hot$", ""), "_peak$", "")
					if unlock(bid) then isNew = true end
				end
			end
		end
		FlavorDiscoveryStore["name:" .. name] = entry
		FlavorDiscoveryStore["name:" .. lowerName] = entry

		
		pcall(function()
			if Function.PlayerDataAdd then Function.PlayerDataAdd(Player.Name) end
			local data = PlayerData[Player.Name]
			if data then
				data.DiscoveredFlavors = data.DiscoveredFlavors or {}
				for k, v in pairs(FlavorDiscoveryStore) do
					if data.DiscoveredFlavors[k] == nil then
						data.DiscoveredFlavors[k] = v
					end
				end
			end
		end)

		if isNew then
			pcall(function() showFlavorDiscoverNotify(name, color) end)
		pcall(function() if Function.OnFlavorDiscoveredCount then Function.OnFlavorDiscoveredCount() end end)
		end
		local function doBookRefresh()
			pcall(function()
				if ForceRefreshFlavorBook then
					ForceRefreshFlavorBook()
				elseif SyncMorphUI and SyncMorphUI.RefreshFlavorBook then
					SyncMorphUI.RefreshFlavorBook()
				end
			end)
		end
		doBookRefresh()
		task.defer(doBookRefresh)
		task.delay(0.15, doBookRefresh)
		task.delay(0.5, doBookRefresh)
		return isNew
	end

	
