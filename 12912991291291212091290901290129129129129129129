	function colorToStr(c)
		if typeof(c) ~= "Color3" then return "255,255,255" end
		return string.format("%d,%d,%d", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
	end
	function parseColor3(str, fallback)
		if typeof(str) == "Color3" then return str end
		if type(str) ~= "string" then return fallback end
		local r,g,b = str:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
		if not r then
			local h = str:match("#?(%x%x%x%x%x%x)")
			if h then
				r = tonumber(h:sub(1,2), 16)
				g = tonumber(h:sub(3,4), 16)
				b = tonumber(h:sub(5,6), 16)
			end
		end
		if r and g and b then
			return Color3.fromRGB(math.clamp(tonumber(r),0,255), math.clamp(tonumber(g),0,255), math.clamp(tonumber(b),0,255))
		end
		return fallback
	end
