		if objectName:find("uv") or objectName:find("texture") then

			if Extra.Shirt and (objectName:find("shirt") or objectName:find("boob") or objectName:find("breast") or objectName:find("torso") or objectName:find("arm")) then
				ObjectInstance.TextureID = Extra.Shirt.ShirtTemplate
			end
