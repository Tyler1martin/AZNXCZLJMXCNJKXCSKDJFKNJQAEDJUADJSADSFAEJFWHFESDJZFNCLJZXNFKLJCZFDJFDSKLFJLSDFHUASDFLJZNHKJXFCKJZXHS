	function bloodGetFolder()
		if BloodSystem.Folder and BloodSystem.Folder.Parent then
			return BloodSystem.Folder
		end
		local f = Instance.new("Folder")
		f.Name = "MorphBloodFX"
		f.Parent = workspace.CurrentCamera or workspace
		BloodSystem.Folder = f
		return f
	end

	function bloodClearAll()
		if BloodSystem.Folder then
			pcall(function() BloodSystem.Folder:ClearAllChildren() end)
		end
		BloodSystem.ActiveDrops = 0
	end

	function bloodPlaySound(parent, id, vol, pitch)
		if App.MasterSFXMute then return end
		local s = Instance.new("Sound")
		s.Name = "MorphBloodSFX"
		s.SoundId = id
		s.Volume = math.clamp(tonumber(vol) or 0.5, 0, 2)
		s.PlaybackSpeed = math.clamp(tonumber(pitch) or 1, 0.5, 2)
		s.RollOffMaxDistance = 100
		local host = parent
		if not (host and host:IsA("BasePart")) then
			local char = Player.Character
			host = char and (char:FindFirstChild("Head") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart"))
		end
		s.Parent = host or bloodGetFolder()
		task.defer(function()
			pcall(function()
				if s.Parent then s:Play() end
			end)
		end)
		s.Ended:Connect(function()
			pcall(function() s:Destroy() end)
		end)
	end

	function bloodSplatterSound(parent)
		local ids = {BloodSystem.SndUnder25, BloodSystem.Snd25to50, BloodSystem.SndOver50}
		local id = ids[math.random(1, #ids)]
		local vol = 1.2 + math.random() * 0.3 
		local pitch = 0.7 + math.random() * 0.3 
		bloodPlaySound(parent, id, vol, pitch)
	end

	function bloodPickPart(char)
		if not char then return nil end
		local pool = {}
		for _, name in ipairs(BloodSystem.BodyParts) do
			local p = char:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				pool[#pool + 1] = p
			end
		end
		local morph = char:FindFirstChild("Morph")
		if morph then
			for _, name in ipairs(BloodSystem.BreastParts) do
				local p = morph:FindFirstChild(name, true)
				if p and p:IsA("BasePart") then
					pool[#pool + 1] = p
				end
			end
			for _, name in ipairs({"TorsoMesh", "Left Leg Mesh", "Right Leg Mesh"}) do
				local p = morph:FindFirstChild(name, true)
				if p and p:IsA("BasePart") then
					pool[#pool + 1] = p
				end
			end
		end
		if #pool == 0 then return nil end
		return pool[math.random(1, #pool)]
	end

	function bloodSpawnPuddle(pos, normal, sizeScale)
		local folder = bloodGetFolder()
		local puddle = Instance.new("Part")
		puddle.Name = "BloodPuddle"
		puddle.Anchored = true
		puddle.CanCollide = false
		puddle.CanQuery = false
		puddle.CanTouch = false
		puddle.CastShadow = false
		puddle.Material = Enum.Material.SmoothPlastic
		puddle.Color = BloodSystem.BloodColor or Color3.fromRGB(70, 4, 4)
		puddle.Transparency = 0.12
		
		local diam = math.clamp((sizeScale or 0.4) * 2.4, 0.45, 1.35)
		puddle.Size = Vector3.new(diam, 0.04, diam)
		local up = normal.Magnitude > 0.05 and normal.Unit or Vector3.yAxis
		puddle.CFrame = CFrame.lookAt(pos + up * 0.03, pos + up) * CFrame.Angles(math.rad(-90), 0, 0)
		puddle.Parent = folder

		local life = (BloodSystem.PuddleMinLife or 3) + math.random() * ((BloodSystem.PuddleMaxLife or 5) - (BloodSystem.PuddleMinLife or 3))
		task.spawn(function()
			local t0 = os.clock()
			while puddle.Parent and (os.clock() - t0) < life do
				local a = math.clamp((os.clock() - t0) / life, 0, 1)
				
				local fade = a * a
				puddle.Transparency = 0.12 + fade * 0.88
				task.wait(0.05)
			end
			pcall(function() puddle:Destroy() end)
		end)
	end

	function bloodSpawnDrop(origin, dir, opts)
		opts = opts or {}
		if BloodSystem.ActiveDrops >= BloodSystem.MaxDrops then return end
		BloodSystem.ActiveDrops = BloodSystem.ActiveDrops + 1
		local folder = bloodGetFolder()

		
		local sizeChoices = { 0.9, 1.0, 1.1, 1.2 }
		local sizeMul = sizeChoices[math.random(1, #sizeChoices)]
		if opts.sizeMul then
			sizeMul = sizeMul * opts.sizeMul
		end
		local baseSz = 0.34 + math.random() * 0.14
		local sz = baseSz * sizeMul

		local drop = Instance.new("Part")
		drop.Name = "BloodSplatterDrop"
		drop.Shape = Enum.PartType.Ball
		drop.Size = Vector3.new(sz, sz, sz)
		drop.Color = BloodSystem.BloodColor or Color3.fromRGB(70, 4, 4)
		drop.Material = Enum.Material.SmoothPlastic
		drop.Transparency = 0.05
		drop.CanCollide = false
		drop.CanQuery = false
		drop.CanTouch = false
		
		drop.Massless = false
		drop.CastShadow = false
		pcall(function()
			drop.CustomPhysicalProperties = PhysicalProperties.new(0.5, 0.4, 0, 1, 1)
		end)
		drop.CFrame = CFrame.new(origin)
		drop.Parent = folder

		
		if dir.Magnitude < 0.05 then dir = Vector3.new(0, 1, 0) end
		dir = dir.Unit
		local upBias = 0.55 + math.random() * 0.55
		dir = (dir + Vector3.new(0, upBias, 0)).Unit
		local forceMul = opts.forceMul or 1
		
		local speed = (28 + math.random() * 26) * 0.6 * forceMul
		
		drop.AssemblyLinearVelocity = dir * speed
		pcall(function()
			drop:ApplyImpulse(dir * speed * drop.AssemblyMass * 0.35)
		end)

		local a0 = Instance.new("Attachment")
		a0.Parent = drop
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, sz * 0.55, 0)
		a1.Parent = drop
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.55
		trail.MinLength = 0.08
		trail.FaceCamera = true
		trail.Color = ColorSequence.new(Color3.fromRGB(55, 2, 2), Color3.fromRGB(20, 0, 0))
		trail.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.06),
			NumberSequenceKeypoint.new(1, 1),
		})
		local w0 = math.clamp(sz * 2.4, 0.45, 1.45)
		trail.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, w0),
			NumberSequenceKeypoint.new(1, w0 * 0.1),
		})
		trail.LightEmission = 0
		trail.Parent = drop

		
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local exclude = { folder, drop }
		local char = Player.Character
		if char then exclude[#exclude + 1] = char end
		params.FilterDescendantsInstances = exclude
		params.IgnoreWater = true

		local lifetime = opts.lifetime or 0.7
		task.spawn(function()
			local t0 = os.clock()
			local madePuddle = false
			while drop.Parent and (os.clock() - t0) < lifetime do
				local vel = drop.AssemblyLinearVelocity
				local mag = vel.Magnitude
				local step = math.clamp(mag * 0.04, 0.35, 3.5)
				local look = mag > 0.5 and vel.Unit or Vector3.new(0, -1, 0)
				local result = workspace:Raycast(drop.Position, look * step, params)
				if not result then
					
					result = workspace:Raycast(drop.Position, Vector3.new(0, -step, 0), params)
				end
				if result then
					bloodSpawnPuddle(result.Position, result.Normal, sz)
					madePuddle = true
					break
				end
				task.wait(0.03)
			end
			pcall(function() drop:Destroy() end)
			BloodSystem.ActiveDrops = math.max(0, BloodSystem.ActiveDrops - 1)
		end)
	end

	function bloodBurst(char, count, origin, opts)
		opts = opts or {}
		bloodSplatterSound(origin and nil or bloodPickPart(char))
		
		local part = bloodPickPart(char)
		if part then bloodSplatterSound(part) end
		if not origin and part then
			origin = part.Position + Vector3.new(
				(math.random() - 0.5) * part.Size.X * 0.4,
				(math.random() - 0.5) * part.Size.Y * 0.4,
				(math.random() - 0.5) * part.Size.Z * 0.4
			)
		end
		if not origin then return end
		for _ = 1, count do
			local dir = Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
			if dir.Magnitude < 0.05 then dir = Vector3.new(0, 1, 0) end
			bloodSpawnDrop(origin, dir.Unit, opts)
		end
	end

	function bloodOnDamaged(dmg, char)
		if not BloodSystem.Enabled or not App.SystemActive then return end
		if dmg < 0.5 then return end
		local part = bloodPickPart(char)
		if not part then return end
		local intensity = BloodSystem.Intensity
		if PlayerData[Player.Name] and PlayerData[Player.Name].BloodIntensity ~= nil then
			intensity = PlayerData[Player.Name].BloodIntensity
		end
		
		local count = math.clamp(math.floor(7 + intensity * 6 + math.random() * 4), 7, 18)
		local origin = part.Position + Vector3.new(
			(math.random() - 0.5) * part.Size.X * 0.4,
			(math.random() - 0.5) * part.Size.Y * 0.4,
			(math.random() - 0.5) * part.Size.Z * 0.4
		)
		bloodSplatterSound(part)
		for _ = 1, count do
			local dir = Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
			if dir.Magnitude < 0.05 then dir = Vector3.new(0, 1, 0) end
			bloodSpawnDrop(origin, dir.Unit, { forceMul = 1, sizeMul = 1 })
		end
	end

	function bloodOnDeath(char)
		if not BloodSystem.Enabled or not App.SystemActive then return end
		local part = bloodPickPart(char)
		local origin
		if part then
			origin = part.Position
			bloodSplatterSound(part)
		else
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			origin = hrp and hrp.Position or nil
		end
		if not origin then return end
		
		local count = math.random(15, 30)
		for _ = 1, count do
			local dir = Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
			if dir.Magnitude < 0.05 then dir = Vector3.new(0, 1, 0) end
			bloodSpawnDrop(origin, dir.Unit, {
				sizeMul = 1.5, 
				forceMul = 1.55,
				lifetime = 0.95,
			})
		end
	end

	function bloodHookCharacter(char)
		if BloodSystem.HealthConn then
			pcall(function() BloodSystem.HealthConn:Disconnect() end)
			BloodSystem.HealthConn = nil
		end
		if BloodSystem.DiedConn then
			pcall(function() BloodSystem.DiedConn:Disconnect() end)
			BloodSystem.DiedConn = nil
		end
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		BloodSystem.LastHealth = hum.Health
		BloodSystem.HealthConn = hum.HealthChanged:Connect(function(newHp)
			if not BloodSystem.Enabled or not App.SystemActive then
				BloodSystem.LastHealth = newHp
				return
			end
			local old = BloodSystem.LastHealth or newHp
			BloodSystem.LastHealth = newHp
			local dmgAmt = old - newHp
			if dmgAmt > 0.5 and newHp > 0 then
				bloodOnDamaged(dmgAmt, char)
			end
		end)
		BloodSystem.DiedConn = hum.Died:Connect(function()
			onPlayerDied(char)
			bloodOnDeath(char)
		end)
	end

	function bloodSetEnabled(on)
		BloodSystem.Enabled = on == true
		if PlayerData[Player.Name] then
			PlayerData[Player.Name].BloodEffectsEnabled = BloodSystem.Enabled
		end
		if not BloodSystem.Enabled then
			bloodClearAll()
		else
			bloodHookCharacter(Player.Character)
		end
		if SyncMorphUI.RefreshToggles then pcall(SyncMorphUI.RefreshToggles) end
	end

	function morphEnableDeathCollision(char)
		if not char then return end
		local morph = char:FindFirstChild("Morph")
		if not morph then return end
		for _, d in ipairs(morph:GetDescendants()) do
			if d:IsA("BasePart") then
				local n = string.lower(d.Name or "")
				
				local isTorso = n:find("torso") ~= nil
				local isLeg = n:find("leg") ~= nil or n:find("foot") ~= nil
				if isTorso or isLeg then
					d.CanCollide = true
					d.Massless = false
					pcall(function()
						d.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.5, 0.2, 1, 1)
					end)
				end
			end
		end
	end

	function onPlayerDied(char)
		HeartSFX.Dead = true
		pcall(stopHeartSound)
		pcall(function() morphEnableDeathCollision(char) end)
	end

	function hookDeathForChar(char)
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		hum.Died:Connect(function()
			onPlayerDied(char)
		end)
	end

