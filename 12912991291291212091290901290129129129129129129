				end
				if not known and data and data.DiscoveredFlavors then
					local nm = mix.name and tostring(mix.name) or ""
					if nm ~= "" and (data.DiscoveredFlavors["name:" .. nm] or data.DiscoveredFlavors["name:" .. string.lower(nm)]) then
						known = true
						data.DiscoveredFlavors[mix.id] = data.DiscoveredFlavors["name:" .. nm] or data.DiscoveredFlavors["name:" .. string.lower(nm)]
					else
						for _, info in pairs(data.DiscoveredFlavors) do
							if type(info) == "table" and info.name and nm ~= "" and string.lower(tostring(info.name)) == string.lower(nm) then
								known = true
