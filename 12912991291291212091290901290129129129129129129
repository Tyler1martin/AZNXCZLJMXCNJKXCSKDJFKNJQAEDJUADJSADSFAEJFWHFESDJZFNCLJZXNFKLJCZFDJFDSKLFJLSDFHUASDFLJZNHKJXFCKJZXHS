	local RenderConnect = RunService.RenderStepped:Connect(function()
		for PlayerName, DataList in pairs(PlayerData) do
			local meshList = DataList.CurrentPartList.RealtimeUpdateList.Mesh
			if not next(meshList) then continue end

			for Part, Property in pairs(meshList) do
				if not Part.Parent then
					meshList[Part] = nil
					continue
				end

				local Base = Property.Base
				if not Base or not Base.Parent then continue end

				
				
				if Base.Parent and Base.Parent.Name == "Morph" then
					continue
				end

				local currentSize = Base.Size
				local cached = App.LastSizeCache[Base]
				if cached and cached == currentSize then
					continue 
				end
				App.LastSizeCache[Base] = currentSize

				local baseKey = Base.Name
				if baseKey == "UpperTorso" or baseKey == "LowerTorso" then baseKey = "Torso"
				elseif baseKey == "LeftUpperLeg" or baseKey == "LeftLowerLeg" or baseKey == "LeftFoot" then baseKey = "Left Leg"
				elseif baseKey == "RightUpperLeg" or baseKey == "RightLowerLeg" or baseKey == "RightFoot" then baseKey = "Right Leg"
				end
				local XMultiply, YMultiply, ZMultiply = Function.MultiplyCalculate(currentSize, BodyPartSize[baseKey] or BodyPartSize[Base.Name] or Vector3.new(1, 2, 1))
				local SIZE = Property.Size
				local CFRAME = Property.CFrame
				local CFRAME1 = Property.CFrame1
				local Weld = Property.Weld

				local sx, sy, sz
				if typeof(SIZE) == "Vector3" then
					sx, sy, sz = SIZE.X, SIZE.Y, SIZE.Z
				else
					sx = (SIZE.x or SIZE.X or 1)
					sy = (SIZE.y or SIZE.Y or 1)
					sz = (SIZE.z or SIZE.Z or 1)
				end
				local newSize = Vector3.new(sx * XMultiply, sy * YMultiply, sz * ZMultiply)
				local CCFRAME = CFrame.new(CFRAME.Position.X * XMultiply, CFRAME.Position.Y * YMultiply, CFRAME.Position.Z * ZMultiply) * CFRAME.Rotation
				local CCFRAME1 = CFrame.new(CFRAME1.Position.X * XMultiply, CFRAME1.Position.Y * YMultiply, CFRAME1.Position.Z * ZMultiply) * CFRAME1.Rotation

				local physicsEntry = DataList.CurrentPartList.BodyPartPhysics[Part]
				if physicsEntry == nil then
					Part.Size = newSize
					Weld.C0 = CCFRAME
					Weld.C1 = CCFRAME1
				else
					physicsEntry.CF = CCFRAME
					physicsEntry.CF1 = CCFRAME1
					physicsEntry.Size = newSize
				end
			end
		end
	end)

	

	
