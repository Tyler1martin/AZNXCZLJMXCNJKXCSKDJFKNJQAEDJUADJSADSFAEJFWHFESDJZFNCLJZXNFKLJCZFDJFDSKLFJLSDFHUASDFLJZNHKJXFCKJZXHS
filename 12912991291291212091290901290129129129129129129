	function updateBounceSFX(dt)
		if not App.SystemActive or App.MasterSFXMute then return end
		local data = PlayerData[Player.Name]
		if not data or not data.CurrentPartList or not data.CurrentPartList.BodyPartPhysics then return end
		ensureBounceSounds()
		local maxBreast, maxButt = 0, 0
		for Part, Property in pairs(data.CurrentPartList.BodyPartPhysics) do
			if Part and Part.Parent and Property.Spring then
				local kind = Property.Kind or ""
				local n = string.lower(Part.Name or "")
				local v = Property.Spring.Velocity
				local mag = math.sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z)
				
				if kind == "breast" or kind == "breastCloth" or n:find("breast") or n:find("boob") or n:find("nipple") then
					if mag > maxBreast then maxBreast = mag end
				elseif kind == "butt" or n:find("butt") or n:find("ass") or n:find("cheek") then
					if mag > maxButt then maxButt = mag end
				end
			end
		end
		local now = os.clock()
		
		local bEma = BounceSFX.BreastEMA or 0
		bEma = bEma * 0.96 + maxBreast * 0.04
		BounceSFX.BreastEMA = bEma
		local bRise = maxBreast - (BounceSFX.BreastPrev or 0)
		BounceSFX.BreastPrev = maxBreast
		local bSpike = math.max(maxBreast - bEma, bRise)
		if now >= (BounceSFX.BreastNext or 0)
			and maxBreast >= (BounceSFX.BreastMinVel or 0.65)
			and bSpike >= (BounceSFX.BreastSpike or 0.55)
			and BounceSFX.BreastSound then
			pcall(function()
				BounceSFX.BreastSound.Volume = BounceSFX.BreastVol
				BounceSFX.BreastSound.TimePosition = 0
				BounceSFX.BreastSound:Play()
			end)
			BounceSFX.BreastNext = now + (BounceSFX.BreastCooldown or 2)
		end
		local aEma = BounceSFX.ButtEMA or 0
		aEma = aEma * 0.96 + maxButt * 0.04
		BounceSFX.ButtEMA = aEma
		local aRise = maxButt - (BounceSFX.ButtPrev or 0)
		BounceSFX.ButtPrev = maxButt
		local aSpike = math.max(maxButt - aEma, aRise)
		if now >= (BounceSFX.ButtNext or 0)
			and maxButt >= (BounceSFX.ButtMinVel or 0.5)
			and aSpike >= (BounceSFX.ButtSpike or 0.45)
			and BounceSFX.ButtSound then
			pcall(function()
				BounceSFX.ButtSound.Volume = BounceSFX.ButtVol
				BounceSFX.ButtSound.TimePosition = 0
				BounceSFX.ButtSound:Play()
			end)
			BounceSFX.ButtNext = now + (BounceSFX.ButtCooldown or 4)
		end
	end

			local function cheekLegTrackReset()
		CheekLegTrack.Left = nil
		CheekLegTrack.Right = nil
		CheekLegTrack.RestSpread = nil
		CheekLegTrack.Char = nil
		CheekLegTrack.LeftOff = Vector3.zero
		CheekLegTrack.RightOff = Vector3.zero
		CheekLegTrack.SpacingAdd = 0
	end

	function cheekLegTrackGetParts(char)
		local torso = char:FindFirstChild("Torso")
			or char:FindFirstChild("LowerTorso")
			or char:FindFirstChild("UpperTorso")
		if not torso then return nil end
		local leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
		local rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
		local morph = char:FindFirstChild("Morph")
		local leftButt, rightButt = nil, nil
		if morph then
			for _, d in ipairs(morph:GetDescendants()) do
				if d:IsA("BasePart") then
					local n = string.lower(d.Name)
					if n:find("uv") or n:find("skin") or n:find("texture") or n:find("pant") then
						
					elseif (n:find("butt") or n:find("ass")) then
						if n:find("left") and not leftButt then
							leftButt = d
						elseif n:find("right") and not rightButt then
							rightButt = d
						end
					end
				end
			end
		end
		return torso, leftLeg, rightLeg, leftButt, rightButt
	end

	function cheekLegTrackCaptureSide(torso, leg, butt)
		if not torso or not leg or not butt then return nil end
		local world = butt.Position
		return {
			legLocal = leg.CFrame:PointToObjectSpace(world), 
			torsoLocal = torso.CFrame:PointToObjectSpace(world), 
		}
	end

	function cheekLegTrackSmooth(current, target, dt)
		local k = CheekLegTrack.Smooth or 12
		local a = 1 - math.exp(-k * math.clamp(dt, 0, 0.1))
		return current:Lerp(target, a)
	end

	
	function updateCheekLegTrack(dt)
		dt = math.clamp(tonumber(dt) or 0.016, 0, 0.1)
		local zero = Vector3.zero
		local data = PlayerData[Player.Name]
		if not data or data.CheekLegTrack ~= true or data.ButtsParentToLegs == true or data.ButtsEnabled == false then
			
			CheekLegTrack.LeftOff = cheekLegTrackSmooth(CheekLegTrack.LeftOff, zero, dt)
			CheekLegTrack.RightOff = cheekLegTrackSmooth(CheekLegTrack.RightOff, zero, dt)
			CheekLegTrack.SpacingAdd = CheekLegTrack.SpacingAdd + (0 - CheekLegTrack.SpacingAdd) * (1 - math.exp(-(CheekLegTrack.Smooth or 12) * dt))
			return
		end
		local char = Player.Character
		if not char then return end
		local torso, leftLeg, rightLeg, leftButt, rightButt = cheekLegTrackGetParts(char)
		if not torso or not leftLeg or not rightLeg then return end

		if CheekLegTrack.Char ~= char or CheekLegTrack.Left == nil or CheekLegTrack.Right == nil then
			CheekLegTrack.Char = char
			
			CheekLegTrack.Left = cheekLegTrackCaptureSide(torso, leftLeg, leftButt)
			CheekLegTrack.Right = cheekLegTrackCaptureSide(torso, rightLeg, rightButt)
			if not CheekLegTrack.Left then
				local approx = leftLeg.Position
				CheekLegTrack.Left = {
					legLocal = leftLeg.CFrame:PointToObjectSpace(approx),
					torsoLocal = torso.CFrame:PointToObjectSpace(approx),
				}
			end
			if not CheekLegTrack.Right then
				local approx = rightLeg.Position
				CheekLegTrack.Right = {
					legLocal = rightLeg.CFrame:PointToObjectSpace(approx),
					torsoLocal = torso.CFrame:PointToObjectSpace(approx),
				}
			end
			local lp = torso.CFrame:PointToObjectSpace(leftLeg.Position)
			local rp = torso.CFrame:PointToObjectSpace(rightLeg.Position)
			CheekLegTrack.RestSpread = rp.X - lp.X
		end

		local maxDist = tonumber(data.CheekLegTrackMaxDist) or CheekLegTrack.MaxDist or 0.3
		local maxSp = tonumber(data.CheekLegTrackMaxSpacing) or CheekLegTrack.MaxSpacing or 0.2
		maxDist = math.clamp(maxDist, 0, 1.5)
		maxSp = math.clamp(maxSp, 0, 1)

		local function sideTarget(leg, cap)
			if not leg or not cap then return zero end
			
			local desiredWorld = leg.CFrame:PointToWorldSpace(cap.legLocal)
			
			local baseWorld = torso.CFrame:PointToWorldSpace(cap.torsoLocal)
			local delta = desiredWorld - baseWorld
			local mag = delta.Magnitude
			if mag > maxDist and mag > 1e-6 then
				delta = delta.Unit * maxDist
			end
			local finalWorld = baseWorld + delta
			
			local finalLocal = torso.CFrame:PointToObjectSpace(finalWorld)
			local off = finalLocal - cap.torsoLocal
			
			return Vector3.new(off.X, 0, off.Z)
		end

		local targetL = sideTarget(leftLeg, CheekLegTrack.Left)
		local targetR = sideTarget(rightLeg, CheekLegTrack.Right)
		CheekLegTrack.LeftOff = cheekLegTrackSmooth(CheekLegTrack.LeftOff, targetL, dt)
		CheekLegTrack.RightOff = cheekLegTrackSmooth(CheekLegTrack.RightOff, targetR, dt)

		local lp = torso.CFrame:PointToObjectSpace(leftLeg.Position)
		local rp = torso.CFrame:PointToObjectSpace(rightLeg.Position)
		local curSpread = rp.X - lp.X
		local restSpread = CheekLegTrack.RestSpread or curSpread
		local targetSp = math.clamp(curSpread - restSpread, -maxSp, maxSp)
		local a = 1 - math.exp(-(CheekLegTrack.Smooth or 12) * dt)
		CheekLegTrack.SpacingAdd = CheekLegTrack.SpacingAdd + (targetSp - CheekLegTrack.SpacingAdd) * a
	end

local function updateCheekImpact(dt)
		dt = math.clamp(dt or 0.016, 0, 0.1)
		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then
			CheekImpact.Squish = 0
			CheekImpact.LandPulse = 0
			CheekImpact.LastState = nil
			return
		end
		local st = hum:GetState()
		local last = CheekImpact.LastState
		CheekImpact.LastState = st

		
		if st == Enum.HumanoidStateType.Landed
			or (last == Enum.HumanoidStateType.Freefall and st == Enum.HumanoidStateType.Running)
			or (last == Enum.HumanoidStateType.Freefall and st == Enum.HumanoidStateType.RunningNoPhysics)
		then
			CheekImpact.LandPulse = math.max(CheekImpact.LandPulse, CheekImpact.LandAmount)
		end
		if last == Enum.HumanoidStateType.Freefall and st ~= Enum.HumanoidStateType.Freefall and st ~= Enum.HumanoidStateType.Jumping then
			CheekImpact.LandPulse = math.max(CheekImpact.LandPulse, CheekImpact.LandAmount * 0.9)
		end

		CheekImpact.LandPulse = math.max(0, CheekImpact.LandPulse - (CheekImpact.LandDecay * dt))

		local sit = 0
		if st == Enum.HumanoidStateType.Seated or hum.Sit then
			sit = CheekImpact.SitAmount
		end

		CheekImpact.Squish = math.clamp(math.max(sit, CheekImpact.LandPulse), 0, 1)
	end

