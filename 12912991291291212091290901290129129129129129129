				discName = discName or eq:GetAttribute("FlavorName")
				if typeof(discCol) ~= "Color3" then
					local fr, fg, fb = eq:GetAttribute("FlavorR"), eq:GetAttribute("FlavorG"), eq:GetAttribute("FlavorB")
					if fr and fg and fb then
						discCol = Color3.new(fr, fg, fb)
					end
				end
				if eq:GetAttribute("FlavorHeated") == true then discHeated = true end
			end
			if type(GlassSystem.LastFilledFlavor) == "table" then
				discId = discId or GlassSystem.LastFilledFlavor.id
				discName = discName or GlassSystem.LastFilledFlavor.name
				if typeof(discCol) ~= "Color3" and typeof(GlassSystem.LastFilledFlavor.color) == "Color3" then
					discCol = GlassSystem.LastFilledFlavor.color
				end
