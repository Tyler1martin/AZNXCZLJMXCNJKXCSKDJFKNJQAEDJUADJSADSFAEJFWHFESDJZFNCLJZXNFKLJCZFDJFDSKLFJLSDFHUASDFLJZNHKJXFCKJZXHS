			0.35,
			{X = "Y", Y = "Z", Z = "X"},
			{X = 0, Y = 0, Z = 0},
			{X = "Y", Y = "Z", Z = "Z"},
			{X = 5, Y = -5, Z = 5},
			Data
		)
	end

	
	
	function Function.ReparentButtsToLegs(Character, Data)
		if not Character then return 0, false, false end
		local morph = Character:FindFirstChild("Morph")
		if not morph then return 0, false, false end

		local leftLeg = Character:FindFirstChild("LeftUpperLeg")
			or Character:FindFirstChild("Left Leg")
		local rightLeg = Character:FindFirstChild("RightUpperLeg")
			or Character:FindFirstChild("Right Leg")
		if not leftLeg and not rightLeg then
			warn("[Morph] ButtsParentToLegs: no leg parts found")
			return 0, false, false
		end

		local function findWeld(part)
			local w = part:FindFirstChildOfClass("Motor6D") or part:FindFirstChildOfClass("Weld")
			if w then return w end
			w = part:FindFirstChild(part.Name .. " Weld") or part:FindFirstChild(part.Name .. "_Weld")
			if w and (w:IsA("Motor6D") or w:IsA("Weld")) then return w end
			for _, c in ipairs(part:GetChildren()) do
				if c:IsA("Motor6D") or c:IsA("Weld") then return c end
			end
			local par = part.Parent
			if par then
				for _, c in ipairs(par:GetChildren()) do
					if (c:IsA("Motor6D") or c:IsA("Weld")) and c.Part1 == part then
						return c
