		local function playDrinkGlass()
			local eq = getEquippedGlass()
			if eq then syncGlassStateFromTool(eq) end
			-- Allow drink if filled flag, tool attr, or we still have a fill snapshot
			local toolFilled = eq and eq:GetAttribute("MilkFilled") == true
			local canDrink = GlassSystem.Filled == true or toolFilled == true or type(GlassSystem.LastFilledFlavor) == "table"
			if not canDrink then return end
			-- Snapshot flavor from glass BEFORE clearing / destroying tool
			local discId = GlassSystem.FlavorId
			local discName = GlassSystem.FlavorName
			local discCol = GlassSystem.FlavorColor
			local discHeated = GlassSystem.FlavorHeated or GlassSystem.Heated
			if eq then
				discId = discId or eq:GetAttribute("FlavorId")
				discName = discName or eq:GetAttribute("FlavorName")
				if typeof(discCol) ~= "Color3" then
					local fr, fg, fb = eq:GetAttribute("FlavorR"), eq:GetAttribute("FlavorG"), eq:GetAttribute("FlavorB")
					if fr and fg and fb then
						discCol = Color3.new(fr, fg, fb)
					end
				end
				if eq:GetAttribute("FlavorHeated") == true then discHeated = true end
			end
			if type(GlassSystem.LastFilledFlavor) == "table" then
				discId = discId or GlassSystem.LastFilledFlavor.id
				discName = discName or GlassSystem.LastFilledFlavor.name
				if typeof(discCol) ~= "Color3" and typeof(GlassSystem.LastFilledFlavor.color) == "Color3" then
					discCol = GlassSystem.LastFilledFlavor.color
				end
			end
			if typeof(discCol) ~= "Color3" then
				discCol = Color3.fromRGB(255, 220, 230)
			end
			local heatedDrink = GlassSystem.Heated == true or discHeated == true
			local char = Player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local animator = hum and (hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum))
			-- Gulp sound
			pcall(function()
				if MasterSFXMute then return end
				local host = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
				if not host then return end
				local s = GlassSystem.GulpSound
				if not s or not s.Parent then
					s = Instance.new("Sound")
					s.Name = "MilkGulp"
					s.SoundId = GlassSystem.GulpSoundId
					s.Volume = 1
					s.Parent = host
					GlassSystem.GulpSound = s
				end
				s.TimePosition = 0
				s:Play()
			end)
			-- Drink anim
			pcall(function()
				if not animator then return end
				if GlassSystem.DrinkTrack then
					GlassSystem.DrinkTrack:Stop(0.1)
					GlassSystem.DrinkTrack:Destroy()
					GlassSystem.DrinkTrack = nil
				end
				local anim = Instance.new("Animation")
				anim.AnimationId = GlassSystem.DrinkAnimId
				local track = animator:LoadAnimation(anim)
				track.Priority = Enum.AnimationPriority.Action4
				track:Play(0.1, 1, GlassSystem.DrinkSpeed or 1.5)
				GlassSystem.DrinkTrack = track
				task.delay(2.5, function()
					if GlassSystem.DrinkTrack == track then
						pcall(function() track:Stop(0.2) track:Destroy() end)
						GlassSystem.DrinkTrack = nil
					end
				end)
			end)
			-- Buff from flavor (random duration; +3s if heated)
			local dur, spd = 5, (heatedDrink and 10 or 5)
			if MilkFlavorSystem and MilkFlavorSystem.Enabled and GlassSystem.FlavorId and GlassSystem.FlavorId ~= "plain" then
				local lb = GlassSystem._flavorLeft or MilkFlavorSystem.LeftBase or "strawberry"
				local rb = GlassSystem._flavorRight or MilkFlavorSystem.RightBase or "strawberry"
				local key = lb .. "|" .. rb
				if heatedDrink or GlassSystem.FlavorHeated then key = key .. "|hot" end
				local mix = MilkFlavorMix[key] or MilkFlavorMix[lb .. "|" .. rb]
				if mix then
					local d0, d1 = tonumber(mix.durMin) or 4, tonumber(mix.durMax) or 8
					dur = d0 + math.random() * math.max(0.1, d1 - d0)
					spd = tonumber(mix.buff) or spd
				end
				if heatedDrink or GlassSystem.FlavorHeated then
					dur = dur + 3
					spd = math.max(spd, 10)
				end
			elseif heatedDrink then
				dur = 8
				spd = 10
			end
			GlassSystem.BuffSpeed = spd
			GlassSystem.BuffUntil = os.clock() + dur
			pcall(function()
				setFlavorDrinkGlow(discCol, GlassSystem.BuffUntil)
			end)

			-- Resolve flavor into a TABLE (executor-safe; no outer-local writes inside pcall)
			local resolved = {
				id = discId,
				name = discName,
				color = discCol,
			}
			do
				local snap = GlassSystem.LastFilledFlavor
				if type(snap) == "table" then
					if not resolved.id or resolved.id == "" or resolved.id == "plain" then
						resolved.id = snap.id
						resolved.name = snap.name or resolved.name
						resolved.color = snap.color or resolved.color
					end
					if not resolved.name then resolved.name = snap.name end
					if typeof(resolved.color) ~= "Color3" and typeof(snap.color) == "Color3" then
						resolved.color = snap.color
					end
				end
				local pdata = PlayerData[Player.Name]
				if pdata and pdata.MilkFlavorsEnabled == true then
					MilkFlavorSystem.Enabled = true
				end
				if MilkFlavorSystem and MilkFlavorSystem.Enabled then
					pcall(function() Function.UpdateMilkFlavor(heatedDrink) end)
					if not resolved.id or resolved.id == "" or resolved.id == "plain" then
						resolved.id = MilkFlavorSystem.Id
						resolved.name = MilkFlavorSystem.Name
						resolved.color = MilkFlavorSystem.Color
					elseif (not resolved.name or resolved.name == "" or resolved.name == "Milk" or resolved.name == "Heated Milk") then
						resolved.name = MilkFlavorSystem.Name or resolved.name
						resolved.color = resolved.color or MilkFlavorSystem.Color
					end
				end
				if typeof(resolved.color) ~= "Color3" then
					resolved.color = Color3.fromRGB(255, 220, 230)
				end
				if (not resolved.id or resolved.id == "plain") and resolved.name and resolved.name ~= "Milk" and resolved.name ~= "Heated Milk" then
					for _, mix in pairs(MilkFlavorMix) do
						if mix and mix.name == resolved.name and mix.id then
							resolved.id = tostring(mix.id)
							if typeof(mix.color) == "Color3" then resolved.color = mix.color end
							break
						end
					end
				end
			end

