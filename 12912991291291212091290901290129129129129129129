	function Function.ClaimChallengeReward(id)
		id = tostring(id or "")
		local rt = Function.AchievementRuntime
		if not rt then return false, "No runtime" end
		rt.ChallengePendingRewards = rt.ChallengePendingRewards or {}
		rt.ChallengeClaimed = rt.ChallengeClaimed or {}
		local pend = rt.ChallengePendingRewards[id]
		if not pend or pend.claimed == true or rt.ChallengeClaimed[id] then
			return false, "Nothing to claim"
		end
		if not rt.ChallengeDone[id] then
			return false, "Challenge not complete"
		end
		local diff = tostring(pend.diff or "Easy")
		local count, preferNew = 1, false
		if diff == "Medium" then
			count, preferNew = 1, true
		elseif diff == "Hard" then
			count, preferNew = 2, true
		end
		local givenIds = {}
		local names = {}
		for _ = 1, count do
			local mix = pickChallengeRewardFlavor(preferNew, givenIds)
			if mix then
				givenIds[tostring(mix.id)] = true
				local ok, name = giveChallengeRewardGlass(mix)
				if ok then
					names[#names + 1] = tostring(name or mix.name or mix.id)
				end
			end
		end
		pend.claimed = true
		rt.ChallengeClaimed[id] = true
		local label = (#names > 0) and table.concat(names, ", ") or "reward"
		pcall(function()
			Function.ShowAchievementNotify("Reward claimed", label, Color3.fromRGB(120, 220, 160))
		end)
		if rt.UIRefresh then pcall(rt.UIRefresh) end
