					if d:IsA("MeshPart") then
						local want = d:GetAttribute("MorphWantDoubleSided")
						d.DoubleSided = (want == true) or s.DoubleSided
					end
					pcall(function() d.LocalTransparencyModifier = 0 end)
				end
			end
			table.clear(fpMorphOpt.Saved)
		end
