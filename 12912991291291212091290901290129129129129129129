			trackImg.Size = UDim2.fromScale(1, 1)
			trackImg.ScaleType = Enum.ScaleType.Stretch
			trackImg.ZIndex = 0
			trackImg.Visible = false
			trackImg.Parent = track

			local fill = Instance.new("Frame")
			fill.Size = UDim2.new(math.clamp((defaultV - minV) / (maxV - minV), 0, 1), 0, 1, 0)
			fill.BackgroundColor3 = Pal.Neon
			fill.BorderSizePixel = 0
			fill.ZIndex = 1
			fill.Parent = track
			local fc = Instance.new("UICorner")
			fc.CornerRadius = UDim.new(0, 3)
			fc.Parent = fill

			local knob = Instance.new("Frame")
			knob.Size = UDim2.new(0, 12, 0, 12)
			knob.Position = UDim2.new(fill.Size.X.Scale, -6, 0.5, -6)
			knob.BackgroundColor3 = Pal.TextBright
			knob.BorderSizePixel = 0
			knob.ZIndex = 2
			knob.Parent = track
			local kc = Instance.new("UICorner")
			kc.CornerRadius = UDim.new(1, 0)
			kc.Parent = knob
			local ks = Instance.new("UIStroke")
			ks.Color = Pal.Neon
			ks.Thickness = 1
			ks.Parent = knob

			local currentVal = defaultV
			local function quantize(v)
				v = math.clamp(tonumber(v) or defaultV, minV, maxV)
				
				v = math.floor(v / step + 0.5) * step
				
				v = tonumber(string.format("%.4f", v)) or v
				v = math.clamp(v, minV, maxV)
				return v
			end
			local function setVisual(v, fromBox)
				v = quantize(v)
				currentVal = v
				local span = maxV - minV
				local alpha = span ~= 0 and ((v - minV) / span) or 0
				fill.Size = UDim2.new(alpha, 0, 1, 0)
				knob.Position = UDim2.new(alpha, -6, 0.5, -6)
				if not fromBox then box.Text = string.format("%.2f", v) end
				return v
			end

			local sliding = false
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
					setVisual(minV + rel * (maxV - minV))
				end
			end)
			UIS.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
					setVisual(minV + rel * (maxV - minV))
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
					sliding = false
					onChanged(currentVal)
				end
			end)
			box.FocusLost:Connect(function()
				local v = tonumber(box.Text)
				if v then
					setVisual(v, true)
					box.Text = string.format("%.2f", currentVal)
					onChanged(currentVal)
				else
					box.Text = string.format("%.2f", currentVal)
				end
			end)
			table.insert(ThemeUI.Sliders, {track, fill, knob, ts, ks, trackImg})
			return setVisual
		end

