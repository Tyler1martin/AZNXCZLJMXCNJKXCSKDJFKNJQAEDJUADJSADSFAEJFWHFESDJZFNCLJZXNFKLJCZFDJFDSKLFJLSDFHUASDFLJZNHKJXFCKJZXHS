			PositionOffset = {X = "X", Y = "Y", Z = "Z"},
			Position = {X = 0, Y = 0, Z = 0},
			RotationOffset = {X = "X", Y = "Y", Z = "Z"},
			Rotation = {X = 0, Y = 0, Z = 0},
			Size = ObjectInstance.Size,
			MeshBaseScale = meshBase,
			Scale = true, 
			Kind = "breastCloth",
			AsymSide = nil,
			LastOffset = Vector3.zero,
			LastRot = Vector3.zero,
		}
	end

	function Function.BreastPhysics(ObjectInstance, Character, Extra, Data)
		local data = getPlayerData(Data)
		if not data or not data.BodyPartPhysics then return end
		if data.BreastPhysicsEnabled == false or data.JigglePhysicsMaster == false then return end
		local Torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
		if not Torso then return end

		local morph = Character:FindFirstChild("Morph")
		local root = morph and morph:FindFirstChild("Torso") and morph.Torso:FindFirstChild("BreastsRoot")
		
		local asym = data.AsymBounce == true and data.UVToggle ~= true

		if asym then
			
			if root and not data.CurrentPartList.BodyPartPhysics[root] then
				pcall(function()
					root:SetAttribute("PhysicsKind", "breast")
					root:SetAttribute("AsymSide", nil)
				end)
				Function.SpringCreate(
					root, Torso,
					Vector3.new(1,1,1) * 5, Vector3.zero,
					10, 0.2,
					{X = "Y", Y = "Z", Z = "X"}, {X = 0, Y = 0, Z = 0},
					{X = "Y", Y = "Z", Z = "X"}, {X = 5, Y = -5, Z = 5},
					Data
				)
			end
			local target = ObjectInstance
			if not target or not target.Parent then return end
			local n = string.lower(target.Name or "")
			if n:find("root") then return end
			if n:find("texture") or n:find("uv") or n:find("pant") or n:find("cloth") then
				return
			end
			if data.CurrentPartList.BodyPartPhysics[target] then return end

			local isLeft = n:find("left") or n:find("nipplel") or n:find("nipple.1") or n:find("nipple_l")
			local isRight = n:find("right") or n:find("nippler") or n:find("nipple_r")
			if not isLeft and not isRight then
				if target.Position.X >= Torso.Position.X then isRight = true else isLeft = true end
			end

			local speed = (isLeft and 8.6 or 11.2) + (math.random() - 0.5) * 1.4
			local damper = (isLeft and 0.28 or 0.14) + (math.random() - 0.5) * 0.06
			speed = math.clamp(speed, 7.5, 12.5)
			damper = math.clamp(damper, 0.10, 0.35)
			pcall(function()
				target:SetAttribute("PhysicsKind", "breast")
				target:SetAttribute("AsymSide", isLeft and "left" or "right")
			end)

			Function.SpringCreate(
				target, Torso,
				Vector3.new(1,1,1) * 5, Vector3.new(0,0,0),
				speed, damper,
				{X = "Y", Y = "Z", Z = "X"}, {X = 0, Y = 0, Z = 0},
				{X = "Y", Y = "Z", Z = "X"}, {X = 5, Y = -5, Z = 5},
				Data
			)
		else
			local target = root or ObjectInstance
			if data.CurrentPartList.BodyPartPhysics[target] then return end
			pcall(function()
				target:SetAttribute("PhysicsKind", "breast")
				target:SetAttribute("AsymSide", nil)
			end)
			Function.SpringCreate(
				target, Torso,
				Vector3.new(1,1,1) * 5, Vector3.new(0,0,0),
				10, 0.2,
				{X = "Y", Y = "Z", Z = "X"}, {X = 0, Y = 0, Z = 0},
				{X = "Y", Y = "Z", Z = "X"}, {X = 5, Y = -5, Z = 5},
				Data
			)
		end
	end

	function Function.BreastUVPhysics(ObjectInstance, Character, Extra, Data)
		local data = getPlayerData(Data)
		if not data or not data.BodyPartPhysics then return end
		if data.BreastPhysicsEnabled == false then return end
		
