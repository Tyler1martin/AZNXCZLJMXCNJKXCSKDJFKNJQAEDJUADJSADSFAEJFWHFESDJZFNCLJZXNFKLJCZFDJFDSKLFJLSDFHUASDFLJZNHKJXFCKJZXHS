	local sweatRayParams = RaycastParams.new()
	sweatRayParams.FilterType = Enum.RaycastFilterType.Exclude
	sweatRayParams.IgnoreWater = true

	function getSweatFolder()
		if SweatSystem.Folder and SweatSystem.Folder.Parent then
			return SweatSystem.Folder
		end
		local f = Instance.new("Folder")
		f.Name = "SweatDroplets"
		f.Parent = workspace.CurrentCamera or workspace
		SweatSystem.Folder = f
		return f
	end

	function clearSweatEmitters()
		for att, _ in pairs(SweatSystem.Glands) do
			if att and att.Parent then att:Destroy() end
			SweatSystem.Glands[att] = nil
		end
		for _, d in ipairs(SweatSystem.Droplets) do
			if d.part then d.part:Destroy() end
		end
		table.clear(SweatSystem.Droplets)
		if SweatSystem.Folder then
			SweatSystem.Folder:Destroy()
			SweatSystem.Folder = nil
		end
		SweatSystem.SpawnAcc = 0
	end

	
	function ensureSweatGland(part, sideName, localPos)
		if not part or not part.Parent then return nil end
		local att = part:FindFirstChild("SweatAtt_" .. sideName)
		if not att then
			att = Instance.new("Attachment")
			att.Name = "SweatAtt_" .. sideName
			att.Parent = part
		end
		att.Position = localPos
		SweatSystem.Glands[att] = true
		return att
	end

	function collectSweatParts()
		local char = Player.Character
		local parts = {}
		if not char then return parts end
		local limbNames = {"Torso", "UpperTorso", "LowerTorso", "Head",
			"Left Arm", "Right Arm", "Left Leg", "Right Leg",
			"LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm",
			"LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg"}
		for _, name in ipairs(limbNames) do
			local p = char:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				table.insert(parts, p)
			end
		end
		local morph = char:FindFirstChild("Morph")
		if morph then
			for _, d in ipairs(morph:GetDescendants()) do
				if d:IsA("BasePart") then
					local n = d.Name:lower()
					if n:find("breast") or n:find("boob") or n:find("butt") then
						
						d.CanQuery = SweatSystem.MorphCollision == true
						table.insert(parts, d)
					end
				end
			end
		end
		return parts
	end

	function updateSweatGlands()
		local parts = collectSweatParts()
		local active = {}
		for _, part in ipairs(parts) do
			local size = part.Size
			local spots = {
				{"L", Vector3.new(-size.X * 0.48, size.Y * 0.1, 0)},
				{"R", Vector3.new(size.X * 0.48, size.Y * 0.1, 0)},
				{"T", Vector3.new(0, size.Y * 0.48, 0)},
				{"TL", Vector3.new(-size.X * 0.28, size.Y * 0.42, 0)},
				{"TR", Vector3.new(size.X * 0.28, size.Y * 0.42, 0)},
			}
			
			local pn = part.Name:lower()
			if pn == "head" then
				table.insert(spots, {"HTL", Vector3.new(-size.X * 0.38, size.Y * 0.42, size.Z * 0.15)})
				table.insert(spots, {"HTR", Vector3.new(size.X * 0.38, size.Y * 0.42, size.Z * 0.15)})
				table.insert(spots, {"HTLC", Vector3.new(-size.X * 0.32, size.Y * 0.48, -size.Z * 0.05)})
				table.insert(spots, {"HTRC", Vector3.new(size.X * 0.32, size.Y * 0.48, -size.Z * 0.05)})
				table.insert(spots, {"HFore", Vector3.new(0, size.Y * 0.45, size.Z * 0.42)})
			end
			for _, spot in ipairs(spots) do
				local att = ensureSweatGland(part, spot[1], spot[2])
				if att then active[att] = true end
			end
		end
		for att, _ in pairs(SweatSystem.Glands) do
			if not active[att] then
				if att and att.Parent then att:Destroy() end
				SweatSystem.Glands[att] = nil
			end
		end
	end

	function spawnSweatDroplet(worldPos, spread)
		if #SweatSystem.Droplets >= SweatSystem.MaxDroplets then return end
		local folder = getSweatFolder()
		sweatRayParams.FilterDescendantsInstances = {folder}

		
		local spawnPos = worldPos
		local spawnNormal = Vector3.new(0, 1, 0)
		local onSurface = false
		local snap = workspace:Raycast(worldPos + Vector3.new(0, 0.12, 0), Vector3.new(0, -0.5, 0), sweatRayParams)
		if not snap then
			snap = workspace:Raycast(worldPos + Vector3.new(0, 0.05, 0), Vector3.new(0, -0.35, 0), sweatRayParams)
		end
		if snap then
			spawnPos = snap.Position + snap.Normal * 0.035
			spawnNormal = snap.Normal
			onSurface = true
		end

		local p = Instance.new("Part")
		p.Name = "SweatDrop"
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.04, 0.04, 0.04)
		p.Transparency = 1
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Massless = true
		p.CFrame = CFrame.new(spawnPos)
		p.Parent = folder

		
		local bb = Instance.new("BillboardGui")
		bb.Name = "SweatVis"
		bb.Size = UDim2.new(0.22, 0, 0.22, 0) 
		bb.StudsOffset = Vector3.zero
		bb.AlwaysOnTop = false
		bb.LightInfluence = 0.25
		bb.MaxDistance = 120
		bb.Adornee = p
		bb.Parent = p

		local img = Instance.new("ImageLabel")
		img.Name = "Drop"
		img.BackgroundColor3 = Color3.fromRGB(130, 190, 230)
		img.BackgroundTransparency = 0.35
		img.Size = UDim2.fromScale(1, 1)
		img.Image = "rbxasset://textures/particles/smoke_main.dds"
		img.ImageColor3 = Color3.fromRGB(150, 205, 240)
		img.ImageTransparency = 0.15
		img.Parent = bb
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = img

		local spr = math.clamp(spread or 0.65, 0, 2)
		local spreadForce = 0.08 + spr * 0.35
		local vel
		if onSurface then
			
			local down = Vector3.new(0, -1, 0)
			local along = down - spawnNormal * down:Dot(spawnNormal)
			if along.Magnitude < 1e-3 then
				along = Vector3.new(1, 0, 0)
			end
			vel = along.Unit * (0.6 + math.random() * 0.5)
				+ Vector3.new((math.random() - 0.5) * spreadForce, 0, (math.random() - 0.5) * spreadForce)
		else
			vel = Vector3.new(
				(math.random() - 0.5) * 2 * spreadForce,
				-0.2 - math.random() * 0.25,
				(math.random() - 0.5) * 2 * spreadForce
			)
		end
		local cont = math.clamp(SweatSystem.Continuity or 0.85, 0, 1)
		local life = 1.2 + cont * 2.0 + math.random() * 0.5
		
		local slideBias = Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2)
		if slideBias.Magnitude < 0.1 then
			slideBias = Vector3.new(1, 0, 0)
		end
		slideBias = slideBias.Unit
		table.insert(SweatSystem.Droplets, {
			part = p,
			img = img,
			vel = vel,
			age = 0,
			life = life,
			onSurface = onSurface,
			normal = spawnNormal,
			slideBias = slideBias,
			groundTime = 0,
		})
	end

	function stepSweatDroplets(dt)
		sweatRayParams.FilterDescendantsInstances = {getSweatFolder()}
		sweatRayParams.RespectCanCollide = false

		local gravity = Vector3.new(0, -22, 0)
		local i = 1
		while i <= #SweatSystem.Droplets do
			local d = SweatSystem.Droplets[i]
			local p = d.part
			if not p or not p.Parent then
				table.remove(SweatSystem.Droplets, i)
			else
				d.age = d.age + dt
				if d.age >= d.life then
					p:Destroy()
					table.remove(SweatSystem.Droplets, i)
				else
					local fade = d.age / d.life
					if d.img and d.img.Parent then
						d.img.ImageTransparency = 0.12 + fade * 0.75
						d.img.BackgroundTransparency = 0.35 + fade * 0.6
					end

					local pos = p.Position

					
					local stickDir = d.vel.Magnitude > 0.05 and d.vel.Unit or Vector3.new(0, -1, 0)
					local result = workspace:Raycast(pos + Vector3.new(0, 0.08, 0), Vector3.new(0, -0.55, 0), sweatRayParams)
					if not result then
						result = workspace:Raycast(pos, stickDir * math.max(d.vel.Magnitude * dt, 0.08) + Vector3.new(0, -0.1, 0), sweatRayParams)
					end

					if result then
						local n = result.Normal
						d.normal = n
						d.onSurface = true
						local hitPos = result.Position + n * 0.03

						
						local char = Player.Character
						local hitInst = result.Instance
						local onChar = char and hitInst and hitInst:IsDescendantOf(char)
						if not onChar then
							d.groundTime = (d.groundTime or 0) + dt
							if d.groundTime >= 0.1 then
								p:Destroy()
								table.remove(SweatSystem.Droplets, i)
								
							else
								
								p.CFrame = CFrame.new(hitPos)
								i = i + 1
							end
						else
							d.groundTime = 0

							local vn = d.vel:Dot(n)
							if vn < 0 then
								d.vel = d.vel - n * vn
							end

							local bias = d.slideBias or Vector3.new(1, 0, 0)
							
							local biasPlane = bias - n * bias:Dot(n)
							if biasPlane.Magnitude < 0.05 then
								biasPlane = n:Cross(Vector3.new(0, 1, 0))
								if biasPlane.Magnitude < 0.05 then
									biasPlane = n:Cross(Vector3.new(1, 0, 0))
								end
							end
							if biasPlane.Magnitude > 1e-3 then
								biasPlane = biasPlane.Unit
							else
								biasPlane = Vector3.new(1, 0, 0)
							end

							local down = Vector3.new(0, -1, 0)
							local along = down - n * down:Dot(n)
							local alongMag = along.Magnitude

							if alongMag > 0.05 then
								
								d.vel = d.vel + along.Unit * (22 * dt) + biasPlane * (10 * dt)
							else
								
								d.vel = d.vel + biasPlane * (20 * dt) + Vector3.new(0, -6 * dt, 0)
							end

							local gPlane = gravity - n * gravity:Dot(n)
							d.vel = d.vel + gPlane * (1.2 * dt)
							d.vel = d.vel * (1 - math.clamp(dt * 0.5, 0, 0.2))

							
							local tangential = d.vel - n * d.vel:Dot(n)
							if tangential.Magnitude < 1.0 then
								local dir = biasPlane
								if alongMag > 0.05 then
									dir = (along.Unit * 0.65 + biasPlane * 0.35)
									if dir.Magnitude > 1e-3 then dir = dir.Unit end
								end
								d.vel = dir * 1.5
							end
							if d.vel.Magnitude > 6 then
								d.vel = d.vel.Unit * 6
							end
							
							if d.vel.X ~= d.vel.X then
								d.vel = biasPlane * 1.5
							end

							local move = d.vel * dt
							move = move - n * move:Dot(n)
							local newPos = hitPos + move
							if newPos.X == newPos.X then
								p.CFrame = CFrame.new(newPos)
							end
							i = i + 1
						end
					else
						d.onSurface = false
						d.groundTime = 0
						d.vel = d.vel + gravity * dt
						d.vel = d.vel * (1 - math.clamp(dt * 1.0, 0, 0.35))
						local newPos = pos + d.vel * dt
						if newPos.X == newPos.X then
							p.CFrame = CFrame.new(newPos)
						end
						i = i + 1
					end
				end
			end
		end
	end

	trackConn(RunService.Heartbeat:Connect(function(dt)
		if not App.SystemActive then return end
		if not SweatSystem.Enabled then
			if next(SweatSystem.Glands) or #SweatSystem.Droplets > 0 then
				clearSweatEmitters()
			end
			return
		end

		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local walking = false
		local moveSpeed = 0
		if hum then
			local md = hum.MoveDirection.Magnitude
			if md > 0.12 and hum.FloorMaterial ~= Enum.Material.Air then
				walking = true
			end
			
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local v = hrp.AssemblyLinearVelocity
				moveSpeed = Vector3.new(v.X, 0, v.Z).Magnitude
			end
			if walking and moveSpeed < 1 then
				moveSpeed = hum.WalkSpeed or 16
			end
		end

		local data = PlayerData[Player.Name]
		local breastScale = (data and data.BreastsScale) or 1
		local buttScale = (data and data.ButtsScale) or 1
		
		local scaleReduction = (breastScale + buttScale) / 0.10
		
		local speedReduction = 0
		if moveSpeed > 16 then
			speedReduction = (moveSpeed - 16) * (5 / 6)
		end
		local required = math.max(3, (SweatSystem.BaseWalkSeconds or 30) - scaleReduction - speedReduction)
		local now = os.clock()
		local bigBreasts = breastScale > 1.05
		local highSpeed = moveSpeed > 16.5

		if SweatSystem.AlwaysActive then
			SweatSystem.Sweating = true
			SweatSystem.SweatUntil = now + 9999
			SweatSystem.RestTime = 0
			SweatSystem.ActivityTime = required
		elseif walking then
			SweatSystem.RestTime = 0
			SweatSystem.ActivityTime = (SweatSystem.ActivityTime or 0) + dt
			if not SweatSystem.Sweating and (SweatSystem.ActivityTime or 0) >= required then
				SweatSystem.Sweating = true
				SweatSystem.SweatUntil = now + (SweatSystem.SweatDuration or 10)
			end
			
			if SweatSystem.Sweating and (highSpeed or bigBreasts) then
				SweatSystem.SweatUntil = now + (SweatSystem.SweatDuration or 10)
			end
		else
			
			SweatSystem.RestTime = (SweatSystem.RestTime or 0) + dt
			SweatSystem.ActivityTime = math.max(0, (SweatSystem.ActivityTime or 0) - dt * 0.5)
			if SweatSystem.Sweating and (SweatSystem.RestTime or 0) >= (SweatSystem.RestSeconds or 5) then
				SweatSystem.Sweating = false
				SweatSystem.SweatUntil = 0
				SweatSystem.ActivityTime = 0
				SweatSystem.RestTime = 0
			end
		end

		
		if SweatSystem.Sweating and not SweatSystem.AlwaysActive and now > (SweatSystem.SweatUntil or 0) then
			if not walking then
				
				SweatSystem.Sweating = false
			else
				
				SweatSystem.Sweating = false
				SweatSystem.ActivityTime = required * 0.35
			end
		end

		local jiggleBoost = 0
		if JiggleMeter.Fill and JiggleMeter.Fill > 0.35 then
			jiggleBoost = (JiggleMeter.Fill - 0.35) * 0.35
		end

		local intensity = math.clamp(SweatSystem.Intensity or 0, 0, 2)
		local active = SweatSystem.Sweating or SweatSystem.AlwaysActive
		local total = 0
		if active then
			local moveFactor = walking and (0.85 + math.clamp(moveSpeed / 24, 0, 0.6)) or 0.55
			total = intensity * (0.55 + jiggleBoost) * moveFactor
		end

		local amount = math.clamp(SweatSystem.Amount or 0.7, 0, 5)
		local cont = math.clamp(SweatSystem.Continuity or 0.85, 0, 1)
		local spawnRate = total * 8 * amount * (0.55 + cont * 0.7)
		if spawnRate < 0.15 then spawnRate = 0 end

		updateSweatGlands()

		SweatSystem.SpawnAcc = SweatSystem.SpawnAcc + spawnRate * dt
		local glandList = {}
		for att, _ in pairs(SweatSystem.Glands) do
			if att and att.Parent then
				table.insert(glandList, att)
			end
		end
		while SweatSystem.SpawnAcc >= 1 and #glandList > 0 and #SweatSystem.Droplets < SweatSystem.MaxDroplets do
			SweatSystem.SpawnAcc = SweatSystem.SpawnAcc - 1
			local att = glandList[math.random(1, #glandList)]
			spawnSweatDroplet(att.WorldPosition, SweatSystem.Spread)
		end
		if SweatSystem.SpawnAcc > 3 then SweatSystem.SpawnAcc = 3 end

		stepSweatDroplets(dt)
	end))

	
	
	
