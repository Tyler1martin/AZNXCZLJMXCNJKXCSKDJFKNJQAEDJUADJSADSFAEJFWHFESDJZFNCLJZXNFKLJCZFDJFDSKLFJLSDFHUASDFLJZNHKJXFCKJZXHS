		-- Don't fight minimize: only resize when not collapsed to title bar
		if main.Size.Y.Offset > 40 then
			main.Size = UDim2.new(0, tw, 0, th)
		end
		ThemeUI.RestSize = UDim2.new(0, tw, 0, th)
		local trans = math.clamp(tonumber(CustomTheme.Config.Transparency) or 0, 0, 0.85)
		main.BackgroundColor3 = cfg.Background
		main.BackgroundTransparency = trans
		local showOut = CustomTheme.ShowOutlines ~= false
		local strokeAlpha = showOut and 0.1 or 1
		if ThemeUI.MainStroke then
			ThemeUI.MainStroke.Color = cfg.Outline
			ThemeUI.MainStroke.Transparency = strokeAlpha
