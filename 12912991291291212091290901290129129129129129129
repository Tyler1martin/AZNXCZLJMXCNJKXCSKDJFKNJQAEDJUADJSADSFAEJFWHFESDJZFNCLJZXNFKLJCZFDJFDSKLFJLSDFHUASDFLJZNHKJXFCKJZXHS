	function Function.ApplyRealisticMovement(Character, Data)
		local data = PlayerData[Data]
		if not data or not Character then return end
		local hum = Character:FindFirstChildOfClass("Humanoid")
		if not hum then return end

		if data.BaseWalkSpeed == nil then
			data.BaseWalkSpeed = hum.WalkSpeed
			data.BaseJumpPower = hum.JumpPower
			data.BaseJumpHeight = hum.JumpHeight
		end

		local milkMult = 1
		local milkJumpMult = 1
		if MilkMeter and MilkMeter.Enabled and not MilkMeter.Paused and (MilkMeter.BuffsEnabled ~= false) then
			-- Buff only while milk can actually drain (same rules as streaming)
			local dataMode = data
			local clothed = dataMode and dataMode.UVToggle == true
			local canDrain = (not clothed) or MilkMeter.WorkClothed
			if canDrain then
				local now = os.clock()
				local leftOk = (MilkMeter.FillL or 0) > 0 and now >= (MilkMeter.CooldownUntilL or 0)
				local rightOk = (MilkMeter.FillR or 0) > 0 and now >= (MilkMeter.CooldownUntilR or 0)
				local milkActive = MilkMeter.AlwaysFull or leftOk or rightOk
				if milkActive and now >= (MilkMeter.DebuffUntil or 0) then
					milkMult = 1.30 -- +30% speed
					milkJumpMult = 1.20 -- +20% jump
				end
			end
		end
		-- Full-swell debuff: -30% speed and jump for 15s
		if MilkMeter and os.clock() < (MilkMeter.DebuffUntil or 0) then
			milkMult = 0.70
			milkJumpMult = 0.70
		end

		if not data.RealisticMovement then
			local extra = 0
			if GlassSystem and GlassSystem.BuffUntil and os.clock() < GlassSystem.BuffUntil then
				extra = GlassSystem.BuffSpeed or 5
			end
			hum.WalkSpeed = data.BaseWalkSpeed * milkMult + extra
			hum.JumpPower = data.BaseJumpPower * milkJumpMult
			hum.JumpHeight = data.BaseJumpHeight * milkJumpMult
			return
		end

		local breastPen = 0
		local buttPen = 0
		if data.BreastsEnabled ~= false then
			breastPen = 0.07 * math.max(0, data.BreastsScale or 1)
		end
		if data.ButtsEnabled ~= false then
			buttPen = 0.05 * math.max(0, data.ButtsScale or 1)
		end
		local total = math.min(0.30, breastPen + buttPen)
		local mult = 1 - total

		local glassExtra = 0
		if GlassSystem and GlassSystem.BuffUntil and os.clock() < GlassSystem.BuffUntil then
			glassExtra = GlassSystem.BuffSpeed or 5
		end
		hum.WalkSpeed = data.BaseWalkSpeed * mult * milkMult + glassExtra
		hum.JumpPower = data.BaseJumpPower * mult * milkJumpMult
		hum.JumpHeight = data.BaseJumpHeight * mult * milkJumpMult
	end


	local MorphLoadState = {
		Busy = false,
		Token = 0,
		LastStart = 0,
		AutoToken = 0,
		MinInterval = 0.2,
		PostResetClean = nil, -- filled after fpMorphOpt exists
	}

	function Function.CharacterReset(Character, Data)

		if Character == nil then return end
		if not PlayerData[Data] then return end

		-- Invalidate any in-flight Function.Weld task.spawns from a previous apply
		PlayerData[Data].WeldToken = (PlayerData[Data].WeldToken or 0) + 1

		local PartList = PlayerData[Data].CurrentPartList
		if PartList then
			-- Physics springs hold Part keys — drop them first so Stepped stops work
			if PartList.BodyPartPhysics then
				table.clear(PartList.BodyPartPhysics)
			end
			if PartList.RealtimeUpdateList then
				if PartList.RealtimeUpdateList.Mesh then table.clear(PartList.RealtimeUpdateList.Mesh) end
				if PartList.RealtimeUpdateList.Accessory then table.clear(PartList.RealtimeUpdateList.Accessory) end
			end

			local function destroyEntry(v)
				if typeof(v) == "Instance" then
					pcall(function() v:Destroy() end)
				end
			end
			if PartList.Organ then
				for _, v in pairs(PartList.Organ) do destroyEntry(v) end
				table.clear(PartList.Organ)
			end
			if PartList.Accessory then
				for _, v in pairs(PartList.Accessory) do destroyEntry(v) end
				table.clear(PartList.Accessory)
			end
			if PartList.Clothes then
				for _, v in pairs(PartList.Clothes) do destroyEntry(v) end
				table.clear(PartList.Clothes)
			end
			if PartList.AreolaDecal then
				for Decal, _ in pairs(PartList.AreolaDecal) do
					if Decal and Decal.Parent then pcall(function() Decal:Destroy() end) end
				end
				table.clear(PartList.AreolaDecal)
			end
		end

		-- Orphan deferred weld queues cause duplicate hierarchy on re-apply
		PlayerData[Data].deferredWelds = {}
		PlayerData[Data].ClothWrap = nil

		PlayerData[Data].CurrentPartList = Function.PlayerDataDefault().CurrentPartList

		-- Runtime caches (fpMorphOpt, SoftWorldImpulses) cleared via MorphLoadState.PostResetClean
		pcall(function()
			if MorphLoadState.PostResetClean then
				MorphLoadState.PostResetClean()
			end
		end)

		local R6Limbs = {"Torso","Head","Right Arm","Right Leg","Left Arm","Left Leg"}
		local R15Parts = {
			"UpperTorso","LowerTorso",
			"LeftUpperArm","LeftLowerArm","LeftHand",
			"RightUpperArm","RightLowerArm","RightHand",
			"LeftUpperLeg","LeftLowerLeg","LeftFoot",
			"RightUpperLeg","RightLowerLeg","RightFoot",
			"Head",
		}
		for _, v in pairs(Character:GetChildren()) do
			if v:IsA("BasePart") then
				if table.find(R6Limbs, v.Name) or table.find(R15Parts, v.Name) then
					v.Transparency = 0
				end
				if v.Name == "HumanoidRootPart" then
					v.Transparency = 1
				end
			end
			if v.Name == "Morph" then
				v:Destroy()
			end
		end
		-- Remove leftover fake R6 limbs from a previous non-compat ParseCharacter
		for _, name in ipairs({"Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
			local p = Character:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				local hum = Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.RigType == Enum.HumanoidRigType.R15 then
					-- Fake R6 parts only exist on R15 after ParseCharacter
					pcall(function() p:Destroy() end)
				end
			end
		end
		pcall(function()
			for i,v in pairs(Character.PrimaryPart:GetChildren()) do
				if v:IsA("Clothing") then
					v.Parent = Character
				end
			end
		end)
		-- Do not clear Base* here (would re-capture a penalized speed). Only CharacterAdded clears them.
		if PlayerData[Data] then
			PlayerData[Data].MorphActive = false
		end
		-- Blush / hold-breast cleanup (defined later; safe pcall)
		pcall(function()
			if clearBlushGlow then clearBlushGlow() end
			if stopHoldBreastAnim then stopHoldBreastAnim() end
			if HoldBreast then HoldBreast.Holding = false end
		end)
		Function.ApplyRealisticMovement(Character, Data)
		if SyncMorphUI.UpdateMode then pcall(SyncMorphUI.UpdateMode) end
	end



	function Function.CharacterExecute(Character, Data)
		if not Character then return end
		local now = os.clock()
		-- Soft debounce only when NOT busy (avoid double-click spam). While busy, a new
		-- call cancels the in-progress apply so mode switch / refresh always works.
		if MorphLoadState.Busy then
			MorphLoadState.Token = (MorphLoadState.Token or 0) + 1 -- cancel old
		elseif (now - (MorphLoadState.LastStart or 0)) < (MorphLoadState.MinInterval or 0.2) then
			return
		end
		MorphLoadState.Busy = true
		MorphLoadState.LastStart = now
		MorphLoadState.Token = (MorphLoadState.Token or 0) + 1
		local myToken = MorphLoadState.Token

		task.spawn(function()
			local function release()
				if MorphLoadState.Token == myToken then
					MorphLoadState.Busy = false
				end
			end
			local ok, err = pcall(function()
			if Character and Character.Parent then
				Function.PlayerDataAdd(Data)
				Function.CharacterReset(Character,Data)
				-- WeldToken was bumped in CharacterReset; all Weld calls in this apply share it

				local DataConfig = PlayerData[Data]
				DataConfig.BreastsScale = DataConfig.BreastsScale or 1
				DataConfig.ButtsScale = DataConfig.ButtsScale or 1
