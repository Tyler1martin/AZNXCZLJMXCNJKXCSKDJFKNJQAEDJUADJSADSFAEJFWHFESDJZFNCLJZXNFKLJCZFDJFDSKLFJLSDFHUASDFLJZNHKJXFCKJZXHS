	}

	function fpForceOne(inst)
		if not inst or not inst.Parent then return end
		
		if inst:IsA("BasePart") and inst:GetAttribute("AreolaResizeBody") then
			inst.Transparency = 1
			inst.LocalTransparencyModifier = 1
			return
		end
		if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
			if not fpShouldSkipLTM(inst) then
				inst.LocalTransparencyModifier = 0
			end
		end
	end

	function fpForceNamedVisible(char)
		if not char then return end
		local morph = char:FindFirstChild("Morph")
		if morph then
			for i = 1, #FP_FORCE_VISIBLE_NAMES do
				local name = FP_FORCE_VISIBLE_NAMES[i]
				
				for _, d in ipairs(morph:GetChildren()) do
					if d.Name == name then fpForceOne(d) end
				end
				
				local found = morph:FindFirstChild(name, true)
				if found then
					fpForceOne(found)
					
					if found.Parent then
						for _, sib in ipairs(found.Parent:GetChildren()) do
							if sib.Name == name then fpForceOne(sib) end
						end
					end
					
					for _, ch in ipairs(found:GetChildren()) do
						if ch:IsA("Decal") or ch:IsA("Texture") then
							local n = string.lower(ch.Name or "")
							if n:find("areola") or n:find("nipple") then
								fpForceOne(ch)
							end
						end
					end
				end
			end
			
			for _, legName in ipairs({"Left Leg", "Right Leg", "Left Arm", "Right Arm", "Torso"}) do
				local container = morph:FindFirstChild(legName)
				if container then
					for _, ch in ipairs(container:GetChildren()) do
						if ch:IsA("BasePart") and not fpShouldSkipLTM(ch) then
							fpForceOne(ch)
							for _, g in ipairs(ch:GetChildren()) do
								if g:IsA("BasePart") or g:IsA("Decal") or g:IsA("Texture") then
									fpForceOne(g)
								end
							end
						end
					end
				end
			end
		end
		
		local data = PlayerData[Player.Name]
		local cpl = data and data.CurrentPartList
		if cpl then
			for Decal, host in pairs(cpl.AreolaDecal or {}) do
				fpForceOne(Decal)
				fpForceOne(host)
			end
			if type(cpl.Organ) == "table" then
				for key, inst in pairs(cpl.Organ) do
					if typeof(inst) == "Instance" and inst:IsA("BasePart") then
						fpForceOne(inst)
					end
				end
			end
		end
	end

	function fpApplyVisibility(isFP)
		local char = Player.Character
		if not char then return end
		local head = char:FindFirstChild("Head")
		if isFP then
			for _, ch in ipairs(char:GetChildren()) do
				if ch:IsA("BasePart") and ch ~= head and ch.Name ~= "HumanoidRootPart" then
					if not fpIsHeadItem(ch, head) and not fpShouldSkipLTM(ch) then
						ch.LocalTransparencyModifier = 0
					end
				elseif ch:IsA("Accessory") then
					local handle = ch:FindFirstChild("Handle")
					if handle and not fpIsHeadItem(handle, head) and not fpShouldSkipLTM(handle) then
						handle.LocalTransparencyModifier = 0
					end
				end
			end
			fpForceNamedVisible(char)
			
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") and d:GetAttribute("AreolaResizeBody") then
					d.Transparency = 1
					d.LocalTransparencyModifier = 1
				elseif d:IsA("BasePart") and d:GetAttribute("AreolaResizeNipple") then
					d.Transparency = 0
					d.LocalTransparencyModifier = 0
				elseif d:IsA("Decal") and string.lower(d.Name or ""):find("areola") then
					d.Transparency = 0
				end
			end
		elseif HeadOrbitFP.WasFP then
			fpForceNamedVisible(char)
			for _, ch in ipairs(char:GetChildren()) do
				if ch:IsA("BasePart") and ch ~= head and not fpShouldSkipLTM(ch) then
					ch.LocalTransparencyModifier = 0
				end
			end
		end
		HeadOrbitFP.WasFP = isFP
	end

	local FP_BIND = "MorphIntegratedFP"

	function fpHelperRender()
		if not HeadOrbitFP.Enabled or not App.SystemActive then return end
		local char = Player.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")
		if not (hum and root and head) then return end
		local cam = workspace.CurrentCamera
		if not cam then return end

		if cam.CameraType ~= Enum.CameraType.Custom then
			cam.CameraType = Enum.CameraType.Custom
		end
		if cam.CameraSubject ~= hum then
			cam.CameraSubject = hum
		end

		local inFP = isFirstPersonLocal()
		Player:SetAttribute("ForceFP", inFP)
		fpApplyVisibility(inFP)

		
		local raw = root.CFrame:PointToObjectSpace(head.Position)
		local horiz = Vector3.new(raw.X, 0, raw.Z)
		local maxH = HeadOrbitFP.MaxHorizontalOffset or 0.5
		if horiz.Magnitude > maxH then
			horiz = horiz.Unit * maxH
		end
		local forwardAmt = HeadOrbitFP.ForwardOffsetAmount or 1
		local forward = inFP and Vector3.new(0, 0, -forwardAmt) or Vector3.zero
		local height = HeadOrbitFP.HeightAdjust or -1.4
		local target = Vector3.new(horiz.X + forward.X, raw.Y + height, horiz.Z + forward.Z)
		local spd = HeadOrbitFP.SmoothSpeed or 0.25
		HeadOrbitFP.CurrentOffset = (HeadOrbitFP.CurrentOffset or Vector3.zero):Lerp(target, spd)
		hum.CameraOffset = HeadOrbitFP.CurrentOffset
	end

	setHeadOrbitEnabled = function(on)
		HeadOrbitFP.Enabled = on == true
		pcall(function() RunService:UnbindFromRenderStep(FP_BIND) end)
		if HeadOrbitFP.Enabled then
			HeadOrbitFP.CurrentOffset = Vector3.zero
			RunService:BindToRenderStep(FP_BIND, Enum.RenderPriority.Last.Value, fpHelperRender)
		else
			Player:SetAttribute("ForceFP", false)
			fpApplyVisibility(false)
			HeadOrbitFP.WasFP = false
			HeadOrbitFP.CurrentOffset = Vector3.zero
			local char = Player.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then hum.CameraOffset = Vector3.zero end
			end
		end
		if SyncMorphUI.RefreshToggles then pcall(SyncMorphUI.RefreshToggles) end
	end

