	local function normalizeClothingTextureId(id)
		if type(id) ~= "string" or id == "" then return id end
		local num = id:match("(%d+)%s*$") or id:match("id=(%d+)") or id:match("rbxassetid://(%d+)")
		if num then
			return "rbxassetid://" .. num
		end
		return id
	end

	
	
	
	local function applyUVSurfaceAppearance(meshPart, textureId, uvT)
		if not meshPart or not meshPart:IsA("MeshPart") then return false end
		textureId = textureId or meshPart.TextureID
		textureId = normalizeClothingTextureId(textureId)
		if type(textureId) ~= "string" or textureId == "" then return false end
		uvT = math.clamp(tonumber(uvT) or 0, 0, 1)
		local n = string.lower(meshPart.Name or "")
		local isLegUV = (n:find("leg") ~= nil) and (n:find("uv") ~= nil or n:find("texture") ~= nil)

		
		if uvT > 0.001 then
			pcall(function()
				local sa = meshPart:FindFirstChildOfClass("SurfaceAppearance")
				if sa then sa:Destroy() end
				meshPart.TextureID = textureId
				meshPart.Transparency = uvT
				meshPart.Material = Enum.Material.SmoothPlastic
				meshPart.Color = Color3.new(1, 1, 1)
			end)
			return true
		end

		
		
		pcall(function()
			local sa = meshPart:FindFirstChildOfClass("SurfaceAppearance")
			if not sa then
				sa = Instance.new("SurfaceAppearance")
				sa.Name = "MorphUVSurface"
				sa.Parent = meshPart
			end
			sa.ColorMap = textureId
			sa.AlphaMode = Enum.AlphaMode.Transparency
			meshPart.TextureID = ""
			meshPart.Transparency = 0
			if meshPart.Material == Enum.Material.Glass or meshPart.Material == Enum.Material.ForceField then
				meshPart.Material = Enum.Material.SmoothPlastic
			end
			pcall(function() meshPart.LocalTransparencyModifier = 0 end)
			
			local isArmUV = (n:find("arm") ~= nil) and (n:find("uv") ~= nil)
			if (isLegUV or isArmUV) and not meshPart:GetAttribute("MorphUVInflated") then
				
				meshPart.Size = meshPart.Size * 1.0005
				meshPart:SetAttribute("MorphUVInflated", true)
			end
		end)
		return true
	end

	function Function.ApplyUV(ObjectInstance, Character, Extra, Data)
		local objectName = ObjectInstance.Name:lower()
		if not (objectName:find("uv") or objectName:find("texture") or objectName:find("shirt") or objectName:find("pant")) then
			return
		end
		Extra = Extra or {}
		if Extra.Shirt and (objectName:find("shirt") or objectName:find("boob") or objectName:find("breast")
			or objectName:find("torso") or objectName:find("arm")) then
			ObjectInstance.TextureID = Extra.Shirt.ShirtTemplate
		end
		if Extra.Pants and (objectName:find("pant") or objectName:find("butt") or objectName:find("ass")
			or objectName:find("leg") or objectName:find("cheek")) then
			ObjectInstance.TextureID = Extra.Pants.PantsTemplate
		end
		
		if (not ObjectInstance.TextureID or ObjectInstance.TextureID == "") and Character then
			if objectName:find("leg") or objectName:find("pant") or objectName:find("butt") then
				local pants = Character:FindFirstChildOfClass("Pants")
				if pants then ObjectInstance.TextureID = pants.PantsTemplate end
			else
				local shirt = Character:FindFirstChildOfClass("Shirt")
				if shirt then ObjectInstance.TextureID = shirt.ShirtTemplate end
			end
		end
		local uvT = 0
		do
			local data = type(Data) == "table" and Data or PlayerData[Data]
			if data and tonumber(data.UVTransparency) then
				uvT = math.clamp(tonumber(data.UVTransparency), 0, 1)
			end
		end
		local usedSA = false
		if ObjectInstance:IsA("MeshPart") then
			usedSA = applyUVSurfaceAppearance(ObjectInstance, ObjectInstance.TextureID, uvT)
		end
		if not usedSA then
			ObjectInstance.Transparency = (uvT > 0.001) and uvT or 0
			if ObjectInstance:IsA("MeshPart") and ObjectInstance.TextureID and ObjectInstance.TextureID ~= "" then
				
			end
		end
		pcall(function()
			if ObjectInstance:IsA("MeshPart") then
				local wantDS = true
				local data = type(Data) == "table" and Data or PlayerData[Data]
				if data and data.UVDoubleSided == false then
					wantDS = false
				end
				ObjectInstance.DoubleSided = wantDS
				ObjectInstance:SetAttribute("MorphWantDoubleSided", wantDS)
			end
		end)
	end

	function Function.ApplyUVTransparency(Character, Data)
		local data = type(Data) == "table" and Data or PlayerData[Data]
		if not data or not Character then return end
		local uvT = math.clamp(tonumber(data.UVTransparency) or 0, 0, 1)
		local morph = Character:FindFirstChild("Morph")
		if not morph then return end
		local primary = Character.PrimaryPart
		local pants = Character:FindFirstChildOfClass("Pants")
			or (primary and primary:FindFirstChildOfClass("Pants"))
		local shirt = Character:FindFirstChildOfClass("Shirt")
			or (primary and primary:FindFirstChildOfClass("Shirt"))
		for _, d in ipairs(morph:GetDescendants()) do
			if d:IsA("BasePart") then
				local n = (d.Name or ""):lower()
				local isUV = n:find("uv") or n:find("texture") or n:find("shirt") or n:find("pant")
				if isUV then
					if d:IsA("MeshPart") then
						local tex = d.TextureID
						local sa = d:FindFirstChildOfClass("SurfaceAppearance")
						if (not tex or tex == "") and sa and sa.ColorMap and sa.ColorMap ~= "" then
							tex = sa.ColorMap
						end
						if (not tex or tex == "") then
							if n:find("leg") or n:find("pant") or n:find("butt") or n:find("cheek") then
								tex = pants and pants.PantsTemplate or tex
							else
								tex = shirt and shirt.ShirtTemplate or tex
							end
						end
						if tex and tex ~= "" then
							applyUVSurfaceAppearance(d, tex, uvT)
						end
					else
						d.Transparency = (uvT > 0.001) and uvT or 0.02
					end
				end
			end
		end
		
		pcall(function() Function.ForceLegUVGlassSafe(Character, Data) end)
	end

	
	local function resolveArmMeshId(Character, morph, armName, solidName, fallbackId)
		
		if morph then
			local solid = morph:FindFirstChild(solidName, true)
			if solid and solid:IsA("MeshPart") then
				local id = solid.MeshId
				if type(id) == "string" and id ~= "" then
					return id, solid
				end
			end
		end
		
		local charArm = Character:FindFirstChild(armName)
		if charArm and charArm:IsA("MeshPart") then
			local id = charArm.MeshId
			if type(id) == "string" and id ~= "" then
				return id, charArm
			end
		end
		
		if charArm then
			local sm = charArm:FindFirstChildOfClass("SpecialMesh")
			if sm then
				local id = sm.MeshId
				if type(id) == "string" and id ~= "" then
					return id, charArm
				end
			end
		end
		
		local bodyEnum = (armName == "Left Arm") and Enum.BodyPart.LeftArm or Enum.BodyPart.RightArm
		for _, cm in ipairs(Character:GetChildren()) do
			if cm:IsA("CharacterMesh") and cm.BodyPart == bodyEnum then
				local mid = cm.MeshId
				if mid and mid ~= 0 then
					return "rbxassetid://" .. tostring(mid), charArm
				end
			end
		end
		
		return fallbackId, (morph and morph:FindFirstChild(solidName, true)) or charArm
	end

	
