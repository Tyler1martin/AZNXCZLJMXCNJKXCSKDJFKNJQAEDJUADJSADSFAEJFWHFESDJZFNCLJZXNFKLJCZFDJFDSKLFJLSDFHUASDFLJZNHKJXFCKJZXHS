	function hideCensorOverlay()
		CensorOverlay.FadeToken = (CensorOverlay.FadeToken or 0) + 1
		local myTok = CensorOverlay.FadeToken
		local gui = CensorOverlay.Gui
		CensorOverlay.Gui = nil
		if not gui or not gui.Parent then
			pcall(function()
				local pg = Player:FindFirstChild("PlayerGui")
				if pg then
					local old = pg:FindFirstChild("MorphCensorOverlay")
					if old then old:Destroy() end
				end
			end)
			return
		end
		local frame = gui:FindFirstChildOfClass("Frame")
		local label = frame and frame:FindFirstChildOfClass("TextLabel")
		local TS = game:GetService("TweenService")
		local tInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		pcall(function()
			if frame then TS:Create(frame, tInfo, {BackgroundTransparency = 1}):Play() end
			if label then TS:Create(label, tInfo, {TextTransparency = 1}):Play() end
		end)
		task.delay(0.32, function()
			if CensorOverlay.FadeToken ~= myTok then return end
			pcall(function() if gui then gui:Destroy() end end)
			pcall(function()
				local pg = Player:FindFirstChild("PlayerGui")
				if pg then
					local old = pg:FindFirstChild("MorphCensorOverlay")
					if old then old:Destroy() end
				end
			end)
		end)
	end

	function showCensorOverlay()
		if not CensorOverlay.Enabled then return end
		CensorOverlay.FadeToken = (CensorOverlay.FadeToken or 0) + 1
		local myTok = CensorOverlay.FadeToken
		pcall(function()
			if CensorOverlay.Gui then CensorOverlay.Gui:Destroy() end
		end)
		CensorOverlay.Gui = nil
		pcall(function()
			local pg = Player:FindFirstChild("PlayerGui")
			if pg then
				local old = pg:FindFirstChild("MorphCensorOverlay")
				if old then old:Destroy() end
			end
		end)
		local pg = Player:FindFirstChild("PlayerGui")
		if not pg then
			pcall(function() pg = Player:WaitForChild("PlayerGui", 2) end)
		end
		if not pg then return end
		local gui = Instance.new("ScreenGui")
		gui.Name = "MorphCensorOverlay"
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 10000
		gui.ResetOnSpawn = false
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.new(0, 0, 0)
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.Parent = gui
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "CENSORED"
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextTransparency = 1
		label.TextScaled = true
		label.Font = Enum.Font.GothamBlack
		label.Parent = frame
		local constraint = Instance.new("UITextSizeConstraint")
		constraint.MaxTextSize = 96
		constraint.MinTextSize = 28
		constraint.Parent = label
		gui.Parent = pg
		CensorOverlay.Gui = gui
		local TS = game:GetService("TweenService")
		local tInfo = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		pcall(function()
			if CensorOverlay.FadeToken ~= myTok then return end
			TS:Create(frame, tInfo, {BackgroundTransparency = 0}):Play()
			TS:Create(label, tInfo, {TextTransparency = 0}):Play()
		end)
	end

	function Function.CharacterReset(Character, Data)

		if Character == nil then return end
		if not PlayerData[Data] then return end

		
		PlayerData[Data].WeldToken = (PlayerData[Data].WeldToken or 0) + 1

		local PartList = PlayerData[Data].CurrentPartList
		if PartList then
			
			if PartList.BodyPartPhysics then
				for part, prop in pairs(PartList.BodyPartPhysics) do
					if type(prop) == "table" and prop.Weld then
						pcall(function()
							if prop.CF then prop.Weld.C0 = prop.CF end
							if prop.CF1 then prop.Weld.C1 = prop.CF1 end
							if prop.Spring then
								prop.Spring.Position = Vector3.zero
								prop.Spring.Velocity = Vector3.zero
							end
						end)
					end
					PartList.BodyPartPhysics[part] = nil
				end
				
				for k in pairs(PartList.BodyPartPhysics) do
					PartList.BodyPartPhysics[k] = nil
				end
			end
			if PartList.RealtimeUpdateList then
				if PartList.RealtimeUpdateList.Mesh then table.clear(PartList.RealtimeUpdateList.Mesh) end
				if PartList.RealtimeUpdateList.Accessory then table.clear(PartList.RealtimeUpdateList.Accessory) end
			end

			local function destroyEntry(v)
				if typeof(v) == "Instance" then
					pcall(function() v:Destroy() end)
				end
			end
			if PartList.Organ then
				for _, v in pairs(PartList.Organ) do destroyEntry(v) end
				table.clear(PartList.Organ)
			end
			if PartList.Accessory then
				for _, v in pairs(PartList.Accessory) do destroyEntry(v) end
				table.clear(PartList.Accessory)
			end
			if PartList.Clothes then
				for _, v in pairs(PartList.Clothes) do destroyEntry(v) end
				table.clear(PartList.Clothes)
			end
			if PartList.AreolaDecal then
				for Decal, _ in pairs(PartList.AreolaDecal) do
					if Decal and Decal.Parent then pcall(function() Decal:Destroy() end) end
				end
				table.clear(PartList.AreolaDecal)
			end
		end

		
		PlayerData[Data].deferredWelds = {}
		PlayerData[Data].ClothWrap = nil
		pcall(function() if bloodClearAll then bloodClearAll() end end)

		PlayerData[Data].CurrentPartList = Function.PlayerDataDefault().CurrentPartList

		
		pcall(function()
			if MorphLoadState.PostResetClean then
				MorphLoadState.PostResetClean()
			end
		end)

		local R6Limbs = {"Torso","Head","Right Arm","Right Leg","Left Arm","Left Leg"}
		local R15Parts = {
			"UpperTorso","LowerTorso",
			"LeftUpperArm","LeftLowerArm","LeftHand",
			"RightUpperArm","RightLowerArm","RightHand",
			"LeftUpperLeg","LeftLowerLeg","LeftFoot",
			"RightUpperLeg","RightLowerLeg","RightFoot",
			"Head",
		}
		for _, v in pairs(Character:GetChildren()) do
			if v:IsA("BasePart") then
				if table.find(R6Limbs, v.Name) or table.find(R15Parts, v.Name) then
					v.Transparency = 0
				end
				if v.Name == "HumanoidRootPart" then
					v.Transparency = 1
				end
			end
			if v.Name == "Morph" then
				v:Destroy()
			end
		end
		
		for _, name in ipairs({"Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
			local p = Character:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				local hum = Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.RigType == Enum.HumanoidRigType.R15 then
					
					pcall(function() p:Destroy() end)
				end
			end
		end
		pcall(function()
			for i,v in pairs(Character.PrimaryPart:GetChildren()) do
				if v:IsA("Clothing") then
					v.Parent = Character
				end
			end
		end)
		
		if PlayerData[Data] then
			PlayerData[Data].MorphActive = false
		end
		
		pcall(function()
			if clearBlushGlow then clearBlushGlow() end
			if stopHoldBreastAnim then stopHoldBreastAnim() end
			if HoldBreast then HoldBreast.Holding = false end
		end)
		Function.ApplyRealisticMovement(Character, Data)
		if SyncMorphUI.UpdateMode then pcall(SyncMorphUI.UpdateMode) end
	end

	function Function.CharacterExecute(Character, Data)
		if not Character then return end
		local now = os.clock()
		
		
		if MorphLoadState.Busy then
			MorphLoadState.Token = (MorphLoadState.Token or 0) + 1 
		elseif (now - (MorphLoadState.LastStart or 0)) < (MorphLoadState.MinInterval or 0.2) then
			return
		end
		MorphLoadState.Busy = true
		MorphLoadState.LastStart = now
		MorphLoadState.Token = (MorphLoadState.Token or 0) + 1
		local myToken = MorphLoadState.Token
		pcall(showCensorOverlay)

		task.spawn(function()
			local function release()
				if MorphLoadState.Token == myToken then
					MorphLoadState.Busy = false
					pcall(hideCensorOverlay)
				end
			end
			local ok, err = pcall(function()
			if Character and Character.Parent then
				Function.PlayerDataAdd(Data)
				Function.CharacterReset(Character,Data)
				

				local DataConfig = PlayerData[Data]
				DataConfig.BreastsScale = DataConfig.BreastsScale or 1
				DataConfig.ButtsScale = DataConfig.ButtsScale or 1
				DataConfig.BreastsAxis = DataConfig.BreastsAxis or {X = 1, Y = 1, Z = 1}
				DataConfig.ButtsAxis = DataConfig.ButtsAxis or {X = 1, Y = 1, Z = 1}
				DataConfig.BreastsOffset = DataConfig.BreastsOffset or {X = 0, Y = 0, Z = 0}
				DataConfig.BreastsRotation = DataConfig.BreastsRotation or {X = 0, Y = 0, Z = 0}
				DataConfig.ButtsOffset = DataConfig.ButtsOffset or {X = 0, Y = 0, Z = 0}
				DataConfig.ButtsRotationL = DataConfig.ButtsRotationL or {X = 0, Y = 0, Z = 0}
				DataConfig.ButtsRotationR = DataConfig.ButtsRotationR or {X = 0, Y = 0, Z = 0}
				DataConfig.ButtsSpacing = DataConfig.ButtsSpacing or 0
				
				if DataConfig.LegsScale == nil then
					DataConfig.LegsScale = DataConfig.LeftLegScale or DataConfig.RightLegScale or 1
				end
				if DataConfig.CurvyLegsEnabled == nil then DataConfig.CurvyLegsEnabled = true end
				if DataConfig.CurvyArmsEnabled == nil then DataConfig.CurvyArmsEnabled = true end
				if DataConfig.CurvyTorsoEnabled == nil then DataConfig.CurvyTorsoEnabled = true end
